  "sourcesContent": ["/* Os estilos base do modal vêm das skills (styles/modal.scss e styles/form-groups.scss) */\n:host { display: block; }\n.event-error { display:flex;align-items:center;gap:7px;margin:10px 24px 0;padding:9px 11px;border-radius:8px;background:#fee2e2;color:#b91c1c;font-size:12px; }\n.event-error mat-icon { width:17px;height:17px;font-size:17px; }\n.event-delete-backdrop { position:fixed;inset:0;z-index:1600;display:grid;place-items:center;padding:16px;background:rgba(15,23,42,.55); }\n.event-delete-confirmation { width:min(390px,100%);padding:22px;border-radius:14px;background:var(--bg-surface);color:var(--text-primary);box-shadow:var(--shadow-xl);text-align:center; }\n.event-delete-confirmation>mat-icon { width:36px;height:36px;font-size:36px;color:#ef4444; }\n.event-delete-confirmation h3 { margin:8px 0; }.event-delete-confirmation p { color:var(--text-secondary);font-size:13px; }\n.event-delete-confirmation>div { display:flex;justify-content:flex-end;gap:8px;margin-top:18px; }.event-delete-confirmation button { padding:9px 13px;border-radius:8px;background:var(--bg-hover); }.event-delete-confirmation button.danger { background:#dc2626;color:#fff; }\n.read-only-view-container {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n  animation: fadeIn 0.2s ease;\n}\n\n.view-content-card {\n  background: var(--bg-surface, #ffffff);\n  border: 1px solid var(--border-light, #e2e8f0);\n  border-left: 6px solid var(--brand-500, #6366f1);\n  border-radius: 12px;\n  padding: 22px 24px;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.view-header-row {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.view-title {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 750;\n  color: var(--text-primary, #0f172a);\n  line-height: 1.35;\n  letter-spacing: -0.01em;\n}\n\n.view-meta-badges {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px;\n}\n\n.view-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 4px 10px;\n  border-radius: 8px;\n  font-size: 12px;\n  font-weight: 600;\n  background: var(--bg-surface-alt, #f8fafc);\n  border: 1px solid var(--border-light, #e2e8f0);\n  color: var(--text-secondary, #475569);\n\n  mat-icon {\n    font-size: 14px;\n    width: 14px;\n    height: 14px;\n  }\n\n  &.badge-calendar {\n    background: color-mix(in srgb, currentColor 8%, transparent);\n    border-color: color-mix(in srgb, currentColor 25%, transparent);\n    font-weight: 700;\n  }\n\n  &.badge-schedule {\n    background: #eff6ff;\n    border-color: #bfdbfe;\n    color: #1d4ed8;\n\n    mat-icon {\n      color: #3b82f6;\n    }\n  }\n\n  &.badge-category {\n    background: #fdf4ff;\n    border-color: #f5d0fe;\n    color: #a21caf;\n\n    mat-icon {\n      color: #c026d3;\n    }\n  }\n}\n\n.view-badge-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  flex-shrink: 0;\n}\n\n.view-description-wrap {\n  padding-top: 14px;\n  border-top: 1px solid var(--border-light, #f1f5f9);\n  color: var(--text-primary, #1e293b);\n  font-size: 14px;\n  line-height: 1.65;\n}\n\n.view-empty-desc {\n  color: var(--text-muted, #94a3b8);\n  font-style: italic;\n  font-size: 13px;\n  margin: 0;\n}\n\n.view-attachments-card {\n  background: var(--bg-surface, #ffffff);\n  border: 1px solid var(--border-light, #e2e8f0);\n  border-radius: 12px;\n  padding: 16px 20px;\n\n  .view-card-subtitle {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 13px;\n    font-weight: 700;\n    color: var(--text-secondary, #475569);\n    margin-bottom: 12px;\n\n    mat-icon {\n      font-size: 17px;\n      width: 17px;\n      height: 17px;\n      color: var(--brand-500, #6366f1);\n    }\n  }\n\n  .view-action-icon {\n    margin-left: auto;\n    color: var(--text-muted);\n    font-size: 18px;\n    width: 18px;\n    height: 18px;\n  }\n}\n\n/* ── Color Picker ── */\n.color-picker {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  padding-top: 2px;\n}\n\n.color-swatch {\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  border: 2.5px solid transparent;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.15s ease;\n\n  mat-icon {\n    color: #fff;\n    font-size: 16px;\n    width: 16px;\n    height: 16px;\n  }\n\n  &.selected {\n    border-color: #fff;\n    box-shadow: 0 0 0 2px currentColor, 0 2px 8px rgba(0,0,0,0.25);\n    transform: scale(1.15);\n  }\n\n  &:hover:not(.selected) {\n    transform: scale(1.1);\n    border-color: rgba(255,255,255,0.6);\n  }\n}\n\n/* ── Aviso de feriado ── */\n.holiday-warning {\n  display: block;\n  margin-top: 6px;\n  font-size: 12px;\n  font-weight: 500;\n  color: #d97706;\n  background: rgba(217, 119, 6, 0.08);\n  border: 1px solid rgba(217, 119, 6, 0.25);\n  border-radius: 8px;\n  padding: 6px 10px;\n}\n\n/* ── All Day Row ── */\n.all-day-row {\n  flex-direction: row !important;\n  align-items: center;\n}\n\n.checkbox-label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--text-secondary);\n  cursor: pointer;\n\n  input[type=\"checkbox\"] {\n    width: 16px;\n    height: 16px;\n    accent-color: var(--brand-500);\n    cursor: pointer;\n  }\n}\n\n/* ── Recorrência Mensal ── */\n.recurrence-card {\n  margin-top: 4px;\n  padding: 12px 14px;\n  background: linear-gradient(135deg, rgba(79, 70, 229, 0.04) 0%, rgba(248, 250, 252, 0.8) 100%);\n  border: 1px solid #e2e8f0;\n  border-radius: 12px;\n  transition: all 0.2s ease;\n\n  &:hover {\n    border-color: #cbd5e1;\n  }\n}\n\n.recurrence-toggle-box {\n  display: flex;\n  align-items: center;\n\n  .recurrence-title {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 13px;\n    color: #1e293b;\n\n    .inline-icon {\n      font-size: 18px;\n      width: 18px;\n      height: 18px;\n      color: var(--brand-500, #4f46e5);\n    }\n  }\n}\n\n.recurrence-config-panel {\n  margin-top: 10px;\n  padding-top: 10px;\n  border-top: 1px solid rgba(226, 232, 240, 0.8);\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.recurrence-duration-row {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 10px;\n\n  label {\n    font-size: 13px;\n    font-weight: 600;\n    color: #475569;\n    white-space: nowrap;\n  }\n\n  .recurrence-select {\n    max-width: 170px;\n    height: 38px;\n  }\n}\n\n.custom-duration-input-box {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n\n  .custom-number-input {\n    width: 76px;\n    height: 38px;\n    padding: 0 10px;\n    border: 1.5px solid #cbd5e1;\n    border-radius: 8px;\n    font-size: 14px;\n    font-weight: 600;\n    color: #1e293b;\n    text-align: center;\n    outline: none;\n    transition: all 0.2s ease;\n\n    &:focus {\n      border-color: #4f46e5;\n      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);\n    }\n  }\n\n  .input-suffix {\n    font-size: 13px;\n    font-weight: 600;\n    color: #64748b;\n  }\n}\n\n.recurrence-preview-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 12px;\n  background: rgba(79, 70, 229, 0.08);\n  border: 1px solid rgba(79, 70, 229, 0.2);\n  border-radius: 8px;\n  font-size: 12.5px;\n  color: #3730a3;\n\n  mat-icon {\n    font-size: 16px;\n    width: 16px;\n    height: 16px;\n    color: #4f46e5;\n    flex-shrink: 0;\n  }\n\n  strong {\n    color: #1e1b4b;\n  }\n}\n\n.disabled-field {\n  opacity: 0.4;\n  pointer-events: none;\n}\n\n/* ── Participantes (Grid de Seleção) ── */\n.attendees-selection-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\n  gap: 8px;\n  max-height: 160px;\n  overflow-y: auto;\n  padding: 2px;\n}\n\n.attendee-chip {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 6px 10px;\n  border-radius: 10px;\n  background: var(--bg-hover, #f1f5f9);\n  border: 1.5px solid var(--border, #e2e8f0);\n  cursor: pointer;\n  transition: all 0.2s ease;\n  user-select: none;\n\n  &:hover {\n    border-color: #cbd5e1;\n    background: #e2e8f0;\n  }\n\n  &.selected {\n    background: rgba(79, 70, 229, 0.08);\n    border-color: var(--brand-500, #4f46e5);\n  }\n}\n\n.chip-avatar {\n  width: 26px;\n  height: 26px;\n  border-radius: 50%;\n  background: var(--brand-500);\n  color: #fff;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 10px;\n  font-weight: 700;\n  overflow: hidden;\n  flex-shrink: 0;\n\n  img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n}\n\n.chip-details {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  flex: 1;\n}\n\n.chip-name {\n  font-size: 12px;\n  font-weight: 600;\n  color: var(--text-primary);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.chip-dept {\n  font-size: 10px;\n  color: var(--text-muted);\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.chip-check {\n  font-size: 16px;\n  width: 16px;\n  height: 16px;\n  color: var(--brand-500);\n  flex-shrink: 0;\n}\n\n/* ── Footer extras ── */\n.footer-spacer { flex: 1; }\n\n.btn-delete {\n  width: 38px;\n  height: 38px;\n  border-radius: 10px;\n  background: #fee2e2;\n  color: #ef4444;\n  border: 1.5px solid #fecaca;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: all 0.2s ease;\n\n  mat-icon { font-size: 20px; width: 20px; height: 20px; }\n\n  &:hover {\n    background: #fecaca;\n    border-color: #f87171;\n  }\n}\n\n/* Spinner dentro do botão salvar */\n.button-spinner {\n  ::ng-deep circle {\n    stroke: rgba(255, 255, 255, 0.85);\n  }\n}\n\n.duplicate-event-section { padding: 0 24px 16px; }\n.no-calendar-warning { margin: 0 0 14px; padding: 10px; border-radius: 8px; background: #fef3c7; color: #92400e; font-size: 13px; }\n.btn-duplicate-toggle, .btn-duplicate-confirm { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--border); border-radius: 8px; padding: 8px 11px; cursor: pointer; }\n.btn-duplicate-toggle { margin-left: 10px; border-color: #c4b5fd; background: #ede9fe; color: #6d28d9; font-weight: 600; }\n.btn-duplicate-toggle:hover { background: #ddd6fe; border-color: #8b5cf6; }\n.btn-duplicate-toggle mat-icon { width: 18px; height: 18px; font-size: 18px; }\n.duplicate-calendar-options { display: grid; gap: 8px; margin-top: 10px; padding: 10px; border: 1px solid var(--border-light); border-radius: 8px; }\n.duplicate-calendar-options label { display: flex; align-items: center; gap: 8px; font-size: 13px; cursor: pointer; }\n.duplicate-dot { width: 9px; height: 9px; border-radius: 50%; }\n.btn-duplicate-confirm { justify-content: center; color: #fff; background: var(--brand-500); border-color: var(--brand-500); }\n.btn-duplicate-confirm:disabled { opacity: .5; cursor: not-allowed; }\n.description-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; }\n.preview-label { display: block; margin-bottom: 7px; color: var(--text-muted); font-size: 9px; font-weight: 750; text-transform: uppercase; letter-spacing: .06em; }\n"],
