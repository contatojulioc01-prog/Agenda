  "sourcesContent": ["app-markdown-editor { display: block; min-width: 0; }\n\n.markdown-editor-shell {\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  position: relative;\n}\n\n/* ── Barra de Ferramentas de Formatação ── */\n.markdown-editor-toolbar {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 2px;\n  padding: 4px 6px;\n  background: var(--bg-surface-alt, #f8fafc);\n  border: 1px solid var(--border-light, #e2e8f0);\n  border-bottom: none;\n  border-radius: 9px 9px 0 0;\n\n  .toolbar-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 28px;\n    height: 28px;\n    border-radius: 6px;\n    border: none;\n    background: transparent;\n    color: var(--text-secondary, #64748b);\n    cursor: pointer;\n    transition: all 0.12s ease;\n\n    mat-icon {\n      font-size: 17px;\n      width: 17px;\n      height: 17px;\n    }\n\n    &:hover {\n      background: var(--bg-hover, rgba(0, 0, 0, 0.05));\n      color: var(--brand-600, #4f46e5);\n    }\n  }\n\n  .toolbar-divider {\n    width: 1px;\n    height: 16px;\n    background: var(--border-light, #e2e8f0);\n    margin: 0 4px;\n  }\n}\n\n.markdown-editor {\n  width: 100%;\n  min-height: 88px;\n  max-height: 260px;\n  overflow-y: auto;\n  padding: 10px 12px;\n  border: 1px solid var(--border-light);\n  border-radius: 0 0 9px 9px;\n  outline: none;\n  background: var(--bg-input, var(--bg-surface-alt));\n  color: var(--text-primary);\n  font: inherit;\n  line-height: 1.55;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  transition: border-color .15s ease, box-shadow .15s ease;\n}\n\n/* Caso a toolbar esteja desativada */\n.markdown-editor-shell:not(:has(.markdown-editor-toolbar)) .markdown-editor {\n  border-radius: 9px;\n}\n\n.markdown-editor:focus {\n  border-color: var(--brand-500);\n  box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-500) 14%, transparent);\n}\n\n/* ══════════════ LIVE PREVIEW (marcadores esmaecidos) ══════════════ */\n.markdown-editor .md-line { min-height: 1.55em; }\n.markdown-editor .md-mark {\n  color: var(--text-muted, #94a3b8);\n  opacity: .55;\n  font-weight: 400;\n  font-style: normal;\n  text-decoration: none;\n}\n.markdown-editor .md-strong { font-weight: 750; }\n.markdown-editor .md-em { font-style: italic; }\n.markdown-editor .md-del { text-decoration: line-through; opacity: .75; }\n.markdown-editor .md-del .md-mark { text-decoration: none; }\n\n.markdown-editor .md-heading { font-weight: 750; line-height: 1.35; color: var(--text-primary); }\n.markdown-editor .md-h1 { font-size: 1.45em; }\n.markdown-editor .md-h2 { font-size: 1.3em; }\n.markdown-editor .md-h3 { font-size: 1.15em; }\n.markdown-editor .md-h4, .markdown-editor .md-h5, .markdown-editor .md-h6 { font-size: 1.03em; }\n\n.markdown-editor .md-bullet {\n  color: var(--brand-600, #4f46e5);\n  opacity: .9;\n  font-weight: 700;\n}\n.markdown-editor .md-task {\n  color: var(--brand-600, #4f46e5);\n  font-weight: 750;\n  cursor: pointer;\n  padding: 1px 3px;\n  border-radius: 4px;\n  user-select: none;\n  transition: all 0.15s ease;\n\n  &:hover {\n    background: color-mix(in srgb, var(--brand-500, #6366f1) 15%, transparent);\n    color: var(--brand-700, #4338ca);\n  }\n}\n.markdown-editor .md-task-done {\n  color: var(--text-muted);\n  text-decoration: line-through;\n  opacity: 0.8;\n}\n.markdown-editor .md-task-done .md-mark { text-decoration: none; }\n\n.markdown-editor .md-quote {\n  border-left: 3px solid var(--brand-500, #6366f1);\n  padding-left: .6em;\n  color: var(--text-secondary);\n}\n\n.markdown-editor .md-hr { color: var(--text-muted); letter-spacing: .2em; }\n\n.markdown-editor .md-code,\n.markdown-editor .md-code-line,\n.markdown-editor .md-fence {\n  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n  font-size: .92em;\n}\n.markdown-editor .md-code {\n  padding: 1px 4px;\n  border-radius: 4px;\n  background: color-mix(in srgb, var(--text-primary) 8%, transparent);\n}\n.markdown-editor .md-code-line,\n.markdown-editor .md-fence {\n  background: color-mix(in srgb, var(--text-primary) 6%, transparent);\n  padding: 0 .5em;\n}\n\n.markdown-editor .md-link,\n.markdown-editor .md-autolink {\n  color: var(--brand-600, #4f46e5);\n  text-decoration: underline;\n  text-underline-offset: 2.5px;\n  cursor: pointer;\n}\n.markdown-editor .md-link:hover,\n.markdown-editor .md-autolink:hover { color: var(--brand-700, #4338ca); }\n.markdown-editor .md-url { font-size: .9em; }\n\n.markdown-editor:empty::before {\n  content: attr(data-placeholder);\n  color: var(--text-muted);\n  pointer-events: none;\n}\n\n.markdown-editor p { margin: 0 0 .45em; }\n.markdown-editor p:last-child { margin-bottom: 0; }\n.markdown-editor h1 { font-size: 1.3em; font-weight: 750; margin: 0.35em 0 0.35em; color: var(--text-primary); line-height: 1.3; }\n.markdown-editor h2 { font-size: 1.2em; font-weight: 700; margin: 0.3em 0 0.3em; color: var(--text-primary); line-height: 1.3; }\n.markdown-editor h3 { font-size: 1.1em; font-weight: 650; margin: 0.25em 0 0.25em; color: var(--text-primary); line-height: 1.3; }\n.markdown-editor h4, .markdown-editor h5, .markdown-editor h6 {\n  margin: .2em 0 .3em;\n  color: var(--text-primary);\n  font-size: 1.02em;\n  font-weight: 650;\n  line-height: 1.3;\n}\n.markdown-editor strong { color: inherit; font-weight: 750; }\n.markdown-editor em { font-style: italic; }\n.markdown-editor del { text-decoration: line-through; opacity: 0.75; }\n\n/* Links interativos dentro do editor */\n.markdown-editor a, .markdown-editor .markdown-link {\n  color: var(--brand-600, #4f46e5);\n  text-decoration: underline;\n  text-underline-offset: 2.5px;\n  text-decoration-thickness: 1px;\n  font-weight: 550;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n  cursor: pointer;\n  padding: 1px 3px;\n  border-radius: 4px;\n  transition: all 0.12s ease;\n\n  &:hover {\n    color: var(--brand-700, #4338ca);\n    background: color-mix(in srgb, var(--brand-500) 10%, transparent);\n  }\n}\n\n.markdown-editor code {\n  padding: 1px 5px;\n  border-radius: 4px;\n  background: color-mix(in srgb, var(--text-primary) 9%, transparent);\n  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n  font-size: .92em;\n}\n\n.markdown-editor blockquote {\n  margin: .45em 0;\n  padding: .2em 0 .2em .8em;\n  border-left: 3px solid var(--brand-500);\n  color: var(--text-secondary);\n}\n.markdown-editor ul, .markdown-editor ol {\n  margin: .4em 0 .5em 0;\n  padding-left: 1.8em;\n  list-style-position: outside;\n}\n.markdown-editor li {\n  margin: .2em 0;\n  line-height: 1.5;\n}\n.markdown-editor li.checklist-item {\n  list-style-type: none;\n  margin-left: -1.4em;\n  padding-left: 0;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.markdown-editor .markdown-table-wrap { max-width: 100%; margin: .55em 0; overflow-x: auto; }\n.markdown-editor table { width: 100%; border-collapse: collapse; font-size: .92em; }\n.markdown-editor th, .markdown-editor td { padding: 6px 7px; border: 1px solid var(--border-light); text-align: left; vertical-align: top; }\n.markdown-editor th { background: var(--bg-surface-alt); font-weight: 750; }\n\n.markdown-editor-footer {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  margin-top: 5px;\n  color: var(--text-muted);\n  font-size: 10px;\n}\n\n.footer-hint {\n  font-weight: 500;\n  opacity: 0.85;\n}\n\n.footer-counter {\n  font-weight: 600;\n}\n\n/* ══════════════ MODAL DE CONFIGURAÇÃO DE HYPERLINK ══════════════ */\n.link-modal-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 99999;\n  background: rgba(15, 23, 42, 0.65);\n  backdrop-filter: blur(4px);\n  -webkit-backdrop-filter: blur(4px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 16px;\n  animation: linkFadeIn 0.18s ease-out forwards;\n}\n\n.link-modal-card {\n  width: 100%;\n  max-width: 480px;\n  background: var(--bg-surface, #ffffff);\n  border: 1px solid var(--border-light, #e2e8f0);\n  border-radius: 14px;\n  box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(0, 0, 0, 0.05);\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  animation: linkScaleIn 0.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n\n.link-modal-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 14px 18px;\n  border-bottom: 1px solid var(--border-light, #e2e8f0);\n  background: var(--bg-surface-alt, #f8fafc);\n}\n\n.link-modal-title {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n\n  .link-modal-badge {\n    width: 34px;\n    height: 34px;\n    border-radius: 8px;\n    background: #4f46e5;\n    color: #ffffff;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    mat-icon {\n      font-size: 19px;\n      width: 19px;\n      height: 19px;\n    }\n  }\n\n  h4 {\n    margin: 0;\n    font-size: 14.5px;\n    font-weight: 700;\n    color: var(--text-primary, #0f172a);\n  }\n\n  span {\n    display: block;\n    font-size: 11.5px;\n    color: var(--text-muted, #64748b);\n    margin-top: 1px;\n  }\n}\n\n.btn-close-link-modal {\n  width: 28px;\n  height: 28px;\n  border-radius: 6px;\n  border: none;\n  background: transparent;\n  color: var(--text-muted, #64748b);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.15s ease;\n\n  mat-icon {\n    font-size: 18px;\n    width: 18px;\n    height: 18px;\n  }\n\n  &:hover {\n    background: rgba(0, 0, 0, 0.06);\n    color: var(--text-primary, #0f172a);\n  }\n}\n\n.link-modal-body {\n  padding: 18px;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n\n.link-field {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n\n  label {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 12.5px;\n    font-weight: 650;\n    color: var(--text-primary, #1e293b);\n\n    mat-icon {\n      font-size: 15px;\n      width: 15px;\n      height: 15px;\n      color: #6366f1;\n    }\n\n    .req {\n      color: #ef4444;\n    }\n  }\n\n  input {\n    width: 100%;\n    padding: 8px 12px;\n    border: 1px solid var(--border-light, #cbd5e1);\n    border-radius: 8px;\n    background: var(--bg-input, #ffffff);\n    color: var(--text-primary, #0f172a);\n    font-size: 13.5px;\n    outline: none;\n    transition: all 0.15s ease;\n\n    &:focus {\n      border-color: #6366f1;\n      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);\n    }\n  }\n\n  .field-hint {\n    font-size: 11px;\n    color: var(--text-muted, #64748b);\n  }\n}\n\n.link-preview-box {\n  padding: 10px 14px;\n  border-radius: 8px;\n  background: var(--bg-surface-alt, #f8fafc);\n  border: 1px dashed var(--border-light, #cbd5e1);\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n\n  .preview-tag {\n    font-size: 10.5px;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n    color: var(--text-muted, #64748b);\n  }\n\n  .preview-result {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 13px;\n\n    .preview-icon {\n      font-size: 15px;\n      width: 15px;\n      height: 15px;\n      color: #4f46e5;\n    }\n\n    .preview-label {\n      font-weight: 650;\n      color: #4f46e5;\n      text-decoration: underline;\n    }\n\n    .preview-target-url {\n      font-size: 11.5px;\n      color: var(--text-muted, #64748b);\n      max-width: 200px;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      white-space: nowrap;\n    }\n  }\n}\n\n.link-modal-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 12px 18px;\n  border-top: 1px solid var(--border-light, #e2e8f0);\n  background: var(--bg-surface-alt, #f8fafc);\n  gap: 10px;\n\n  .btn-remove-link {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    padding: 7px 11px;\n    border-radius: 7px;\n    border: 1px solid rgba(239, 68, 68, 0.25);\n    background: rgba(239, 68, 68, 0.08);\n    color: #ef4444;\n    font-size: 12px;\n    font-weight: 600;\n    cursor: pointer;\n    transition: all 0.15s ease;\n\n    mat-icon {\n      font-size: 15px;\n      width: 15px;\n      height: 15px;\n    }\n\n    &:hover {\n      background: rgba(239, 68, 68, 0.18);\n    }\n  }\n\n  .footer-right-actions {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-left: auto;\n  }\n\n  .btn-cancel-link {\n    padding: 7px 13px;\n    border-radius: 7px;\n    border: 1px solid var(--border-light, #cbd5e1);\n    background: transparent;\n    color: var(--text-secondary, #475569);\n    font-size: 12.5px;\n    font-weight: 600;\n    cursor: pointer;\n    transition: all 0.15s ease;\n\n    &:hover {\n      background: rgba(0, 0, 0, 0.04);\n      color: var(--text-primary, #0f172a);\n    }\n  }\n\n  .btn-apply-link {\n    display: inline-flex;\n    align-items: center;\n    gap: 5px;\n    padding: 7px 15px;\n    border-radius: 7px;\n    border: none;\n    background: #4f46e5;\n    color: #ffffff;\n    font-size: 12.5px;\n    font-weight: 600;\n    cursor: pointer;\n    box-shadow: 0 2px 4px rgba(79, 70, 229, 0.25);\n    transition: all 0.15s ease;\n\n    mat-icon {\n      font-size: 16px;\n      width: 16px;\n      height: 16px;\n    }\n\n    &:hover:not(:disabled) {\n      background: #4338ca;\n      box-shadow: 0 4px 8px rgba(79, 70, 229, 0.35);\n    }\n\n    &:disabled {\n      opacity: 0.5;\n      cursor: not-allowed;\n      box-shadow: none;\n    }\n  }\n}\n\n@keyframes linkFadeIn {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes linkScaleIn {\n  from { opacity: 0; transform: scale(0.95) translateY(6px); }\n  to { opacity: 1; transform: scale(1) translateY(0); }\n}\n\n/* ══════════════ MENU DE CONTEXTO MARKDOWN (MAT-MENU) ══════════════ */\n.mat-mdc-menu-panel.md-editor-context-menu {\n  width: 320px !important;\n  min-width: 320px !important;\n  max-width: 340px !important;\n  border-radius: 14px !important;\n  overflow: hidden !important;\n  background: var(--bg-card, #ffffff) !important;\n  border: 1px solid var(--border-light, #e2e8f0) !important;\n  box-shadow: 0 16px 36px -6px rgba(15, 23, 42, 0.16), 0 8px 16px -4px rgba(15, 23, 42, 0.08) !important;\n  backdrop-filter: blur(16px);\n\n  .mat-mdc-menu-content {\n    padding: 8px 6px !important;\n  }\n\n  /* Cabeçalho do menu */\n  .md-context-menu-header {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 6px 10px 10px;\n    border-bottom: 1px solid var(--border-light, #f1f5f9);\n    margin-bottom: 4px;\n    user-select: none;\n\n    .header-icon-pill {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      width: 28px;\n      height: 28px;\n      border-radius: 8px;\n      background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);\n      color: #ffffff;\n      box-shadow: 0 2px 6px rgba(79, 70, 229, 0.3);\n\n      mat-icon {\n        font-size: 16px;\n        width: 16px;\n        height: 16px;\n      }\n    }\n\n    .header-text-group {\n      display: flex;\n      flex-direction: column;\n      min-width: 0;\n\n      .header-title {\n        font-size: 12px;\n        font-weight: 700;\n        letter-spacing: -0.01em;\n        color: var(--text-primary, #0f172a);\n        line-height: 1.25;\n      }\n\n      .header-subtitle {\n        font-size: 10.5px;\n        color: var(--text-muted, #94a3b8);\n        font-weight: 500;\n        line-height: 1.2;\n      }\n    }\n  }\n\n  /* Rótulo de seção dentro do menu */\n  .md-context-section-label {\n    padding: 6px 10px 2px;\n    font-size: 10px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.06em;\n    color: var(--text-muted, #94a3b8);\n    user-select: none;\n  }\n\n  /* Itens do menu */\n  .mat-mdc-menu-item.md-context-item {\n    min-height: 38px !important;\n    height: 38px !important;\n    padding: 0 8px !important;\n    margin: 1px 0 !important;\n    border-radius: 8px !important;\n    transition: all 0.12s ease !important;\n\n    .mat-mdc-menu-item-text {\n      display: flex !important;\n      align-items: center !important;\n      width: 100% !important;\n      min-width: 0 !important;\n      gap: 10px !important;\n      white-space: nowrap !important;\n    }\n\n    /* Caixa com ícone moderno */\n    .item-icon-box {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      width: 26px;\n      height: 26px;\n      border-radius: 6px;\n      flex-shrink: 0;\n      background: var(--bg-surface-alt, #f8fafc);\n      color: var(--text-secondary, #64748b);\n      border: 1px solid var(--border-light, #e2e8f0);\n      transition: all 0.12s ease;\n\n      mat-icon {\n        font-size: 16px !important;\n        width: 16px !important;\n        height: 16px !important;\n        margin: 0 !important;\n      }\n\n      &.bold-icon { color: #4f46e5; background: #eef2ff; border-color: #e0e7ff; }\n      &.italic-icon { color: #0284c7; background: #f0f9ff; border-color: #e0f2fe; }\n      &.strike-icon { color: #dc2626; background: #fef2f2; border-color: #fee2e2; }\n      &.heading-icon { color: #7c3aed; background: #f5f3ff; border-color: #ede9fe; }\n      &.quote-icon { color: #d97706; background: #fffbeb; border-color: #fef3c7; }\n      &.list-icon { color: #059669; background: #ecfdf5; border-color: #d1fae5; }\n      &.check-icon { color: #16a34a; background: #f0fdf4; border-color: #dcfce7; }\n      &.link-icon { color: #2563eb; background: #eff6ff; border-color: #dbeafe; }\n    }\n\n    /* Rótulo de texto */\n    .md-menu-label {\n      flex: 1 1 auto;\n      font-size: 12.5px;\n      font-weight: 550;\n      color: var(--text-primary, #1e293b);\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      letter-spacing: -0.01em;\n    }\n\n    /* Badge com sintaxe Markdown empurrada para a extrema direita */\n    .md-menu-badge {\n      margin-left: auto !important;\n      flex-shrink: 0;\n      font-family: ui-monospace, SFMono-Regular, Consolas, Menlo, monospace;\n      font-size: 10.5px;\n      font-weight: 600;\n      color: var(--text-muted, #64748b);\n      background: var(--bg-surface-alt, #f8fafc);\n      border: 1px solid var(--border-light, #e2e8f0);\n      padding: 1.5px 6px;\n      border-radius: 5px;\n      letter-spacing: -0.02em;\n      white-space: nowrap;\n      transition: all 0.12s ease;\n    }\n\n    /* Efeitos de Hover */\n    &:hover {\n      background: var(--bg-hover, #f1f5f9) !important;\n\n      .md-menu-label {\n        color: var(--brand-600, #4f46e5);\n      }\n\n      .item-icon-box {\n        transform: scale(1.05);\n        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.06);\n      }\n\n      .md-menu-badge {\n        color: var(--brand-600, #4f46e5);\n        border-color: color-mix(in srgb, var(--brand-600, #4f46e5) 28%, transparent);\n        background: color-mix(in srgb, var(--brand-600, #4f46e5) 8%, transparent);\n      }\n    }\n\n    &.link-item {\n      margin-top: 2px !important;\n      \n      .md-menu-badge.link-badge {\n        color: #2563eb;\n        background: #eff6ff;\n        border-color: #dbeafe;\n      }\n    }\n  }\n\n  .mat-divider {\n    margin: 5px 0 !important;\n    border-top-color: var(--border-light, #f1f5f9) !important;\n  }\n}\n"],
