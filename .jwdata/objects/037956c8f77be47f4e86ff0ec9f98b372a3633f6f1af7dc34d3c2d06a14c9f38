  "sources": ["src/app/features/mural/mural-board/mural-board.component.scss"],
  "sourcesContent": [":host { display: flex; flex: 1; min-width: 0; min-height: 0; }\n\n.mural-shell { display: flex; flex: 1; min-width: 0; min-height: 0; flex-direction: column; gap: 0; }\n\n/* ══════════════ TOOLBAR ══════════════ */\n.mural-toolbar {\n  flex-shrink: 0;\n  min-height: 72px;\n  padding: 10px 16px;\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n}\n\n.toolbar-left {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  flex: 1;\n  overflow-x: auto;\n  min-width: 0;\n}\n\n/* Board selector — Angular Material Design */\n.board-selector-wrapper {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n}\n\n.mat-board-trigger {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 6px 12px 6px 8px;\n  border-radius: 12px;\n  background: var(--bg-surface-alt, rgba(0, 0, 0, 0.03));\n  border: 1px solid var(--border-light, rgba(0, 0, 0, 0.08));\n  cursor: pointer;\n  outline: none;\n  transition: all var(--transition, 0.2s);\n  text-align: left;\n  user-select: none;\n\n  &:hover {\n    background: var(--bg-hover);\n    border-color: var(--border);\n    box-shadow: var(--shadow-sm);\n\n    .dropdown-chevron {\n      color: var(--brand-500);\n      transform: translateY(1px);\n    }\n  }\n\n  &:focus-visible {\n    box-shadow: 0 0 0 2px var(--brand-500);\n  }\n}\n\n.board-mark {\n  width: 40px;\n  height: 40px;\n  border-radius: 10px;\n  flex-shrink: 0;\n  color: #fff;\n  display: grid;\n  place-items: center;\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.16);\n  mat-icon { font-size: 22px; width: 22px; height: 22px; }\n}\n\n.board-heading {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n\n.board-title-row {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.board-active-name {\n  font-size: 16px;\n  font-weight: 750;\n  color: var(--text-primary);\n  letter-spacing: -0.01em;\n  white-space: nowrap;\n  max-width: 220px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.board-items-badge {\n  font-size: 11px;\n  font-weight: 700;\n  color: var(--text-muted);\n  background: var(--bg-hover);\n  padding: 1px 6px;\n  border-radius: 8px;\n}\n\n.dropdown-chevron {\n  font-size: 20px;\n  width: 20px;\n  height: 20px;\n  color: var(--text-muted);\n  transition: transform 0.2s ease, color 0.2s ease;\n}\n\n.board-subtitle {\n  color: var(--text-muted);\n  font-size: 11px;\n  font-weight: 500;\n  white-space: nowrap;\n}\n\n/* Search */\n.search-box {\n  height: 34px;\n  border: 1px solid var(--border);\n  border-radius: 9px;\n  background: var(--bg-input);\n  color: var(--text-secondary);\n  font-size: 12px;\n  display: flex;\n  align-items: center;\n  flex: 1;\n  min-width: 180px;\n  max-width: 260px;\n  padding: 0 10px;\n  gap: 7px;\n  transition: all .2s;\n\n  &:focus-within { border-color: var(--brand-500); background: var(--bg-surface); }\n\n  mat-icon { font-size: 18px; width: 18px; height: 18px; color: var(--text-muted); }\n  input { border: 0; background: transparent; color: var(--text-primary); width: 100%; outline: none; }\n}\n\n/* Filter toggles */\n.archive-toggle {\n  height: 34px;\n  border: 1px solid var(--border);\n  border-radius: 9px;\n  background: var(--bg-input);\n  color: var(--text-secondary);\n  font-size: 12px;\n  padding: 0 11px;\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  cursor: pointer;\n  transition: all .2s;\n  white-space: nowrap;\n\n  mat-icon { font-size: 16px; width: 16px; height: 16px; }\n  &:hover { color: var(--text-primary); background: var(--bg-hover); }\n  &.active { color: var(--text-brand); background: var(--bg-active); border-color: var(--brand-500); }\n}\n\n/* Toolbar buttons */\n.toolbar-actions { display: flex; align-items: center; gap: 7px; }\n\n.icon-btn, .danger-icon {\n  width: 30px; height: 30px;\n  display: inline-grid; place-items: center;\n  border-radius: 8px;\n  color: var(--text-muted);\n  cursor: pointer;\n  transition: all .2s;\n  border: none;\n  background: transparent;\n  mat-icon { font-size: 18px; width: 18px; height: 18px; }\n  &:hover { background: var(--bg-hover); color: var(--text-primary); }\n  &.danger-icon:hover { color: #ef4444; background: rgba(239,68,68,.1); }\n}\n\n.primary-btn, .secondary-btn, .cancel-btn, .delete-btn {\n  height: 36px; border-radius: 9px; padding: 0 13px;\n  display: inline-flex; align-items: center; justify-content: center;\n  gap: 6px; font-size: 12.5px; font-weight: 650; white-space: nowrap;\n  cursor: pointer; transition: all .2s; border: none;\n  mat-icon { font-size: 17px; width: 17px; height: 17px; }\n}\n\n.primary-btn {\n  background: linear-gradient(135deg, var(--brand-500), var(--brand-700));\n  color: #fff;\n  box-shadow: 0 2px 8px rgba(245,158,11,.25);\n  &:hover { transform: translateY(-1px); filter: brightness(1.06); }\n  &:disabled { opacity: .45; cursor: not-allowed; transform: none; }\n}\n\n.secondary-btn { background: var(--bg-hover); color: var(--text-secondary); border: 1px solid var(--border); &:hover { color: var(--text-primary); } }\n.cancel-btn { background: var(--bg-hover); color: var(--text-secondary); border: 1px solid var(--border); &:hover { color: var(--text-primary); } }\n.delete-btn { background: transparent; color: #dc2626; border: 1px solid #fecaca; &:hover:not(:disabled) { background: #fee2e2; } &:disabled { opacity: .6; cursor: not-allowed; } }\n.button-spinner { display: inline-block; }\n\n/* ══════════════ CANVAS ══════════════ */\n.mural-canvas {\n  flex: 1;\n  padding: 20px;\n  overflow-y: auto;\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n  background-color: var(--color-bg, #f1f5f9);\n  background-image:\n    radial-gradient(circle, color-mix(in srgb, var(--border) 80%, transparent) 1px, transparent 1px),\n    radial-gradient(circle, color-mix(in srgb, var(--border) 80%, transparent) 1px, transparent 1px);\n  background-size: 24px 24px;\n  background-position: 0 0, 12px 12px;\n\n  &.is-loading { opacity: .7; pointer-events: none; }\n}\n\n/* ══════════════ GROUPS ══════════════ */\n.mural-groups-row { display: flex; flex-direction: column; gap: 20px; }\n\n.mural-group-frame {\n  background: var(--bg-surface, #fff);\n  border: 2px dashed var(--border);\n  border-radius: 16px;\n  padding: 16px 18px;\n  box-shadow: 4px 6px 10px rgba(15,23,42,.08), 8px 18px 32px rgba(15,23,42,.06);\n  transition: border-color .2s, box-shadow .2s;\n\n  &:hover { border-color: var(--brand-500); }\n\n  &.drag-over {\n    border-color: var(--brand-500);\n    background: color-mix(in srgb, var(--brand-500) 6%, var(--bg-surface));\n    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-500) 20%, transparent);\n  }\n}\n\n.group-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 14px;\n  padding-bottom: 10px;\n  border-bottom: 1px solid var(--border-light);\n}\n\n.group-title-box { display: flex; align-items: center; gap: 8px; }\n\n.column-accent { width: 8px; height: 8px; border-radius: 50%; }\n.column-title { color: var(--text-primary); font-size: 13.5px; font-weight: 780; }\n.column-count {\n  color: var(--text-secondary); font-size: 10px; font-weight: 800;\n  min-width: 22px; height: 22px; border-radius: 11px;\n  border: 1px solid var(--border-light); background: var(--bg-hover);\n  display: grid; place-items: center;\n}\n\n.group-actions { display: flex; align-items: center; gap: 4px; }\n\n.group-items-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(260px, 320px));\n  gap: 16px;\n}\n\n.empty-group-placeholder {\n  grid-column: 1 / -1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 18px;\n  border: 1.5px dashed var(--border);\n  border-radius: 10px;\n  color: var(--text-muted);\n  font-size: 12.5px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all .2s;\n  mat-icon { font-size: 20px; opacity: .5; }\n  &:hover { background: color-mix(in srgb,var(--brand-500) 5%,transparent); border-color: var(--brand-500); color: var(--text-brand); }\n}\n\n/* ══════════════ UNGROUPED SECTION ══════════════ */\n.mural-ungrouped-section {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  padding: 16px 18px;\n  border: 2px dashed var(--border);\n  border-radius: 16px;\n  transition: all .2s;\n\n  &.drag-over {\n    border-color: var(--brand-500);\n    background: color-mix(in srgb, var(--brand-500) 6%, var(--bg-surface));\n  }\n}\n\n.section-title-divider {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12px;\n  font-weight: 800;\n  color: var(--text-muted);\n  text-transform: uppercase;\n  letter-spacing: .06em;\n  mat-icon { font-size: 17px; color: var(--text-brand); }\n}\n\n.ungrouped-wall-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(260px, 320px));\n  gap: 20px;\n}\n\n/* ══════════════ STICKY CARD ══════════════ */\n.sticky-card {\n  position: relative;\n  box-sizing: border-box;\n  width: 100%;\n  max-width: 320px;\n  min-height: 140px;\n  max-height: 280px;\n  border-radius: 12px;\n  padding: 18px 16px 14px;\n  box-shadow: 0 6px 14px rgba(0,0,0,.09), 0 1px 3px rgba(0,0,0,.05);\n  cursor: grab;\n  display: flex;\n  flex-direction: column;\n  gap: 9px;\n  transition: transform .2s cubic-bezier(.34,1.56,.64,1), box-shadow .2s, opacity .2s;\n  color: #1e293b;\n  border: 1px solid rgba(0,0,0,.06);\n  user-select: none;\n\n  &:hover {\n    transform: translateY(-4px) scale(1.015) !important;\n    box-shadow: 0 14px 28px rgba(0,0,0,.14), 0 2px 6px rgba(0,0,0,.06);\n    z-index: 10;\n  }\n\n  &:active { cursor: grabbing; }\n\n  &.pinned { border: 2px solid rgba(239,68,68,.4); box-shadow: 0 8px 20px rgba(239,68,68,.15); }\n\n  &.dragging { opacity: .4; transform: scale(.97) !important; cursor: grabbing; }\n\n  /* Pin sobreposto ao topo do cartão */\n  .card-pin {\n    position: absolute;\n    top: -11px;\n    right: 14px;\n    width: 26px;\n    height: 26px;\n    border-radius: 50%;\n    background: #f1f5f9;\n    border: 1.5px solid rgba(255, 255, 255, 0.95);\n    box-shadow: 0 3px 8px rgba(0,0,0,.22), 0 1px 3px rgba(0,0,0,.12);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    transition: all .2s cubic-bezier(0.34, 1.56, 0.64, 1);\n    z-index: 25;\n\n    mat-icon {\n      font-size: 14px;\n      width: 14px;\n      height: 14px;\n      color: #64748b;\n    }\n\n    &:hover {\n      transform: scale(1.22);\n      box-shadow: 0 5px 12px rgba(0,0,0,.3);\n    }\n\n    &.active {\n      background: #ef4444;\n      border-color: #fee2e2;\n      box-shadow: 0 3px 10px rgba(239,68,68,.4);\n      mat-icon { color: #fff; }\n    }\n  }\n\n  .card-header-row {\n    display: flex;\n    align-items: flex-start;\n    padding-right: 18px;\n    flex-shrink: 0;\n  }\n\n  .card-title {\n    margin: 0;\n    font-size: 14px;\n    font-weight: 800;\n    line-height: 1.35;\n    color: #0f172a;\n    word-break: break-word;\n    display: -webkit-box;\n    -webkit-line-clamp: 2;\n    line-clamp: 2;\n    -webkit-box-orient: vertical;\n    overflow: hidden;\n  }\n\n  .card-body {\n    font-size: 12.5px;\n    line-height: 1.5;\n    color: #334155;\n    word-break: break-word;\n    flex: 1;\n    min-height: 0;\n    overflow-y: auto;\n    overflow-x: hidden;\n    padding-right: 2px;\n\n    /* Barra de rolagem discreta e elegante */\n    &::-webkit-scrollbar {\n      width: 4px;\n    }\n    &::-webkit-scrollbar-track {\n      background: transparent;\n    }\n    &::-webkit-scrollbar-thumb {\n      background: rgba(0, 0, 0, 0.15);\n      border-radius: 4px;\n    }\n    &::-webkit-scrollbar-thumb:hover {\n      background: rgba(0, 0, 0, 0.28);\n    }\n  }\n\n  .card-attachments-chips {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 5px;\n    max-height: 52px;\n    overflow-y: auto;\n    min-height: 0;\n    flex-shrink: 0;\n\n    &::-webkit-scrollbar {\n      width: 3px;\n      height: 3px;\n    }\n    &::-webkit-scrollbar-thumb {\n      background: rgba(0, 0, 0, 0.15);\n      border-radius: 3px;\n    }\n  }\n\n  .att-chip {\n    display: flex; align-items: center; gap: 4px;\n    padding: 3px 7px;\n    background: rgba(255,255,255,.7); border: 1px solid rgba(0,0,0,.08);\n    border-radius: 6px; font-size: 10.5px; font-weight: 700; color: #1e293b;\n    cursor: pointer; transition: all .2s; max-width: 100%;\n    mat-icon { font-size: 12px; width: 12px; height: 12px; color: #3b82f6; }\n    &.is-pdf mat-icon { color: #ef4444; }\n    span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n    &:hover { background: #fff; box-shadow: 0 2px 6px rgba(0,0,0,.1); }\n  }\n\n  .card-footer {\n    display: flex; align-items: center; justify-content: space-between;\n    padding-top: 8px; border-top: 1px solid rgba(0,0,0,.06);\n    font-size: 10.5px; color: #64748b; margin-top: auto;\n    flex-shrink: 0;\n  }\n\n  .card-author { display: flex; align-items: center; gap: 4px; font-weight: 600;\n    mat-icon { font-size: 12px; width: 12px; height: 12px; } }\n  .card-date { font-size: 10px; opacity: .85; }\n}\n\n.loose-card { box-shadow: 0 10px 20px rgba(0,0,0,.09), 0 3px 6px rgba(0,0,0,.05); }\n\n/* ══════════════ EMPTY STATE ══════════════ */\n.mural-empty-state {\n  display: flex; flex-direction: column; align-items: center;\n  justify-content: center; text-align: center; padding: 60px 20px;\n  color: var(--text-muted); margin: auto;\n\n  .empty-icon-box {\n    width: 72px; height: 72px; border-radius: 20px;\n    background: var(--bg-active); color: var(--text-brand);\n    display: flex; align-items: center; justify-content: center;\n    margin-bottom: 16px;\n    mat-icon { font-size: 36px; width: 36px; height: 36px; }\n  }\n\n  h2 { margin: 0 0 6px; font-size: 20px; font-weight: 800; color: var(--text-primary); }\n  p { margin: 0 0 20px; font-size: 13.5px; max-width: 360px; }\n}\n\n/* ══════════════ MODALS ══════════════ */\n.modal-overlay {\n  position: fixed; inset: 0; z-index: 1050;\n  background: rgba(15,23,42,.55);\n  backdrop-filter: blur(6px);\n  display: flex; align-items: center; justify-content: center;\n  padding: 20px; box-sizing: border-box;\n}\n\n.attachment-overlay { z-index: 1200; }\n\n.modal-card {\n  display: flex; flex-direction: column;\n  max-height: 90vh; width: 100%;\n  background: var(--bg-surface);\n  border-radius: 16px; overflow: hidden;\n  box-shadow: 0 24px 48px rgba(0,0,0,.22);\n  &.modal-sm { max-width: 490px; }\n  &.modal-md { max-width: 640px; }\n}\n\n.modal-header {\n  flex-shrink: 0;\n  padding: 18px 24px;\n  display: flex; align-items: center; justify-content: space-between;\n  border-bottom: 1px solid var(--border-light);\n  background: linear-gradient(135deg, color-mix(in srgb, var(--brand-500) 5%, transparent) 0%, var(--bg-surface) 100%);\n\n  .header-main { display: flex; align-items: center; gap: 14px; }\n\n  h2 { margin: 0 0 2px; font-size: 17px; font-weight: 750; color: var(--text-primary); }\n  p { margin: 0; font-size: 12.5px; color: var(--text-muted); }\n}\n\n.header-badge {\n  width: 44px; height: 44px; border-radius: 12px;\n  background: linear-gradient(135deg, var(--brand-500), var(--brand-700));\n  color: #fff; display: flex; align-items: center; justify-content: center;\n  flex-shrink: 0;\n  mat-icon { font-size: 22px; }\n  &.edit-mode { background: linear-gradient(135deg, #0284c7, #0369a1); }\n}\n\n.close-btn {\n  background: var(--bg-hover); border: none;\n  width: 36px; height: 36px; border-radius: 10px;\n  display: flex; align-items: center; justify-content: center;\n  cursor: pointer; color: var(--text-muted);\n  transition: all .2s;\n  mat-icon { font-size: 20px; }\n  &:hover { background: #fee2e2; color: #ef4444; transform: rotate(90deg); }\n}\n\n.modal-body { flex: 1; padding: 18px 24px; overflow-y: auto; display: flex; flex-direction: column; gap: 14px; }\n\n.modal-footer {\n  padding: 14px 24px;\n  display: flex; align-items: center; justify-content: flex-end; gap: 10px;\n  background: var(--bg-surface); border-top: 1px solid var(--border-light);\n  .delete-btn { margin-right: auto; }\n}\n\n/* Form elements */\n.form-card {\n  background: var(--bg-surface);\n  border: 1px solid var(--border-light);\n  border-radius: 12px;\n  padding: 14px 18px;\n}\n\n.card-section-header {\n  display: flex; align-items: center; gap: 9px;\n  margin-bottom: 12px; padding-bottom: 8px;\n  border-bottom: 1px solid var(--border-light);\n  h3 { margin: 0; font-size: 14px; font-weight: 700; color: var(--text-primary); }\n  mat-icon { font-size: 18px; width: 18px; height: 18px; }\n  &.color-blue mat-icon, .color-blue { color: #3b82f6; }\n  &.color-amber mat-icon, .color-amber { color: #f59e0b; }\n  &.color-emerald mat-icon, .color-emerald { color: #10b981; }\n  &.color-indigo mat-icon, .color-indigo { color: #6366f1; }\n}\n.color-blue { color: #3b82f6; }\n.color-amber { color: #f59e0b; }\n.color-emerald { color: #10b981; }\n.color-indigo { color: #6366f1; }\n\n.form-grid { display: flex; flex-direction: column; gap: 12px; }\n\n.form-field {\n  display: flex; flex-direction: column; gap: 5px;\n  label { font-size: 12.5px; font-weight: 650; color: var(--text-secondary); }\n  .required { color: #ef4444; margin-left: 2px; }\n\n  input[type=\"text\"], .custom-textarea, .custom-select {\n    width: 100%; border: 1.5px solid var(--border); border-radius: 9px;\n    font-size: 13.5px; color: var(--text-primary); outline: none;\n    background: var(--bg-input); box-sizing: border-box;\n    &:focus { border-color: var(--brand-500); box-shadow: 0 0 0 3px color-mix(in srgb,var(--brand-500) 15%,transparent); }\n  }\n  input[type=\"text\"] { height: 38px; padding: 0 12px; }\n  .custom-textarea { padding: 10px 12px; resize: vertical; }\n  .custom-select { height: 38px; padding: 0 10px; cursor: pointer; }\n\n  .color-input { width: 100%; height: 40px; padding: 2px 6px; border: 1.5px solid var(--border); border-radius: 9px; cursor: pointer; }\n}\n\n.invite-row { display: flex; align-items: flex-start; gap: 10px; flex-wrap: wrap; }\n\n/* Team members */\n.team-members-list { display: flex; flex-direction: column; gap: 8px; }\n\n.member-row {\n  display: flex; align-items: center; gap: 12px;\n  padding: 10px 12px; border-radius: 10px;\n  background: var(--bg-hover); border: 1px solid var(--border-light);\n  transition: all .2s;\n  &:hover { border-color: var(--border); }\n}\n\n.member-avatar {\n  width: 34px; height: 34px; border-radius: 50%;\n  background: linear-gradient(135deg,var(--brand-500),var(--brand-700));\n  color: #fff; display: grid; place-items: center;\n  font-size: 14px; font-weight: 750; flex-shrink: 0;\n}\n\n.member-info { display: flex; align-items: center; gap: 8px; flex: 1; }\n.member-name { font-size: 13px; font-weight: 650; color: var(--text-primary); }\n\n.member-role-badge {\n  font-size: 10px; font-weight: 750; padding: 2px 7px; border-radius: 20px;\n  background: var(--bg-hover); color: var(--text-muted); border: 1px solid var(--border);\n  &.is-admin { background: color-mix(in srgb,var(--brand-500) 12%,transparent); color: var(--text-brand); border-color: var(--brand-500); }\n}\n\n.empty-hint { font-size: 12.5px; color: var(--text-muted); text-align: center; padding: 10px; }\n\n/* Attachment preview */\n.attachment-preview-card {\n  background: var(--bg-surface); border-radius: 16px;\n  display: flex; flex-direction: column;\n  max-width: 900px; width: 100%; max-height: 90vh;\n  box-shadow: 0 24px 48px rgba(0,0,0,.3);\n  overflow: hidden;\n}\n\n.preview-header {\n  padding: 14px 20px; display: flex; align-items: center; justify-content: space-between;\n  border-bottom: 1px solid var(--border-light);\n}\n\n.preview-title { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 700; color: var(--text-primary);\n  mat-icon { font-size: 22px; } }\n\n.preview-body { flex: 1; overflow: auto; display: flex; align-items: center; justify-content: center; background: var(--bg-hover); min-height: 400p