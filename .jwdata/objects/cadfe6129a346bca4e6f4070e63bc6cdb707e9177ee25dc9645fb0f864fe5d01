  "sourcesContent": [":host {\n  display: block;\n  position: relative;\n}\n\n/* ════════════════════════════════════════\n   BASE TOGGLE\n   ════════════════════════════════════════ */\n.theme-toggle-btn {\n  position: relative;\n  width: 68px;\n  height: 34px;\n  border-radius: 999px;\n  background: var(--toggle-track, #e2e8f0);\n  border: 2px solid var(--border);\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  padding: 0 4px;\n  outline: none;\n  overflow: visible;\n  transition: background 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;\n\n  &.dark:not(.angel):not(.demon):not(.cadu) {\n    background: #1e293b;\n    border-color: #334155;\n  }\n\n  &:focus-visible { outline: 2px solid var(--border-focus); outline-offset: 2px; }\n}\n\n/* ════════════════════════════════════════\n   ICONS\n   ════════════════════════════════════════ */\n.toggle-icon {\n  position: absolute;\n  font-size: 14px;\n  line-height: 1;\n  pointer-events: none;\n  user-select: none;\n  transition: opacity 0.25s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.icon-sun   { left: 6px; }\n.icon-moon  { right: 5px; }\n.icon-angel { right: 5px; font-size: 15px; }\n.icon-demon { right: 5px; font-size: 15px; }\n.icon-cadu  { right: 5px; font-size: 15px; }\n\n/* Light → sol */\n.theme-toggle-btn:not(.dark):not(.angel):not(.demon):not(.cadu) {\n  .icon-sun   { opacity: 1; }\n  .icon-moon  { opacity: 0; }\n  .icon-angel { opacity: 0; }\n  .icon-demon { opacity: 0; }\n  .icon-cadu  { opacity: 0; }\n}\n/* Dark (normal) → lua */\n.theme-toggle-btn.dark:not(.angel):not(.demon):not(.cadu) {\n  .icon-sun   { opacity: 0; }\n  .icon-moon  { opacity: 1; }\n  .icon-angel { opacity: 0; }\n  .icon-demon { opacity: 0; }\n  .icon-cadu  { opacity: 0; }\n}\n/* Angel → anjo */\n.theme-toggle-btn.angel {\n  .icon-sun   { opacity: 0; }\n  .icon-moon  { opacity: 0; }\n  .icon-angel { opacity: 1; animation: iconFloat 2.4s ease-in-out infinite; }\n  .icon-demon { opacity: 0; }\n  .icon-cadu  { opacity: 0; }\n}\n/* Demon → demônio */\n.theme-toggle-btn.demon {\n  .icon-sun   { opacity: 0; }\n  .icon-moon  { opacity: 0; }\n  .icon-angel { opacity: 0; }\n  .icon-demon { opacity: 1; animation: iconShake 1.6s ease-in-out infinite; }\n  .icon-cadu  { opacity: 0; }\n}\n/* Cadu → surfista */\n.theme-toggle-btn.cadu {\n  .icon-sun   { opacity: 0; }\n  .icon-moon  { opacity: 0; }\n  .icon-angel { opacity: 0; }\n  .icon-demon { opacity: 0; }\n  .icon-cadu  { opacity: 1; animation: iconSurf 2s ease-in-out infinite; }\n}\n\n@keyframes iconFloat {\n  0%, 100% { transform: translateY(0); }\n  50%       { transform: translateY(-2px); }\n}\n@keyframes iconShake {\n  0%, 100% { transform: rotate(-4deg); }\n  50%       { transform: rotate(4deg); }\n}\n@keyframes iconSurf {\n  0%, 100% { transform: translateY(0) rotate(-6deg); }\n  50%       { transform: translateY(-3px) rotate(6deg); }\n}\n\n/* ════════════════════════════════════════\n   THUMB\n   ════════════════════════════════════════ */\n.toggle-thumb {\n  position: absolute;\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  background: #ffffff;\n  box-shadow: 0 2px 6px rgba(0,0,0,.20);\n  left: 3px;\n  transition:\n    transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),\n    background 0.4s ease,\n    box-shadow 0.4s ease;\n}\n\n.theme-toggle-btn.dark:not(.angel):not(.demon):not(.cadu) .toggle-thumb {\n  transform: translateX(34px);\n  background: #94a3b8;\n}\n\n/* ════════════════════════════════════════\n   ANGEL MODE\n   ════════════════════════════════════════ */\n.theme-toggle-btn.angel.dark {\n  background: linear-gradient(135deg, #1a0a2e, #0d0d1a);\n  border-color: transparent;\n  box-shadow:\n    0 0 0 1.5px rgba(180,120,255,.55),\n    0 0 14px rgba(160,80,255,.40),\n    0 0 32px rgba(100,40,200,.22);\n  animation: angelPulse 3s ease-in-out infinite;\n\n  .toggle-thumb {\n    transform: translateX(34px);\n    background: linear-gradient(135deg, #e0c8ff, #c084fc, #a855f7);\n    box-shadow:\n      0 0 8px rgba(192,132,252,.80),\n      0 0 20px rgba(192,132,252,.40);\n    animation: thumbAngelGlow 2s ease-in-out infinite alternate;\n  }\n}\n\n.theme-toggle-btn.angel:not(.dark) {\n  background: linear-gradient(135deg, #f3e8ff, #e9d5ff);\n  border-color: transparent;\n  box-shadow:\n    0 0 0 1.5px rgba(167,139,250,.55),\n    0 0 14px rgba(139,92,246,.20);\n  animation: angelPulseLight 3s ease-in-out infinite;\n\n  .toggle-thumb {\n    transform: translateX(0);\n    background: linear-gradient(135deg, #ffffff, #f5f3ff);\n    box-shadow:\n      0 0 8px rgba(139,92,246,.40);\n  }\n}\n\n@keyframes angelPulse {\n  0%, 100% { box-shadow: 0 0 0 1.5px rgba(180,120,255,.55), 0 0 14px rgba(160,80,255,.40), 0 0 32px rgba(100,40,200,.22); }\n  50%       { box-shadow: 0 0 0 2px rgba(200,150,255,.75), 0 0 22px rgba(180,100,255,.60), 0 0 48px rgba(120,50,220,.38); }\n}\n@keyframes angelPulseLight {\n  0%, 100% { box-shadow: 0 0 0 1.5px rgba(167,139,250,.45), 0 0 10px rgba(139,92,246,.15); }\n  50%       { box-shadow: 0 0 0 2px rgba(139,92,246,.60), 0 0 16px rgba(139,92,246,.25); }\n}\n@keyframes thumbAngelGlow {\n  from { box-shadow: 0 0 8px rgba(192,132,252,.80), 0 0 20px rgba(192,132,252,.40); }\n  to   { box-shadow: 0 0 14px rgba(220,160,255,1),  0 0 30px rgba(192,132,252,.60); }\n}\n\n/* ════════════════════════════════════════\n   DEMON MODE\n   ════════════════════════════════════════ */\n.theme-toggle-btn.demon.dark {\n  background: linear-gradient(135deg, #1a0000, #0d0000);\n  border-color: transparent;\n  box-shadow:\n    0 0 0 1.5px rgba(220,40,40,.60),\n    0 0 14px rgba(200,30,30,.45),\n    0 0 32px rgba(120,0,0,.30);\n  animation: demonPulse 2.4s ease-in-out infinite;\n\n  .toggle-thumb {\n    transform: translateX(34px);\n    background: linear-gradient(135deg, #ff6b2b, #dc2626, #7f0000);\n    box-shadow:\n      0 0 8px rgba(220,60,60,.80),\n      0 0 20px rgba(220,60,60,.40);\n    animation: thumbDemonGlow 1.8s ease-in-out infinite alternate;\n  }\n}\n\n.theme-toggle-btn.demon:not(.dark) {\n  background: linear-gradient(135deg, #fee2e2, #fca5a5);\n  border-color: transparent;\n  box-shadow:\n    0 0 0 1.5px rgba(248,113,113,.55),\n    0 0 14px rgba(239,68,68,.20);\n  animation: demonPulseLight 2.4s ease-in-out infinite;\n\n  .toggle-thumb {\n    transform: translateX(0);\n    background: linear-gradient(135deg, #ffffff, #fef2f2);\n    box-shadow:\n      0 0 8px rgba(239,68,68,.40);\n  }\n}\n\n@keyframes demonPulse {\n  0%, 100% { box-shadow: 0 0 0 1.5px rgba(220,40,40,.60), 0 0 14px rgba(200,30,30,.45), 0 0 32px rgba(120,0,0,.30); }\n  50%       { box-shadow: 0 0 0 2px rgba(255,60,60,.80),  0 0 22px rgba(220,40,40,.65), 0 0 48px rgba(150,0,0,.45); }\n}\n@keyframes demonPulseLight {\n  0%, 100% { box-shadow: 0 0 0 1.5px rgba(248,113,113,.45), 0 0 10px rgba(239,68,68,.15); }\n  50%       { box-shadow: 0 0 0 2px rgba(239,68,68,.60),  0 0 16px rgba(239,68,68,.25); }\n}\n@keyframes thumbDemonGlow {\n  from { box-shadow: 0 0 8px rgba(220,60,60,.80), 0 0 20px rgba(220,60,60,.40); }\n  to   { box-shadow: 0 0 16px rgba(255,80,30,1),  0 0 32px rgba(220,60,60,.65); }\n}\n\n/* ════════════════════════════════════════\n   CADU MAVERICK MODE (SURF'S UP)\n   ════════════════════════════════════════ */\n.theme-toggle-btn.cadu.dark {\n  background: linear-gradient(135deg, #041d30, #083344);\n  border-color: transparent;\n  box-shadow:\n    0 0 0 1.5px rgba(6,182,212,.60),\n    0 0 14px rgba(6,182,212,.45),\n    0 0 32px rgba(245,158,11,.25);\n  animation: caduPulse 2.8s ease-in-out infinite;\n\n  .toggle-thumb {\n    transform: translateX(34px);\n    background: linear-gradient(135deg, #38bdf8, #06b6d4, #f59e0b);\n    box-shadow:\n      0 0 8px rgba(6,182,212,.80),\n      0 0 20px rgba(245,158,11,.45);\n    animation: thumbCaduGlow 2s ease-in-out infinite alternate;\n  }\n}\n\n.theme-toggle-btn.cadu:not(.dark) {\n  background: linear-gradient(135deg, #ccfbf1, #fef08a);\n  border-color: transparent;\n  box-shadow:\n    0 0 0 1.5px rgba(20,184,166,.55),\n    0 0 14px rgba(245,158,11,.30);\n  animation: caduPulseLight 2.8s ease-in-out infinite;\n\n  .toggle-thumb {\n    transform: translateX(0);\n    background: linear-gradient(135deg, #ffffff, #e0f2fe);\n    box-shadow:\n      0 0 8px rgba(6,182,212,.50);\n  }\n}\n\n@keyframes caduPulse {\n  0%, 100% { box-shadow: 0 0 0 1.5px rgba(6,182,212,.60), 0 0 14px rgba(6,182,212,.45), 0 0 32px rgba(245,158,11,.25); }\n  50%       { box-shadow: 0 0 0 2px rgba(56,189,248,.80), 0 0 24px rgba(6,182,212,.70), 0 0 48px rgba(245,158,11,.40); }\n}\n@keyframes caduPulseLight {\n  0%, 100% { box-shadow: 0 0 0 1.5px rgba(20,184,166,.45), 0 0 10px rgba(245,158,11,.20); }\n  50%       { box-shadow: 0 0 0 2px rgba(6,182,212,.65), 0 0 18px rgba(6,182,212,.35); }\n}\n@keyframes thumbCaduGlow {\n  from { box-shadow: 0 0 8px rgba(6,182,212,.80), 0 0 20px rgba(245,158,11,.45); }\n  to   { box-shadow: 0 0 16px rgba(56,189,248,1), 0 0 32px rgba(245,158,11,.70); }\n}\n\n/* ════════════════════════════════════════\n   AURA RING (angel / demon / cadu)\n   ════════════════════════════════════════ */\n.realm-aura,\n.realm-ring {\n  position: absolute;\n  border-radius: 999px;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity 0.5s ease;\n}\n\n/* Angel aura */\n.angel .realm-aura {\n  inset: -5px;\n  opacity: 1;\n  background: conic-gradient(\n    from 0deg,\n    rgba(180,100,255,0)    0%,\n    rgba(200,140,255,.45) 25%,\n    rgba(240,210,255,.55) 50%,\n    rgba(200,140,255,.45) 75%,\n    rgba(180,100,255,0)  100%\n  );\n  filter: blur(2px);\n  animation: rotateConic 5s linear infinite;\n  z-index: -1;\n}\n.angel .realm-ring {\n  inset: -8px;\n  opacity: 1;\n  border: 1.5px solid rgba(200, 140, 255, 0.35);\n  box-shadow: 0 0 10px rgba(180,100,255,.30), inset 0 0 6px rgba(180,100,255,.15);\n  animation: ringPulse 3s ease-in-out infinite;\n  z-index: -2;\n}\n\n/* Demon aura */\n.demon .realm-aura {\n  inset: -5px;\n  opacity: 1;\n  background: conic-gradient(\n    from 0deg,\n    rgba(200,0,0,0)      0%,\n    rgba(220,40,0,.45)  25%,\n    rgba(255,100,30,.55) 50%,\n    rgba(220,40,0,.45)  75%,\n    rgba(200,0,0,0)     100%\n  );\n  filter: blur(2px);\n  animation: rotateConic 3.2s linear infinite;\n  z-index: -1;\n}\n.demon .realm-ring {\n  inset: -8px;\n  opacity: 1;\n  border: 1.5px solid rgba(220, 60, 30, 0.45);\n  box-shadow: 0 0 10px rgba(200,30,0,.35), inset 0 0 6px rgba(200,30,0,.20);\n  animation: ringPulse 2.4s ease-in-out infinite;\n  z-index: -2;\n}\n\n/* Cadu aura */\n.cadu .realm-aura {\n  inset: -5px;\n  opacity: 1;\n  background: conic-gradient(\n    from 0deg,\n    rgba(6,182,212,0)     0%,\n    rgba(6,182,212,.50)  25%,\n    rgba(245,158,11,.60) 50%,\n    rgba(6,182,212,.50)  75%,\n    rgba(6,182,212,0)    100%\n  );\n  filter: blur(2px);\n  animation: rotateConic 4s linear infinite;\n  z-index: -1;\n}\n.cadu .realm-ring {\n  inset: -8px;\n  opacity: 1;\n  border: 1.5px solid rgba(6, 182, 212, 0.45);\n  box-shadow: 0 0 12px rgba(6,182,212,.40), inset 0 0 6px rgba(245,158,11,.25);\n  animation: ringPulse 2.6s ease-in-out infinite;\n  z-index: -2;\n}\n\n@keyframes rotateConic {\n  from { transform: rotate(0deg); }\n  to   { transform: rotate(360deg); }\n}\n@keyframes ringPulse {\n  0%, 100% { opacity: 0.5; transform: scale(1); }\n  50%       { opacity: 1;   transform: scale(1.05); }\n}\n\n/* ════════════════════════════════════════\n   REALM BADGES (asa / chifre / surf)\n   ════════════════════════════════════════ */\n.realm-badge {\n  position: absolute;\n  display: flex;\n  align-items: center;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n\n.badge-left {\n  right: calc(100% + 3px);\n  top: 50%;\n  transform: translateY(-50%) scale(0.6);\n}\n\n.wing-svg {\n  width: 22px;\n  height: 28px;\n  display: none;\n  filter: drop-shadow(0 0 4px rgba(192,132,252,.70));\n}\n.horn-svg {\n  width: 14px;\n  height: 26px;\n  display: none;\n  filter: drop-shadow(0 0 4px rgba(220,60,30,.70));\n}\n.surf-svg {\n  width: 16px;\n  height: 28px;\n  display: none;\n  filter: drop-shadow(0 0 5px rgba(6,182,212,.80));\n}\n\n/* Angel state */\n.angel .badge-left {\n  opacity: 1;\n  transform: translateY(-50%) scale(1);\n  animation: wingFlap 2.4s ease-in-out infinite;\n  .wing-svg { display: block; }\n}\n\n/* Demon state */\n.demon .badge-left {\n  opacity: 1;\n  transform: translateY(-50%) scale(1);\n  animation: hornWobble 1.8s ease-in-out infinite;\n  .horn-svg { display: block; }\n}\n\n/* Cadu state */\n.cadu .badge-left {\n  opacity: 1;\n  transform: translateY(-50%) scale(1);\n  animation: surfBob 2.2s ease-in-out infinite;\n  .surf-svg { display: block; }\n}\n\n@keyframes wingFlap {\n  0%, 100% { transform: translateY(-50%) scale(1) rotate(-5deg); }\n  50%       { transform: translateY(-52%) scale(1.06) rotate(0deg); }\n}\n@keyframes hornWobble {\n  0%, 100% { transform: translateY(-50%) scale(1) rotate(-3deg); }\n  50%       { transform: translateY(-48%) scale(1.04) rotate(3deg); }\n}\n@keyframes surfBob {\n  0%, 100% { transform: translateY(-50%) scale(1) rotate(-10deg); }\n  50%       { transform: translateY(-54%) scale(1.08) rotate(10deg); }\n}\n\n/* ════════════════════════════════════════\n   PARTICLES\n   ════════════════════════════════════════ */\n.particle {\n  position: absolute;\n  border-radius: 50%;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity 0.4s ease;\n}\n\n/* Angel particles */\n.angel .p1 { opacity: 1; width: 4px; height: 4px; background: rgba(220,180,255,.90); top: -8px;  left: 50%;  animation: sparkle1 2.8s ease-in-out infinite 0.0s; }\n.angel .p2 { opacity: 1; width: 3px; height: 3px; background: rgba(255,255,255,.85); bottom: -7px; right: 22%; animation: sparkle1 2.5s ease-in-out infinite 0.6s; }\n.angel .p3 { opacity: 1; width: 5px; height: 5px; background: rgba(200,140,255,.80); top: 20%;  right: -9px; animation: sparkle2 3.2s ease-in-out infinite 1.2s; }\n.angel .p4 { opacity: 1; width: 3px; height: 3px; background: rgba(255,240,255,.90); bottom: 20%; left: -8px; animation: sparkle2 2.7s ease-in-out infinite 0.4s; }\n.angel .p5 { opacity: 1; width: 4px; height: 4px; background: rgba(240,200,255,.85); top: -7px; right: 30%; animation: sparkle1 3.0s ease-in-out infinite 1.8s; }\n\n/* Demon particles */\n.demon .p1 { opacity: 1; width: 4px; height: 4px; background: rgba(255,80,30,.90); top: -8px;  left: 45%;  animation: ember1 1.8s ease-in-out infinite 0.0s; }\n.demon .p2 { opacity: 1; width: 3px; height: 3px; background: rgba(255,160,0,.85); bottom: -7px; right: 22%; animation: ember1 2.0s ease-in-out infinite 0.5s; }\n.demon .p3 { opacity: 1; width: 5px; height: 5px; background: rgba(220,30,0,.80); top: 20%;  right: -9px; animation: ember2 1.6s ease-in-out infinite 1.0s; }\n.demon .p4 { opacity: 1; width: 3px; height: 3px; background: rgba(255,100,0,.90); bottom: 20%; left: -8px; animation: ember2 2.2s ease-in-out infinite 0.3s; }\n.demon .p5 { opacity: 1; width: 4px; height: 4px; background: rgba(255,60,20,.85); top: -7px; right: 30%; animation: ember1 1.9s ease-in-out infinite 1.5s; }\n\n/* Cadu particles (gotas do oceano e fagulhas do sol) */\n.cadu .p1 { opacity: 1; width: 4px; height: 4px; background: rgba(6,182,212,.95); top: -8px;  left: 45%;  animation: waveSplash1 2.0s ease-in-out infinite 0.0s; }\n.cadu .p2 { opacity: 1; width: 3px; height: 3px; background: rgba(245,158,11,.90); bottom: -7px; right: 22%; animation: waveSplash1 2.4s ease-in-out infinite 0.5s; }\n.cadu .p3 { opacity: 1; width: 5px; height: 5px; background: rgba(56,189,248,.90); top: 20%;  right: -9px; animation: waveSplash2 2.2s ease-in-out infinite 1.0s; }\n.cadu .p4 { opacity: 1; width: 3px; height: 3px; background: rgba(255,255,255,.95); bottom: 20%; left: -8px; animation: waveSplash2 2.6s ease-in-out infinite 0.3s; }\n.cadu .p5 { opacity: 1; width: 4px; height: 4px; background: rgba(20,184,166,.90); top: -7px; right: 30%; animation: waveSplash1 2.1s ease-in-out infinite 1.4s; }\n\n@keyframes sparkle1 {\n  0%, 100% { transform: translateY(0)    scale(1);    opacity: 0.8; }\n  50%       { transform: translateY(-6px) scale(1.35); opacity: 1; }\n}\n@keyframes sparkle2 {\n  0%, 100% { transform: translateX(0)    scale(1);    opacity: 0.8; }\n  50%       { transform: translateX(-5px) scale(1.40); opacity: 1; }\n}\n@keyframes ember1 {\n  0%   { transform: translateY(0)    scale(1);    opacity: 0.9; }\n  50%  { transform: translateY(-8px) scale(1.3);  opacity: 1; }\n  100% { transform: translateY(-14px) scale(0.5); opacity: 0; }\n}\n@keyframes ember2 {\n  0%   { transform: translateX(0)    scale(1);    opacity: 0.9; }\n  50%  { transform: translateX(6px)  scale(1.3);  opacity: 1; }\n  100% { transform: translateX(10px) scale(0.5);  opacity: 0; }\n}\n@keyframes waveSplash1 {\n  0%, 100% { transform: translateY(0) scale(1); opacity: 0.8; }\n  50% { transform: translateY(-7px) scale(1.3); opacity: 1; }\n}\n@keyframes waveSplash2 {\n  0%, 100% { transform: translateX(0) scale(1); opacity: 0.8; }\n  50% { transform: translateX(-6px) scale(1.35); opacity: 1; }\n}\n"],
