  "sourcesContent": ["\n    .auth-container {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      min-height: 100vh;\n      width: 100vw;\n      background: var(--bg-app, #f1f5f9);\n      padding: 20px;\n      box-sizing: border-box;\n    }\n\n    .auth-card {\n      background: var(--bg-surface, #ffffff);\n      border: 1px solid var(--border, #e2e8f0);\n      border-radius: 20px;\n      padding: 40px 36px;\n      max-width: 480px;\n      width: 100%;\n      box-shadow: 0 12px 36px rgba(0, 0, 0, 0.08);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      text-align: center;\n    }\n\n    .auth-icon-badge {\n      width: 60px;\n      height: 60px;\n      border-radius: 16px;\n      background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);\n      color: #ffffff;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      box-shadow: 0 6px 18px rgba(239, 68, 68, 0.35);\n      margin-bottom: 20px;\n\n      mat-icon {\n        font-size: 32px;\n        width: 32px;\n        height: 32px;\n      }\n    }\n\n    h1 {\n      margin: 0 0 10px 0;\n      font-size: 22px;\n      font-weight: 700;\n      color: var(--text-primary, #0f172a);\n    }\n\n    .auth-desc {\n      margin: 0 0 24px 0;\n      font-size: 14px;\n      line-height: 1.6;\n      color: var(--text-secondary, #475569);\n    }\n\n    .token-input-box {\n      width: 100%;\n      display: flex;\n      flex-direction: column;\n      align-items: flex-start;\n      gap: 8px;\n      margin-bottom: 24px;\n\n      label {\n        font-size: 12.5px;\n        font-weight: 600;\n        color: var(--text-secondary, #475569);\n      }\n    }\n\n    .input-row {\n      display: flex;\n      gap: 8px;\n      width: 100%;\n\n      input {\n        flex: 1;\n        height: 44px;\n        padding: 0 14px;\n        border: 1.5px solid var(--border, #e2e8f0);\n        border-radius: 10px;\n        font-size: 13.5px;\n        background: var(--bg-input, #f8fafc);\n        color: var(--text-primary, #0f172a);\n        outline: none;\n\n        &:focus {\n          border-color: #4f46e5;\n          box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);\n        }\n      }\n    }\n\n    .btn-submit {\n      padding: 0 20px;\n      height: 44px;\n      border-radius: 10px;\n      border: none;\n      background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);\n      color: #ffffff;\n      font-weight: 600;\n      font-size: 14px;\n      cursor: pointer;\n      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);\n      transition: all 0.2s ease;\n\n      &:hover:not(:disabled) {\n        transform: translateY(-1px);\n        box-shadow: 0 6px 16px rgba(79, 70, 229, 0.35);\n      }\n\n      &:disabled {\n        opacity: 0.5;\n        cursor: not-allowed;\n      }\n    }\n\n    .auth-footer-help {\n      font-size: 12px;\n      color: var(--text-muted, #94a3b8);\n\n      p {\n        margin: 0 0 4px 0;\n      }\n\n      code {\n        background: var(--bg-hover, #f1f5f9);\n        padding: 4px 8px;\n        border-radius: 6px;\n        font-family: monospace;\n        font-size: 11px;\n        color: var(--text-secondary, #475569);\n        word-break: break-all;\n      }\n    }\n  "],
