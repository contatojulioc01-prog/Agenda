ary) !important;\n    font-family: inherit !important;\n    font-size: 12px !important;\n    font-weight: 600 !important;\n    text-align: left !important;\n    transition: all 0.15s ease !important;\n\n    mat-icon {\n      margin-right: 0 !important;\n      font-size: 17px !important;\n      width: 17px !important;\n      height: 17px !important;\n    }\n\n    &:hover {\n      color: var(--text-primary) !important;\n      background: var(--bg-hover) !important;\n    }\n\n    &.menu-item-danger {\n      color: #ef4444 !important;\n\n      mat-icon {\n        color: #ef4444 !important;\n      }\n\n      &:hover {\n        color: #dc2626 !important;\n        background: rgba(239, 68, 68, 0.1) !important;\n      }\n    }\n  }\n\n  .mat-divider {\n    margin: 4px 0 !important;\n    border-top-color: var(--border-light) !important;\n  }\n}\n\n/* Confirmação In-App no Rodapé */\n.delete-confirm-box {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-right: auto;\n  padding: 4px 10px;\n  border-radius: 8px;\n  background: #fef2f2;\n  border: 1px solid #fecaca;\n  animation: bannerFadeIn 0.15s ease-out;\n\n  .confirm-text {\n    font-size: 12px;\n    font-weight: 600;\n    color: #991b1b;\n  }\n\n  .btn-delete.confirm {\n    height: 32px;\n    padding: 0 10px;\n    font-size: 12px;\n    background: #ef4444;\n    color: #fff;\n    border: none;\n    border-radius: 6px;\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n    cursor: pointer;\n\n    mat-icon { font-size: 15px; width: 15px; height: 15px; }\n\n    &:hover { background: #dc2626; }\n  }\n\n  .btn-cancel.compact {\n    height: 32px;\n    padding: 0 8px;\n    font-size: 12px;\n    border: 1px solid #cbd5e1;\n    background: #fff;\n    border-radius: 6px;\n    cursor: pointer;\n    color: #475569;\n\n    &:hover { background: #f1f5f9; }\n  }\n}\n\n.modal-footer {\n  flex-shrink: 0;\n  position: sticky;\n  bottom: 0;\n  z-index: 10;\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 12px;\n  padding: 14px 24px;\n  background: #ffffff;\n  border-top: 1px solid #e2e8f0;\n}\n\n.btn-delete {\n  margin-right: auto;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 8px 14px;\n  background: transparent;\n  border: 1px solid #fecaca;\n  color: #dc2626;\n  border-radius: 8px;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s ease;\n\n  &:hover:not(:disabled) {\n    background: #fee2e2;\n  }\n\n  &:disabled {\n    opacity: 0.6;\n    cursor: not-allowed;\n  }\n}\n\n.btn-cancel {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  height: 38px;\n  padding: 0 18px;\n  background: #f1f5f9;\n  border: 1px solid #e2e8f0;\n  color: #475569;\n  border-radius: 8px;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: all 0.2s ease;\n  box-sizing: border-box;\n  white-space: nowrap;\n\n  mat-icon {\n    font-size: 18px;\n    width: 18px;\n    height: 18px;\n    line-height: 18px;\n  }\n\n  &:hover {\n    background: #e2e8f0;\n    color: #1e293b;\n  }\n}\n\n.btn-save {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  height: 38px;\n  padding: 0 20px;\n  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);\n  border: none;\n  color: #ffffff;\n  border-radius: 8px;\n  font-size: 13px;\n  font-weight: 700;\n  cursor: pointer;\n  box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);\n  transition: all 0.2s ease;\n  box-sizing: border-box;\n  white-space: nowrap;\n\n  mat-icon {\n    font-size: 18px;\n    width: 18px;\n    height: 18px;\n    line-height: 18px;\n  }\n\n  &:hover:not(:disabled) {\n    transform: translateY(-1px);\n    box-shadow: 0 6px 16px rgba(245, 158, 11, 0.4);\n  }\n\n  &:disabled {\n    opacity: 0.6;\n    cursor: not-allowed;\n    transform: none;\n  }\n}\n\n.button-spinner {\n  display: inline-block;\n}\n\n/* Attachment Preview Modal */\n.attachment-preview-bac