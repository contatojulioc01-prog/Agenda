-- =============================================================================
-- SCRIPT DE SEGURANÇA: Configuração de Usuário com Mínimo Privilégio (Principle of Least Privilege)
-- =============================================================================
-- Execute este script como superusuário (postgres) no PostgreSQL:
-- psql -h 127.0.0.1 -U postgres -d agenda_db -f security-setup.sql
-- =============================================================================

-- 1. Criar usuário de aplicação dedicado (NUNCA usar o superuser postgres em produção)
DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'agenda_app') THEN
    CREATE ROLE agenda_app WITH LOGIN PASSWORD 'DEFINA_UMA_SENHA_FORTE_AQUI_32_CHARS';
  END IF;
END
$$;

-- 2. Conceder permissões apenas na base de dados da aplicação
GRANT CONNECT ON DATABASE agenda_db TO agenda_app;

-- 3. Conectar na base de dados agenda_db e conceder privilégios DML nas tabelas
\c agenda_db

GRANT USAGE ON SCHEMA public TO agenda_app;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO agenda_app;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO agenda_app;

-- Garantir que tabelas e sequências futuras também herdem as permissões
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO agenda_app;
ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE, SELECT ON SEQUENCES TO agenda_app;

