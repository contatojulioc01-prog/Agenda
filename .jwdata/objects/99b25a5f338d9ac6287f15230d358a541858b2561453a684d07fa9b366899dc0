  "sourcesContent": ["app-markdown-text { display: block; min-width: 0; }\n.markdown-text { color: inherit; font: inherit; line-height: 1.55; overflow-wrap: anywhere; }\n.markdown-text p { margin: 0 0 .45em; }\n.markdown-text p:last-child { margin-bottom: 0; }\n.markdown-text h1, .markdown-text h2, .markdown-text h3, .markdown-text h4, .markdown-text h5, .markdown-text h6 { margin: .2em 0 .5em; color: inherit; font-size: 1.08em; line-height: 1.3; }\n.markdown-text strong { color: inherit; font-weight: 750; }\n.markdown-text em { font-style: italic; }\n.markdown-text a, .markdown-text .markdown-link {\n  color: var(--brand-600, #4f46e5);\n  text-decoration: underline;\n  text-underline-offset: 2.5px;\n  text-decoration-thickness: 1px;\n  font-weight: 550;\n  transition: color 0.15s ease, text-decoration-color 0.15s ease;\n  overflow-wrap: anywhere;\n  word-break: break-word;\n\n  &:hover {\n    color: var(--brand-700, #4338ca);\n    text-decoration-thickness: 2px;\n  }\n}\n.markdown-text code { padding: 1px 5px; border-radius: 4px; background: color-mix(in srgb, var(--text-primary) 9%, transparent); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: .92em; }\n.markdown-text blockquote { margin: .45em 0; padding: .2em 0 .2em .8em; border-left: 3px solid var(--brand-500); color: var(--text-secondary); }\n.markdown-text blockquote p { margin-bottom: .3em; }\n.markdown-text ul, .markdown-text ol { margin: .4em 0 .5em; padding-left: 1.35em; }\n.markdown-text li { margin: .18em 0; }\n.markdown-text .markdown-table-wrap { max-width: 100%; margin: .55em 0; overflow-x: auto; }\n.markdown-text table { width: 100%; border-collapse: collapse; font-size: .92em; }\n.markdown-text th, .markdown-text td { padding: 6px 7px; border: 1px solid var(--border-light); text-align: left; vertical-align: top; }\n.markdown-text th { background: var(--bg-surface-alt); font-weight: 750; }\n\n/* ── Checklist padrão Angular Material ── */\n.markdown-text ul:has(.checklist-item) {\n  list-style: none;\n  padding-left: 0;\n}\n\n.markdown-text li.checklist-item {\n  list-style: none;\n  display: flex;\n  align-items: flex-start;\n  gap: 8px;\n  margin: 4px 0;\n  padding: 3px 6px;\n  border-radius: 6px;\n  transition: background 0.15s ease, transform 0.1s ease;\n  user-select: text;\n\n  &:hover {\n    background: color-mix(in srgb, var(--brand-500, #6366f1) 8%, transparent);\n  }\n}\n\n.markdown-text.interactive li.checklist-item {\n  cursor: pointer;\n\n  &:active {\n    transform: scale(0.99);\n  }\n}\n\n.markdown-text .mat-pseudo-checkbox {\n  width: 18px;\n  height: 18px;\n  min-width: 18px;\n  border-radius: 4px;\n  border: 2px solid var(--text-muted, #94a3b8);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  box-sizing: border-box;\n  margin-top: 2px;\n  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n  background: transparent;\n  color: transparent;\n  flex-shrink: 0;\n  cursor: pointer;\n\n  &:hover {\n    border-color: var(--brand-500, #6366f1);\n    background: color-mix(in srgb, var(--brand-500, #6366f1) 12%, transparent);\n  }\n\n  .mat-pseudo-checkbox-check {\n    width: 14px;\n    height: 14px;\n    opacity: 0;\n    transform: scale(0.5);\n    transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);\n  }\n\n  &.mat-pseudo-checkbox-checked {\n    background: var(--brand-500, #6366f1);\n    border-color: var(--brand-500, #6366f1);\n    color: #ffffff;\n    box-shadow: 0 1px 3px rgba(99, 102, 241, 0.35);\n\n    .mat-pseudo-checkbox-check {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n}\n\n.markdown-text .checklist-text {\n  flex: 1;\n  font-size: 13.5px;\n  line-height: 1.45;\n  color: var(--text-primary);\n  transition: all 0.2s ease;\n\n  &.done {\n    text-decoration: line-through;\n    color: var(--text-muted, #94a3b8);\n    opacity: 0.75;\n  }\n}\n"],
