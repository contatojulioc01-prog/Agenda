  "sourcesContent": [":host { position: fixed; inset: 0; z-index: 2000; }\n\n.ai-backdrop {\n  position: fixed; inset: 0; display: grid; place-items: center; padding: 24px;\n  background: rgba(20, 24, 34, .62); backdrop-filter: blur(6px);\n}\n.ai-backdrop.minimized { pointer-events: none; place-items: end; background: transparent; backdrop-filter: none; }\n.ai-backdrop.minimized .ai-panel { pointer-events: auto; }\n\n.ai-panel {\n  position: relative; width: min(900px, calc(100vw - 40px)); height: min(620px, calc(100dvh - 48px));\n  display: flex; flex-direction: column; overflow: hidden; color: #30394a;\n  background: linear-gradient(90deg, #f3ead8 0%, #fffdf6 6%, #fffef9 47.5%, #eadfc9 49.7%, #c7b79d 50%, #eadfc9 50.3%, #fffef9 52.5%, #fffdf6 94%, #f3ead8 100%);\n  border: 8px solid #e87824; border-width: 7px 10px 10px; border-radius: 28px 28px 24px 24px;\n  box-shadow: 0 34px 95px rgba(0, 0, 0, .52), inset 0 0 30px rgba(99, 74, 43, .12);\n  transform-origin: center bottom; animation: openBook 250ms cubic-bezier(.2, .9, .22, 1) both;\n}\n.ai-panel::before {\n  position: absolute; top: 0; bottom: 0; left: 50%; z-index: 4; width: 22px; pointer-events: none;\n  background: linear-gradient(90deg, transparent, rgba(80, 58, 34, .16) 38%, rgba(255, 255, 255, .7) 50%, rgba(80, 58, 34, .12) 62%, transparent);\n  content: ''; transform: translateX(-50%);\n}\n.ai-panel.minimized { width: min(430px, calc(100vw - 24px)); height: 74px; margin: 0 0 12px; border-width: 4px 7px 7px; border-radius: 17px; background: #fffdf6; }\n.ai-panel.minimized::before { display: none; }\n\n.ai-header {\n  position: relative; z-index: 6; min-height: 72px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 11px 18px;\n  background: linear-gradient(90deg, rgba(47, 155, 216, .13), rgba(255, 255, 255, .48) 48%, rgba(238, 116, 32, .12));\n  border-bottom: 1px solid rgba(112, 89, 56, .18);\n}\n.ai-heading { display: flex; align-items: center; gap: 11px; min-width: 0; }\n.ai-heading h2 { margin: 0; color: #26354a; font-size: 17px; }\n.ai-heading span { color: #6e7887; font-size: 11px; }\n.ai-logo { width: 43px; height: 43px; flex: 0 0 43px; display: grid; place-items: center; overflow: hidden; border-radius: 11px; box-shadow: 0 4px 12px rgba(47, 155, 216, .16); }\n.ai-logo img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }\n.ai-header-actions { display: flex; align-items: center; gap: 4px; }\n.ai-header-actions button { border: 0; color: #5d6878; background: transparent; cursor: pointer; }\n.icon-button { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 9px; }\n.icon-button:hover { color: #26354a; background: rgba(47, 155, 216, .12) !important; }\n.icon-button mat-icon { width: 19px; height: 19px; font-size: 19px; }\n.new-chat { display: flex; align-items: center; gap: 5px; padding: 7px 9px; border-radius: 9px; font-size: 11px; }\n.new-chat:hover { color: #26354a; background: rgba(238, 116, 32, .11) !important; }\n.new-chat mat-icon { width: 16px; height: 16px; font-size: 16px; }\n\n.ai-messages {\n  position: relative; z-index: 2; flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 14px;\n  overflow-y: auto; padding: 23px 28px 18px; scrollbar-width: thin; scrollbar-color: #d2b896 transparent;\n}\n.ai-welcome { width: calc(50% - 34px); margin: auto auto auto 0; text-align: center; color: #697386; }\n.ai-welcome > span { width: 72px; height: 72px; margin: 0 auto 12px; display: grid; place-items: center; overflow: hidden; border-radius: 20px; box-shadow: 0 8px 22px rgba(47, 155, 216, .16); }\n.ai-welcome img { width: 100%; height: 100%; object-fit: cover; }\n.ai-welcome h3 { margin: 0 0 7px; color: #2f4057; font-size: 18px; }\n.ai-welcome p { margin: 0; font-size: 12px; line-height: 1.6; }\n\n.message { width: calc(50% - 25px); max-width: none; padding: 11px 13px; font-size: 13px; line-height: 1.55; word-break: break-word; }\n.message.user { align-self: flex-end; color: #fff; background: linear-gradient(135deg, #2f9bd8, #227eb7); border-radius: 15px 15px 4px 15px; box-shadow: 0 7px 17px rgba(47, 155, 216, .18); }\n.message.assistant { align-self: flex-start; color: #374151; background: rgba(255, 255, 255, .72); border: 1px solid rgba(158, 126, 84, .24); border-radius: 15px 15px 15px 4px; box-shadow: 0 5px 15px rgba(91, 68, 38, .08); }\n.message.error { border-color: rgba(220, 38, 38, .4); color: #991b1b; background: #fff1f1; }\n.message-label { margin-bottom: 4px; font-size: 10px; font-weight: 750; opacity: .65; text-transform: uppercase; letter-spacing: .06em; }\n.message-content { white-space: normal; }\n:host ::ng-deep .message-content code { padding: 1px 5px; border-radius: 4px; background: rgba(38, 53, 74, .09); }\n:host ::ng-deep .message-content p { margin: 0 0 .5em; }\n:host ::ng-deep .message-content p:last-child { margin-bottom: 0; }\n:host ::ng-deep .message-content h1,\n:host ::ng-deep .message-content h2,\n:host ::ng-deep .message-content h3,\n:host ::ng-deep .message-content h4,\n:host ::ng-deep .message-content h5,\n:host ::ng-deep .message-content h6 { margin: .15em 0 .5em; color: #25364d; font-size: 1.05em; line-height: 1.3; }\n:host ::ng-deep .message-content ul,\n:host ::ng-deep .message-content ol { margin: .4em 0 .5em; padding-left: 1.35em; }\n:host ::ng-deep .message-content li { margin: .2em 0; }\n:host ::ng-deep .message-content blockquote { margin: .45em 0; padding-left: .75em; border-left: 3px solid #e87824; color: #596579; }\n:host ::ng-deep .message-content .markdown-table-wrap { max-width: 100%; margin: .55em 0; overflow-x: auto; }\n:host ::ng-deep .message-content table { width: 100%; border-collapse: collapse; font-size: .92em; }\n:host ::ng-deep .message-content th,\n:host ::ng-deep .message-content td { padding: 6px 7px; border: 1px solid rgba(105, 82, 53, .22); text-align: left; vertical-align: top; }\n:host ::ng-deep .message-content th { color: #25364d; background: rgba(47, 155, 216, .1); }\n\n.typing { display: flex; gap: 4px; padding: 5px 2px; }\n.typing i { width: 6px; height: 6px; border-radius: 50%; background: #e87824; animation: pulse 1s infinite ease-in-out; }\n.typing i:nth-child(2) { animation-delay: .15s; }\n.typing i:nth-child(3) { animation-delay: .3s; }\n\n/* --- Interactive Options Card --- */\n.ai-options-card {\n  width: 100%; margin-top: 10px; padding: 12px 11px 10px; border-radius: 13px;\n  background: rgba(255, 255, 255, .62); border: 1.5px solid rgba(47, 155, 216, .28);\n  box-shadow: 0 3px 12px rgba(47, 155, 216, .09);\n  transition: border-color 250ms ease; box-sizing: border-box; overflow: hidden;\n}\n.ai-options-card.answered {\n  background: rgba(232, 248, 236, .55); border-color: rgba(34, 197, 94, .35);\n}\n\n.ai-options-title {\n  display: flex; align-items: flex-start; gap: 6px; margin-bottom: 10px;\n  color: #25364d; font-size: 12.5px; font-weight: 600; line-height: 1.4;\n}\n.ai-options-title .title-icon { font-size: 15px; width: 15px; height: 15px; flex: 0 0 15px; margin-top: 1px; color: #2f9bd8; }\n\n.ai-options-answered-badge {\n  display: flex; align-items: center; gap: 6px; color: #166534; font-size: 12px;\n}\n.ai-options-answered-badge .answered-icon { font-size: 15px; width: 15px; height: 15px; flex: 0 0 15px; color: #22c55e; }\n\n.ai-options-grid {\n  display: flex; flex-wrap: wrap; gap: 6px; width: 100%; overflow: hidden;\n}\n\n.ai-option-chip {\n  display: inline-flex; align-items: center;\n  padding: 6px 11px; border-radius: 20px; font-size: 12px; font-weight: 500;\n  color: #344056; background: rgba(255, 255, 255, .85);\n  border: 1.5px solid rgba(47, 155, 216, .28); cursor: pointer;\n  transition: background 160ms ease, border-color 160ms ease, color 160ms ease, transform 120ms ease;\n  font-family: inherit; white-space: nowrap; max-width: 100%; overflow: hidden; text-overflow: ellipsis;\n}\n.ai-option-chip:hover:not(:disabled) {\n  background: rgba(47, 155, 216, .09); border-color: #2f9bd8; color: #1a3353;\n  transform: translateY(-1px);\n}\n.ai-option-chip.selected {\n  background: linear-gradient(135deg, rgba(47, 155, 216, .18), rgba(47, 155, 216, .09));\n  border-color: #2f9bd8; color: #1a3353;\n}\n.ai-option-chip:disabled { opacity: .5; cursor: not-allowed; }\n.ai-option-chip .chip-label { line-height: 1.3; }\n\n.ai-options-footer {\n  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 6px;\n  margin-top: 10px; padding-top: 9px; border-top: 1px solid rgba(112, 89, 56, .12);\n}\n\n.options-select-all-btn {\n  background: transparent; border: 0; padding: 0; font-size: 11px; color: #6e7887;\n  cursor: pointer; font-family: inherit; text-decoration: underline dotted;\n  transition: color 150ms;\n}\n.options-select-all-btn:hover:not(:disabled) { color: #2f9bd8; }\n.options-select-all-btn:disabled { opacity: .4; cursor: not-allowed; }\n\n.options-confirm-btn {\n  display: inline-flex; align-items: center; gap: 5px;\n  padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 600;\n  color: #fff; background: linear-gradient(135deg, #2f9bd8, #227eb7); border: 0;\n  cursor: pointer; font-family: inherit; box-shadow: 0 4px 12px rgba(47, 155, 216, .24);\n  transition: opacity 160ms ease, transform 120ms ease;\n}\n.options-confirm-btn:hover:not(:disabled) { transform: translateY(-1px); opacity: .9; }\n.options-confirm-btn:disabled { opacity: .38; cursor: not-allowed; transform: none; }\n.options-confirm-btn mat-icon { font-size: 14px; width: 14px; height: 14px; }\n\n.ai-composer {\n  position: relative; z-index: 6; width: 50%; min-height: 77px; margin-left: 50%; display: grid; grid-template-columns: 1fr 40px; gap: 9px;\n  padding: 12px 20px 25px 23px; background: rgba(255, 255, 255, .35); border-top: 1px solid rgba(112, 89, 56, .14);\n}\n.ai-composer textarea { min-height: 41px; max-height: 105px; resize: vertical; padding: 10px 12px; color: #2d3b50; background: rgba(255, 255, 255, .78); border: 1px solid rgba(117, 91, 58, .24); border-radius: 11px; outline: none; font: inherit; }\n.ai-composer textarea:focus { border-color: #2f9bd8; box-shadow: 0 0 0 3px rgba(47, 155, 216, .13); }\n.ai-composer textarea::placeholder { color: #8a93a1; }\n.ai-composer small { position: absolute; left: 25px; bottom: 7px; color: #8b8175; font-size: 9px; }\n.send-button { width: 40px; height: 40px; display: grid; place-items: center; align-self: center; border: 0; border-radius: 50%; color: #fff; background: linear-gradient(135deg, #e87824, #f39b3f); cursor: pointer; box-shadow: 0 7px 17px rgba(232, 120, 36, .28); transition: transform 180ms ease; }\n.send-button:hover:not(:disabled) { transform: scale(1.07); }\n.send-button:disabled { opacity: .4; cursor: default; }\n.send-button mat-icon { width: 19px; height: 19px; font-size: 19px; }\n\n@keyframes openBook {\n  0% { opacity: 0; transform: perspective(1200px) rotateX(8deg) scaleX(.18) scaleY(.72); }\n  55% { opacity: 1; transform: perspective(1200px) rotateX(2deg) scaleX(1.025) scaleY(.98); }\n  100% { opacity: 1; transform: none; }\n}\n@keyframes pulse { 0%, 60%, 100% { opacity: .35; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }\n\n@media (max-width: 700px) {\n  .ai-backdrop { padding: 0; }\n  .ai-panel { width: 100vw; height: 100dvh; max-height: none; border: 0; border-radius: 0; background: #fffdf6; }\n  .ai-panel::before { display: none; }\n  .new-chat span { display: none; }\n  .ai-welcome { width: min(300px, 90%); margin: auto; }\n  .message { width: auto; max-width: 86%; }\n  .ai-composer { width: 100%; margin-left: 0; padding-left: 14px; padding-right: 14px; }\n  .ai-composer small { left: 17px; }\n  .ai-panel.minimized { width: calc(100vw - 24px); height: 70px; margin: 0 12px 12px; border: 5px solid #e87824; border-radius: 16px; }\n  .ai-options-grid { gap: 6px; }\n  .ai-option-chip { font-size: 11.5px; }\n  .options-confirm-btn { font-size: 11.5px; padding: 5px 11px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .ai-panel,\n  .typing i { animation: none; }\n}\n"],
