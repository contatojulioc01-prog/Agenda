  "sourcesContent": [":host {\n  --move-x: 0px;\n  --move-y: 0px;\n  position: fixed;\n  right: clamp(14px, 2vw, 26px);\n  bottom: clamp(14px, 2vw, 26px);\n  z-index: 1400;\n  display: block;\n  width: max-content;\n  height: max-content;\n  transform: translate(0, 0);\n  transition: left 650ms cubic-bezier(0.2, 0.9, 0.25, 1), top 650ms cubic-bezier(0.2, 0.9, 0.25, 1), transform 650ms cubic-bezier(0.2, 0.9, 0.25, 1);\n  will-change: left, top, transform;\n  transform: translate(0, 0) scale(1);\n  transform-origin: center center;\n  transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);\n  will-change: transform;\n}\n\n:host.positioned {\n  right: auto;\n  bottom: auto;\n}\n\n:host.opening {\n  z-index: 2100;\n  transform: scale(1.68);\n  z-index: 2200;\n  transform: translate(var(--move-x), var(--move-y)) scale(1.75);\n  pointer-events: none;\n}\n\n.livro-assistente {\n  position: relative;\n  display: grid;\n  width: 170px;\n  min-height: 132px;\n  place-items: center;\n  padding: 0 4px 5px;\n  overflow: visible;\n  border: 0;\n  color: var(--text-primary);\n  background: transparent;\n  cursor: grab;\n  isolation: isolate;\n  touch-action: none;\n  transition: transform 180ms ease, filter 180ms ease;\n\n  &:hover,\n  &:focus-visible {\n    transform: translateY(-5px) scale(1.04);\n    filter: drop-shadow(0 12px 16px color-mix(in srgb, var(--brand-500) 28%, transparent));\n  }\n\n  &:focus-visible {\n    border-radius: 18px;\n    outline: 3px solid color-mix(in srgb, var(--brand-500) 58%, transparent);\n    outline-offset: 3px;\n  }\n\n  &.opening {\n    transform: none;\n  }\n  &:disabled { opacity: 1; cursor: default; }\n}\n\n:host.dragging {\n  transition: none;\n\n  .livro-assistente {\n    cursor: grabbing;\n    transform: scale(1.03);\n    filter: drop-shadow(0 12px 16px color-mix(in srgb, var(--brand-500) 28%, transparent));\n  }\n}\n\n.livro-svg {\n  position: relative;\n  z-index: 1;\n  display: block;\n  width: 154px;\n  height: auto;\n  margin: -10px 0 -14px;\n  pointer-events: none;\n  user-select: none;\n  filter: drop-shadow(0 14px 28px rgba(238, 116, 32, .32));\n}\n\n.livro-static {\n  position: relative;\n  z-index: 1;\n  display: block;\n  width: 101px;\n  height: 101px;\n  margin: 0 0 -5px;\n  object-fit: contain;\n  filter: drop-shadow(0 10px 16px rgba(47, 155, 216, .2));\n  pointer-events: none;\n  user-select: none;\n}\n\n.livro-label {\n  position: relative;\n  z-index: 2;\n  padding: 5px 11px;\n  border: 1px solid color-mix(in srgb, var(--brand-500) 28%, transparent);\n  border-radius: 999px;\n  color: var(--text-primary);\n  background: color-mix(in srgb, var(--bg-surface) 92%, transparent);\n  box-shadow: 0 6px 18px color-mix(in srgb, #000 16%, transparent);\n  font-size: 11px;\n  font-weight: 750;\n  letter-spacing: .01em;\n  white-space: nowrap;\n  backdrop-filter: blur(10px);\n  transition: opacity 220ms ease, transform 220ms ease;\n}\n\n.livro-assistente.opening .livro-label {\n  opacity: 0;\n  transform: translateY(6px) scale(0.85);\n}\n\n.livro-glow {\n  position: absolute;\n  inset: 10px;\n  z-index: 0;\n  border-radius: 50%;\n  background: color-mix(in srgb, var(--brand-500) 25%, transparent);\n  filter: blur(18px);\n  opacity: 0;\n  transition: opacity 300ms ease;\n}\n\n.livro-assistente.opening .livro-glow {\n  opacity: 0.9;\n  transform: scale(1.35);\n  animation: livro-glow 2.4s ease-in-out infinite;\n}\n\n@keyframes livro-glow {\n  50% { opacity: .55; transform: scale(1.45); }\n}\n\n@media (max-width: 600px) {\n  :host { right: 10px; bottom: 10px; }\n  :host.positioned { right: auto; bottom: auto; }\n  :host.opening { transform: scale(1.35); }\n  .livro-assistente { width: 142px; min-height: 110px; }\n  .livro-svg { width: 124px; }\n  .livro-static { width: 85px; height: 85px; }\n  .livro-label { padding: 4px 9px; font-size: 10px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .livro-assistente,\n  .livro-glow,\n  :host { animation: none; transition-duration: 1ms; }\n}\n"],
