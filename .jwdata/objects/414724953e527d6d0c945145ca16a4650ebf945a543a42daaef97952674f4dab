  "sourcesContent": [":host { display: inline-flex; }\n.ai-text-btn-wrap { position: relative; display: inline-flex; align-items: center; }\n.ai-trigger-btn { height: 28px; display: inline-flex; align-items: center; gap: 4px; padding: 0 9px; border: 1px solid rgba(129, 140, 248, .45); border-radius: 8px; color: #fff; background: linear-gradient(135deg, var(--brand-500), var(--brand-600)); box-shadow: 0 4px 12px rgba(99, 102, 241, .2); font: inherit; font-size: 11px; font-weight: 800; cursor: pointer; transition: .18s ease; &:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(99, 102, 241, .35); } &:disabled { opacity: .45; cursor: default; } mat-icon { width: 15px; height: 15px; font-size: 15px; } }\n.ai-menu-backdrop { position: fixed; inset: 0; z-index: 2098; }\n.ai-actions-menu { position: absolute; top: calc(100% + 7px); right: 0; z-index: 2099; width: 205px; overflow: hidden; padding: 6px; border: 1px solid rgba(129, 140, 248, .35); border-radius: 12px; background: color-mix(in srgb, var(--bg-surface) 92%, transparent); box-shadow: 0 18px 45px rgba(0, 0, 0, .35); backdrop-filter: blur(16px); transform-origin: top right; animation: menuIn .15s ease-out; }\n.ai-action-item { width: 100%; display: flex; align-items: center; gap: 9px; padding: 9px 10px; border: 0; border-radius: 8px; color: var(--text-primary); background: transparent; font: inherit; font-size: 12px; text-align: left; cursor: pointer; &:hover, &.active { color: var(--text-brand); background: var(--bg-hover); } mat-icon { width: 18px; height: 18px; color: var(--brand-500); font-size: 18px; } }\n.ai-action-error { width: 18px; height: 18px; margin-left: 5px; display: grid; place-items: center; border-radius: 50%; color: #fff; background: #ef4444; font-size: 11px; font-weight: 800; }\n@keyframes menuIn { from { opacity: 0; transform: scale(.95) translateY(-3px); } to { opacity: 1; transform: scale(1) translateY(0); } }\n@media (prefers-reduced-motion: reduce) { .ai-actions-menu { animation: none; } }\n"],
