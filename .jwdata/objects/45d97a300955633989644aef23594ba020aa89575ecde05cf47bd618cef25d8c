=\"baixarAnexo()\"\n></app-attachment-preview-modal>\n","import { Injectable, inject, signal } from '@angular/core';\r\nimport { HttpClient } from '@angular/common/http';\r\nimport { catchError, finalize, of } from 'rxjs';\r\nimport { NotificationDevice, NotificationPreferences, NotificationSettings } from '../models/notification.model';\r\n\r\n@Injectable({ providedIn: 'root' })\r\nexport class NotificationsService {\r\n  private readonly http = inject(HttpClient);\r\n  readonly preferences = signal<NotificationPreferences>({\r\n    enabled: true,\r\n    taskEnabled: true,\r\n    eventEnabled: true,\r\n    taskTime: '08:30',\n    taskDaysBefore: 1,\n    eventMinutesBefore: 15,\r\n  });\r\n  readonly devices = signal<NotificationDevice[]>([]);\r\n  readonly loading = signal(false);\r\n  readonly saving = signal(false);\r\n  readonly error = signal('');\r\n\r\n  load(): void {\r\n    this.loading.set(true);\r\n    this.error.set('');\r\n    this.http.get<NotificationSettings>('/api/notifications')\r\n      .pipe(\r\n        catchError(error => {\r\n          this.error.set(error.error?.error || 'Não foi possível carregar as notificações.');\r\n          return of(null);\r\n        }),\r\n        finalize(() => this.loading.set(false)),\r\n      )\r\n      .subscribe(result => {\r\n        if (!result) return;\r\n        this.preferences.set(result.preferences);\r\n        this.devices.set(result.devices);\r\n      });\r\n  }\r\n\r\n  save(preferences: NotificationPreferences, complete?: (success: boolean) => void): void {\r\n    this.saving.set(true);\r\n    this.error.set('');\r\n    this.http.put<NotificationPreferences>('/api/notifications/preferences', preferences)\r\n      .pipe(\r\n        catchError(error => {\r\n          this.error.set(error.error?.error || 'Não foi possível salvar as preferências.');\r\n          return of(null);\r\n        }),\r\n        finalize(() => this.saving.set(false)),\r\n      )\r\n      .subscribe(result => {\r\n        if (result) this.preferences.set(result);\r\n        complete?.(!!result);\r\n      });\r\n  }\r\n\r\n  createDevice(name: string, complete: (result: { device: NotificationDevice; deviceKey: string } | null) => void): void {\r\n    this.saving.set(true);\r\n    this.error.set('');\r\n    this.http.post<{ device: NotificationDevice; deviceKey: string }>('/api/notifications/devices', { name })\r\n      .pipe(\r\n        catchError(error => {\r\n          this.error.set(error.error?.error || 'Não foi possível gerar o código de ativação.');\r\n          return of(null);\r\n        }),\r\n        finalize(() => this.saving.set(false)),\r\n      )\r\n      .subscribe(result => {\r\n        if (result) this.devices.update(devices => [result.device, ...devices]);\r\n        complete(result);\r\n      });\r\n  }\r\n\r\n  revokeDevice(id: string): void {\r\n    this.error.set('');\r\n    this.http.delete<{ success: boolean }>(`/api/notifications/devices/${encodeURIComponent(id)}`)\r\n      .pipe(catchError(error => {\r\n        this.error.set(error.error?.error || 'Não foi possível revogar o computador.');\r\n        return of(null);\r\n      }))\r\n      .subscribe(result => {\r\n        if (result) this.devices.update(devices => devices.filter(device => device.id !== id));\r\n      });\r\n  }\r\n}\r\n","import { CommonModule } from '@angular/common';\r\nimport { Component, EventEmitter, OnInit, Output, inject, signal } from '@angular/core';\r\nimport { FormsModule } from '@angular/forms';\r\nimport { MatIconModule } from '@angular/material/icon';\r\nimport { NotificationsService } from '../../core/services/notifications.service';\r\nimport { AuthService } from '../../core/services/auth.service';\r\n\r\n@Component({\r\n  selector: 'app-notification-settings',\r\n  standalone: true,\r\n  imports: [CommonModule, FormsModule, MatIconModule],\r\n  templateUrl: './notification-settings.component.html',\r\n  styleUrl: './notification-settings.component.scss',\r\n})\r\nexport class NotificationSettingsComponent implements OnInit {\r\n  @Output() readonly closed = new EventEmitter<void>();\r\n  readonly service = inject(NotificationsService);\r\n  private readonly auth = inject(AuthService);\r\n  readonly copied = signal(false);\n  readonly saved = signal(false);\n  deviceName = 'Meu computador';\r\n  activationCode = '';\r\n\r\n  get downloadUrl(): string {\r\n    return new URL('downloads/Agenda.Notifier.exe?v=4', document.baseURI).toString();\n  }\r\n\r\n  ngOnInit(): void {\n    this.service.load();\r\n  }\n\n  savePreferences(): void {\n    this.saved.set(false);\n    this.service.save(this.service.preferences(), success => this.saved.set(success));\n  }\n\r\n  generateCode(): void {\r\n    const name = this.deviceName.trim();\r\n    if (!name) return;\r\n    this.service.createDevice(name, result => {\r\n      if (!result) return;\r\n      const baseUrl = new URL('.', document.baseURI).toString();\r\n      const serverUrl = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;\r\n      const encoded = btoa(JSON.stringify({\r\n        serverUrl,\r\n        userId: this.auth.currentUser()?.id || '',\r\n        deviceKey: result.deviceKey,\r\n      })).split('+').join('-').split('/').join('_').replace(/=+$/, '');\r\n      this.activationCode = `AGENDA1-${encoded}`;\r\n      this.copied.set(false);\r\n    });\r\n  }\r\n\r\n  async copyCode(): Promise<void> {\r\n    if (!this.activationCode) return;\r\n    let success = false;\r\n    try {\r\n      if (window.isSecureContext && navigator.clipboard?.writeText) {\r\n        await navigator.clipboard.writeText(this.activationCode);\r\n        success = true;\r\n      }\r\n    } catch {\r\n      success = false;\r\n    }\r\n    if (!success) {\r\n      const textarea = document.createElement('textarea');\r\n      textarea.value = this.activationCode;\r\n      textarea.setAttribute('readonly', '');\r\n      textarea.style.position = 'fixed';\r\n      textarea.style.left = '-9999px';\r\n      textarea.style.opacity = '0';\r\n      document.body.appendChild(textarea);\r\n      textarea.focus();\r\n      textarea.select();\r\n      textarea.setSelectionRange(0, textarea.value.length);\r\n      try { success = document.execCommand('copy'); } catch { success = false; }\r\n      textarea.remove();\r\n    }\r\n    if (!success) {\r\n      this.service.error.set('O navegador bloqueou a cópia. Selecione o código e pressione Ctrl+C.');\r\n      return;\r\n    }\r\n    this.service.error.set('');\r\n    this.copied.set(true);\r\n    window.setTimeout(() => this.copied.set(false), 2500);\r\n  }\r\n\r\n  formatLastSeen(value: string | null): string {\r\n    if (!value) return 'Ainda não conectado';\r\n    return `Último acesso: ${new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short', timeStyle: 'short' }).format(new Date(value))}`;\r\n  }\r\n}\r\n","<div class=\"notification-backdrop\" (mousedown)=\"closed.emit()\">\r\n  <section class=\"notification-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"notification-title\" (mousedown)=\"$event.stopPropagation()\">\r\n    <header class=\"notification-header\">\n      <span class=\"notification-icon\"><mat-icon>notifications_active</mat-icon></span>\n      <div><h2 id=\"notification-title\">Notificações do Windows</h2><p>Configure seus lembretes e acompanhe o Kanban sem manter a Agenda aberta.</p></div>\n      <button type=\"button\" class=\"close-button\" (click)=\"closed.emit()\" aria-label=\"Fechar\"><mat-icon>close</mat-icon></button>\r\n    </header>\r\n\r\n    <div class=\"notification-body\" *ngIf=\"!service.loading(); else loading\">\r\n      <section class=\"settings-card setup-card\">\n        <div class=\"section-heading\"><span class=\"section-icon\"><mat-icon>laptop_windows</mat-icon></span><div><strong>Aplicativo para Windows</strong><span>Baixe uma vez e conecte este computador.</span></div><a class=\"download-button\" [href]=\"downloadUrl\" download><mat-icon>download</mat-icon>Baixar EXE</a></div>\n        <div class=\"setup-steps\"><span><b>1</b><small>Baixe e abra o<br><strong>Agenda.Notifier.exe</strong></small></span><i></i><span><b>2</b><small>Gere seu<br><strong>código de ativação</strong></small></span><i></i><span><b>3</b><small>Cole o código<br><strong>no aplicativo</strong></small></span></div>\n        <div class=\"activation-row\"><label><span>Nome deste computador</span><input [(ngModel)]=\"deviceName\" maxlength=\"80\" placeholder=\"Ex.: Meu computador\"></label><button type=\"button\" (click)=\"generateCode()\" [disabled]=\"service.saving() || !deviceName.trim()\"><mat-icon>key</mat-icon>Gerar código</button></div>\n        <div class=\"activation-code\" *ngIf=\"activationCode\"><code>{{ activationCode }}</code><button type=\"button\" (click)=\"copyCode()\"><mat-icon>{{ copied() ? 'check' : 'content_copy' }}</mat-icon>{{ copied() ? 'Copiado' : 'Copiar' }}</button><p>Use somente este código iniciado por AGENDA1-. Não cole o token do portal.</p></div>\r\n      </section>\r\n\r\n      <section class=\"settings-card\">\n        <div class=\"section-heading\"><span class=\"section-icon accent-green\"><mat-icon>schedule</mat-icon></span><div><strong>Lembretes de prazos</strong><span>Escolha quando deseja receber cada tipo de aviso.</span></div></div>\n        <form #preferencesForm=\"ngForm\" (ngSubmit)=\"savePreferences()\" (change)=\"saved.set(false)\">\n          <label class=\"master-toggle\"><input type=\"checkbox\" name=\"enabled\" [(ngModel)]=\"service.preferences().enabled\"><span class=\"toggle-track\"><i></i></span><span><strong>Ativar notificações</strong><small>Receba avisos no Windows para prazos próximos.</small></span></label>\n          <div class=\"preference-grid\" [class.disabled]=\"!service.preferences().enabled\">\n            <div class=\"preference-group\"><label class=\"check-setting\"><input type=\"checkbox\" name=\"tasks\" [(ngModel)]=\"service.preferences().taskEnabled\"><span><strong>Avisar sobre tarefas</strong><small>Notificação diária até o vencimento.</small></span></label><div class=\"field-row\"><label><span>Antecedência</span><div class=\"input-with-suffix\"><input type=\"number\" name=\"days\" min=\"0\" max=\"30\" required [(ngModel)]=\"service.preferences().taskDaysBefore\"><em>dias</em></div></label><label><span>Horário</span><input type=\"time\" name=\"time\" required [(ngModel)]=\"service.preferences().taskTime\"></label></div></div>\n            <div class=\"preference-group\"><label class=\"check-setting\"><input type=\"checkbox\" name=\"events\" [(ngModel)]=\"service.preferences().eventEnabled\"><span><strong>Avisar sobre eventos</strong><small>Receba o aviso antes do início.</small></span></label><div class=\"field-row single\"><label><span>Antecedência</span><div class=\"input-with-suffix\"><input type=\"number\" name=\"minutes\" min=\"0\" max=\"1440\" required [(ngModel)]=\"service.preferences().eventMinutesBefore\"><em>minutos</em></div></label></div></div>\n          </div>\n          <div class=\"preferences-footer\"><span role=\"status\" class=\"saved-message\" *ngIf=\"saved()\"><mat-icon>check_circle</mat-icon>Preferências salvas</span><button class=\"primary-action\" type=\"submit\" [disabled]=\"service.saving() || preferencesForm.invalid\"><mat-icon>{{ service.saving() ? 'hourglass_top' : 'save' }}</mat-icon>{{ service.saving() ? 'Salvando…' : 'Salvar lembretes' }}</button></div>\n        </form>\n        <div class=\"kanban-tip\"><mat-icon>view_kanban</mat-icon><span>No ícone do aplicativo na bandeja, escolha <strong>Kanban na área de trabalho</strong> para abrir um painel transparente e clicar diretamente nos cartões.</span></div>\n      </section>\n\n      <section class=\"settings-card\" *ngIf=\"service.devices().length\">\n        <div class=\"section-heading\"><span class=\"section-icon accent-blue\"><mat-icon>devices</mat-icon></span><div><strong>Computadores conectados</strong><span>Revogue dispositivos que você não utiliza mais.</span></div></div>\n        <div class=\"device-row\" *ngFor=\"let device of service.devices()\"><span class=\"device-icon\"><mat-icon>computer</mat-icon></span><div><strong>{{ device.name }}</strong><small>{{ formatLastSeen(device.lastSeenAt) }}</small></div><span class=\"device-status\"><i></i>Ativo</span><button type=\"button\" (click)=\"service.revokeDevice(device.id)\" title=\"Revogar acesso\"><mat-icon>delete_outline</mat-icon></button></div>\n      </section>\r\n\r\n      <p class=\"error-message\" *ngIf=\"service.error()\"><mat-icon>error_outline</mat-icon>{{ service.error() }}</p>\r\n    </div>\r\n    <ng-template #loading><div class=\"loading-notifications\"><span></span>Carregando configurações...</div></ng-template>\r\n  </section>\r\n</div>\r\n","import { Injectable, signal } from '@angular/core';\r\n\r\n@Injectable({ providedIn: 'root' })\r\nexport class AppLoadingService {\r\n  private readonly readyState = signal(false);\r\n  readonly ready = this.readyState.asReadonly();\r\n\r\n  complete(): void {\r\n    this.readyState.set(true);\r\n  }\r\n}\r\n","export interface AiOptionPrompt {\n  question?: string;\n  multiSelect: boolean;\n  options: string[];\n}\n\nexport interface ParsedAiContent {\n  text: string;\n  optionsPrompt: AiOptionPrompt | null;\n}\n\n/**\n * Extracts and parses any interactive options block formatted as:\n * ```options\n * {\n *   \"question\": \"De quais times você gostaria de visualizar as tarefas?\",\n *   \"multiSelect\": true,\n *   \"options\": [\"Equipe Comercial\", \"Equipe TI\", \"Todos os times\"]\n * }\n * ```\n */\nexport function parseAiMessageContent(rawContent: string): ParsedAiContent {\n  if (!rawContent) {\n    return { text: '', optionsPrompt: null };\n  }\n\n  const optionsRegex = /```(?:options|json:options|interactive-options|choices)\\s*([\\s\\S]*?)```/i;\n  const match = rawContent.match(optionsRegex);\n\n  if (!match) {\n    return { text: rawContent, optionsPrompt: null };\n  }\n\n  const rawJson = match[1]?.trim() || '';\n  const cleanText = rawContent.replace(optionsRegex, '').trim();\n\n  let parsedObject: any = null;\n  try {\n    parsedObject = JSON.parse(rawJson);\n  } catch {\n    // If JSON is slightly malformed or has relaxed syntax, attempt cleanup\n    try {\n      const sanitized = rawJson\n        .replace(/,\\s*([\\]}])/g, '$1') // remove trailing commas\n        .replace(/(['\"])?([a-zA-Z0-9_]+)(['\"])?\\s*:/g, '\"$2\": '); // ensure keys are quoted\n      parsedObject = JSON.parse(sanitized);\n    } catch {\n      parsedObject = null;\n    }\n  }\n\n  if (!parsedObject || typeof parsedObject !== 'object') {\n    return { text: cleanText || rawContent, optionsPrompt: null };\n  }\n\n  const rawOptions = Array.isArray(parsedObject.options)\n    ? parsedObject.options\n    : Array.isArray(parsedObject.choices)\n    ? parsedObject.choices\n    : Array.isArray(parsedObject.items)\n    ? parsedObject.items\n    : [];\n\n  const options: string[] = [];\n  for (const item of rawOptions) {\n    if (typeof item === 'string' && item.trim()) {\n      options.push(item.trim());\n    } else if (item && typeof item === 'object') {\n      const label = String(item.label || item.name || item.title || item.text || item.value || '').trim();\n      if (label) options.push(label);\n    }\n  }\n\n  if (options.length === 0) {\n    return { text: cleanText || rawContent, optionsPrompt: null };\n  }\n\n  // Deduplicate preserving order\n  const uniqueOptions = Array.from(new Set(options));\n\n  const multiSelect = parsedObject.multiSelect !== undefined\n    ? Boolean(parsedObject.multiSelect)\n    : parsedObject.multi_select !== undefined\n    ? Boolean(parsedObject.multi_select)\n    : parsedObject.multiple !== undefined\n    ? Boolean(parsedObject.multiple)\n    : true; // default to true for maximum flexibility\n\n  const question = typeof parsedObject.question === 'string' && parsedObject.question.trim()\n    ? parsedObject.question.trim()\n    : typeof parsedObject.title === 'string' && parsedObject.title.trim()\n    ? parsedObject.title.trim()\n    : undefined;\n\n  return {\n    text: cleanText,\n    optionsPrompt: {\n      question,\n      multiSelect,\n      options: uniqueOptions,\n    },\n  };\n}\n\n","import { CommonModule } from '@angular/common';\nimport { AfterViewInit, Component, ElementRef, HostListener, ViewChild, inject, signal } from '@angular/core';\nimport { FormsModule } from '@angular/forms';\nimport { MatIconModule } from '@angular/material/icon';\nimport { Subscription } from 'rxjs';\nimport { AiConversationMessage, AiService } from '../../../core/services/ai.service';\nimport { AiOptionPrompt, ParsedAiContent, parseAiMessageContent } from '../../../core/utils/ai-message-parser.util';\nimport { renderBasicMarkdown } from '../../../core/utils/markdown.util';\n\n@Component({\n  selector: 'app-ai-assistant',\n  standalone: true,\n  imports: [CommonModule, FormsModule, MatIconModule],\n  templateUrl: './ai-assistant.component.html',\n  styleUrl: './ai-assistant.component.scss',\n})\nexport class AiAssistantComponent implements AfterViewInit {\n  @ViewChild('messageList') private messageList?: ElementRef<HTMLElement>;\n  readonly aiService = inject(AiService);\n  readonly messages = this.aiService.conversationMessages;\n  readonly isLoading = signal(false);\n  readonly minimized = signal(false);\n  readonly pendingSelections = signal<Record<number, string[]>>({});\n  draft = '';\n  private request?: Subscription;\n\n  ngAfterViewInit(): void {\n    // Ao (re)abrir o assistente, rola até a última mensagem automaticamente\n    this.scrollToEnd();\n  }\n\n  @HostListener('document:keydown.escape')\n  close(): void {\n    this.request?.unsubscribe();\n    this.aiService.closeAssistant();\n  }\n\n  newConversation(): void {\n    this.request?.unsubscribe();\n    this.isLoading.set(false);\n    this.pendingSelections.set({});\n    this.aiService.newConversation();\n    this.draft = '';\n  }\n\n  onKeydown(event: KeyboardEvent): void {\n    if (event.key === 'Enter' && !event.shiftKey) {\n      event.preventDefault();\n      this.send();\n    }\n  }\n\n  send(): void {\n    const content = this.draft.trim();\n    if (!content || this.isLoading()) return;\n    this.draft = '';\n    this.sendMessage(content);\n  }\n\n  sendMessage(content: string): void {\n    if (!content || this.isLoading()) return;\n    this.aiService.addConversationMessage('user', content);\n    const assistantMessage = this.aiService.addConversationMessage('assistant', '');\n    const assistantMessageId = assistantMessage.id;\n    this.isLoading.set(true);\n    this.scrollToEnd();\n\n    const history = this.messages()\n      .filter(message => message.content && !message.error)\n      .map(({ role, content }) => ({ role, content }));\n\n    this.request = this.aiService.chat(history).subscribe({\n      next: delta => {\n        this.aiService.updateConversationMessage(assistantMessageId, item => ({ ...item, content: item.content + delta }));\n        this.scrollToEnd();\n      },\n      error: () => {\n        this.aiService.updateConversationMessage(assistantMessageId, item => ({\n          ...item,\n          content: 'Ocorreu um erro ao falar com a IA. Tente novamente.',\n          error: true,\n        }));\n        this.isLoading.set(false);\n        this.scrollToEnd();\n      },\n      complete: () => {\n        const completed = this.messages().find(item => item.id === assistantMessageId);\n        if (!completed?.content.trim()) {\n          this.aiService.updateConversationMessage(assistantMessageId, item => ({\n            ...item,\n            content: 'A IA não retornou uma resposta. Tente novamente.',\n            error: true,\n          }));\n        }\n        this.isLoading.set(false);\n        this.scrollToEnd();\n      },\n    });\n  }\n\n  parseContent(rawContent: string): ParsedAiContent {\n    return parseAiMessageContent(rawContent);\n  }\n\n  formatMessage(content: string): string {\n    return renderBasicMarkdown(content);\n  }\n\n  isOptionPending(messageId: number, option: string): boolean {\n    const current = this.pendingSelections()[messageId] || [];\n    return current.includes(option);\n  }\n\n  getPendingCount(messageId: number): number {\n    return (this.pendingSelections()[messageId] || []).length;\n  }\n\n  isAllPendingSelected(messageId: number, options: string[]): boolean {\n    const current = this.pendingSelections()[messageId] || [];\n    return options.length > 0 && options.every(opt => current.includes(opt));\n  }\n\n  toggleSelectAll(messageId: number, options: string[]): void {\n    if (this.isLoading()) return;\n    const current = this.pendingSelections()[messageId] || [];\n    const allSelected = options.every(opt => current.includes(opt));\n    this.pendingSelections.update(map => ({\n      ...map,\n      [messageId]: allSelected ? [] : [...options],\n    }));\n  }\n\n  onOptionClick(message: AiConversationMessage, _prompt: AiOptionPrompt, option: string): void {\n    if (this.isLoading()) return;\n    // Chip click always submits that single option immediately\n    this.aiService.updateConversationMessage(message.id, item => ({\n      ...item,\n      selectedOptions: [option],\n    }));\n    this.sendMessage(`Gostaria de ver referente a: ${option}`);\n  }\n\n  submitPendingSelection(message: AiConversationMessage, prompt: AiOptionPrompt): void {\n    if (this.isLoading()) return;\n    const current = this.pendingSelections()[message.id] || [];\n    const selection = current.length > 0 ? current : [...prompt.options];\n\n    this.aiService.updateConversationMessage(message.id, item => ({\n      ...item,\n      selectedOptions: selection,\n    }));\n\n    const text = `Gostaria de ver referente a: ${selection.join(', ')}`;\n    this.sendMessage(text);\n  }\n\n  private scrollToEnd(): void {\n    setTimeout(() => {\n      const element = this.messageList?.nativeElement;\n      if (element) element.scrollTop = element.scrollHeight;\n    });\n  }\n}\n"