Id ? { ...item, done } : { ...item });\r\n    this.service.updateTask(task.id, { checklist });\r\n  }\r\n\r\n  isOverdue(task: KanbanTask): boolean {\r\n    if (!task.dueDate) return false;\r\n    return new Date(`${task.dueDate}T23:59:59`).getTime() < Date.now();\r\n  }\r\n\r\n  isDueSoon(task: KanbanTask): boolean {\r\n    if (!task.dueDate || this.isOverdue(task)) return false;\r\n    const diff = new Date(`${task.dueDate}T23:59:59`).getTime() - Date.now();\r\n    return diff < 3 * 86400000;\r\n  }\r\n\r\n  formatDate(date: string | null): string {\r\n    return date ? new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short' }).format(new Date(`${date}T12:00:00`)) : '';\r\n  }\r\n\r\n  setViewMode(mode: 'kanban' | 'list'): void {\r\n    this.viewMode.set(mode);\r\n    if (typeof localStorage !== 'undefined') {\r\n      localStorage.setItem('dc_kanban_view_mode', mode);\r\n    }\r\n  }\r\n\r\n  toggleSortMenu(event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    this.showSortMenu.update(v => !v);\r\n    if (this.showSortMenu()) {\r\n      this.showColumnManager.set(false);\r\n      this.showFilterMenu.set(false);\r\n      this.showMoreMenu.set(false);\r\n    }\r\n  }\r\n\r\n  toggleFilterMenu(event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    this.showFilterMenu.update(v => !v);\r\n    if (this.showFilterMenu()) {\r\n      this.showSortMenu.set(false);\r\n      this.showColumnManager.set(false);\r\n      this.showMoreMenu.set(false);\r\n    }\r\n  }\r\n\r\n  toggleMoreMenu(event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    this.showMoreMenu.update(v => !v);\r\n    if (this.showMoreMenu()) {\r\n      this.showSortMenu.set(false);\r\n      this.showColumnManager.set(false);\r\n      this.showFilterMenu.set(false);\r\n    }\r\n  }\r\n\r\n  clearFilters(event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    this.setPriorityFilter('all');\r\n    this.setAssigneeFilter('all');\r\n  }\r\n\r\n  toggleSort(option: 'default' | 'dueDate' | 'priority' | 'title' | 'status'): void {\r\n    if (this.sortOption() === option) {\r\n      this.sortDirection.set(this.sortDirection() === 'asc' ? 'desc' : 'asc');\r\n    } else {\r\n      this.sortOption.set(option);\r\n      this.sortDirection.set('asc');\r\n    }\r\n    this.showSortMenu.set(false);\r\n  }\r\n\r\n  private loadInitialColumnWidths(): Record<string, number> {\r\n    const defaults = { ...this.defaultTableWidths };\r\n    if (typeof localStorage !== 'undefined') {\r\n      try {\r\n        const saved = localStorage.getItem('dc_table_column_widths');\r\n        if (saved) {\r\n          const parsed = JSON.parse(saved);\r\n          return { ...defaults, ...parsed };\r\n        }\r\n      } catch {}\r\n    }\r\n    return defaults;\r\n  }\r\n\r\n  private loadInitialKanbanColumnWidths(): Record<string, number> {\r\n    if (typeof localStorage !== 'undefined') {\r\n      try {\r\n        const saved = localStorage.getItem('dc_kanban_column_widths');\r\n        if (saved) {\r\n          return JSON.parse(saved);\r\n        }\r\n      } catch {}\r\n    }\r\n    return {};\r\n  }\r\n\r\n  getColumnWidth(colId: string): number {\r\n    return this.columnWidths()[colId] || this.defaultTableWidths[colId] || 150;\r\n  }\r\n\r\n  getKanbanColumnWidth(colId: string): number {\r\n    return this.kanbanColumnWidths()[colId] || this.defaultKanbanColumnWidth;\r\n  }\r\n\r\n  onColumnResizeStart(event: MouseEvent, colId: string): void {\r\n    event.preventDefault();\r\n    event.stopPropagation();\r\n\r\n    const startX = event.clientX;\r\n    const startWidth = this.getColumnWidth(colId);\r\n    const minWidth = colId === 'subject' || colId === 'demand' ? 100 : 70;\r\n\r\n    this.resizingColumnId.set(colId);\r\n    if (typeof document !== 'undefined') {\r\n      document.body.style.cursor = 'col-resize';\r\n      document.body.style.userSelect = 'none';\r\n    }\r\n\r\n    this.cleanupResizeListeners();\r\n\r\n    this.resizeMoveListener = (e: MouseEvent) => {\r\n      const diff = e.clientX - startX;\r\n      const newWidth = Math.max(minWidth, Math.min(800, Math.round(startWidth + diff)));\r\n      this.columnWidths.update(widths => ({ ...widths, [colId]: newWidth }));\r\n    };\r\n\r\n    this.resizeUpListener = () => {\r\n      this.resizingColumnId.set(null);\r\n      if (typeof document !== 'undefined') {\r\n        document.body.style.cursor = '';\r\n        document.body.style.userSelect = '';\r\n      }\r\n      this.cleanupResizeListeners();\r\n      this.saveColumnWidths();\r\n    };\r\n\r\n    window.addEventListener('mousemove', this.resizeMoveListener);\r\n    window.addEventListener('mouseup', this.resizeUpListener);\r\n  }\r\n\r\n  resetColumnWidth(colId: string, event?: Event): void {\r\n    if (event) {\r\n      event.preventDefault();\r\n      event.stopPropagation();\r\n    }\r\n    const def = this.defaultTableWidths[colId] || 150;\r\n    this.columnWidths.update(widths => ({ ...widths, [colId]: def }));\r\n    this.saveColumnWidths();\r\n  }\r\n\r\n  private saveColumnWidths(): void {\r\n    if (typeof localStorage === 'undefined') return;\r\n    try {\r\n      localStorage.setItem('dc_table_column_widths', JSON.stringify(this.columnWidths()));\r\n    } catch {}\r\n  }\r\n\r\n  onKanbanColumnResizeStart(event: MouseEvent, colId: string): void {\r\n    event.preventDefault();\r\n    event.stopPropagation();\r\n\r\n    const startX = event.clientX;\r\n    const startWidth = this.getKanbanColumnWidth(colId);\r\n    const minWidth = 220;\r\n    const maxWidth = 700;\r\n\r\n    this.resizingColumnId.set(`kanban_${colId}`);\r\n    if (typeof document !== 'undefined') {\r\n      document.body.style.cursor = 'col-resize';\r\n      document.body.style.userSelect = 'none';\r\n    }\r\n\r\n    this.cleanupResizeListeners();\r\n\r\n    this.resizeMoveListener = (e: MouseEvent) => {\r\n      const diff = e.clientX - startX;\r\n      const newWidth = Math.max(minWidth, Math.min(maxWidth, Math.round(startWidth + diff)));\r\n      this.kanbanColumnWidths.update(widths => ({ ...widths, [colId]: newWidth }));\r\n    };\r\n\r\n    this.resizeUpListener = () => {\r\n      this.resizingColumnId.set(null);\r\n      if (typeof document !== 'undefined') {\r\n        document.body.style.cursor = '';\r\n        document.body.style.userSelect = '';\r\n      }\r\n      this.cleanupResizeListeners();\r\n      this.saveKanbanColumnWidths();\r\n    };\r\n\r\n    window.addEventListener('mousemove', this.resizeMoveListener);\r\n    window.addEventListener('mouseup', this.resizeUpListener);\r\n  }\r\n\r\n  resetKanbanColumnWidth(colId: string, event?: Event): void {\r\n    if (event) {\r\n      event.preventDefault();\r\n      event.stopPropagation();\r\n    }\r\n    this.kanbanColumnWidths.update(widths => {\r\n      const updated = { ...widths };\r\n      delete updated[colId];\r\n      return updated;\r\n    });\r\n    this.saveKanbanColumnWidths();\r\n  }\r\n\r\n  private saveKanbanColumnWidths(): void {\r\n    if (typeof localStorage === 'undefined') return;\r\n    try {\r\n      localStorage.setItem('dc_kanban_column_widths', JSON.stringify(this.kanbanColumnWidths()));\r\n    } catch {}\r\n  }\r\n\r\n  private cleanupResizeListeners(): void {\r\n    if (this.resizeMoveListener) {\r\n      window.removeEventListener('mousemove', this.resizeMoveListener);\r\n      this.resizeMoveListener = null;\r\n    }\r\n    if (this.resizeUpListener) {\r\n      window.removeEventListener('mouseup', this.resizeUpListener);\r\n      this.resizeUpListener = null;\r\n    }\r\n  }\r\n\r\n  private loadInitialTableColumns(): TableColumnDef[] {\r\n    let customCols: TableColumnDef[] = [];\r\n    if (typeof localStorage !== 'undefined') {\r\n      try {\r\n        const savedCustom = localStorage.getItem('dc_table_custom_columns');\r\n        if (savedCustom) {\r\n          customCols = JSON.parse(savedCustom);\r\n        }\r\n      } catch {\r\n        customCols = [];\r\n      }\r\n    }\r\n\r\n    const allBase = [...DEFAULT_TABLE_COLUMNS, ...customCols];\r\n\r\n    if (typeof localStorage !== 'undefined') {\r\n      try {\r\n        const savedVis = localStorage.getItem('dc_table_visible_columns');\r\n        if (savedVis) {\r\n          const parsedVis = JSON.parse(savedVis) as Record<string, boolean>;\r\n          return allBase.map(col => ({\r\n            ...col,\r\n            visible: parsedVis[col.id] !== undefined ? parsedVis[col.id] : col.visible,\r\n          }));\r\n        }\r\n      } catch {}\r\n    }\r\n    return allBase;\r\n  }\r\n\r\n  saveTableColumnsState(): void {\r\n    if (typeof localStorage === 'undefined') return;\r\n    const current = this.tableColumns();\r\n    const custom = current.filter(c => c.isCustom);\r\n    localStorage.setItem('dc_table_custom_columns', JSON.stringify(custom));\r\n    const visMap: Record<string, boolean> = {};\r\n    current.forEach(c => (visMap[c.id] = c.visible));\r\n    localStorage.setItem('dc_table_visible_columns', JSON.stringify(visMap));\r\n  }\r\n\r\n  addCustomColumn(label?: string, type?: ColumnFieldType, optionsStr?: string): void {\r\n    const colLabel = (label || this.newCustomColumnLabel).trim();\r\n    if (!colLabel) return;\r\n    const colType = type || this.newCustomColumnType || 'text';\r\n    const id = 'col_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 6);\r\n    \r\n    let icon = 'text_fields';\r\n    if (colType === 'date') icon = 'calendar_today';\r\n    else if (colType === 'number') icon = 'tag';\r\n    else if (colType === 'select') icon = 'list';\r\n    else if (colType === 'checkbox') icon = 'check_box';\r\n    else if (colType === 'person') icon = 'person';\r\n\r\n    const options = (optionsStr !== undefined ? optionsStr : this.newCustomColumnOptions)\r\n      ? (optionsStr !== undefined ? optionsStr : this.newCustomColumnOptions).split(',').map(o => o.trim()).filter(Boolean)\r\n      : undefined;\r\n\r\n    const newCol: TableColumnDef = {\r\n      id,\r\n      label: colLabel,\r\n      icon,\r\n      visible: true,\r\n      type: colType,\r\n      options,\r\n      isCustom: true,\r\n    };\r\n\r\n    const updated = [...this.tableColumns(), newCol];\r\n    this.tableColumns.set(updated);\r\n    this.saveTableColumnsState();\r\n\r\n    this.newCustomColumnLabel = '';\r\n    this.newCustomColumnType = 'text';\r\n    this.newCustomColumnOptions = '';\r\n    this.showAddColumnPopover.set(false);\r\n  }\r\n\r\n  addPropertyInModal(): void {\r\n    const label = this.newPropertyLabelInModal.trim();\r\n    if (!label) return;\r\n    this.addCustomColumn(label, this.newPropertyTypeInModal, this.newPropertyOptionsInModal);\r\n    this.newPropertyLabelInModal = '';\r\n    this.newPropertyTypeInModal = 'text';\r\n    this.newPropertyOptionsInModal = '';\r\n    this.showAddPropertyInModal.set(false);\r\n  }\r\n\r\n  openDatePicker(inputEl: HTMLInputElement | null, event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    if (!inputEl) return;\r\n    try {\r\n      if (typeof inputEl.showPicker === 'function') {\r\n        inputEl.showPicker();\r\n      } else {\r\n        inputEl.focus();\r\n      }\r\n    } catch {\r\n      inputEl.focus();\r\n    }\r\n  }\r\n\r\n  openDatePickerFromCell(event: Event): void {\r\n    event.stopPropagation();\r\n    const cell = event.currentTarget as HTMLElement;\r\n    const input = cell.querySelector<HTMLInputElement>('input[type=\"date\"]');\r\n    if (!input) return;\r\n    try {\r\n      if (typeof input.showPicker === 'function') {\r\n        input.showPicker();\r\n      } else {\r\n        input.click();\r\n        input.focus();\r\n      }\r\n    } catch {\r\n      input.click();\r\n      input.focus();\r\n    }\r\n  }\r\n\r\n  isCustomColumn(col: TableColumnDef): boolean {\r\n    return !!col.isCustom || col.id.startsWith('col_') || !DEFAULT_TABLE_COLUMNS.some(d => d.id === col.id);\r\n  }\r\n\r\n  removeCustomColumn(colId: string, event?: Event): void {\r\n    if (event) {\r\n      event.preventDefault();\r\n      event.stopPropagation();\r\n    }\r\n    const target = this.tableColumns().find(c => c.id === colId);\r\n    if (!target) return;\r\n\r\n    // Remove from tableColumns\r\n    const updated = this.tableColumns().filter(c => c.id !== colId);\r\n    this.tableColumns.set(updated);\r\n    this.saveTableColumnsState();\r\n\r\n    // Clean up columnWidths from localStorage\r\n    this.columnWidths.update(widths => {\r\n      const next = { ...widths };\r\n      delete next[colId];\r\n      return next;\r\n    });\r\n    this.saveColumnWidths();\r\n\r\n    // Clean up task custom labels if any\r\n    const board = this.board();\r\n    if (board) {\r\n      const prefix = `cx_${colId}:`;\r\n      const simplePrefix = `${colId}:`;\r\n      const updatedTasks = board.tasks.map(t => {\r\n        if (!t.labels || !t.labels.some(l => l.startsWith(prefix) || l.startsWith(simplePrefix))) {\r\n          return t;\r\n        }\r\n        return {\r\n          ...t,\r\n          labels: t.labels.filter(l => !l.startsWith(prefix) && !l.startsWith(simplePrefix)),\r\n        };\r\n      });\r\n      this.service.activeBoard.set({ ...board, tasks: updatedTasks });\r\n    }\r\n  }\r\n\r\n  isColumnVisible(colId: string): boolean {\r\n    const col = this.tableColumns().find(c => c.id === colId);\r\n    return col ? col.visible : true;\r\n  }\r\n\r\n  toggleColumnVisibility(colId: string, event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    const current = this.tableColumns();\r\n    const target = current.find(c => c.id === colId);\r\n    if (!target) return;\r\n\r\n    if (target.visible && this.visibleColumnsCount() <= 1) {\r\n      return;\r\n    }\r\n\r\n    const updated = current.map(col => {\r\n      if (col.id === colId) {\r\n        return { ...col, visible: !col.visible };\r\n      }\r\n      return col;\r\n    });\r\n\r\n    this.tableColumns.set(updated);\r\n    this.saveTableColumnsState();\r\n  }\r\n\r\n  setAllColumnsVisibility(visible: boolean, event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    const updated = this.tableColumns().map(col => ({\r\n      ...col,\r\n      visible: !visible && col.id === 'subject' ? true : visible,\r\n    }));\r\n    this.tableColumns.set(updated);\r\n    this.saveTableColumnsState();\r\n  }\r\n\r\n  toggleColumnManager(event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    this.showColumnManager.update(v => !v);\r\n    if (this.showColumnManager()) {\r\n      this.showSortMenu.set(false);\r\n      this.showFilterMenu.set(false);\r\n      this.showMoreMenu.set(false);\r\n    }\r\n  }\r\n\r\n  getCustomFieldValue(task: KanbanTask, col: TableColumnDef): any {\r\n    if (!task || !task.labels) return col.type === 'checkbox' ? false : '';\r\n    const prefix = `cx_${col.id}:`;\r\n    const labelMatch = task.labels.find(l => l.startsWith(prefix));\r\n    if (labelMatch) {\r\n      const val = labelMatch.substring(prefix.length);\r\n      if (col.type === 'checkbox') return val === 'true';\r\n      return val;\r\n    }\r\n    const simpleMatch = task.labels.find(l => l.startsWith(`${col.id}:`));\r\n    if (simpleMatch) {\r\n      const val = simpleMatch.substring(col.id.length + 1);\r\n      if (col.type === 'checkbox') return val === 'true';\r\n      return val;\r\n    }\r\n    if (col.type === 'checkbox') return false;\r\n    return '';\r\n  }\r\n\r\n  updateCustomField(task: KanbanTask, col: TableColumnDef, value: any, event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    const board = this.board();\r\n    if (!board) return;\r\n\r\n    const prefix = `cx_${col.id}:`;\r\n    const simplePrefix = `${col.id}:`;\r\n    const cleanLabels = (task.labels || []).filter(l => !l.startsWith(prefix) && !l.startsWith(simplePrefix));\r\n\r\n    const stringVal = col.type === 'checkbox'\r\n      ? (value ? 'true' : 'false')\r\n      : (typeof value === 'string' ? value.trim() : (value !== null && value !== undefined ? String(value) : ''));\r\n\r\n    if (stringVal && stringVal !== 'false') {\r\n      cleanLabels.push(`${prefix}${stringVal}`);\r\n    }\r\n\r\n    this.service.updateTask(task.id, { labels: cleanLabels.slice(0, 30) });\r\n  }\r\n\r\n  toggleCustomCheckbox(task: KanbanTask, col: TableColumnDef, event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    const current = !!this.getCustomFieldValue(task, col);\r\n    this.updateCustomField(task, col, !current);\r\n  }\r\n\r\n  startInlineEdit(task: KanbanTask, field: string, event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    let initial = '';\r\n    if (field === 'title') initial = task.title;\r\n    else if (field === 'demand') initial = task.description || '';\r\n    else if (field === 'labels') initial = this.getTaskFreeLabels(task).join(', ');\r\n    else if (field === 'ped') initial = this.getOrderText(task);\r\n    else if (field === 'rede') initial = this.getNetworkPath(task);\r\n    else if (field === 'exec') initial = this.getExecutionDateRaw(task);\r\n    else if (field === 'dueDate') initial = task.dueDate ? task.dueDate.split('T')[0] : '';\r\n    else if (field.startsWith('col_')) {\r\n      const col = this.customColumns().find(c => c.id === field);\r\n      if (col) initial = String(this.getCustomFieldValue(task, col) || '');\r\n    }\r\n\r\n    this.inlineEditValue = initial;\r\n    this.inlineEditingCell.set({ taskId: task.id, field });\r\n  }\r\n\r\n  cancelInlineEdit(event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    this.inlineEditingCell.set(null);\r\n  }\r\n\r\n  saveInlineEdit(task: KanbanTask, field: string, event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    if (field.startsWith('col_')) {\r\n      const col = this.customColumns().find(c => c.id === field);\r\n      if (col) this.updateCustomField(task, col, this.inlineEditValue);\r\n    } else {\r\n      this.updateTaskField(task, field, this.inlineEditValue);\r\n    }\r\n    this.inlineEditingCell.set(null);\r\n  }\r\n\r\n  updateTaskField(task: KanbanTask, field: string, value: any, event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    const board = this.board();\r\n    if (!board) return;\r\n\r\n    if (field === 'dueDate') {\r\n      const dateVal = value ? value : null;\r\n      this.service.updateTask(task.id, { dueDate: dateVal });\r\n      return;\r\n    }\r\n\r\n    if (field === 'title') {\r\n      const titleVal = (value || '').trim();\r\n      if (titleVal && titleVal !== task.title) {\r\n        this.service.updateTask(task.id, { title: titleVal });\r\n      }\r\n      return;\r\n    }\r\n\r\n    if (field === 'demand' || field === 'description') {\r\n      this.service.updateTask(task.id, { description: value || '' });\r\n      return;\r\n    }\r\n\r\n    if (field === 'labels') {\r\n      const freeParts = typeof value === 'string'\r\n        ? value.split(',').map(s => s.trim()).filter(Boolean)\r\n        : [];\r\n      const nonFree = (task.labels || []).filter(l => l.startsWith('cx_') || /^(setor|macro|exec|ped|pedido|rede):/i.test(l));\r\n      this.service.updateTask(task.id, { labels: [...freeParts, ...nonFree].slice(0, 30) });\r\n      return;\r\n    }\r\n\r\n    if (field === 'assignee') {\r\n      const userId = value;\r\n      let newAssignees: string[] = [];\r\n      if (userId === 'none' || !userId) {\r\n        newAssignees = [];\r\n      } else {\r\n        newAssignees = [userId];\r\n      }\r\n      this.service.updateTask(task.id, { assigneeIds: newAssignees });\r\n      return;\r\n    }\r\n\r\n    // Label-based fields: setor, macro, exec, ped, rede\r\n    const cleanLabels = (task.labels || []).filter(l => {\r\n      if (field === 'setor') return !/^setor:/i.test(l) && !this.predefinedSectors.some(s => s.toLowerCase() === l.toLowerCase().replace(/^#/, ''));\r\n      if (field === 'macro') return !/^macro:/i.test(l) && !this.predefinedMacroThemes.some(m => m.toLowerCase() === l.toLowerCase().replace(/^#/, ''));\r\n      if (field === 'exec') return !/^exec:/i.test(l);\r\n      if (field === 'ped') return !/^(ped|pedido|ped-|ord-|#ped):?/i.test(l);\r\n      if (field === 'rede') return !/^rede:/i.test(l);\r\n      return true;\r\n    });\r\n\r\n    const val = typeof value === 'string' ? value.trim() : '';\r\n    if (val) {\r\n      cleanLabels.push(`${field}:${val}`);\r\n    }\r\n\r\n    this.service.updateTask(task.id, { labels: cleanLabels.slice(0, 30) });\r\n  }\r\n\r\n  getPriorityLabel(priority?: TaskPriority | string): string {\r\n    switch (priority) {\r\n      case 'urgent': return 'Urgente';\r\n      case 'high': return 'Alta';\r\n      case 'medium': return 'Média';\r\n      case 'low': return 'Baixa';\r\n      default: return 'Média';\r\n    }\r\n  }\r\n\r\n  getPriorityIcon(priority?: TaskPriority | string): string {\r\n    switch (priority) {\r\n      case 'urgent': return 'error_outline';\r\n      case 'high': return 'flag';\r\n      case 'medium': return 'outlined_flag';\r\n      case 'low': return 'arrow_downward';\r\n      default: return 'outlined_flag';\r\n    }\r\n  }\r\n\r\n  currentSortLabel(): string {\r\n    if (this.sortOption() === 'default') {\r\n      return 'Ordenar';\r\n    }\r\n    const map: Record<string, string> = {\r\n      dueDate: 'Prazo',\r\n      priority: 'Prioridade',\r\n      title: 'Assunto',\r\n      status: 'Status',\r\n    };\r\n    const label = map[this.sortOption()] || 'Ordenar';\r\n    return `${label} ${this.sortDirection() === 'asc' ? '↑' : '↓'}`;\r\n  }\r\n\r\n  autoArchiveLabel(delay?: string): string {\r\n    switch (delay) {\r\n      case 'immediate': return 'Imediatamente';\r\n      case '1h': return 'Após 1 hora';\r\n      case '6h': return 'Após 6 horas';\r\n      case '12h': return 'Após 12 horas';\r\n      case '24h': return 'Após 1 dia';\r\n      case '48h': return 'Após 2 dias';\r\n      case '72h': return 'Após 3 dias';\r\n      case '7d': return 'Após 7 dias';\r\n      default: return 'Nunca';\r\n    }\r\n  }\r\n\r\n  getColumnTitle(columnId: string): string {\r\n    const col = this.board()?.columns.find(c => c.id === columnId);\r\n    return col?.title || 'Sem lista';\r\n  }\r\n\r\n  getColumnColor(columnId: string): string {\r\n    const col = this.board()?.columns.find(c => c.id === columnId);\r\n    return col?.color || 'var(--brand-500)';\r\n  }\r\n\r\n  getColumnBg(columnId: string): string {\r\n    const color = this.getColumnColor(columnId);\r\n    return `color-mix(in srgb, ${color} 15%, transparent)`;\r\n  }\r\n\r\n  getDemandText(task: KanbanTask): string {\r\n    if (task.description && task.description.trim()) {\r\n      const firstLine = task.description.trim().split('\\n')[0].replace(/^#+\\s*/, '');\r\n      return firstLine.length > 70 ? firstLine.substring(0, 70) + '...' : firstLine;\r\n    }\r\n    if (task.checklist && task.checklist.length) {\r\n      const done = task.checklist.filter(i => i.done).length;\r\n      return `Checklist (${done}/${task.checklist.length})`;\r\n    }\r\n    return '—';\r\n  }\r\n\r\n  setActiveTab(tab: 'month_tasks' | 'month_completed' | 'week_tasks' | 'kanban'): void {\r\n    this.activeTab.set(tab);\r\n    if (typeof localStorage !== 'undefined') {\r\n      localStorage.setItem('dc_kanban_active_tab', tab);\r\n    }\r\n  }\r\n\r\n  getSectorText(task: KanbanTask): string {\r\n    const sectorLabel = task.labels?.find(l => l.toLowerCase().startsWith('setor:') || l.toLowerCase().startsWith('setor '));\r\n    if (sectorLabel) {\r\n      return sectorLabel.replace(/^setor:?\\s*/i, '').trim();\r\n    }\r\n    const match = task.labels?.find(l => this.predefinedSectors.some(s => s.toLowerCase() === l.toLowerCase().replace(/^#/, '')));\r\n    if (match) return match.replace(/^#/, '');\r\n\r\n    const board = this.board();\r\n    if (board?.teamName) return board.teamName;\r\n    const currentTeam = this.currentTeam();\r\n    if (currentTeam?.name) return currentTeam.name;\r\n    return 'Gráfico - P&D';\r\n  }\r\n\r\n  getSectorTheme(sector: string): { color: string; bg: string; border: string } {\r\n    const s = (sector || '').toLowerCase();\r\n    if (s.includes('gráfico') || s.includes('grafico') || s.includes('p&d') || s.includes('arte final')) {\r\n      return { color: '#fbbf24', bg: 'rgba(245, 158, 11, 0.18)', border: 'rgba(245, 158, 11, 0.35)' };\r\n    }\r\n    if (s.includes('compra') || s.includes('impress')) {\r\n      return { color: '#d6d3d1', bg: 'rgba(120, 113, 108, 0.25)', border: 'rgba(120, 113, 108, 0.4)' };\r\n    }\r\n    if (s.includes('pcp') || s.includes('produç') || s.includes('produc')) {\r\n      return { color: '#cbd5e1', bg: 'rgba(100, 116, 139, 0.25)', border: 'rgba(100, 116, 139, 0.4)' };\r\n    }\r\n    if (s.includes('social') || s.includes('mídia') || s.includes('midia')) {\r\n      return { color: '#e879f9', bg: 'rgba(217, 70, 239, 0.18)', border: 'rgba(217, 70, 239, 0.35)' };\r\n    }\r\n    if (s.includes('licen') || s.includes('royal')) {\r\n      return { color: '#5eead4', bg: 'rgba(20, 184, 166, 0.18)', border: 'rgba(20, 184, 166, 0.35)' };\r\n    }\r\n    return { color: '#e2e8f0', bg: 'rgba(148, 163, 184, 0.18)', border: 'rgba(148, 163, 184, 0.3)' };\r\n  }\r\n\r\n  getMacroTheme(task: KanbanTask, withEmoji = true): string {\r\n    const macroLabel = task.labels?.find(l => l.toLowerCase().startsWith('macro:') || l.toLowerCase().startsWith('macro '));\r\n    let name = macroLabel ? macroLabel.replace(/^macro:?\\s*/i, '').trim() : '';\r\n    if (!name) {\r\n      const match = task.labels?.find(l => this.predefinedMacroThemes.some(m => m.toLowerCase() === l.toLowerCase().replace(/^#/, '')));\r\n      if (match) name = match.replace(/^#/, '');\r\n    }\r\n    if (!name) {\r\n      name = this.board()?.name || 'Galeroca';\r\n    }\r\n    if (!withEmoji) return name;\r\n\r\n    const n = name.toLowerCase();\r\n    if (n.includes('compra')) return `🛒 ${name}`;\r\n    if (n.includes('galeroca')) return `⚱️ ${name}`;\r\n    if (n.includes('pcp')) return `🔀 ${name}`;\r\n    if (n.includes('reil leão') || n.includes('rei leao') || n.includes('enlace')) return `🏆 ${name}`;\r\n    if (n.includes('venom') || n.includes('gelelé venom') || n.includes('gelele')) return `★ ${name}`;\r\n    if (n.includes('maria')) return `📁 ${name}`;\r\n    return `📁 ${name}`;\r\n  }\r\n\r\n  getExecutionDate(task: KanbanTask): string {\r\n    const execLabel = task.labels?.find(l => l.toLowerCase().startsWith('exec:'));\r\n    if (execLabel) {\r\n      return this.formatFullDate(execLabel.replace(/^exec:\\s*/i, '').trim());\r\n    }\r\n    const colTitle = this.getColumnTitle(task.columnId).toLowerCase();\r\n    const isCompleted = colTitle.includes('finaliz') || colTitle.includes('conclu') || colTitle.includes('done');\r\n    if (isCompleted && task.updatedAt) {\r\n      return this.formatFullDate(task.updatedAt);\r\n    }\r\n    return '';\r\n  }\r\n\r\n  getExecutionDateRaw(task: KanbanTask): string {\r\n    const execLabel = task.labels?.find(l => l.toLowerCase().startsWith('exec:'));\r\n    if (execLabel) return execLabel.replace(/^exec:\\s*/i, '').trim();\r\n    return '';\r\n  }\r\n\r\n  getOrderText(task: KanbanTask): string {\r\n    const orderLabel = task.labels?.find(l => /^(ped|pedido|ped-|ord-|#ped):?/i.test(l));\r\n    if (orderLabel) {\r\n      return orderLabel.replace(/^(ped|pedido|ped-|ord-|#ped):?\\s*/i, '').replace(/^#/, '');\r\n    }\r\n    return '';\r\n  }\r\n\r\n  getNetworkPath(task: KanbanTask): string {\r\n    const redeLabel = task.labels?.find(l => l.toLowerCase().startsWith('rede:'));\r\n    if (redeLabel) {\r\n      return redeLabel.replace(/^rede:\\s*/i, '').trim();\r\n    }\r\n    return '';\r\n  }\r\n\r\n  getAssigneeBadgeStyle(assigneeName: string): { bg: string; color: string; border: string } {\r\n    const n = (assigneeName || '').toLowerCase();\r\n    if (n.includes('emily')) return { bg: 'rgba(244, 114, 182, 0.2)', color: '#f472b6', border: 'rgba(244, 114, 182, 0.4)' };\r\n    if (n.includes('eduardo')) return { bg: 'rgba(74, 222, 128, 0.2)', color: '#4ade80', border: 'rgba(74, 222, 128, 0.4)' };\r\n    if (n.includes('marcus')) return { bg: 'rgba(96, 165, 250, 0.2)', color: '#60a5fa', border: 'rgba(96, 165, 250, 0.4)' };\r\n    if (n.includes('luisa')) return { bg: 'rgba(251, 146, 60, 0.2)', color: '#fb923c', border: 'rgba(251, 146, 60, 0.4)' };\r\n    if (n.includes('giovanna')) return { bg: 'rgba(248, 113, 113, 0.2)', color: '#f87171', border: 'rgba(248, 113, 113, 0.4)' };\r\n    if (n.includes('felix')) return { bg: 'rgba(167, 139, 250, 0.2)', color: '#a78bfa', border: 'rgba(167, 139, 250, 0.4)' };\r\n    if (n.includes('leticia')) return { bg: 'rgba(148, 163, 184, 0.2)', color: '#94a3b8', border: 'rgba(148, 163, 184, 0.4)' };\r\n    if (n.includes('fornecedor')) return { bg: 'rgba(192, 132, 252, 0.2)', color: '#c084fc', border: 'rgba(192, 132, 252, 0.4)' };\r\n    return { bg: 'rgba(244, 114, 182, 0.15)', color: '#f472b6', border: 'rgba(244, 114, 182, 0.3)' };\r\n  }\r\n\r\n  getStatusTheme(columnId: string): { className: string; color: string; bg: string; dot: string; border: string } {\r\n    const title = this.getColumnTitle(columnId).toLowerCase();\r\n    if (title.includes('finaliz') || title.includes('conclu') || title.includes('done')) {\r\n      return { className: 'status-done', color: '#4ade80', bg: 'rgba(34, 197, 94, 0.18)', dot: '#22c55e', border: 'rgba(34, 197, 94, 0.4)' };\r\n    }\r\n    if (title.includes('não finalizado') || title.includes('nao finalizado') || title.includes('andamento') || title.includes('doing') || title.includes('fazendo')) {\r\n      return { className: 'status-in-progress', color: '#60a5fa', bg: 'rgba(59, 130, 246, 0.18)', dot: '#3b82f6', border: 'rgba(59, 130, 246, 0.4)' };\r\n    }\r\n    if (title.includes('cancelad') || title.includes('bloquead')) {\r\n      return { className: 'status-canceled', color: '#f87171', bg: 'rgba(239, 68, 68, 0.18)', dot: '#ef4444', border: 'rgba(239, 68, 68, 0.4)' };\r\n    }\r\n    if (title.includes('espera') || title.includes('aguard') || title.includes('pendent') || title.includes('pausa')) {\r\n      return { className: 'status-waiting', color: '#fbbf24', bg: 'rgba(245, 158, 11, 0.18)', dot: '#f59e0b', border: 'rgba(245, 158, 11, 0.4)' };\r\n    }\r\n    if (title.includes('fazer') || title.includes('backlog') || title.includes('abert') || title.includes('todo')) {\r\n      return { className: 'status-todo', color: '#94a3b8', bg: 'rgba(148, 163, 184, 0.18)', dot: '#94a3b8', border: 'rgba(148, 163, 184, 0.4)' };\r\n    }\r\n    const color = this.getColumnColor(columnId);\r\n    return {\r\n      className: 'status-custom',\r\n      color: color || '#94a3b8',\r\n      bg: `color-mix(in srgb, ${color || '#94a3b8'} 18%, transparent)`,\r\n      dot: color || '#94a3b8',\r\n      border: `color-mix(in srgb, ${color || '#94a3b8'} 35%, transparent)`\r\n    };\r\n  }\r\n\r\n  changeTaskColumn(task: KanbanTask, newColumnId: string, event?: Event): void {\r\n    if (event) event.stopPropagation();\r\n    if (task.columnId === newColumnId) return;\r\n    const board = this.board();\r\n    if (!board) return;\r\n    const updatedTasks = board.tasks.map(item => item.id === task.id ? { ...item, columnId: newColumnId } : item);\r\n    this.service.activeBoard.set({ ...board, tasks: updatedTasks });\r\n    this.service.updateTask(task.id, { columnId: newColumnId });\r\n  }\r\n\r\n\r\n  printSingleTask(): void {\r\n    this.printingSingleTask.set(true);\r\n    document.body.classList.add('print-single-task-mode');\r\n    setTimeout(() => {\r\n      window.print();\r\n    }, 150);\r\n  }\r\n\r\n  columnTitle(columnId: string): string {\r\n    return this.board()?.columns.find(c => c.id === columnId)?.title || 'Etapa';\r\n  }\r\n\r\n  draftAssigneeNames(): string {\r\n    if (!this.draft.assigneeIds.length) return 'Não atribuído';\r\n    return this.draft.assigneeIds.map(id => this.assigneeName(id)).filter(Boolean).join(', ');\r\n  }\r\n\r\n  formatDueDate(dateStr?: string | null): string {\r\n    if (!dateStr) return '';\r\n    const clean = dateStr.split('T')[0];\r\n    const parts = clean.split('-');\r\n    if (parts.length === 3) return `${parts[2]}/${parts[1]}/${parts[0]}`;\r\n    return clean;\r\n  }\r\n\r\n  getTaskFreeLabels(task: KanbanTask): string[] {\r\n    if (!task || !task.labels) return [];\r\n    return task.labels.filter(l => !l.startsWith('cx_') && !/^(setor|macro|exec|ped|pedido|rede):/i.test(l));\r\n  }\r\n\r\n  draftLabels(): string[] {\r\n    if (this.labelText) {\r\n      return this.labelText.split(',').map(s => s.trim()).filter(Boolean);\r\n    }\r\n    return (this.draft.labels || []).filter(l => !l.startsWith('cx_') && !/^(setor|macro|exec|ped|pedido|rede):/i.test(l));\r\n  }\r\n\r\n  printBoard(): void {\r\n    this.printingSingleTask.set(false);\r\n    document.body.classList.remove('print-single-task-mode');\r\n    setTimeout(() => {\r\n      window.print();\r\n    }, 80);\r\n  }\r\n\r\n  printDateTime(): string {\r\n    const now = new Date();\r\n    const dateStr = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(now);\r\n    const timeStr = new Intl.DateTimeFormat('pt-BR', { hour: '2-digit', minute: '2-digit' }).format(now);\r\n    return `${dateStr}  ${timeStr}`;\r\n  }\r\n\r\n  formatFullDate(date: string | null): string {\r\n    if (!date) return '';\r\n    try {\r\n      const cleanDate = date.includes('T') ? date : `${date}T12:00:00`;\r\n      const d = new Date(cleanDate);\r\n      if (isNaN(d.getTime())) return '';\r\n      return new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(d);\r\n    } catch {\r\n      return '';\r\n    }\r\n  }\r\n\r\n  assigneeNames(task: KanbanTask): string {\r\n    if (!task.assigneeIds.length) return '';\r\n    return task.assigneeIds.map(id => this.assigneeName(id)).filter(Boolean).join(', ');\r\n  }\r\n\r\n  columnPrintColor(column: KanbanColumn, index: number): string {\r\n    if (column.color && column.color !== '#4f46e5' && column.color !== 'var(--brand-500)') return column.color;\r\n    const palette = ['#475569', '#f59e0b', '#8b5cf6', '#10b981', '#0ea5e9', '#ec4899', '#6366f1'];\r\n    return palette[index % palette.length];\r\n  }\r\n\r\n  columnPrintBg(column: KanbanColumn, index: number): string {\r\n    const bgPalette = ['#f8fafc', '#fffbeb', '#f5f3ff', '#ecfdf5', '#f0f9ff', '#fdf2f8', '#eef2ff'];\r\n    return bgPalette[index % bgPalette.length];\r\n  }\r\n\r\n  trackById(_: number, item: { id: string }): string { return item.id; }\r\n\r\n  private updateUrl(queryParams: Record<string, string | null>, replaceUrl = false): void {\r\n    const boardId = this.board()?.id || this.route.snapshot.paramMap.get('boardId');\r\n    void this.router.navigate(boardId ? ['/tarefas', boardId] : ['/tarefas'], {\r\n      replaceUrl,\r\n      queryParams,\r\n      queryParamsHandling: 'merge',\r\n    });\r\n  }\r\n\r\n  private emptyDraft(columnId: string, parentTaskId: string | null = null): KanbanTaskInput {\r\n    return { title: '', description: '', columnId, priority: 'medium', dueDate: null, labels: [], assigneeIds: [], checklist: [], parentTaskId };\r\n  }\r\n}\r\n","<div class=\"kanban-shell\" (click)=\"closeContextMenus()\">\r\n  <!-- ══════════════ CABEÇALHO DE IMPRESSÃO (PRINT ONLY) ══════════════ -->\r\n  <header class=\"kanban-print-header\" *ngIf=\"board() as currentBoard\" [hidden]=\"printingSingleTask()\">\r\n    <div class=\"print-header-brand\">\r\n      <div class=\"print-header-logo\">\r\n        <img src=\"sidebar.png\" alt=\"Logo\" class=\"print-logo-img\">\r\n      </div>\r\n      <div class=\"print-header-titles\">\r\n        <h1 class=\"print-title\">Quadro Kanban</h1>\r\n        <p class=\"print-subtitle\">Sistema de Gestão de Tarefas • {{ currentBoard.name || 'Gelelê' }}</p>\r\n      </div>\r\n    </div>\r\n    <div class=\"print-header-meta\">\r\n      <span>Impresso em {{ printDateTime() }}</span>\r\n    </div>\r\n  </header>\r\n\r\n  <header class=\"kanban-toolbar group-panel\" *ngIf=\"!isFullscreen()\">\r\n    <div class=\"board-heading\">\r\n      <span class=\"board-mark\"\r\n        [style.background]=\"board()?.color || 'var(--brand-500)'\"><mat-icon>view_kanban</mat-icon></span>\r\n      <div>\r\n        <div class=\"board-title-row\">\r\n          <h1 class=\"board-name\">{{ board()?.name || 'Kanban' }}</h1>\r\n          <button class=\"icon-btn\" (click)=\"renameBoard()\"\r\n            matTooltip=\"Renomear quadro\"><mat-icon>edit</mat-icon></button>\r\n        </div>\r\n        <span class=\"board-subtitle\">{{ board()?.scopeType === 'team' ? 'Time · ' + (board()?.teamName ||\r\n          currentTeam()?.name || '') : 'Espaço pessoal' }} · {{ totalActive() }} tarefas · {{ completedCount() }}\r\n          concluídas</span>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"toolbar-actions\">\r\n      <!-- <button class=\"secondary-btn expand-pill-btn size-36 fullscreen-btn\" [class.active]=\"isFullscreen()\" (click)=\"toggleFullscreen()\" [matTooltip]=\"isFullscreen() ? 'Restaurar layout (exibir cabeçalho e menu lateral)' : 'Modo expandido (ocultar cabeçalho e menu lateral)'\">\r\n        <mat-icon>{{ isFullscreen() ? 'unfold_less' : 'aspect_ratio' }}</mat-icon>\r\n        <span class=\"pill-label\">{{ isFullscreen() ? 'Restaurar layout' : 'Tela cheia' }}</span>\r\n      </button> -->\r\n      <button class=\"secondary-btn expand-pill-btn size-36 print-btn-action\" (click)=\"printBoard()\"\r\n        matTooltip=\"Imprimir quadro Kanban\">\r\n        <mat-icon>print</mat-icon>\r\n        <span class=\"pill-label\">Imprimir</span>\r\n      </button>\r\n      <button class=\"secondary-btn expand-pill-btn size-36\" (click)=\"openTeamManager()\" matTooltip=\"Gerenciar times e membros\">\r\n        <mat-icon>groups</mat-icon>\r\n        <span class=\"pill-label\">Times</span>\r\n      </button>\r\n      <button class=\"primary-btn expand-pill-btn size-36 primary-pill\" (click)=\"openCreate()\" matTooltip=\"Nova tarefa\">\r\n        <mat-icon>add</mat-icon>\r\n        <span class=\"pill-label\">Nova tarefa</span>\r\n      </button>\r\n    </div>\r\n\r\n    <form class=\"quick-create\" *ngIf=\"addingBoard()\" (ngSubmit)=\"saveBoard()\">\r\n      <input [(ngModel)]=\"newBoardName\" name=\"boardName\" placeholder=\"Nome do novo time\" maxlength=\"80\" autofocus>\r\n      <button type=\"submit\" class=\"primary-btn\">Criar</button>\r\n      <button type=\"button\" class=\"icon-btn\" (click)=\"addingBoard.set(false)\"><mat-icon>close</mat-icon></button>\r\n    </form>\r\n  </header>\r\n\r\n  <nav class=\"workspace-tabs group-panel\" *ngIf=\"!isFullscreen()\" aria-label=\"Kanbans disponíveis\">\r\n    <div class=\"tabs-list-wrap\">\r\n      <button *ngIf=\"personalBoardId() as personalId\" [class.active]=\"board()?.id === personalId\"\r\n        (click)=\"switchBoard(personalId)\">\r\n        <mat-icon>person</mat-icon><span>Meu Kanban</span>\r\n      </button>\r\n      <button *ngFor=\"let team of teams()\" [class.active]=\"board()?.teamId === team.id\"\r\n        (click)=\"switchBoard(team.boardId)\" (contextmenu)=\"openTeamContextMenu($event, team)\">\r\n        <span class=\"team-dot\" [style.background]=\"team.color\"></span><span>{{ team.name }}</span><small>{{\r\n          team.memberCount }}</small>\r\n      </button>\r\n      <button class=\"add-team-tab expand-pill-btn size-32\" (click)=\"creatingTeam.set(true); teamModalOpen.set(true)\"\r\n        matTooltip=\"Adicionar novo time\">\r\n        <mat-icon>group_add</mat-icon>\r\n        <span class=\"pill-label\">Novo time</span>\r\n      </button>\r\n    </div>\r\n\r\n    <!-- Botão no canto direito das abas para alternar modo expandido sem F11 -->\r\n    <!-- <button type=\"button\" class=\"expand-mode-btn expand-pill-btn size-32\" [class.active]=\"isFullscreen()\" (click)=\"toggleFullscreen()\" [matTooltip]=\"isFullscreen() ? 'Restaurar layout (exibir cabeçalho e menu lateral)' : 'Modo expandido (ocultar cabeçalho e menu lateral)'\">\r\n      <mat-icon>{{ isFullscreen() ? 'unfold_less' : 'aspect_ratio' }}</mat-icon>\r\n      <span class=\"pill-label\">{{ isFullscreen() ? 'Restaurar layout' : 'Tela cheia' }}</span>\r\n    </button> -->\r\n  </nav>\r\n\r\n  <nav class=\"tree-breadcrumb\" *ngIf=\"parentStack().length\" aria-label=\"Navegação de subtarefas\">\r\n    <button (click)=\"navigateTree(-1)\"><mat-icon>home</mat-icon>{{ board()?.name }}</button>\r\n    <ng-container *ngFor=\"let parent of parentStack(); let level = index\">\r\n      <mat-icon>chevron_right</mat-icon><button [class.current]=\"level === parentStack().length - 1\"\r\n        (click)=\"navigateTree(level)\">{{ parent.title }}</button>\r\n    </ng-container>\r\n  </nav>\r\n\r\n  <section class=\"kanban-filters group-panel\">\r\n    <!-- ═════════ 1. VISUALIZAÇÕES (Segmented Control + Ordenar / Colunas) ═════════ -->\r\n    <div class=\"filters-views-cluster\">\r\n      <div class=\"notion-tabs-nav\" role=\"tablist\" aria-label=\"Visualizações do quadro\">\r\n        <button type=\"button\" class=\"notion-nav-tab\" [class.active]=\"activeTab() === 'month_tasks'\"\r\n          (click)=\"setActiveTab('month_tasks')\" matTooltip=\"Tarefas do mês\">\r\n          <mat-icon>table_chart</mat-icon>\r\n          <span>Mês</span>\r\n        </button>\r\n        <button type=\"button\" class=\"notion-nav-tab\" [class.active]=\"activeTab() === 'month_completed'\"\r\n          (click)=\"setActiveTab('month_completed')\" matTooltip=\"Atividades concluídas no mês\">\r\n          <mat-icon>done_all</mat-icon>\r\n          <span>Concluídas</span>\r\n        </button>\r\n        <button type=\"button\" class=\"notion-nav-tab\" [class.active]=\"activeTab() === 'week_tasks'\"\r\n          (click)=\"setActiveTab('week_tasks')\" matTooltip=\"Tarefas da semana\">\r\n          <mat-icon>date_range</mat-icon>\r\n          <span>Semana</span>\r\n        </button>\r\n        <button type=\"button\" class=\"notion-nav-tab\" [class.active]=\"activeTab() === 'kanban'\"\r\n          (click)=\"setActiveTab('kanban')\" matTooltip=\"Quadro Kanban\">\r\n          <mat-icon>view_kanban</mat-icon>\r\n          <span>Kanban</span>\r\n        </button>\r\n      </div>\r\n\r\n      <!-- Dropdown de Ordenação (apenas em visualização de tabela) -->\r\n      <div class=\"notion-sort-wrapper\" *ngIf=\"activeTab() !== 'kanban'\">\r\n        <button type=\"button\" class=\"action-ghost-btn\" (click)=\"toggleSortMenu($event)\"\r\n          [class.active]=\"sortOption() !== 'default'\"\r\n          matTooltip=\"Ordenar tarefas\">\r\n          <mat-icon>swap_vert</mat-icon>\r\n          <span>{{ currentSortLabel() }}</span>\r\n        </button>\r\n        <div class=\"notion-sort-menu\" *ngIf=\"showSortMenu()\" (click)=\"$event.stopPropagation()\">\r\n          <button type=\"button\" [class.active]=\"sortOption() === 'default'\" (click)=\"toggleSort('default')\">\r\n            <mat-icon>format_line_spacing</mat-icon><span>Padrão (Posição)</span>\r\n          </button>\r\n          <button type=\"button\" [class.active]=\"sortOption() === 'dueDate'\" (click)=\"toggleSort('dueDate')\">\r\n            <mat-icon>event</mat-icon><span>Prazo</span>\r\n          </button>\r\n          <button type=\"button\" [class.active]=\"sortOption() === 'priority'\" (click)=\"toggleSort('priority')\">\r\n            <mat-icon>flag</mat-icon><span>Prioridade</span>\r\n          </button>\r\n          <button type=\"button\" [class.active]=\"sortOption() === 'title'\" (click)=\"toggleSort('title')\">\r\n            <mat-icon>sort_by_alpha</mat-icon><span>Assunto (Título)</span>\r\n          </button>\r\n          <button type=\"button\" [class.active]=\"sortOption() === 'status'\" (click)=\"toggleSort('status')\">\r\n            <mat-icon>donut_large</mat-icon><span>Status (Coluna)</span>\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Dropdown de Colunas (apenas em visualização de tabela) -->\r\n      <div class=\"notion-columns-wrapper\" *ngIf=\"activeTab() !== 'kanban'\">\r\n        <button type=\"button\" class=\"action-ghost-btn\" (click)=\"toggleColumnManager($event)\"\r\n          [class.active]=\"showColumnManager()\"\r\n          matTooltip=\"Personalizar colunas visíveis\">\r\n          <mat-icon>view_column</mat-icon>\r\n          <span>Colunas</span>\r\n        </button>\r\n        <div class=\"notion-columns-menu\" *ngIf=\"showColumnManager()\" (click)=\"$event.stopPropagation()\">\r\n          <div class=\"notion-columns-menu-header\">\r\n            <span>Colunas da Tabela</span>\r\n            <div class=\"col-actions-quick\">\r\n              <button type=\"button\" class=\"quick-btn\" (click)=\"setAllColumnsVisibility(true, $event)\">Todas</button>\r\n              <button type=\"button\" class=\"quick-btn\" (click)=\"setAllColumnsVisibility(false, $event)\">Mínimo</button>\r\n            </div>\r\n          </div>\r\n          <div class=\"notion-columns-list\">\r\n            <div *ngFor=\"let col of tableColumns()\" class=\"notion-column-item-row\" [class.is-custom]=\"isCustomColumn(col)\">\r\n              <label class=\"notion-column-toggle-item\" [class.checked]=\"col.visible\">\r\n                <input type=\"checkbox\" [checked]=\"col.visible\" (change)=\"toggleColumnVisibility(col.id, $event)\"\r\n                  [disabled]=\"col.id === 'subject' && col.visible && visibleColumnsCount() <= 1\">\r\n                <mat-icon class=\"col-item-icon\">{{ col.icon }}</mat-icon>\r\n                <span class=\"col-item-name\">{{ col.label }}</span>\r\n                <span *ngIf=\"isCustomColumn(col)\" class=\"custom-badge-tag\">Personalizada</span>\r\n              </label>\r\n              <button *ngIf=\"isCustomColumn(col)\" type=\"button\" class=\"btn-delete-custom-col\"\r\n                (click)=\"removeCustomColumn(col.id, $event)\"\r\n                matTooltip=\"Excluir coluna personalizada\">\r\n                <mat-icon>delete_outline</mat-icon>\r\n              </button>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Adicionar Nova Coluna Personalizada -->\r\n          <div class=\"notion-add-column-section\">\r\n            <div class=\"add-col-toggle-row\" *ngIf=\"!showAddColumnPopover()\">\r\n              <button type=\"button\" class=\"btn-open-add-col\" (click)=\"showAddColumnPopover.set(true)\">\r\n                <mat-icon>add</mat-icon>\r\n                <span>Nova coluna personalizada</span>\r\n              </button>\r\n            </div>\r\n            <div class=\"add-col-popover-form\" *ngIf=\"showAddColumnPopover()\">\r\n              <div class=\"add-col-form-title\">\r\n                <span>Nova Coluna</span>\r\n                <button type=\"button\" (click)=\"showAddColumnPopover.set(false)\"><mat-icon>close</mat-icon></button>\r\n              </div>\r\n              <input type=\"text\" [(ngModel)]=\"newCustomColumnLabel\" placeholder=\"Nome da coluna...\" class=\"add-col-input\" autofocus />\r\n              <select [(ngModel)]=\"newCustomColumnType\" class=\"add-col-select\">\r\n                <option value=\"text\">Texto</option>\r\n                <option value=\"date\">Data</option>\r\n                <option value=\"number\">Número</option>\r\n                <option value=\"select\">Lista de Seleção</option>\r\n                <option value=\"checkbox\">Caixa de Seleção (Sim/Não)</option>\r\n              </select>\r\n              <input *ngIf=\"newCustomColumnType === 'select'\" type=\"text\" [(ngModel)]=\"newCustomColumnOptions\" placeholder=\"Opções: Opção 1, Opção 2...\" class=\"add-col-input\" />\r\n              <button type=\"button\" class=\"btn-save-new-col\" (click)=\"addCustomColumn()\" [disabled]=\"!newCustomColumnLabel.trim()\">\r\n                <mat-icon>check</mat-icon> Adicionar Coluna\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- ═════════ 2. BUSCA DE TAREFAS (Completa a linha) ═════════ -->\r\n    <div class=\"search-box\">\r\n      <mat-icon class=\"search-icon\">search</mat-icon>\r\n      <input [ngModel]=\"search()\" (ngModelChange)=\"setSearch($event)\" placeholder=\"Buscar tarefas...\" />\r\n      <button *ngIf=\"search()\" type=\"button\" class=\"search-clear-btn\" (click)=\"setSearch('')\" matTooltip=\"Limpar busca\">\r\n        <mat-icon>close</mat-icon>\r\n      </button>\r\n    </div>\r\n\r\n    <!-- ═════════ 3. FILTROS & AÇÕES COLADOS À DIREITA ═════════ -->\r\n    <div class=\"filters-actions-cluster\">\r\n      <!-- Botão Dropdown \"Filtros\" colado à direita -->\r\n      <div class=\"filter-dropdown-wrapper\">\r\n        <button type=\"button\" class=\"action-ghost-btn filter-pill-btn\" [class.active]=\"hasActiveFilters()\"\r\n          (click)=\"toggleFilterMenu($event)\" matTooltip=\"Filtrar por prioridade e responsável\">\r\n          <mat-icon>tune</mat-icon>\r\n          <span>Filtros</span>\r\n          <span *ngIf=\"hasActiveFilters()\" class=\"filter-count-badge\">{{ activeFilterCount() }}</span>\r\n        </button>\r\n\r\n        <div class=\"notion-filter-popover\" *ngIf=\"showFilterMenu()\" (click)=\"$event.stopPropagation()\">\r\n          <div class=\"popover-header\">\r\n            <div class=\"header-title\">\r\n              <mat-icon>tune</mat-icon>\r\n              <span>Filtros</span>\r\n            </div>\r\n            <button *ngIf=\"hasActiveFilters()\" type=\"button\" class=\"clear-filters-link\" (click)=\"clearFilters($event)\">\r\n              Limpar filtros\r\n            </button>\r\n          </div>\r\n\r\n          <div class=\"popover-section\">\r\n            <label class=\"popover-label\">Prioridade</label>\r\n            <div class=\"priority-chips-row\">\r\n              <button type=\"button\" class=\"chip-filter-btn\" [class.active]=\"priorityFilter() === 'all'\" (click)=\"setPriorityFilter('all')\">\r\n                Todas\r\n              </button>\r\n              <button type=\"button\" class=\"chip-filter-btn urgent\" [class.active]=\"priorityFilter() === 'urgent'\" (click)=\"setPriorityFilter('urgent')\">\r\n                <span class=\"p-dot\"></span> Urgente\r\n              </button>\r\n              <button type=\"button\" class=\"chip-filter-btn high\" [class.active]=\"priorityFilter() === 'high'\" (click)=\"setPriorityFilter('high')\">\r\n                <span class=\"p-dot\"></span> Alta\r\n              </button>\r\n              <button type=\"button\" class=\"chip-filter-btn medium\" [class.active]=\"priorityFilter() === 'medium'\" (click)=\"setPriorityFilter('medium')\">\r\n                <span class=\"p-dot\"></span> Média\r\n              </button>\r\n              <button type=\"button\" class=\"chip-filter-btn low\" [class.active]=\"priorityFilter() === 'low'\" (click)=\"setPriorityFilter('low')\">\r\n                <span class=\"p-dot\"></span> Baixa\r\n              </button>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"popover-section\">\r\n            <label class=\"popover-label\">Responsável</label>\r\n            <select class=\"popover-select\" [ngModel]=\"assigneeFilter()\" (ngModelChange)=\"setAssigneeFilter($event)\">\r\n              <option value=\"all\">Todos os responsáveis</option>\r\n              <option [value]=\"auth.currentUser()?.id\">{{ auth.currentUser()?.name || 'Eu' }} (Você)</option>\r\n              <option *ngFor=\"let user of assignableUsers()\" [value]=\"user.id\">{{ user.name }}</option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Indicador de Tarefas Atrasadas -->\r\n      <div class=\"filter-stat overdue\" *ngIf=\"overdueCount()\">\r\n        <mat-icon>schedule</mat-icon>\r\n        <span>{{ overdueCount() }} atrasada{{ overdueCount() > 1 ? 's' : '' }}</span>\r\n      </div>\r\n\r\n      <!-- Badge de Arquivadas Ativas se estiver navegando no arquivo -->\r\n      <button *ngIf=\"showArchived()\" type=\"button\" class=\"active-archive-indicator\" (click)=\"toggleArchived()\"\r\n        matTooltip=\"Visualizando tarefas arquivadas. Clique para voltar ao quadro ativo.\">\r\n        <mat-icon>inventory_2</mat-icon>\r\n        <span>Arquivadas</span>\r\n        <mat-icon class=\"icon-close\">close</mat-icon>\r\n      </button>\r\n\r\n      <!-- Botão Modo Tela Cheia NA BARRA (fora dos 3 pontos) -->\r\n      <button type=\"button\" class=\"action-ghost-btn icon-only-btn fullscreen-bar-btn\" (click)=\"toggleFullscreen()\"\r\n        [class.active]=\"isFullscreen()\"\r\n        [matTooltip]=\"isFullscreen() ? 'Restaurar layout (exibir cabeçalho e menu lateral)' : 'Tela cheia (modo foco)'\">\r\n        <mat-icon>{{ isFullscreen() ? 'unfold_less' : 'aspect_ratio' }}</mat-icon>\r\n      </button>\r\n\r\n      <!-- Dropdown \"Mais Opções\" (Arquivadas, Lixeira) -->\r\n      <div class=\"more-actions-wrapper\">\r\n        <button type=\"button\" class=\"action-ghost-btn icon-only-btn\" (click)=\"toggleMoreMenu($event)\"\r\n          [class.active]=\"showMoreMenu() || showArchived()\"\r\n          matTooltip=\"Mais opções do quadro\">\r\n          <mat-icon>more_horiz</mat-icon>\r\n        </button>\r\n\r\n        <div class=\"notion-more-menu\" *ngIf=\"showMoreMenu()\" (click)=\"$event.stopPropagation()\">\r\n          <button type=\"button\" class=\"more-menu-item\" [class.active]=\"showArchived()\" (click)=\"toggleArchived(); showMoreMenu.set(false)\">\r\n            <mat-icon>{{ showArchived() ? 'unarchive' : 'archive' }}</mat-icon>\r\n            <span>{{ showArchived() ? 'Voltar ao quadro ativo' : 'Tarefas arquivadas' }}</span>\r\n          </button>\r\n\r\n          <button type=\"button\" class=\"more-menu-item\" (click)=\"openTrash(); showMoreMenu.set(false)\">\r\n            <mat-icon>delete_outline</mat-icon>\r\n            <span>Lixeira de tarefas</span>\r\n            <span *ngIf=\"board()?.trashCount\" class=\"menu-badge\">{{ board()?.trashCount }}</span>\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </section>\r\n\r\n  <div class=\"loading-state\" *ngIf=\"loading()\"><span class=\"spinner\"></span>Carregando quadro...</div>\r\n  <div class=\"error-banner\" *ngIf=\"service.error()\"><mat-icon>error_outline</mat-icon>{{ service.error() }}<button\r\n      (click)=\"service.error.set('')\"><mat-icon>close</mat-icon></button></div>\r\n\r\n  <main class=\"board-canvas\" *ngIf=\"board() as currentBoard\" [hidden]=\"printingSingleTask()\"\r\n    [class.is-list-view]=\"activeTab() !== 'kanban'\">\r\n    <!-- ══════════════ VISÃO KANBAN ══════════════ -->\r\n    <ng-container *ngIf=\"activeTab() === 'kanban'\">\r\n      <section class=\"kanban-column\"\r\n        *ngFor=\"let column of currentBoard.columns; let colIndex = index; trackBy: trackById\"\r\n        [style.width.px]=\"getKanbanColumnWidth(column.id)\"\r\n        [style.flex-basis.px]=\"getKanbanColumnWidth(column.id)\"\r\n        [style.min-width.px]=\"getKanbanColumnWidth(column.id)\"\r\n        [style.max-width.px]=\"getKanbanColumnWidth(column.id)\"\r\n        [style.--col-print-color]=\"columnPrintColor(column, colIndex)\"\r\n        [style.--col-print-bg]=\"columnPrintBg(column, colIndex)\">\r\n        <div class=\"kanban-col-resizer\"\r\n          (mousedown)=\"onKanbanColumnResizeStart($event, column.id)\"\r\n          (dblclick)=\"resetKanbanColumnWidth(column.id, $event)\"\r\n          title=\"Arraste para redimensionar (duplo clique para restaurar)\"></div>\r\n        <header class=\"column-header\">\r\n          <span class=\"column-accent\" [style.background]=\"column.color\"></span>\r\n          <span class=\"column-title\">{{ column.title }}</span>\r\n          <span class=\"column-count\">{{ tasksFor(column.id).length }}</span>\r\n          <span class=\"column-auto-archive-badge\" *ngIf=\"column.autoArchiveDelay && column.autoArchiveDelay !== 'never'\"\r\n            [matTooltip]=\"'Arquivamento automático: ' + autoArchiveLabel(column.autoArchiveDelay)\">\r\n            <mat-icon>schedule</mat-icon>\r\n          </span>\r\n          <button class=\"column-action\" (click)=\"moveColumn(column, -1)\"\r\n            matTooltip=\"Mover para esquerda\"><mat-icon>chevron_left</mat-icon></button>\r\n          <button class=\"column-action\" (click)=\"moveColumn(column, 1)\"\r\n            matTooltip=\"Mover para direita\"><mat-icon>chevron_right</mat-icon></button>\r\n          <div class=\"column-options-wrap\">\r\n            <button class=\"column-action\" (click)=\"toggleColumnMenu(column.id, $event)\" matTooltip=\"Opções da lista\"\r\n              [attr.aria-expanded]=\"columnMenuId() === column.id\"><mat-icon>more_horiz</mat-icon></button>\r\n            <div class=\"column-options-menu\" *ngIf=\"columnMenuId() === column.id\">\r\n              <button (click)=\"openColumnDialog(column, 'rename')\"><mat-icon>palette</mat-icon><span>Editar lista /\r\n                  cor</span></button>\r\n              <button class=\"danger\"\r\n                (click)=\"openColumnDialog(column, 'delete')\"><mat-icon>delete_outline</mat-icon><span>Excluir\r\n                  lista</span></button>\r\n            </div>\r\n          </div>\r\n        </header>\r\n\r\n        <div class=\"task-list\" cdkDropList [id]=\"column.id\" [cdkDropListData]=\"tasksFor(column.id)\"\r\n          [cdkDropListConnectedTo]=\"dropListIds\" [cdkDropListAutoScrollStep]=\"18\"\r\n          (cdkDropListEntered)=\"enterColumn(column.id)\" (cdkDropListExited)=\"leaveColumn(column.id)\"\r\n          (cdkDropListDropped)=\"dropTask($event, column)\">\r\n          <article class=\"task-card\" *ngFor=\"let task of tasksFor(column.id); trackBy: trackById\" cdkDrag\r\n            [cdkDragData]=\"task\" [cdkDragDisabled]=\"showArchived()\" [attr.data-priority]=\"task.priority\" tabindex=\"0\"\r\n            (keydown.enter)=\"openView(task)\" (click)=\"openView(task)\" (contextmenu)=\"openTaskContextMenu($event, task)\">\r\n            <div class=\"drag-placeholder\" *cdkDragPlaceholder></div>\r\n            <div class=\"card-labels\" *ngIf=\"getTaskFreeLabels(task).length\"><span *ngFor=\"let label of getTaskFreeLabels(task) | slice:0:4\">{{\r\n                label }}</span></div>\r\n            <div class=\"card-title-row\">\r\n              <h3>{{ task.title }}</h3><button class=\"child-board-btn\" (click)=\"openChildBoard(task, $event)\"\r\n                [matTooltip]=\"branchHasContent(task) ? childCount(task) + ' subtarefas ativas' : 'Criar ramificação de subtarefas'\"><mat-icon>account_tree</mat-icon><small\r\n                  *ngIf=\"childCount(task)\">{{ childCount(task) }}</small></button><mat-icon\r\n                class=\"edit-hint\">edit</mat-icon>\r\n            </div>\r\n            <app-markdown-text class=\"card-description\" *ngIf=\"task.description\" [text]=\"task.description\" />\r\n            <div class=\"check-progress\" *ngIf=\"task.checklist.length\"><span\r\n                [style.width.%]=\"checklistProgress(task)\"></span></div>\r\n            <button class=\"card-checklist-toggle\" *ngIf=\"task.checklist.length\" type=\"button\"\r\n              (mousedown)=\"$event.stopPropagation()\" (click)=\"toggleCardChecklist(task.id, $event)\"\r\n              [attr.aria-expanded]=\"isChecklistExpanded(task.id)\">\r\n              <mat-icon>{{ isChecklistExpanded(task.id) ? 'keyboard_arrow_up' : 'keyboard_arrow_down' }}</mat-icon>\r\n              <span>Checklist</span>\r\n              <strong>{{ task.checklist.filter(item => item.done).length }}/{{ task.checklist.length }}</strong>\r\n            </button>\r\n            <div class=\"card-checklist-items\" *ngIf=\"task.checklist.length && isChecklistExpanded(task.id)\"\r\n              (mousedown)=\"$event.stopPropagation()\" (click)=\"$event.stopPropagation()\">\r\n              <ng-container *ngFor=\"let item of task.checklist; let itemIdx = index; trackBy: trackById\">\r\n                <div class=\"card-checklist-group-label\" *ngIf=\"item.groupTitle && (itemIdx === 0 || task.checklist[itemIdx - 1].groupTitle !== item.groupTitle)\">\r\n                  <mat-icon>folder_open</mat-icon>\r\n                  <span>{{ item.groupTitle }}</span>\r\n                </div>\r\n                <label [class.card-item-grouped]=\"!!item.groupTitle\">\r\n                  <input type=\"checkbox\" [checked]=\"item.done\" (change)=\"toggleCardChecklistItem(task, item.id, $event)\">\r\n                  <span [class.done]=\"item.done\">{{ item.text }}</span>\r\n                </label>\r\n              </ng-container>\r\n            </div>\r\n            <footer class=\"card-footer\">\r\n              <div class=\"card-badges\">\r\n                <span class=\"priority\" [class]=\"task.priority\">{{ task.priority === 'urgent' ? 'Urgente' : task.priority\r\n                  === 'high' ? 'Alta' : task.priority === 'low' ? 'Baixa' : 'Média' }}</span>\r\n                <span class=\"date-badge\" *ngIf=\"task.dueDate\" [class.overdue]=\"isOverdue(task)\"\r\n                  [class.soon]=\"isDueSoon(task)\"><mat-icon>schedule</mat-icon>{{ formatDate(task.dueDate) }}</span>\r\n              </div>\r\n              <div class=\"assignee-stack\" *ngIf=\"task.assigneeIds.length\"><img\r\n                  *ngFor=\"let assigneeId of task.assigneeIds | slice:0:3\" class=\"assignee-avatar\"\r\n                  [src]=\"assigneeAvatar(assigneeId)\" [alt]=\"assigneeName(assigneeId)\"\r\n                  [matTooltip]=\"assigneeName(assigneeId)\" (error)=\"$any($event.target).src = defaultAvatar\"><span\r\n                  *ngIf=\"task.assigneeIds.length > 3\">+{{ task.assigneeIds.length - 3 }}</span></div>\r\n            </footer>\r\n\r\n            <!-- ── Elementos exclusivos para impressão ── -->\r\n            <div class=\"print-card-content\">\r\n              <div class=\"print-card-title\">{{ task.title }}</div>\r\n              <div class=\"print-card-meta\">\r\n                <span class=\"print-priority-badge\" [attr.data-priority]=\"task.priority\">{{ task.priority === 'urgent' ?\r\n                  'Alta' : task.priority === 'high' ? 'Alta' : task.priority === 'low' ? 'Baixa' : 'Média' }}</span>\r\n                <span class=\"print-card-date\" *ngIf=\"task.dueDate\">{{ formatFullDate(task.dueDate) }}</span>\r\n              </div>\r\n              <div class=\"print-card-assignee\" *ngIf=\"task.assigneeIds.length\">\r\n                {{ assigneeNames(task) }}\r\n              </div>\r\n              <div class=\"print-card-labels\" *ngIf=\"getTaskFreeLabels(task).length\">\r\n                <span *ngFor=\"let label of getTaskFreeLabels(task)\" class=\"print-label-tag\">#{{ label.startsWith('#') ?\r\n                  label.substring(1) : label }}</span>\r\n              </div>\r\n              <div class=\"print-checklist\" *ngIf=\"task.checklist.length\">\r\n                <div class=\"print-checklist-item\" *ngFor=\"let item of task.checklist\">\r\n                  <span class=\"print-checklist-box\" [class.done]=\"item.done\">{{ item.done ? '☑' : '☐' }}</span>\r\n                  <span class=\"print-checklist-text\" [class.done]=\"item.done\">{{ item.text }}</span>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </article>\r\n          <div class=\"empty-column\" *ngIf=\"!tasksFor(column.id).length && dragOverColumnId() !== column.id\">\r\n            <mat-icon>inbox</mat-icon><span>{{ showArchived() ? 'Nenhuma arquivada' : 'Arraste uma tarefa para cá'\r\n              }}</span></div>\r\n          <div class=\"print-empty-column\" *ngIf=\"!tasksFor(column.id).length\">\r\n            <span>Nenhum item</span>\r\n          </div>\r\n        </div>\r\n        <button class=\"add-card-btn\" (click)=\"openCreate(column.id)\"\r\n          *ngIf=\"!showArchived()\"><mat-icon>add</mat-icon>Adicionar tarefa</button>\r\n      </section>\r\n\r\n      <section class=\"add-column-card\">\r\n        <button *ngIf=\"!addingColumn()\" (click)=\"addingColumn.set(true)\"\r\n          class=\"add-column-trigger-btn\"><mat-icon>add</mat-icon>Adicionar lista</button>\r\n        <form *ngIf=\"addingColumn()\" (ngSubmit)=\"saveColumn()\" class=\"add-column-form\">\r\n          <input [(ngModel)]=\"newColumnTitle\" name=\"columnTitle\" placeholder=\"Nome da lista\" maxlength=\"60\" autofocus>\r\n          <div class=\"column-color-picker-box\">\r\n            <span class=\"color-picker-label\">Cor da lista</span>\r\n            <div class=\"column-color-swatches\">\r\n              <button type=\"button\" *ngFor=\"let c of columnColors\" class=\"column-color-swatch\"\r\n                [style.background]=\"c.value\" [class.selected]=\"newColumnColor === c.value\" [matTooltip]=\"c.label\"\r\n                (click)=\"newColumnColor = c.value\">\r\n                <mat-icon *ngIf=\"newColumnColor === c.value\">check</mat-icon>\r\n              </button>\r\n            </div>\r\n          </div>\r\n          <div class=\"add-column-actions\">\r\n            <button class=\"primary-btn\" type=\"submit\" [disabled]=\"!newColumnTitle.trim()\">Adicionar</button>\r\n            <button class=\"icon-btn\" type=\"button\" (click)=\"addingColumn.set(false)\"><mat-icon>close</mat-icon></button>\r\n          </div>\r\n        </form>\r\n      </section>\r\n    </ng-container>\r\n\r\n    <!-- ══════════════ VISÃO DE TABELA NOTION (Tarefas do mês / Atividades concluídas / Tarefas da semana) ══════════════ -->\r\n    <section class=\"notion-list-view\" *ngIf=\"activeTab() !== 'kanban'\">\r\n      <div class=\"notion-table-container\">\r\n        <table class=\"notion-table\">\r\n          <thead>\r\n            <tr>\r\n              <!-- Assunto / Título -->\r\n              <th *ngIf=\"isColum