)\"\r\n                  (dblclick)=\"resetColumnWidth(col.id, $event)\"\r\n                  (click)=\"$event.stopPropagation()\"\r\n                  title=\"Arraste para redimensionar (duplo clique para restaurar)\"></div>\r\n              </th>\r\n\r\n              <!-- Botão de gerenciar colunas estilo Notion (+) -->\r\n              <th class=\"col-add-column\" (click)=\"toggleColumnManager($event)\" matTooltip=\"Adicionar / Ocultar colunas\">\r\n                <mat-icon>add</mat-icon>\r\n              </th>\r\n            </tr>\r\n          </thead>\r\n          <tbody>\r\n            <tr *ngFor=\"let task of sortedVisibleTasks(); trackBy: trackById\" class=\"notion-row\"\r\n              (click)=\"openView(task)\" (contextmenu)=\"openTaskContextMenu($event, task)\">\r\n\r\n              <!-- Assunto -->\r\n              <td *ngIf=\"isColumnVisible('subject')\" class=\"col-subject\"\r\n                [style.width.px]=\"getColumnWidth('subject')\"\r\n                [style.min-width.px]=\"getColumnWidth('subject')\"\r\n                [style.max-width.px]=\"getColumnWidth('subject')\"\r\n                (click)=\"$event.stopPropagation(); (inlineEditingCell()?.taskId !== task.id || inlineEditingCell()?.field !== 'title') ? startInlineEdit(task, 'title', $event) : null\">\r\n                <div class=\"subject-cell-content\">\r\n                  <ng-container *ngIf=\"inlineEditingCell()?.taskId === task.id && inlineEditingCell()?.field === 'title'; else titleStatic\">\r\n                    <input type=\"text\" class=\"inline-cell-input title-input\" [(ngModel)]=\"inlineEditValue\"\r\n                      (blur)=\"saveInlineEdit(task, 'title', $event)\"\r\n                      (keydown.enter)=\"saveInlineEdit(task, 'title', $event)\"\r\n                      (keydown.escape)=\"cancelInlineEdit($event)\" autofocus />\r\n                  </ng-container>\r\n                  <ng-template #titleStatic>\r\n                    <span class=\"task-title-text edi