-- Etiquetas -->\r\n              <td *ngIf=\"isColumnVisible('labels')\" class=\"col-labels\"\r\n                [style.width.px]=\"getColumnWidth('labels')\"\r\n                [style.min-width.px]=\"getColumnWidth('labels')\"\r\n                [style.max-width.px]=\"getColumnWidth('labels')\"\r\n                (click)=\"$event.stopPropagation(); (inlineEditingCell()?.taskId !== task.id || inlineEditingCell()?.field !== 'labels') ? startInlineEdit(task, 'labels', $event) : null\">\r\n                <div class=\"notion-labels-wrapper\">\r\n                  <ng-container *ngIf=\"inlineEditingCell()?.taskId === task.id && inlineEditingCell()?.field === 'labels'; else labelsStatic\">\r\n                    <input type=\"text\" class=\"inline-cell-input labels-input\" [(ngModel)]=\"inlineEditValue\"\r\n                      (blur)=\"saveInlineEdit(task, 'labels', $event)\"\r\n                      (keydown.enter)=\"saveInlineEdit(task, 'labels', $event)\"\r\n                      (keydown.escape)=\"cancelInlineEdit($event)\" autofocus placeholder=\"Separe por vírgula...\" />\r\n                  </ng-container>\r\n                  <ng-template #labelsStatic>\r\n                    <ng-container *ngIf=\"getTaskFreeLabels(task).length; else labelsEmpty\">\r\n                      <span *ngFor=\"let label of getTaskFreeLabels(task).slice(0, 3)\" class=\"notion-label-tag\">\r\n                        {{ label }}\r\n                      </span>\r\n                      <span *ngIf=\"getTaskFreeLabels(task).length > 3\" class=\"notion-label-more\">+{{ getTaskFreeLabels(task).length - 3 }}</span>\r\n                    </ng-container>\r\n                    <ng-template #labelsEmpty>\r\n                      <span class=\"notion-empty-cell notion-assignee-placeholder\">+ Etiqueta</span>\r\n                    </ng-template>\r\n                  </ng-template>\r\n                </div>\r\n              </td>\r\n\r\n              <!-- Células das Colunas Personalizadas -->\r\n              <td *ngFor=\"let col of activeCustomColumns()\" class=\"col-custom-cell\"\r\n                [style.width.px]=\"getColumnWidth(col.id)\"\r\n                [style.min-width.px]=\"getColumnWidth(col.id)\"\r\n                [style.max-width.px]=\"getColumnWidth(col.id)\"\r\n                [class.interactive-cell]=\"col.type === 'date' || col.type === 'select'\"\r\n                [class.interactive-check-cell]=\"col.type === 'checkbox'\"\r\n                (click)=\"$event.stopPropagation();\r\n                  col.type === 'checkbox' ? toggleCustomCheckbox(task, col, $event) :\r\n                  col.type === 'date' ? openDatePickerFromCell($event) :\r\n                  (col.type === 'text' || col.type === 'number') && (inlineEditingCell()?.taskId !== task.id || inlineEditingCell()?.field !== col.id) ? startInlineEdit(task, col.id, $event) : null\">\r\n\r\n                <!-- Texto ou Número com Inline Edit -->\r\n                <div *ngIf=\"col.type === 'text' || col.type === 'number'\" class=\"notion-custom-text-wrap\">\r\n                  <ng-container *ngIf=\"inlineEditingCell()?.taskId === task.id && inlineEditingCell()?.field === col.id; else customTextStatic\">\r\n                    <input [type]=\"col.type === 'number' ? 'number' : 'text'\" class=\"inline-cell-input\" [(ngModel)]=\"inlineEditValue\"\r\n                      (blur)=\"saveInlineEdit(task, col.id, $event)\"\r\n                      (keydown.enter)=\"saveInlineEdit(task, col.id, $event)\"\r\n                      (keydown.escape)=\"cancelInlineEdit($event)\" autofocus [placeholder]=\"col.label + '...'\" />\r\n                  </ng-container>\r\n                  <ng-template #customTextStatic>\r\n                    <span class=\"editable-field\" [title]=\"'Clique para editar ' + col.label\">\r\n                      {{ getCustomFieldValue(task, col) || '—' }}\r\n                    </span>\r\n                  </ng-template>\r\n                </div>\r\n\r\n                <!-- Data com Datepicker Overlay Cobrindo 100% da Célula -->\r\n                <ng-container *ngIf=\"col.type === 'date'\">\r\n                  <div class=\"notion-date-wrapper\" [title]=\"'Clique para alterar ' + col.label\">\r\n                    <span class=\"notion-date-text\" *ngIf=\"getCustomFieldValue(task, col)\">{{ formatFullDate(getCustomFieldValue(task, col)) }}</span>\r\n                    <span class=\"notion-empty-cell notion-assignee-placeholder\" *ngIf=\"!getCustomFieldValue(task, col)\">+ Data</span>\r\n                  </div>\r\n                  <input type=\"date\" class=\"cell-date-overlay\" [ngModel]=\"getCustomFieldValue(task, col)\"\r\n                    (change)=\"updateCustomField(task, col, $any($event.target).value, $event)\"\r\n                    [title]=\"'Clique para alterar ' + col.label\">\r\n                </ng-container>\r\n\r\n                <!-- Select Interativo com Overlay Cobrindo 100% da Célula -->\r\n                <ng-container *ngIf=\"col.type === 'select'\">\r\n                  <div class=\"notion-custom-select-wrap\" [title]=\"'Clique para alterar ' + col.label\">\r\n                    <span class=\"custom-select-val\">{{ getCustomFieldValue(task, col) || '— Vazio —' }}</span>\r\n                  </div>\r\n                  <select class=\"cell-select-overlay\" [ngModel]=\"getCustomFieldValue(task, col) || ''\"\r\n                    (change)=\"updateCustomField(task, col, $any($event.target).value, $event)\"\r\n                    [title]=\"'Clique para alterar ' + col.label\">\r\n                    <option value=\"\">— Vazio —</option>\r\n                    <option *ngFor=\"let opt of col.options\" [value]=\"opt\">{{ opt }}</option>\r\n                  </select>\r\n                </ng-container>\r\n\r\n                <!-- Checkbox Interativo -->\r\n                <div *ngIf=\"col.type === 'checkbox'\" class=\"notion-custom-check-wrap\" [title]=\"'Clique para alternar ' + col.label\">\r\n                  <input type=\"checkbox\" [checked]=\"getCustomFieldValue(task, col)\"\r\n                    (change)=\"updateCustomField(task, col, $any($event.target).checked, $event)\"\r\n                    (click)=\"$event.stopPropagation()\" />\r\n                </div>\r\n              </td>\r\n\r\n              <!-- Coluna de Ações rápidas / Espaçador -->\r\n              <td class=\"col-add-column-cell\" (click)=\"$event.stopPropagation()\">\r\n                <button type=\"button\" class=\"row-open-modal-btn\" (click)=\"openEdit(task)\" matTooltip=\"Abrir detalhes da tarefa\">\r\n                  <mat-icon>open_in_new</mat-icon>\r\n                </button>\r\n              </td>\r\n            </tr>\r\n\r\n            <!-- Tabela Vazia -->\r\n            <tr *ngIf=\"!sortedVisibleTasks().length\">\r\n              <td [attr.colspan]=\"visibleColumnsCount() + 1\" class=\"notion-empty-row\">\r\n                <mat-icon>inbox</mat-icon>\r\n                <span>Nenhuma tarefa encontrada para esta visualização.</span>\r\n              </td>\r\n            </tr>\r\n          </tbody>\r\n        </table>\r\n\r\n        <!-- Linha rápida para adicionar tarefa estilo Notion -->\r\n        <div class=\"notion-add-task-row\" (click)=\"openCreate()\">\r\n          <mat-icon>add</mat-icon>\r\n          <span>Nova tarefa</span>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  </main>\r\n\r\n  <!-- ══════════════ IMPRESSÃO INDIVIDUAL: SOMENTE O CARD (MODO RETRATO) ══════════════ -->\r\n  <div class=\"single-card-print-container\" *ngIf=\"printingSingleTask()\">\r\n    <div class=\"single-card-print-box\" [attr.data-priority]=\"draft.priority\">\r\n      <!-- Top header do card com etapa e prioridade -->\r\n      <div class=\"single-card-header-bar\">\r\n        <span class=\"single-card-stage\">{{ columnTitle(draft.columnId) }}</span>\r\n        <div class=\"single-card-meta-right\">\r\n          <span class=\"single-card-priority\" [attr.data-priority]=\"draft.priority\">\r\n            Prioridade {{ draft.priority === 'urgent' ? 'Urgente' : draft.priority === 'high' ? 'Alta' : draft.priority\r\n            === 'low' ? 'Baixa' : 'Média' }}\r\n          </span>\r\n          <span class=\"single-card-due\" *ngIf=\"draft.dueDate\">\r\n            Prazo: {{ formatFullDate(draft.dueDate) }}\r\n          </span>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Título principal do card -->\r\n      <h1 class=\"single-card-title\">{{ draft.title || 'Sem título' }}</h1>\r\n\r\n      <!-- Responsáveis e etiquetas -->\r\n      <div class=\"single-card-sub-info\">\r\n        <div class=\"single-card-assignees\" *ngIf=\"draft.assigneeIds.length\">\r\n          <span class=\"info-tag\">Responsável:</span>\r\n          <strong>{{ draftAssigneeNames() }}</strong>\r\n        </div>\r\n        <div class=\"single-card-labels\" *ngIf=\"draftLabels().length\">\r\n          <span *ngFor=\"let label of draftLabels()\" class=\"single-label-pill\">#{{ label.startsWith('#') ?\r\n            label.substring(1) : label }}</span>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Descrição se houver -->\r\n      <div class=\"single-card-description\" *ngIf=\"draft.description\">\r\n        <div class=\"section-label\">Descrição:</div>\r\n        <div class=\"desc-content\">\r\n          <app-markdown-text [text]=\"draft.description\" />\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Checklist se houver -->\r\n      <div class=\"single-card-checklist\" *ngIf=\"draft.checklist.length\">\r\n        <div class=\"section-label\">Checklist ({{ draft.checklist.filter(item => item.done).length }}/{{\r\n          draft.checklist.length }}):</div>\r\n        <!-- Itens sem grupo -->\r\n        <ng-container *ngIf=\"ungroupedChecklistItems.length\">\r\n          <div class=\"single-check-item\" *ngFor=\"let item of ungroupedChecklistItems\">\r\n            <span class=\"single-check-box\" [class.done]=\"item.done\">{{ item.done ? '☑' : '☐' }}</span>\r\n            <span class=\"single-check-text\" [class.done]=\"item.done\">{{ item.text }}</span>\r\n          </div>\r\n        </ng-container>\r\n        <!-- Grupos -->\r\n        <ng-container *ngFor=\"let group of checklistGroups\">\r\n          <div class=\"single-check-group-title\">{{ group }}</div>\r\n          <div class=\"single-check-item single-check-item-grouped\" *ngFor=\"let item of checklistItemsForGroup(group)\">\r\n            <span class=\"single-check-box\" [class.done]=\"item.done\">{{ item.done ? '☑' : '☐' }}</span>\r\n            <span class=\"single-check-text\" [class.done]=\"item.done\">{{ item.text }}</span>\r\n          </div>\r\n        </ng-container>\r\n      </div>\r\n\r\n      <!-- Anexos se houver -->\r\n      <div class=\"single-card-attachments\" *ngIf=\"taskAttachments.length\">\r\n        <div class=\"section-label\">Anexos:</div>\r\n        <div class=\"single-att-item\" *ngFor=\"let att of taskAttachments\">\r\n          <span>📎 {{ att.fileName }} ({{ att.byteSize / 1048576 | number:'1.0-2' }} MB)</span>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Rodapé do card -->\r\n      <div class=\"single-card-footer\">\r\n        <span>{{ board()?.name || 'Quadro Kanban' }} · Impresso em {{ printDateTime() }}</span>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <!-- ══════════════ RODAPÉ DE IMPRESSÃO (PRINT ONLY) ══════════════ -->\r\n  <footer class=\"kanban-print-footer\" [hidden]=\"printingSingleTask()\">\r\n    <span class=\"print-footer-left\">{{ board()?.name || 'Gelelê' }} • Kanban System • Layout otimizado para\r\n      impressão</span>\r\n    <span class=\"print-footer-right\">Página 1 de 1</span>\r\n  </footer>\r\n\r\n</div>\r\n\r\n<div class=\"team-context-menu\" *ngIf=\"teamContextMenu() as menu\" [style.left.px]=\"menu.x\" [style.top.px]=\"menu.y\"\r\n  (click)=\"$event.stopPropagation()\">\r\n  <button type=\"button\" (click)=\"requestTeamDeletion(menu.team)\"><mat-icon>delete_outline</mat-icon>Excluir\r\n    time</button>\r\n</div>\r\n\r\n<div class=\"task-context-menu\" *ngIf=\"taskContextMenu() as menu\" [style.left.px]=\"menu.x\" [style.top.px]=\"menu.y\"\r\n  (click)=\"$event.stopPropagation()\">\r\n  <button type=\"button\" (click)=\"viewTaskFromContext(menu.task)\"><mat-icon>visibility</mat-icon>Visualizar tarefa</button>\r\n  <button type=\"button\" (click)=\"editTaskFromContext(menu.task)\"><mat-icon>edit</mat-icon>Editar tarefa</button>\r\n  <button type=\"button\" (click)=\"openTaskBranchFromContext(menu.task)\"><mat-icon>account_tree</mat-icon>{{\r\n    branchHasContent(menu.task) ? 'Abrir subtarefas' : 'Criar subtarefas' }}</button>\r\n  <button type=\"button\" (click)=\"toggleTaskArchiveFromContext(menu.task)\"><mat-icon>{{ menu.task.archived ? 'unarchive'\r\n      : 'archive' }}</mat-icon>{{ menu.task.archived ? 'Restaurar tarefa' : 'Arquivar tarefa' }}</button>\r\n  <button type=\"button\" class=\"danger\" *ngIf=\"canDeleteTasks()\"\r\n    (click)=\"deleteTaskFromContext(menu.task)\"><mat-icon>delete_outline</mat-icon>Mover para lixeira</button>\r\n</div>\r\n\r\n<div class=\"column-dialog-backdrop\" *ngIf=\"taskDeleteTarget() as task\" (mousedown)=\"cancelTaskDeletion()\">\r\n  <section class=\"column-dialog team-delete-dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"task-delete-title\"\r\n    (mousedown)=\"$event.stopPropagation()\">\r\n    <header>\r\n      <span class=\"column-dialog-icon delete\"><mat-icon>delete_outline</mat-icon></span>\r\n      <div>\r\n        <h2 id=\"task-delete-title\">Mover para lixeira</h2>\r\n        <p>A tarefa poderá ser restaurada durante 30 dias.</p>\r\n      </div>\r\n      <button class=\"icon-btn\" type=\"button\" [disabled]=\"taskDeleteLoading()\"\r\n        (click)=\"cancelTaskDeletion()\"><mat-icon>close</mat-icon></button>\r\n    </header>\r\n    <div class=\"column-dialog-body delete-copy\">\r\n      <p>Deseja mover <strong>{{ task.title }}</strong> para a lixeira?</p>\r\n      <div class=\"blocked-warning\"><mat-icon>info_outline</mat-icon><span>As subtarefas vinculadas também irão para a\r\n          lixeira. Os prazos sairão da Agenda e voltarão caso a tarefa seja restaurada.</span></div>\r\n    </div>\r\n    <footer>\r\n      <button class=\"cancel-btn\" type=\"button\" [disabled]=\"taskDeleteLoading()\"\r\n        (click)=\"cancelTaskDeletion()\">Cancelar</button>\r\n      <button class=\"delete-confirm-btn\" type=\"button\" [disabled]=\"taskDeleteLoading()\"\r\n        (click)=\"confirmTaskDeletion()\"><mat-icon>{{ taskDeleteLoading() ? 'hourglass_top' : 'delete_outline'\r\n          }}</mat-icon>{{ taskDeleteLoading() ? 'Movendo...' : 'Mover para lixeira' }}</button>\r\n    </footer>\r\n  </section>\r\n</div>\r\n\r\n<div class=\"trash-backdrop\" *ngIf=\"trashOpen()\" (mousedown)=\"closeTrash()\">\r\n  <section class=\"trash-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"trash-title\"\r\n    (mousedown)=\"$event.stopPropagation()\">\r\n    <header>\r\n      <span class=\"trash-modal-icon\"><mat-icon>delete_outline</mat-icon></span>\r\n      <div>\r\n        <h2 id=\"trash-title\">Lixeira de tarefas</h2>\r\n        <p>Itens são excluídos permanentemente após 30 dias.</p>\r\n      </div>\r\n      <button class=\"icon-btn\" type=\"button\" [disabled]=\"trashActionLoading()\"\r\n        (click)=\"closeTrash()\"><mat-icon>close</mat-icon></button>\r\n    </header>\r\n    <div class=\"trash-body\">\r\n      <div class=\"trash-loading\" *ngIf=\"service.trashLoading()\"><span class=\"spinner\"></span>Carregando lixeira...</div>\r\n      <div class=\"trash-empty\" *ngIf=\"!service.trashLoading() && !service.trash().length\">\r\n        <mat-icon>delete_sweep</mat-icon><strong>A lixeira está vazia</strong><span>As tarefas excluídas aparecerão\r\n          aqui.</span></div>\r\n      <article class=\"trash-item\" *ngFor=\"let task of service.trash(); trackBy: trackById\">\r\n        <div class=\"trash-item-icon\"><mat-icon>task_alt</mat-icon></div>\r\n        <div class=\"trash-item-info\"><strong>{{ task.title }}</strong><span>Excluída em {{ formatTrashDate(task) }} · {{\r\n            trashDaysRemaining(task) }} dia{{ trashDaysRemaining(task) === 1 ? '' : 's' }} restante{{\r\n            trashDaysRemaining(task) === 1 ? '' : 's' }}</span><small\r\n            *ngIf=\"task.attachments.length\"><mat-icon>attach_file</mat-icon>{{ task.attachments.length }} anexo{{\r\n            task.attachments.length === 1 ? '' : 's' }}</small></div>\r\n        <div class=\"trash-actions\" *ngIf=\"canDeleteTasks()\"><button type=\"button\" class=\"restore-task-btn\"\r\n            [disabled]=\"trashActionLoading()\"\r\n            (click)=\"restoreFromTrash(task)\"><mat-icon>restore</mat-icon>Restaurar</button><button type=\"button\"\r\n            class=\"permanent-task-btn\" [disabled]=\"trashActionLoading()\" (click)=\"requestPermanentDeletion(task)\"\r\n            matTooltip=\"Excluir permanentemente\"><mat-icon>delete_forever</mat-icon></button></div>\r\n      </article>\r\n      <p class=\"trash-readonly\" *ngIf=\"!canDeleteTasks() && service.trash().length\">\r\n        <mat-icon>info_outline</mat-icon>Somente administradores podem restaurar ou excluir tarefas permanentemente.</p>\r\n    </div>\r\n  </section>\r\n</div>\r\n\r\n<div class=\"column-dialog-backdrop permanent-delete-backdrop\" *ngIf=\"permanentDeleteTarget() as task\"\r\n  (mousedown)=\"permanentDeleteTarget.set(null)\">\r\n  <section class=\"column-dialog team-delete-dialog\" role=\"alertdialog\" aria-modal=\"true\"\r\n    aria-labelledby=\"permanent-delete-title\" (mousedown)=\"$event.stopPropagation()\">\r\n    <header><span class=\"column-dialog-icon delete\"><mat-icon>delete_forever</mat-icon></span>\r\n      <div>\r\n        <h2 id=\"permanent-delete-title\">Excluir permanentemente</h2>\r\n        <p>Esta ação não poderá ser desfeita.</p>\r\n      </div>\r\n    </header>\r\n    <div class=\"column-dialog-body delete-copy\">\r\n      <p>Deseja apagar definitivamente <strong>{{ task.title }}</strong>?</p>\r\n      <div class=\"blocked-warning\"><mat-icon>warning_amber</mat-icon><span>Subtarefas, checklists e anexos vinculados\r\n          também serão apagados.</span></div>\r\n    </div>\r\n    <footer><button class=\"cancel-btn\" type=\"button\" [disabled]=\"trashActionLoading()\"\r\n        (click)=\"permanentDeleteTarget.set(null)\">Cancelar</button><button class=\"delete-confirm-btn\" type=\"button\"\r\n        [disabled]=\"trashActionLoading()\" (click)=\"confirmPermanentDeletion()\"><mat-icon>{{ trashActionLoading() ?\r\n          'hourglass_top' : 'delete_forever' }}</mat-icon>{{ trashActionLoading() ? 'Excluindo...' : 'Excluir\r\n        permanentemente' }}</button></footer>\r\n  </section>\r\n</div>\r\n\r\n<div class=\"column-dialog-backdrop\" *ngIf=\"teamDeleteTarget() as team\" (mousedown)=\"cancelTeamDeletion()\">\r\n  <section class=\"column-dialog team-delete-dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"team-delete-title\"\r\n    (mousedown)=\"$event.stopPropagation()\">\r\n    <header>\r\n      <span class=\"column-dialog-icon delete\"><mat-icon>groups</mat-icon></span>\r\n      <div>\r\n        <h2 id=\"team-delete-title\">Excluir time</h2>\r\n        <p>Esta ação não poderá ser desfeita.</p>\r\n      </div>\r\n      <button class=\"icon-btn\" type=\"button\" (click)=\"cancelTeamDeletion()\"><mat-icon>close</mat-icon></button>\r\n    </header>\r\n    <div class=\"column-dialog-body delete-copy\">\r\n      <p>Deseja excluir o time <strong>{{ team.name }}</strong>?</p>\r\n      <div class=\"blocked-warning\"><mat-icon>warning_amber</mat-icon><span>O Kanban compartilhado, suas listas e todas\r\n          as tarefas deste time serão excluídos permanentemente.</span></div>\r\n    </div>\r\n    <footer>\r\n      <button class=\"cancel-btn\" type=\"button\" [disabled]=\"teamDeleteLoading()\"\r\n        (click)=\"cancelTeamDeletion()\">Cancelar</button>\r\n      <button class=\"delete-confirm-btn\" type=\"button\" [disabled]=\"teamDeleteLoading()\"\r\n        (click)=\"confirmTeamDeletion()\"><mat-icon>{{ teamDeleteLoading() ? 'hourglass_top' : 'delete_forever'\r\n          }}</mat-icon>{{ teamDeleteLoading() ? 'Excluindo...' : 'Excluir time' }}</button>\r\n    </footer>\r\n  </section>\r\n</div>\r\n\r\n<div class=\"column-dialog-backdrop\" *ngIf=\"memberRemovalTarget() as member\" (mousedown)=\"cancelMemberRemoval()\">\r\n  <section class=\"column-dialog member-removal-dialog\" role=\"dialog\" aria-modal=\"true\"\r\n    aria-labelledby=\"member-removal-title\" (mousedown)=\"$event.stopPropagation()\">\r\n    <header>\r\n      <span class=\"column-dialog-icon delete\"><mat-icon>person_remove</mat-icon></span>\r\n      <div>\r\n        <h2 id=\"member-removal-title\">Remover pessoa do time</h2>\r\n        <p>Confirme antes de alterar os participantes.</p>\r\n      </div>\r\n      <button class=\"icon-btn\" type=\"button\" (click)=\"cancelMemberRemoval()\"><mat-icon>close</mat-icon></button>\r\n    </header>\r\n    <div class=\"column-dialog-body delete-copy\">\r\n      <p>Deseja remover <strong>{{ memberName(member.user_id) }}</strong> do time <strong>{{ currentTeam()?.name\r\n          }}</strong>?</p>\r\n      <div class=\"member-removal-warning\"><mat-icon>info_outline</mat-icon><span>A pessoa perderá o acesso ao Kanban do\r\n          time e será retirada das tarefas atribuídas a ela.</span></div>\r\n    </div>\r\n    <footer>\r\n      <button class=\"cancel-btn\" type=\"button\" (click)=\"cancelMemberRemoval()\">Cancelar</button>\r\n      <button class=\"delete-confirm-btn\" type=\"button\"\r\n        (click)=\"confirmMemberRemoval()\"><mat-icon>person_remove</mat-icon>Remover pessoa</button>\r\n    </footer>\r\n  </section>\r\n</div>\r\n\r\n<div class=\"column-dialog-backdrop\" *ngIf=\"columnDialog() && selectedColumn() as column\"\r\n  (mousedown)=\"closeColumnDialog()\">\r\n  <section class=\"column-dialog\" role=\"dialog\" aria-modal=\"true\" (mousedown)=\"$event.stopPropagation()\">\r\n    <header>\r\n      <span class=\"column-dialog-icon\" [class.delete]=\"columnDialog() === 'delete'\"\r\n        [style.background]=\"columnDialog() === 'rename' ? columnColorDraft : null\">\r\n        <mat-icon>{{ columnDialog() === 'rename' ? 'palette' : 'delete_outline' }}</mat-icon>\r\n      </span>\r\n      <div>\r\n        <h2>{{ columnDialog() === 'rename' ? 'Editar lista' : 'Excluir lista' }}</h2>\r\n        <p>{{ columnDialog() === 'rename' ? 'Altere o nome e a cor de destaque desta lista.' : 'Esta ação remove a lista\r\n          permanentemente.' }}</p>\r\n      </div>\r\n      <button class=\"icon-btn\" (click)=\"closeColumnDialog()\"><mat-icon>close</mat-icon></button>\r\n    </header>\r\n    <div class=\"column-dialog-body\" *ngIf=\"columnDialog() === 'rename'\">\r\n      <label>\r\n        <span>Nome da lista</span>\r\n        <input [(ngModel)]=\"columnTitleDraft\" maxlength=\"60\" (keydown.enter)=\"confirmColumnDialog()\" autofocus>\r\n      </label>\r\n      <div class=\"column-dialog-colors\">\r\n        <span class=\"color-picker-label\">Cor da lista</span>\r\n        <div class=\"column-color-swatches\">\r\n          <button type=\"button\" *ngFor=\"let c of columnColors\" class=\"column-color-swatch\" [style.background]=\"c.value\"\r\n            [class.selected]=\"columnColorDraft === c.value\" [matTooltip]=\"c.label\" (click)=\"columnColorDraft = c.value\">\r\n            <mat-icon *ngIf=\"columnColorDraft === c.value\">check</mat-icon>\r\n          </button>\r\n        </div>\r\n      </div>\r\n      <!-- Auto-arquivamento -->\r\n      <div class=\"column-auto-archive-section\">\r\n        <div class=\"auto-archive-header\">\r\n          <mat-icon>archive</mat-icon>\r\n          <div>\r\n            <span class=\"auto-archive-label\">Arquivamento automático</span>\r\n            <p class=\"auto-archive-desc\">Ao mover um card para esta lista, ele será arquivado automaticamente após o tempo configurado.</p>\r\n          </div>\r\n        </div>\r\n        <div class=\"auto-archive-options\">\r\n          <label class=\"archive-option\" [class.selected]=\"columnAutoArchiveDelayDraft === 'never'\">\r\n            <input type=\"radio\" [(ngModel)]=\"columnAutoArchiveDelayDraft\" value=\"never\">\r\n            <mat-icon>block</mat-icon><span>Nunca arquivar</span>\r\n          </label>\r\n          <label class=\"archive-option\" [class.selected]=\"columnAutoArchiveDelayDraft === 'immediate'\">\r\n            <input type=\"radio\" [(ngModel)]=\"columnAutoArchiveDelayDraft\" value=\"immediate\">\r\n            <mat-icon>flash_on</mat-icon><span>Imediatamente</span>\r\n          </label>\r\n          <label class=\"archive-option\" [class.selected]=\"columnAutoArchiveDelayDraft === '1h'\">\r\n            <input type=\"radio\" [(ngModel)]=\"columnAutoArchiveDelayDraft\" value=\"1h\">\r\n            <mat-icon>schedule</mat-icon><span>Após 1 hora</span>\r\n          </label>\r\n          <label class=\"archive-option\" [class.selected]=\"columnAutoArchiveDelayDraft === '6h'\">\r\n            <input type=\"radio\" [(ngModel)]=\"columnAutoArchiveDelayDraft\" value=\"6h\">\r\n            <mat-icon>schedule</mat-icon><span>Após 6 horas</span>\r\n          </label>\r\n          <label class=\"archive-option\" [class.selected]=\"columnAutoArchiveDelayDraft === '12h'\">\r\n            <input type=\"radio\" [(ngModel)]=\"columnAutoArchiveDelayDraft\" value=\"12h\">\r\n            <mat-icon>schedule</mat-icon><span>Após 12 horas</span>\r\n          </label>\r\n          <label class=\"archive-option\" [class.selected]=\"columnAutoArchiveDelayDraft === '24h'\">\r\n            <input type=\"radio\" [(ngModel)]=\"columnAutoArchiveDelayDraft\" value=\"24h\">\r\n            <mat-icon>today</mat-icon><span>Após 1 dia</span>\r\n          </label>\r\n          <label class=\"archive-option\" [class.selected]=\"columnAutoArchiveDelayDraft === '48h'\">\r\n            <input type=\"radio\" [(ngModel)]=\"columnAutoArchiveDelayDraft\" value=\"48h\">\r\n            <mat-icon>calendar_today</mat-icon><span>Após 2 dias</span>\r\n          </label>\r\n          <label class=\"archive-option\" [class.selected]=\"columnAutoArchiveDelayDraft === '72h'\">\r\n            <input type=\"radio\" [(ngModel)]=\"columnAutoArchiveDelayDraft\" value=\"72h\">\r\n            <mat-icon>calendar_today</mat-icon><span>Após 3 dias</span>\r\n          </label>\r\n          <label class=\"archive-option\" [class.selected]=\"columnAutoArchiveDelayDraft === '7d'\">\r\n            <input type=\"radio\" [(ngModel)]=\"columnAutoArchiveDelayDraft\" value=\"7d\">\r\n            <mat-icon>date_range</mat-icon><span>Após 7 dias</span>\r\n          </label>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"column-dialog-body delete-copy\" *ngIf=\"columnDialog() === 'delete'\">\r\n      <p>Deseja excluir <strong>{{ column.title }}</strong>?</p>\r\n      <div class=\"blocked-warning\" *ngIf=\"columnHasActiveTasks(column.id)\"><mat-icon>warning_amber</mat-icon><span>Esta\r\n          lista possui tarefas ativas. Mova ou arquive os cartões antes de excluí-la.</span></div>\r\n      <p class=\"safe-hint\" *ngIf=\"!columnHasActiveTasks(column.id)\">Tarefas arquivadas nesta lista também serão\r\n        removidas.</p>\r\n    </div>\r\n    <footer>\r\n      <button class=\"cancel-btn\" (click)=\"closeColumnDialog()\">Cancelar</button>\r\n      <button *ngIf=\"columnDialog() === 'rename'\" class=\"primary-btn\" [disabled]=\"!columnTitleDraft.trim()\"\r\n        (click)=\"confirmColumnDialog()\">Salvar alterações</button>\r\n      <button *ngIf=\"columnDialog() === 'delete'\" class=\"delete-confirm-btn\"\r\n        [disabled]=\"columnHasActiveTasks(column.id)\"\r\n        (click)=\"confirmColumnDialog()\"><mat-icon>delete_outline</mat-icon>Excluir lista</button>\r\n    </footer>\r\n  </section>\r\n</div>\r\n\r\n<div class=\"column-dialog-backdrop\" *ngIf=\"boardNameDialogOpen()\" (mousedown)=\"closeBoardNameDialog()\">\r\n  <section class=\"column-dialog\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"board-name-dialog-title\"\r\n    (mousedown)=\"$event.stopPropagation()\">\r\n    <header>\r\n      <span class=\"column-dialog-icon\"><mat-icon>edit</mat-icon></span>\r\n      <div>\r\n        <h2 id=\"board-name-dialog-title\">Nome do Kanban</h2>\r\n        <p>Escolha um nome para identificar este quadro.</p>\r\n      </div>\r\n      <button class=\"icon-btn\" type=\"button\" (click)=\"closeBoardNameDialog()\"><mat-icon>close</mat-icon></button>\r\n    </header>\r\n    <div class=\"column-dialog-body\">\r\n      <label><span>Nome do Kanban</span><input [(ngModel)]=\"boardNameDraft\" maxlength=\"80\"\r\n          (keydown.enter)=\"confirmBoardName()\" autofocus></label>\r\n    </div>\r\n    <footer><button class=\"cancel-btn\" type=\"button\" (click)=\"closeBoardNameDialog()\">Cancelar</button><button\r\n        class=\"primary-btn\" type=\"button\" [disabled]=\"!boardNameDraft.trim()\" (click)=\"confirmBoardName()\">Salvar\r\n        nome</button></footer>\r\n  </section>\r\n</div>\r\n\r\n<div class=\"column-dialog-backdrop\" *ngIf=\"branchConfirmationTask() as task\" (mousedown)=\"cancelBranchCreation()\">\r\n  <section class=\"column-dialog branch-confirmation-dialog\" role=\"dialog\" aria-modal=\"true\"\r\n    aria-labelledby=\"branch-confirmation-title\" (mousedown)=\"$event.stopPropagation()\">\r\n    <header>\r\n      <span class=\"column-dialog-icon\"><mat-icon>account_tree</mat-icon></span>\r\n      <div>\r\n        <h2 id=\"branch-confirmation-title\">Criar ramificação</h2>\r\n        <p>Esta tarefa ainda não possui uma ramificação.</p>\r\n      </div>\r\n      <button class=\"icon-btn\" type=\"button\" (click)=\"cancelBranchCreation()\"><mat-icon>close</mat-icon></button>\r\n    </header>\r\n    <div class=\"column-dialog-body delete-copy\">\r\n      <p>Deseja criar uma ramificação dentro de <strong>{{ task.title }}</strong>?</p>\r\n      <div class=\"branch-temporary-note\"><mat-icon>info_outline</mat-icon><span>A ramificação será temporária enquanto\r\n          estiver vazia. Se você sair sem criar nenhuma subtarefa, ela será descartada automaticamente.</span></div>\r\n    </div>\r\n    <footer><button class=\"cancel-btn\" type=\"button\" (click)=\"cancelBranchCreation()\">Cancelar</button><button\r\n        class=\"primary-btn\" type=\"button\" (click)=\"confirmBranchCreation()\"><mat-icon>account_tree</mat-icon>Criar\r\n        ramificação</button></footer>\r\n  </section>\r\n</div>\r\n\r\n<div class=\"task-modal-backdrop\" *ngIf=\"modalOpen()\" (mousedown)=\"closeTaskModal()\">\r\n  <section class=\"task-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"task-modal-title\"\r\n    (mousedown)=\"$event.stopPropagation()\">\r\n    \r\n    <!-- Modal Header -->\r\n    <header class=\"task-modal-header\">\r\n      <div class=\"modal-header-left\">\r\n        <div class=\"modal-icon\">\r\n          <mat-icon>{{ editingId() ? 'edit_note' : 'add_task' }}</mat-icon>\r\n        </div>\r\n        <div class=\"modal-title-group\">\r\n          <div class=\"modal-breadcrumb\">\r\n            <span class=\"board-badge\">{{ board()?.name || 'Quadro' }}</span>\r\n            <mat-icon class=\"bc-sep\">chevron_right</mat-icon>\r\n            <span class=\"status-chip-badge\" [ngClass]=\"getStatusTheme(draft.columnId).className\"\r\n              [style.color]=\"getStatusTheme(draft.columnId).color\"\r\n              [style.background]=\"getStatusTheme(draft.columnId).bg\"\r\n              [style.border-color]=\"getStatusTheme(draft.columnId).border\">\r\n              <span class=\"chip-dot\" [style.background]=\"getStatusTheme(draft.columnId).dot\"></span>\r\n              {{ getColumnTitle(draft.columnId) }}\r\n            </span>\r\n          </div>\r\n          <h2 id=\"task-modal-title\">{{ isTaskReadOnly() ? 'Detalhes da Tarefa' : (editingId() ? 'Editar Tarefa' : 'Nova Tarefa') }}</h2>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"modal-header-actions\">\r\n        <button class=\"icon-btn\" type=\"button\" (click)=\"printSingleTask()\" matTooltip=\"Imprimir esta tarefa\">\r\n          <mat-icon>print</mat-icon>\r\n        </button>\r\n        <button class=\"icon-btn close-btn\" type=\"button\" (click)=\"closeTaskModal()\" matTooltip=\"Fechar\">\r\n          <mat-icon>close</mat-icon>\r\n        </button>\r\n      </div>\r\n    </header>\r\n\r\n    <!-- Modal Body -->\r\n    <div class=\"modal-body task-modal-body\">\r\n      \r\n      <!-- Modo Visualização Limpo & Elegante -->\r\n      <div class=\"read-only-view-container\" *ngIf=\"isTaskReadOnly()\">\r\n        <div class=\"view-content-card\" [style.border-left-color]=\"getStatusTheme(draft.columnId).dot\">\r\n          <div class=\"view-header-row\">\r\n            <h1 class=\"view-title\">{{ draft.title || 'Sem título' }}</h1>\r\n            <div class=\"view-meta-badges\">\r\n              <!-- Status -->\r\n              <span class=\"view-badge badge-status\" [style.color]=\"getStatusTheme(draft.columnId).color\">\r\n                <span class=\"view-badge-dot\" [style.background]=\"getStatusTheme(draft.columnId).dot\"></span>\r\n                <span>{{ getColumnTitle(draft.columnId) }}</span>\r\n              </span>\r\n\r\n              <!-- Prioridade -->\r\n              <span class=\"view-badge badge-priority priority\" [ngClass]=\"draft.priority\" *ngIf=\"draft.priority\">\r\n                <mat-icon>{{ getPriorityIcon(draft.priority) }}</mat-icon>\r\n                <span>{{ getPriorityLabel(draft.priority) }}</span>\r\n              </span>\r\n\r\n              <!-- Prazo -->\r\n              <span class=\"view-badge badge-due-date\" *ngIf=\"draft.dueDate\">\r\n                <mat-icon>event</mat-icon>\r\n                <span>{{ formatDueDate(draft.dueDate) }}</span>\r\n              </span>\r\n\r\n              <!-- Responsáveis -->\r\n              <span class=\"view-badge badge-assignees\" *ngIf=\"draft.assigneeIds.length\">\r\n                <mat-icon>person</mat-icon>\r\n                <span>{{ draftAssigneeNames() }}</span>\r\n              </span>\r\n\r\n              <!-- Etiquetas -->\r\n              <ng-container *ngIf=\"draftLabels().length\">\r\n                <span *ngFor=\"let label of draftLabels()\" class=\"view-badge badge-label\">\r\n                  #{{ label.startsWith('#') ? label.substring(1) : label }}\r\n                </span>\r\n              </ng-container>\r\n\r\n              <!-- Propriedades Customizadas & Checkboxes -->\r\n              <ng-container *ngFor=\"let col of activeCustomColumns()\">\r\n                <span\r\n                  *ngIf=\"col.type === 'checkbox'\"\r\n                  class=\"view-badge badge-custom-check clickable\"\r\n                  [class.checked]=\"!!draftCustomFields[col.id]\"\r\n                  (click)=\"toggleCustomFieldInView(col)\"\r\n                  role=\"checkbox\"\r\n                  [attr.aria-checked]=\"!!draftCustomFields[col.id]\"\r\n                  tabindex=\"0\"\r\n                  (keydown.enter)=\"toggleCustomFieldInView(col)\"\r\n                  (keydown.space)=\"toggleCustomFieldInView(col); $event.preventDefault()\"\r\n                  [matTooltip]=\"col.label\"\r\n                >\r\n                  <mat-icon>{{ !!draftCustomFields[col.id] ? 'check_box' : 'check_box_outline_blank' }}</mat-icon>\r\n                  <span>{{ col.label }}</span>\r\n                </span>\r\n                <span\r\n                  *ngIf=\"col.type !== 'checkbox' && draftCustomFields[col.id]\"\r\n                  class=\"view-badge badge-custom-prop\"\r\n                >\r\n                  <mat-icon>{{ col.icon }}</mat-icon>\r\n                  <span>{{ col.label }}: {{ draftCustomFields[col.id] }}</span>\r\n                </span>\r\n              </ng-container>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"view-description-wrap\">\r\n            <app-markdown-text *ngIf=\"draft.description\" [text]=\"draft.description\" (textChange)=\"onTaskDescriptionChangeInView($event)\"></app-markdown-text>\r\n            <p *ngIf=\"!draft.description\" class=\"view-empty-desc\">Nenhuma descrição informada.</p>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Checklist no modo visualização (se houver) -->\r\n        <div class=\"view-checklist-card\" *ngIf=\"draft.checklist.length > 0\">\r\n          <div class=\"view-card-subtitle\">\r\n            <mat-icon>checklist</mat-icon>\r\n            <span>Checklist ({{ draft.checklist.filter(item => item.done).length }}/{{ draft.checklist.length }})</span>\r\n          </div>\r\n          <div class=\"view-checklist-list\">\r\n            <!-- Itens avulsos -->\r\n            <div\r\n              class=\"view-check-item clickable-check-item\"\r\n              *ngFor=\"let item of ungroupedChecklistItems\"\r\n              (click)=\"toggleChecklistItemInView(item)\"\r\n              role=\"checkbox\"\r\n              [attr.aria-checked]=\"item.done\"\r\n              tabindex=\"0\"\r\n              (keydown.enter)=\"toggleChecklistItemInView(item)\"\r\n              (keydown.space)=\"toggleChecklistItemInView(item); $event.preventDefault()\"\r\n            >\r\n              <mat-icon class=\"check-icon\" [class.done]=\"item.done\">{{ item.done ? 'check_box' : 'check_box_outline_blank' }}</mat-icon>\r\n              <span class=\"check-text\" [class.done]=\"item.done\">{{ item.text }}</span>\r\n            </div>\r\n            <!-- Seções / Grupos -->\r\n            <div class=\"view-check-group\" *ngFor=\"let group of checklistGroups\">\r\n              <div class=\"view-group-title\">\r\n                <mat-icon>folder</mat-icon>\r\n                <span>{{ group }}</span>\r\n              </div>\r\n              <div\r\n                class=\"view-check-item grouped clickable-check-item\"\r\n                *ngFor=\"let item of checklistItemsForGroup(group)\"\r\n                (click)=\"toggleChecklistItemInView(item)\"\r\n                role=\"checkbox\"\r\n                [attr.aria-checked]=\"item.done\"\r\n                tabindex=\"0\"\r\n                (keydown.enter)=\"toggleChecklistItemInView(item)\"\r\n                (keydown.space)=\"toggleChecklistItemInView(item); $event.preventDefault()\"\r\n              >\r\n                <mat-icon class=\"check-icon\" [class.done]=\"item.done\">{{ item.done ? 'check_box' : 'check_box_outline_blank' }}</mat-icon>\r\n                <span class=\"check-text\" [class.done]=\"item.done\">{{ item.text }}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Anexos no modo visualização (se houver) -->\r\n        <div class=\"view-attachments-card\" *ngIf=\"taskAttachments.length > 0\">\r\n          <div class=\"view-card-subtitle\">\r\n            <mat-icon>attach_file</mat-icon>\r\n            <span>Anexos ({{ taskAttachments.length }})</span>\r\n          </div>\r\n          <div class=\"attachment-list\">\r\n            <div\r\n              class=\"attachment-item\"\r\n              *ngFor=\"let attachment of taskAttachments\"\r\n              (click)=\"openTaskAttachment(attachment)\"\r\n              role=\"button\"\r\n              tabindex=\"0\"\r\n              (keydown.enter)=\"openTaskAttachment(attachment)\"\r\n            >\r\n              <mat-icon [style.color]=\"getFileInfo(attachment.fileName, attachment.mimeType).color\">\r\n                {{ getFileInfo(attachment.fileName, attachment.mimeType).icon }}\r\n              </mat-icon>\r\n              <div>\r\n                <strong>{{ attachment.fileName }}</strong>\r\n                <span>{{ attachment.byteSize / 1048576 | number:'1.0-2' }} MB · {{ getFileInfo(attachment.fileName, attachment.mimeType).name }}</span>\r\n              </div>\r\n              <mat-icon class=\"view-action-icon\">visibility</mat-icon>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Modo Edição / Criação com Formulário Completo -->\r\n      <ng-container *ngIf=\"!isTaskReadOnly()\">\r\n        <!-- Título Principal -->\r\n        <div class=\"task-title-section\">\r\n          <input [(ngModel)]=\"draft.title\" maxlength=\"180\" class=\"task-title-main-input\"\r\n            placeholder=\"O que precisa ser feito? (Título da tarefa)\" autofocus />\r\n        </div>\r\n\r\n        <!-- Grade de Propriedades (Estilo Notion/Linear) -->\r\n        <div class=\"task-properties-card\">\r\n          <div class=\"props-header\">\r\n            <span class=\"props-title\"><mat-icon>tune</mat-icon> Propriedades da Tarefa</span>\r\n            <button type=\"button\" class=\"btn-add-prop-inline\" (click)=\"showAddPropertyInModal.set(!showAddPropertyInModal())\">\r\n              <mat-icon>{{ showAddPropertyInModal() ? 'close' : 'add' }}</mat-icon>\r\n              <span>{{ showAddPropertyInModal() ? 'Cancelar' : 'Adicionar Campo' }}</span>\r\n            </button>\r\n          </div>\r\n\r\n          <!-- Form Inline para Adicionar Nova Propriedade no Modal -->\r\n          <div class=\"modal-add-property-form\" *ngIf=\"showAddPropertyInModal()\">\r\n            <div class=\"add-prop-fields\">\r\n              <input type=\"text\" [(ngModel)]=\"newPropertyLabelInModal\" placeholder=\"Nome do campo (ex: Cliente, Valor...)\" class=\"prop-input-name\" />\r\n              <select [(ngModel)]=\"newPropertyTypeInModal\" class=\"prop-select-type\">\r\n                <option value=\"text\">Texto</option>\r\n                <option value=\"date\">Data</option>\r\n                <option value=\"number\">Número</option>\r\n                <option value=\"select\">Lista de Seleção</option>\r\n                <option value=\"checkbox\">Caixa de Seleção (Sim/Não)</option>\r\n              </select>\r\n              <input *ngIf=\"newPropertyTypeInModal === 'select'\" type=\"text\" [(ngModel)]=\"newPropertyOptionsInModal\" placeholder=\"Opções separadas por vírgula...\" class=\"prop-input-options\" />\r\n            </div>\r\n            <div class=\"add-prop-actions\">\r\n              <button type=\"button\" class=\"btn-confirm-add-prop\" (click)=\"addPropertyInModal()\" [disabled]=\"!newPropertyLabelInModal.trim()\">\r\n                <mat-icon>check</mat-icon> Criar Propriedade\r\n              </button>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"props-grid\">\r\n            <!-- Status / Lista -->\r\n            <div class=\"prop-item\">\r\n              <div class=\"prop-label\">\r\n                <mat-icon>donut_large</mat-icon>\r\n                <span>Status</span>\r\n              </div>\r\n              <div class=\"prop-value\">\r\n                <div class=\"modal-status-select-wrap\">\r\n                  <span class=\"status-dot-indicator\" [style.background]=\"getStatusTheme(draft.columnId).dot\"></span>\r\n                  <select [(ngModel)]=\"draft.columnId\" class=\"modal-select-input\">\r\n                    <option *ngFor=\"let column of board()?.columns\" [value]=\"column.id\">{{ column.title }}</option>\r\n                  </select>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Prioridade -->\r\n            <div class=\"prop-item\">\r\n              <div class=\"prop-label\">\r\n                <mat-icon>flag</mat-icon>\r\n                <span>Prioridade</span>\r\n              </div>\r\n              <div class=\"prop-value\">\r\n                <div class=\"modal-priority-wrap priority\" [ngClass]=\"draft.priority\">\r\n                  <mat-icon class=\"p-icon\">{{ getPriorityIcon(draft.priority) }}</mat-icon>\r\n                  <select [(ngModel)]=\"draft.priority\" class=\"modal-select-input\">\r\n                    <option value=\"low\">Baixa</option>\r\n                    <option value=\"medium\">Média</option>\r\n                    <option value=\"high\">Alta</option>\r\n                    <option value=\"urgent\">Urgente</option>\r\n                  </select>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Prazo -->\r\n            <div class=\"prop-item\">\r\n              <div class=\"prop-label\">\r\n                <mat-icon>event</mat-icon>\r\n                <span>Prazo</span>\r\n              </div>\r\n              <div class=\"prop-value\">\r\n                <input type=\"date\" [(ngModel)]=\"draft.dueDate\" class=\"modal-date-input\" />\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Responsáveis -->\r\n            <div class=\"prop-item prop-item-full\">\r\n              <div class=\"prop-label\">\r\n                <mat-icon>person</mat-icon>\r\n                <span>Responsáveis</span>\r\n              </div>\r\n              <div class=\"prop-value assignees-prop-value\">\r\n                <div class=\"assignee-options\">\r\n                  <button type=\"button\"\r\n                    [class.selected]=\"isDraftAssignee(auth.currentUser()?.id || '')\"\r\n                    (click)=\"toggleDraftAssignee(auth.currentUser()?.id || '')\">\r\n                    <img [src]=\"auth.currentUser()?.avatar || defaultAvatar\" (error)=\"$any($event.target).src = defaultAvatar\">\r\n                    <span>{{ auth.currentUser()?.name || 'Eu' }}</span>\r\n                    <mat-icon>{{ isDraftAssignee(auth.currentUser()?.id || '') ? 'check_circle' : 'add_circle_outline' }}</mat-icon>\r\n                  </button>\r\n                  <button type=\"button\" *ngFor=\"let user of assignableUsers()\"\r\n                    [class.selected]=\"isDraftAssignee(user.id)\" (click)=\"toggleDraftAssignee(user.id)\">\r\n                    <img [src]=\"user.avatar || defaultAvatar\" (error)=\"$any($event.target).src = defaultAvatar\">\r\n                    <span>{{ user.name }}</span>\r\n                    <mat-icon>{{ isDraftAssignee(user.id) ? 'check_circle' : 'add_circle_outline' }}</mat-icon>\r\n                  </button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Etiquetas -->\r\n            <div class=\"prop-item prop-item-full\">\r\n              <div class=\"prop-label\">\r\n                <mat-icon>sell</mat-icon>\r\n                <span>Etiquetas</span>\r\n              </div>\r\n              <div class=\"prop-value\">\r\n                <input [(ngModel)]=\"labelText\" placeholder=\"Ex.: Produto, Cliente, Bloqueado (separadas por vírgula)\" class=\"modal-text-input\" />\r\n              </div>\r\n            </div>\r\n\r\n            <!-- Campos Personalizados Dinâmicos -->\r\n            <ng-container *ngFor=\"let col of customColumns()\">\r\n              <div class=\"prop-item\" [class.prop-item-full]=\"col.type === 'text' && (col.label.length > 15)\">\r\n                <div class=\"prop-label\">\r\n                  <mat-icon>{{ col.icon }}</mat-icon>\r\n                  <span>{{ col.label }}</span>\r\n                  <button type=\"button\" class=\"btn-remove-custom-prop\" (click)=\"removeCustomColumn(col.id, $event)\" matTooltip=\"Excluir este campo\">\r\n                    <mat-icon>close</mat-icon>\r\n                  </button>\r\n                </div>\r\n                <div class=\"prop-value\">\r\n                  <input *ngIf=\"col.type === 'text'\" type=\"text\" [(ngModel)]=\"draftCustomFields[col.id]\" [placeholder]=\"col.label + '...'\" class=\"modal-text-input\" />\r\n                  <input *ngIf=\"col.type === 'number'\" type=\"number\" [(ngModel)]=\"draftCustomFields[col.id]\" placeholder=\"0\" class=\"modal-text-input\" />\r\n                  <input *ngIf=\"col.type === 'date'\" type=\"date\" [(ngModel)]=\"draftCustomFields[col.id]\" class=\"modal-date-input\" />\r\n                  <label *ngIf=\"col.type === 'checkbox'\" class=\"modal-checkbox-toggle\">\r\n                    <input type=\"checkbox\" [(ngModel)]=\"draftCustomFields[col.id]\" />\r\n                    <span>{{ draftCustomFields[col.id] ? 'Sim / Concluído' : 'Não / Pendente' }}</span>\r\n                  </label>\r\n                  <select *ngIf=\"col.type === 'select'\" [(ngModel)]=\"draftCustomFields[col.id]\" class=\"modal-select-input\">\r\n                    <option value=\"\">— Selecione —</option>\r\n                    <option *ngFor=\"let opt of col.options\" [value]=\"opt\">{{ opt }}</option>\r\n                  </select>\r\n                </div>\r\n              </div>\r\n            </ng-container>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Demanda / Descrição -->\r\n        <div class=\"task-description-card full\">\r\n          <div class=\"description-header\">\r\n            <div class=\"desc-heading-title\">\r\n              <mat-icon>notes</mat-icon>\r\n              <span>Descrição & Demanda</span>\r\n            </div>\r\n            <app-ai-text-button [text]=\"draft.description\" (textChange)=\"draft.description = $event\" />\r\n          </div>\r\n          <app-markdown-editor [text]=\"draft.description\" (textChange)=\"draft.description = $event\" [maxLength]=\"5000\"\r\n            placeholder=\"Adicione contexto, links ou critérios de aceite...\" ariaLabel=\"Descrição da tarefa\" />\r\n        </div>\r\n\r\n        <div class='task-attachments full'>\r\n          <div class='attachment-heading'><span><mat-icon>attach_file</mat-icon>Anexos</span><strong>{{\r\n              taskAttachments.length + pendingFiles.length }}/10</strong></div>\r\n          <p>Aceita todos os tipos de arquivos até 10 MB. Arquivos de programação contam com destaque de sintaxe.</p>\r\n          <label class='attachment-picker' *ngIf='taskAttachments.length + pendingFiles.length < 10'>\r\n            <mat-icon>upload_file</mat-icon><span>Adicionar arquivos ou imagens</span><input type='file' multiple\r\n              (change)='selectTaskFiles($event)'>\r\n          </label>\r\n          <div class='attachment-list' *ngIf='taskAttachments.length || pendingFiles.length'>\r\n            <div class='attachment-item' *ngFor='let attachment of taskAttachments'\r\n              (click)='openTaskAttachment(attachment)' role='button' tabindex='0'\r\n              (keydown.enter)='openTaskAttachment(attachment)'>\r\n              <mat-icon [style.color]=\"getFileInfo(attachment.fileName, attachment.mimeType).color\">\r\n                {{ getFileInfo(attachment.fileName, attachment.mimeType).icon }}\r\n              </mat-icon>\r\n              <div><strong>{{ attachment.fileName }}</strong><span>{{ attachment.byteSize / 1048576 | number:'1.0-2' }}\r\n                  MB · {{ getFileInfo(attachment.fileName, attachment.mimeType).name }}</span></div>\r\n              <button type='button' (click)='$event.stopPropagation(); deleteTaskAttachment(attachment)'\r\n                title='Excluir anexo'><mat-icon>delete_outline</mat-icon></button>\r\n            </div>\r\n            <div class='attachment-item pending' *ngFor='let file of pendingFiles; let index = index'\r\n              (click)='openPendingFile(file)'>\r\n              <mat-icon [style.color]=\"getFileInfo(file.name, file.type).color\">\r\n                {{ getFileInfo(file.name, file.type).icon }}\r\n              </mat-icon>\r\n              <div><strong>{{ file.name }}</strong><span>Aguardando salvar · {{ file.size / 1048576 | number:'1.0-2' }}\r\n                  MB · {{ getFileInfo(file.name, file.type).name }}</span></div>\r\n              <button type='button' (click)='$event.stopPropagation(); removePendingFile(index)'\r\n                title='Remover'><mat-icon>close</mat-icon></button>\r\n            </div>\r\n          </div>\r\n          <p class='attachment-error' *ngIf='attachmentError'>{{ attachmentError }}</p>\r\n        </div>\r\n\r\n        <div class=\"checklist-field full\">\r\n          <!-- Cabeçalho Principal do Checklist -->\r\n          <div class=\"checklist-main-header\">\r\n            <div class=\"checklist-heading-left\">\r\n              <span class=\"checklist-title-badge\"><mat-icon>checklist</mat-icon>Checklist & Seções</span>\r\n              <span class=\"checklist-counter-pill\" *ngIf=\"draft.checklist.length\">\r\n                {{ draft.checklist.filter(item => item.done).length }}/{{ draft.checklist.length }} concluídos\r\n              </span>\r\n            </div>\r\n            <button type=\"button\" class=\"add-section-toggle-btn\"\r\n              (click)=\"showAddSectionForm = !showAddSectionForm\"\r\n              [class.active]=\"showAddSectionForm\"\r\n              matTooltip=\"Adicionar nova seção organizada\">\r\n              <mat-icon>{{ showAddSectionForm ? 'close' : 'create_new_folder' }}</mat-icon>\r\n              <span>{{ showAddSectionForm ? 'Fechar' : 'Nova Seção' }}</span>\r\n            </button>\r\n          </div>\r\n\r\n          <!-- Painel Moderno: Criar Nova Seção com Sugestões Rápidas -->\r\n          <div class=\"modern-new-section-card\" *ngIf=\"showAddSectionForm || !checklistGroups.length\">\r\n            <div class=\"new-section-card-top\">\r\n              <div class=\"new-section-input-wrap\">\r\n                <mat-icon class=\"new-section-icon\">folder_open</mat-icon>\r\n                <input [(ngModel)]=\"checklistGroupTitle\"\r\n                  (keydown.enter)=\"$event.preventDefault(); addChecklistGroup()\"\r\n                  placeholder=\"Nome da nova seção (ex: Preparação, Execução, Revisão...)\"\r\n                  maxlength=\"80\">\r\n              </div>\r\n              <button type=\"button\" class=\"btn-create-section\" (click)=\"addChecklistGroup()\" [disabled]=\"!checklistGroupTitle.trim()\">\r\n                <mat-icon>add</mat-icon>\r\n                <span>Criar Seção</span>\r\n              </button>\r\n            </div>\r\n            <div class=\"section-quick-presets\">\r\n              <span class=\"preset-label\">Sugestões rápidas:</span>\r\n              <button type=\"button\" class=\"preset-chip\" *ngFor=\"let preset of quickSectionPresets\"\r\n                (click)=\"addChecklistGroup(preset)\"\r\n                [disabled]=\"checklistGroups.includes(preset)\">\r\n                + {{ preset }}\r\n              </button>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Bloco de Itens Gerais / Avulsos -->\r\n          <div class=\"checklist-section-block general-block\" *ngIf=\"ungroupedChecklistItems.length || !checklistGroups.length\">\r\n            <div class=\"section-block-header general-header\" *ngIf=\"checklistGroups.length\">\r\n              <div class=\"section-header-title\">\r\n                <mat-icon class=\"section-type-icon\">format_list_bulleted</mat-icon>\r\n                <span class=\"section-name\">Itens Gerais</span>\r\n              </div>\r\n              <span class=\"section-counter-badge\">{{ ungroupedChecklistItems.filter(i => i.done).length }}/{{ ungroupedChecklistItems.length }}</span>\r\n            </div>\r\n\r\n            <div class=\"section-items-list\" *ngIf=\"ungroupedChecklistItems.length\">\r\n              <label class=\"check-item modern-check-item\" *ngFor=\"let item of ungroupedChecklistItems\">\r\n                <input type=\"checkbox\" [(ngModel)]=\"item.done\">\r\n                <span [class.done]=\"item.done\">{{ item.text }}</span>\r\n                <button (click)=\"removeChecklistItem(draft.checklist.indexOf(item))\" type=\"button\" matTooltip=\"Excluir item\">\r\n                  <mat-icon>close</mat-icon>\r\n                </button>\r\n              </label>\r\n            </div>\r\n\r\n            <!-- Input inline para itens gerais -->\r\n            <div class=\"inline-add-item-row\">\r\n              <mat-icon class=\"inline-add-icon\">add</mat-icon>\r\n              <input [(ngModel)]=\"checklistText\"\r\n                (keydown.enter)=\"$event.preventDefault(); addChecklistItemToGroup()\"\r\n                placeholder=\"Adicionar item avulso...\">\r\n              <button type=\"button\" class=\"inline-btn-add\" (click)=\"addChecklistItemToGroup()\" [disabled]=\"!checklistText.trim()\">\r\n                <mat-icon>arrow_forward</mat-icon>\r\n              </button>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- Blocos de Seções Criadas -->\r\n          <div class=\"checklist-section-block\" *ngFor=\"let group of checklistGroups\" [class.is-active-target]=\"activeChecklistGroup === group\">\r\n            <div class=\"section-block-header\">\r\n              <div class=\"section-header-title\" (click)=\"setActiveGroup(activeChecklistGroup === group ? undefined : group)\">\r\n                <mat-icon class=\"section-type-icon\">folder</mat-icon>\r\n                <span class=\"section-name\">{{ group }}</span>\r\n              </div>\r\n              <div class=\"section-progress-wrapper\">\r\n                <span class=\"section-counter-badge\">\r\n                  {{ groupProgress(group).done }}/{{ groupProgress(group).total }}\r\n                </span>\r\n                <div class=\"section-mini-progress\">\r\n                  <div class=\"section-progress-fill\"\r\n                    [style.width.%]=\"groupProgress(group).total ? (groupProgress(group).done / groupProgress(group).total * 100) : 0\">\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <button class=\"remove-section-btn\" type=\"button\" (click)=\"removeChecklistGroup(group)\"\r\n                matTooltip=\"Excluir seção e seus itens\">\r\n                <mat-icon>delete_outline</mat-icon>\r\n              </button>\r\n            </div>\r\n\r\n            <div class=\"section-items-list\">\r\n              <div class=\"section-empty-hint\" *ngIf=\"!checklistItemsForGroup(group).length\">\r\n                <mat-icon>info_outline</mat-icon>\r\n                <span>Nenhum item adicionado nesta seção ainda.</span>\r\n              </div>\r\n              <label class=\"check-item modern-check-item grouped-item\" *ngFor=\"let item of checklistItemsForGroup(group)\">\r\n                <input type=\"checkbox\" [(ngModel)]=\"item.done\">\r\n                <span [class.done]=\"item.done\">{{ item.text }}</span>\r\n                <button (click)=\"removeChecklistItem(draft.checklist.indexOf(item))\" type=\"button\" matTooltip=\"Excluir item\">\r\n                  <mat-icon>close</mat-icon>\r\n                </button>\r\n              </label>\r\n            </div>\r\n\r\n            <!-- Input inline exclusivo desta seção -->\r\n            <div class=\"inline-add-item-row\">\r\n              <mat-icon class=\"inline-add-icon\">add</mat-icon>\r\n              <input [(ngModel)]=\"sectionItemDrafts[group]\"\r\n                (keydown.enter)=\"$event.preventDefault(); addChecklistItemToGroup(group)\"\r\n                [placeholder]=\"'Adicionar item em ' + group + '...'\">\r\n              <button type=\"button\" class=\"inline-btn-add\" (click)=\"addChecklistItemToGroup(group)\" [disabled]=\"!sectionItemDrafts[group]?.trim()\">\r\n                <mat-icon>arrow_forward</mat-icon>\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </ng-container>\r\n    </div>\r\n    <app-attachment-preview-modal\r\n      *ngIf=\"attachmentPreviewUrl()\"\r\n      [fileName]=\"attachmentPreviewName()\"\r\n      [fileUrl]=\"attachmentPreviewUrl()\"\r\n      [mimeType]=\"attachmentPreviewMimeType()\"\r\n      [rawContent]=\"attachmentPreviewRawContent()\"\r\n      [byteSize]=\"attachmentPreviewByteSize()\"\r\n      (close)=\"closeAttachmentPreview()\"\r\n      (download)=\"downloadTaskAttachment()\"\r\n    ></app-attachment-preview-modal>\r\n    <footer>\r\n      <div>\r\n        <button *ngIf=\"editingId() && !showArchived()\" class=\"subtasks-btn\" [disabled]=\"savingTask()\"\r\n          (click)=\"openEditingChildBoard()\"><mat-icon>account_tree</mat-icon>Subtarefas</button>\r\n        <ng-container *ngIf=\"!isTaskReadOnly()\">\r\n          <button *ngIf=\"editingId() && !showArchived()\" class=\"archive-btn\" [disabled]=\"savingTask()\"\r\n            (click)=\"archiveEditing()\"><mat-icon>archive</mat-icon>Arquivar</button>\r\n          <button *ngIf=\"editingId() && showArchived()\" class=\"archive-btn\" [disabled]=\"savingTask()\"\r\n            (click)=\"archiveEditing()\"><mat-icon>unarchive</mat-icon>Restaurar</button>\r\n          <button *ngIf=\"editingId() && canDeleteTasks()\" class=\"delete-btn\" [disabled]=\"savingTask()\"\r\n            (click)=\"deleteEditing()\"><mat-icon>delete_outline</mat-icon>Lixeira</button>\r\n        </ng-container>\r\n      </div>\r\n      <div>\r\n        <button type=\"button\" class=\"secondary-btn print-task-btn\"\r\n          (click)=\"printSingleTask()\"><mat-icon>print</mat-icon>Imprimir</button>\r\n        <ng-container *ngIf=\"isTaskReadOnly()\">\r\n          <button type=\"button\" class=\"secondary-btn\" (click)=\"enableTaskEditMode()\">\r\n            <mat-icon>edit</mat-icon>\r\n            <span>Editar Tarefa</span>\r\n          </button>\r\n          <button type=\"button\" class=\"primary-btn\" (click)=\"closeTaskModal()\">\r\n            <mat-icon>close</mat-icon>\r\n            <span>Fechar</span>\r\n          </button>\r\n        </ng-container>\r\n        <ng-container *ngIf=\"!isTaskReadOnly()\">\r\n          <button class=\"cancel-btn\" [disabled]=\"savingTask()\" (click)=\"closeTaskModal()\">Cancelar</button>\r\n          <button class=\"primary-btn\" [disabled]=\"savingTask() || !draft.title.trim()\" (click)=\"saveTask()\"><mat-icon>{{ savingTask() ?\r\n            'hourglass_top' : 'save' }}</mat-icon>{{ savingTask() ? 'Salvando...' : 'Salvar tarefa' }}</button>\r\n        </ng-container>\r\n      </div>\r\n    </footer>\r\n  </section>\r\n</div>\r\n\r\n<div class=\"team-modal-backdrop\" *ngIf=\"teamModalOpen()\" (mousedown)=\"teamModalOpen.set(false)\">\r\n  <section class=\"team-modal\" (mousedown)=\"$event.stopPropagation()\">\r\n    <header>\r\n      <div>\r\n        <h2>{{ creatingTeam() ? 'Criar novo time' : 'Gerenciar time' }}</h2>\r\n        <p>Times têm um Kanban compartilhado entre todos os membros.</p>\r\n      </div><button class=\"icon-btn\" (click)=\"teamModalOpen.set(false)\"><mat-icon>close</mat-icon></button>\r\n    </header>\r\n\r\n    <div class=\"team-selector\" *ngIf=\"!creatingTeam() && teams().length > 1\">\r\n      <button *ngFor=\"let team of teams()\" [class.active]=\"currentTeam()?.id === team.id\"\r\n        (click)=\"switchBoard(team.boardId); service.loadTeamMembers(team.id)\"><span\r\n          [style.background]=\"team.color\"></span>{{ team.name }}</button>\r\n    </div>\r\n\r\n    <form class=\"team-create-form\" *ngIf=\"creatingTeam()\" (ngSubmit)=\"saveBoard()\">\r\n      <label><span>Nome do time *</span><input [(ngModel)]=\"newBoardName\" name=\"teamName\" maxlength=\"80\"\r\n          placeholder=\"Ex.: Produto, Marketing, Operações\" autofocus></label>\r\n      <div class=\"team-description-field\">\r\n        <div class=\"description-header\"><span>Descrição</span><app-ai-text-button [text]=\"newTeamDescription\"\r\n            (textChange)=\"newTeamDescription = $event\" /></div><app-markdown-editor [text]=\"newTeamDescription\"\r\n          (textChange)=\"newTeamDescription = $event\" [maxLength]=\"1000\" placeholder=\"Objetivo deste time\"\r\n          ariaLabel=\"Descrição do time\" />\r\n      </div>\r\n      <label><span>Cor</span><input [(ngModel)]=\"newTeamColor\" name=\"teamColor\" type=\"color\"></label>\r\n      <div class=\"team-form-actions\"><button type=\"button\" class=\"cancel-btn\" (click)=\"creatingTeam.set(false)\"\r\n          *ngIf=\"teams().length\">Voltar</button><button class=\"primary-btn\" type=\"submit\"\r\n          [disabled]=\"!newBoardName.trim()\">Criar time</button></div>\r\n    </form>\r\n\r\n    <div class=\"team-management\" *ngIf=\"!creatingTeam() && currentTeam() as team\">\r\n      <div class=\"team-summary\"><span class=\"team-logo\"\r\n          [style.background]=\"team.color\"><mat-icon>groups</mat-icon></span>\r\n        <div>\r\n          <h3>{{ team.name }}</h3>\r\n          <p>{{ team.memberCount }} membro{{ team.memberCount !== 1 ? 's' : '' }} · {{ team.myRole === 'admin' ? 'Você\r\n            administra este time' : 'Você é membro' }}</p>\r\n        </div><button class=\"danger-icon\" *ngIf=\"team.myRole === 'admin'\" (click)=\"removeTeam()\"\r\n          matTooltip=\"Excluir time\"><mat-icon>delete_outline</mat-icon></button>\r\n      </div>\r\n      <div class=\"invite-row\" *ngIf=\"team.myRole === 'admin'\"><select [(ngModel)]=\"invitedUserId\">\r\n          <option value=\"\">Selecione uma pessoa para convidar</option>\r\n          <option *ngFor=\"let user of inviteableUsers()\" [value]=\"user.id\">{{ user.name }} · {{ user.email }}</option>\r\n        </select><button class=\"primary-btn\" (click)=\"inviteMember()\"\r\n          [disabled]=\"!invitedUserId\"><mat-icon>person_add</mat-icon>Convidar</button></div>\r\n      <div class=\"member-list\">\r\n        <h4>Membros</h4>\r\n        <div class=\"member-row\" *ngFor=\"let member of service.teamMembers()\"><img [src]=\"memberAvatar(member.user_id)\"\r\n            [alt]=\"memberName(member.user_id)\" (error)=\"$any($event.target).src = defaultAvatar\">\r\n          <div><strong>{{ memberName(member.user_id) }}</strong><span>{{ member.role === 'admin' ? 'Administrador' :\r\n              'Membro' }}</span></div>\r\n          <span *ngIf=\"isTeamOwner(member.user_id)\" class=\"owner-badge\" matTooltip=\"Criador do time\">\r\n            <mat-icon>shield</mat-icon>\r\n          </span>\r\n          <ng-container *ngIf=\"team.myRole === 'admin' && !isTeamOwner(member.user_id)\">\r\n            <button *ngIf=\"member.role !== 'admin'\" class=\"icon-btn promote-btn\"\r\n              (click)=\"changeMemberRole(member.id, 'admin')\" matTooltip=\"Promover a administrador\">\r\n              <mat-icon>manage_accounts</mat-icon>\r\n            </button>\r\n            <button *ngIf=\"member.role === 'admin'\" class=\"icon-btn\"\r\n              (click)=\"changeMemberRole(member.id, 'member')\" matTooltip=\"Rebaixar a membro\">\r\n              <mat-icon>person_outline</mat-icon>\r\n            </button>\r\n            <button class=\"danger-icon\" (click)=\"removeMember(member.id)\"\r\n              matTooltip=\"Remover do time\"><mat-icon>person_remove</mat-icon></button>\r\n          </ng-container>\r\n        </div>\r\n      </div>\r\n      <button class=\"new-team-link\" (click)=\"creatingTeam.set(true)\"><mat-icon>add</mat-icon>Criar outro time</button>\r\n    </div>\r\n  </section>\r\n</div>","import { Injectable, inject } from '@angular/core';\nimport { HttpClient } from '@angular/common/http';\nimport { Observable } from 'rxjs';\nimport { MuralBoard, MuralBoardSummary, MuralGroup, MuralItem, MuralItemInput } from '../../../core/models/mural.model';\n\n@Injectable({ providedIn: 'root' })\nexport class MuralBoardApiService {\n  private http = inject(HttpClient);\n\n  obterMurais(userId: string): Observable<MuralBoardSummary[]> {\n    return this.http.get<MuralBoardSummary[]>('/api/mural/boards', {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  obterMural(muralId: string, userId: string): Observable<{ board: MuralBoardSummary; groups: MuralGroup[]; items: MuralItem[]; teamMembers: any[] }> {\n    return this.http.get<{ board: MuralBoardSummary; groups: MuralGroup[]; items: MuralItem[]; teamMembers: any[] }>(\n      `/api/mural/boards/${muralId}`,\n      { headers: { 'x-user-id': userId } }\n    );\n  }\n\n  salvarMural(dados: { name: string; description?: string; color?: string; scopeType?: string; teamId?: string | null }, userId: string): Observable<MuralBoardSummary> {\n    return this.http.post<MuralBoardSummary>('/api/mural/boards', dados, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  atualizarMural(muralId: string, dados: Partial<MuralBoardSummary>, userId: string): Observable<MuralBoardSummary> {\n    return this.http.put<MuralBoardSummary>(`/api/mural/boards/${muralId}`, dados, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  excluirMural(muralId: string, userId: string): Observable<{ success: boolean }> {\n    return this.http.delete<{ success: boolean }>(`/api/mural/boards/${muralId}`, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  salvarGrupo(muralId: string, dados: { title: string; color?: string }, userId: string): Observable<MuralGroup> {\n    return this.http.post<MuralGroup>(`/api/mural/boards/${muralId}/groups`, dados, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  atualizarGrupo(groupId: string, dados: Partial<MuralGroup>, userId: string): Observable<MuralGroup> {\n    return this.http.put<MuralGroup>(`/api/mural/groups/${groupId}`, dados, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  excluirGrupo(groupId: string, userId: string): Observable<{ success: boolean }> {\n    return this.http.delete<{ success: boolean }>(`/api/mural/groups/${groupId}`, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  reordenarGrupos(muralId: string, groupIds: string[], userId: string): Observable<MuralGroup[]> {\n    return this.http.put<MuralGroup[]>(`/api/mural/boards/${muralId}/groups/reorder`, { groupIds }, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  reordenarMurais(boardIds: string[], userId: string): Observable<{ success: boolean }> {\n    return this.http.put<{ success: boolean }>('/api/mural/boards/reorder', { boardIds }, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  alternarFixacao(itemId: string, isPinned: boolean, userId: string): Observable<MuralItem> {\n    return this.http.put<MuralItem>(`/api/mural/items/${itemId}`, { isPinned }, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  moverItemParaGrupo(itemId: string, groupId: string | null, userId: string): Observable<MuralItem> {\n    return this.http.put<MuralItem>(`/api/mural/items/${itemId}`, { groupId }, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  atualizarItem(itemId: string, dados: Partial<MuralItem>, userId: string): Observable<MuralItem> {\n    return this.http.put<MuralItem>(`/api/mural/items/${itemId}`, dados, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  excluirItem(itemId: string, userId: string): Observable<{ success: boolean }> {\n    return this.http.delete<{ success: boolean }>(`/api/mural/items/${itemId}`, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  adicionarMembroTime(teamId: string, userId: string, role: 'member' | 'admin', requesterId: string): Observable<{ success: boolean }> {\n    return this.http.post<{ success: boolean }>(`/api/mural/teams/${teamId}/members`, { userId, role }, {\n      headers: { 'x-user-id': requesterId }\n    });\n  }\n\n  removerMembroTime(teamId: string, userId: string, requesterId: string): Observable<{ success: boolean }> {\n    return this.http.delete<{ success: boolean }>(`/api/mural/teams/${teamId}/members/${userId}`, {\n      headers: { 'x-user-id': requesterId }\n    });\n  }\n}\n","import { Injectable, inject } from '@angular/core';\nimport { HttpClient } from '@angular/common/http';\nimport { Observable } from 'rxjs';\nimport { MuralItem, MuralItemInput } from '../../../core/models/mural.model';\nimport { Attachment } from '../../../core/models/attachment.model';\n\n@Injectable({ providedIn: 'root' })\nexport class MuralItemModalService {\n  private http = inject(HttpClient);\n\n  salvarItem(boardId: string, item: MuralItemInput, userId: string): Observable<MuralItem> {\n    return this.http.post<MuralItem>(`/api/mural/boards/${boardId}/items`, item, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  atualizarItem(itemId: string, item: Partial<MuralItem>, userId: string): Observable<MuralItem> {\n    return this.http.put<MuralItem>(`/api/mural/items/${itemId}`, item, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n\n  excluirItem(itemId: string, userId: string): Observable<{ success: boolean }> {\n    return this.http.delete<{ success: boolean }>(`/api/mural/items/${itemId}`, {\n      headers: { 'x-user-id': userId }\n    });\n  }\n}\n","import { Component, EventEmitter, Input, OnChanges, OnInit, Output, SimpleChanges, ViewChild, inject, signal } from '@angular/core';\nimport { CommonModule } from '@angular/common';\nimport { FormsModule } from '@angular/forms';\nimport { MatIconModule } from '@angular/material/icon';\nimport { MatTooltipModule } from '@angular/material/tooltip';\nimport { MatProgressSpinnerModule } from '@angular/material/progress-spinner';\nimport { MatMenuModule, MatMenuTrigger } from '@angular/material/menu';\nimport { MatDividerModule } from '@angular/material/divider';\nimport { DomSanitizer, SafeResourceUrl } from '@angular/platform-browser';\nimport { finalize, forkJoin, of } from 'rxjs';\n\nimport { MuralGroup, MuralItem, MuralItemInput } from '../../../core/models/mural.model';\nimport { Attachment } from '../../../core/models/attachment.model';\nimport { AttachmentsService } from '../../../core/services/attachments.service';\nimport { AuthService } from '../../../core/services/auth.service';\nimport { MuralItemModalService } from './mural-item-modal.service';\nimport { AiTextButtonComponent } from '../../../shared/components/ai-text-button/ai-text-button.component';\nimport { MarkdownEditorComponent } from '../../../shared/components/markdown-editor/markdown-editor.component';\nimport { MarkdownTextComponent } from '../../../shared/components/markdown-text/markdown-text.component';\nimport { AttachmentPreviewModalComponent } from '../../../shared/components/attachment-preview-modal/attachment-preview-modal.component';\nimport { detectFileType } from '../../../core/utils/code-highlight.util';\n\nexport interface MuralColorOption {\n  value: string;\n  name: string;\n  border: string;\n}\n\n@Component({\n  selector: 'app-mural-item-modal',\n  standalone: true,\n  imports: [\n    CommonModule,\n    FormsModule,\n    MatIconModule,\n    MatTooltipModule,\n    MatProgressSpinnerModule,\n    MatMenuModule,\n    MatDividerModule,\n    AiTextButtonComponent,\n    MarkdownEditorComponent,\n    MarkdownTextComponent,\n    AttachmentPreviewModalComponent,\n  ],\n  templateUrl: './mural-item-modal.component.html',\n  styleUrl: './mural-item-modal.component.scss',\n})\nexport class MuralItemModalComponent implements OnInit, OnChanges {\n  @ViewChild(MatMenuTrigger) contextMenuTrigger?: MatMenuTrigger;\n  @Input() boardId = '';\n  @Input() item: MuralItem | null = null;\n  @Input() groups: MuralGroup[] = [];\n  @Input() defaultGroupId: string | null = null;\n  @Input() isReadOnly = false;\n  @Output() close = new EventEmitter<void>();\n  @Output() saved = new EventEmitter<MuralItem>();\n  @Output() deleted = new EventEmitter<string>();\n\n  private service = inject(MuralItemModalService);\n  private attachmentsService = inject(AttachmentsService);\n  private auth = inject(AuthService);\n  private sanitizer = inject(DomSanitizer);\n\n  isEdit = false;\n\n  enableEditMode(): void {\n    this.isReadOnly = false;\n    this.isEdit = true;\n  }\n  title = '';\n  content = '';\n  selectedColor = '#fef08a';\n  selectedGroupId: string | null = null;\n  isPinned = false;\n  attachments: Attachment[] = [];\n  pendingFiles: File[] = [];\n\n  onContentChangeInView(newContent: string): void {\n    this.content = newContent;\n    if (this.item) {\n      this.service.atualizarItem(this.item.id, { content: newContent }, this.currentUserId).subscribe({\n        next: (updated) => {\n          this.saved.emit({ ...this.item!, ...updated, content: newContent });\n        },\n        error: (err) => console.error('Erro ao atualizar checklist do mural:', err),\n      });\n    }\n  }\n\n  getGroupName(): string | null {\n    if (!this.selectedGroupId) return null;\n    const group = this.groups.find(g => g.id === this.selectedGroupId);\n    return group ? group.title : null;\n  }\n\n  readonly colorOptions: MuralColorOption[] = [\n    { value: '#fef08a', name: 'Amarelo Clássico', border: '#facc15' },\n    { value: '#bbf7d0', name: 'Menta Pastel', border: '#86efac' },\n    { value: '#bae6fd', name: 'Azul Céu', border: '#7dd3fc' },\n    { value: '#fbcfe8', name: 'Rosa Suave', border: '#f472b6' },\n    { value: '#ddd6fe', name: 'Lavanda', border: '#a78bfa' },\n    { value: '#fed7aa', name: 'Pêssego', border: '#fb923c' },\n    { value: '#f1f5f9', name: 'Branco Neutro', border: '#cbd5e1' },\n    { value: '#334155', name: 'Grafite Escuro', border: '#475569' },\n  ];\n\n  loadingSalvar = false;\n  loadingExcluir = false;\n  loadingUpload = false;\n  readonly errorMessage = signal('');\n  readonly confirmDelete = signal(false);\n\n  // Context menu state (Angular Material)\n  contextMenuPosition = { x: 0, y: 0 };\n  contextAttachment: Attachment | null = null;\n  contextPendingIndex: number | null = null;\n\n  previewAttachmentUrl = signal<string | null>(null);\n  previewAttachmentName = signal('');\n  previewAttachmentMimeType = signal('');\n  previewAttachmentRawContent = signal<string | null>(null);\n  previewAttachmentByteSize = signal(0);\n  previewCurrentAttachment = signal<Attachment | null>(null);\n\n  get currentUserId(): string {\n    return this.auth.currentUser()?.id || 'anonymous';\n  }\n\n  get currentUserName(): string {\n    return this.auth.currentUser()?.name || '';\n  }\n\n  ngOnInit(): void {\n    this.pendingFiles = [];\n    this.errorMessage.set('');\n    this.confirmDelete.set(false);\n    if (this.item) {\n      this.isEdit = true;\n      this.title = this.item.title;\n      this.content = this.item.content;\n      this.selectedColor = this.item.color || '#fef08a';\n      this.selectedGroupId = this.item.groupId;\n      this.isPinned = this.item.isPinned;\n      this.attachments = [...(this.item.attachments || [])];\n    } else {\n      this.isEdit = false;\n      this.title = '';\n      this.content = '';\n      this.selectedColor = '#fef08a';\n      this.selectedGroupId = this.defaultGroupId;\n      this.isPinned = false;\n      this.attachments = [];\n    }\n  }\n\n  ngOnChanges(changes: SimpleChanges): void {\n    if (changes['item'] && this.item) {\n      this.title = this.item.title;\n      this.content = this.item.content;\n      this.selectedColor = this.item.color || '#fef08a';\n      this.selectedGroupId = this.item.groupId;\n      this.isPinned = this.item.isPinned;\n      this.attachments = [...(this.item.attachments || [])];\n    }\n  }\n\n  fechar(): void {\n    this.close.emit();\n  }\n\n  salvar(): void {\n    if (this.loadingSalvar || !this.title.trim()) return;\n\n    this.errorMessage.set('');\n    this.loadingSalvar = true;\n    if (this.isEdit && this.item) {\n      this.service.atualizarItem(this.item.id, {\n        title: this.title.trim(),\n        content: this.content,\n        color: this.selectedColor,\n        groupId: this.selectedGroupId,\n        isPinned: this.isPinned,\n      }, this.currentUserId).subscribe({\n        next: (updated) => {\n          this.uploadPendingFiles(this.item!.id, (uploadedAtts) => {\n            this.loadingSalvar = false;\n            this.saved.emit({ ...updated, attachments: [...this.attachments, ...uploadedAtts] });\n            this.fechar();\n          });\n        },\n        error: (err) => {\n          this.loadingSalvar = false;\n          this.errorMessage.set(err.error?.error || 'Erro ao salvar alterações no cartão.');\n          console.error('Erro ao salvar nota do mural:', err);\n        }\n      });\n    } else {\n      const payload: MuralItemInput = {\n        title: this.title.trim(),\n        content: this.content,\n        color: this.selectedColor,\n        groupId: this.selectedGroupId,\n        isPinned: this.isPinned,\n        createdByName: this.currentUserName,\n      };\n\n      this.service.salvarItem(this.boardId, payload, this.currentUserId).subscribe({\n        next: (created) => {\n          this.uploadPendingFiles(created.id, (uploadedAtts) => {\n            this.loadingSalvar = false;\n            this.saved.emit({ ...created, attachments: uploadedAtts });\n            this.fechar();\n          });\n        },\n        error: (err) => {\n          this.loadingSalvar = false;\n          this.errorMessage.set(err.error?.error || 'Erro ao criar cartão no mural.');\n          console.error('Erro ao criar nota do mural:', err);\n        }\n      });\n    }\n  }\n\n  private uploadPendingFiles(itemId: string, callback: (atts: Attachment[]) => void): void {\n    if (!this.pendingFiles.length) {\n      callback([]);\n      return;\n    }\n\n    const uploads$ = this.pendingFiles.map(file =>\n      this.attachmentsService.upload('mural_item', itemId, file, this.currentUserId)\n    );\n\n    forkJoin(uploads$).pipe(\n      finalize(() => {\n        this.pendingFiles = [];\n      })\n    ).subscribe({\n      next: (results) => {\n        callback(results);\n      },\n      error: (err) => {\n        console.error('Erro ao fazer upload de arquivos pendentes:', err);\n        this.errorMessage.set(err.error?.error || 'Não foi possível enviar todos os anexos.');\n        callback([]);\n      }\n    });\n  }\n\n  excluir(): void {\n    if (!this.isEdit || !this.item || this.loadingExcluir) return;\n    \n    // Confirmação in-app em 2 etapas\n    if (!this.confirmDelete()) {\n      this.confirmDelete.set(true);\n      return;\n    }\n\n    this.loadingExcluir = true;\n    this.service.excluirItem(this.item.id, this.currentUserId)\n      .pipe(finalize(() => { this.loadingExcluir = false; }))\n      .subscribe({\n        next: () => {\n          this.deleted.emit(this.item!.id);\n          this.fechar();\n        },\n        error: (err) => {\n          this.errorMessage.set(err.error?.error || 'Erro ao excluir o cartão.');\n          console.error('Erro ao excluir nota:', err);\n        }\n      });\n  }\n\n  cancelarExclusao(): void {\n    this.confirmDelete.set(false);\n  }\n\n  onFilesSelected(event: Event): void {\n    const input = event.target as HTMLInputElement;\n    const files = Array.from(input.files || []);\n    if (!files.length) return;\n\n    this.errorMessage.set('');\n\n    if (this.isEdit && this.item) {\n      // Faz upload imediato dos múltiplos arquivos\n      this.loadingUpload = true;\n      const uploads$ = files.map(file =>\n        this.attachmentsService.upload('mural_item', this.item!.id, file, this.currentUserId)\n      );\n\n      forkJoin(uploads$).pipe(\n        finalize(() => {\n          this.loadingUpload = false;\n          input.value = '';\n        })\n      ).subscribe({\n        next: (uploadedList) => {\n          this.attachments.push(...uploadedList);\n          this.saved.emit({ ...this.item!, attachments: [...this.attachments] });\n        },\n        error: (err) => {\n          console.error('Erro ao enviar anexos:', err);\n          this.errorMessage.set(err.error?.error || 'Não foi possível enviar um ou mais anexos. Verifique o limite de 10 MB por arquivo.');\n        }\n      });\n    } else {\n      // Adiciona na fila pendente para quando o item for criado\n      this.pendingFiles.push(...files);\n      input.value = '';\n    }\n  }\n\n  removerPendingFile(index: number): void {\n    this.pendingFiles.splice(index, 1);\n  }\n\n  removerAnexo(att: Attachment): void {\n    this.attachmentsService.remove(att.id, this.currentUserId).subscribe({\n      next: () => {\n        this.attachments = this.attachments.filter(a => a.id !== att.id);\n        if (this.isEdit && this.item) {\n          this.saved.emit({ ...this.item, attachments: [...this.attachments] });\n        }\n      },\n      error: (err) => {\n        this.errorMessage.set(err.error?.error || 'Não foi possível remover o anexo.');\n        console.error('Erro ao remover anexo:', err);\n      }\n    });\n  }\n\n  getFileInfo(fileName: string, mimeType?: string) {\n    return detectFileType(fileName, mimeType);\n  }\n\n  abrirPreview(att: Attachment): void {\n    const fileInfo = detectFileType(att.fileName, att.mimeType);\n    this.previewCurrentAttachment.set(att);\n    this.previewAttachmentName.set(att.fileName);\n    this.previewAttachmentMimeType.set(att.mimeType);\n    this.previewAttachmentByteSize.set(att.byteSize);\n\n    if (fileInfo.category === 'code' || fileInfo.category === 'other' || att.mimeType.startsWith('text/')) {\n      this.attachmentsService.text(att.id, this.currentUserId).subscribe({\n        next: (text) => {\n          this.previewAttachmentRawContent.set(text);\n          this.attachmentsService.content(att.id, this.currentUserId).subscribe({\n            next: (blob) => {\n              const url = URL.createObjectURL(blob);\n              this.previewAttachmentUrl.set(url);\n            }\n          });\n        },\n        error: () => {\n          this.attachmentsService.content(att.id, this.currentUserId).subscribe({\n            next: (blob) => {\n              const url = URL.createObjectURL(blob);\n              this.previewAttachmentUrl.set(url);\n            }\n          });\n        }\n      });\n    } else {\n      this.previewAttachmentRawContent.set(null);\n      this.attachmentsService.content(att.id, this.currentUserId).subscribe({\n        next: (blob) => {\n          const url = URL.createObjectURL(blob);\n          this.previewAttachmentUrl.set(url);\n        }\n      });\n    }\n  }\n\n  abrirPendingPreview(file: File): void {\n    const fileInfo = detectFileType(file.name, file.type);\n    this.previewCurrentAttachment.set(null);\n    this.previewAttachmentName.set(file.name);\n    this.previewAttachmentMimeType.set(file.type || '');\n    this.previewAttachmentByteSize.set(file.size);\n\n    if (fileInfo.category === 'code' || file.type.startsWith('text/')) {\n      file.text().then(text => {\n        this.previewAttachmentRawContent.set(text);\n        const url = URL.createObjectURL(file);\n        this.previewAttachmentUrl.set(url);\n      }).catch(() => {\n        const url = URL.createObjectURL(file);\n        this.previewAttachmentUrl.set(url);\n      });\n    } else {\n      this.previewAttachmentRawContent.set(null);\n      const url = URL.createObjectURL(file);\n      this.previewAttachmentUrl.set(url);\n    }\n  }\n\n  fecharPreview(): void {\n    const current = this.previewAttachmentUrl();\n    if (current) URL.revokeObjectURL(current);\n    this.previewAttachmentUrl.set(null);\n    this.previewAttachmentName.set('');\n    this.previewAttachmentMimeType.set('');\n    this.previewAttachmentRawContent.set(null);\n    this.previewAttachmentByteSize.set(0);\n    this.previewCurrentAttachment.set(null);\n  }\n\n  baixarAnexo(att?: Attachment | null): void {\n    const target = att || this.previewCurrentAttachment();\n    if (target) {\n      this.attachmentsService.download(target, this.currentUserId);\n    }\n  }\n\n  formatarTamanho(bytes: number): string {\n    if (!bytes) return '0 B';\n    if (bytes < 1024) return `${bytes} B`;\n    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;\n    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;\n  }\n\n  onAttachmentContextMenu(event: MouseEvent, att: Attachment): void {\n    event.preventDefault();\n    event.stopPropagation();\n    this.contextAttachment = att;\n    this.contextPendingIndex = null;\n    this.contextMenuPosition = { x: event.clientX, y: event.clientY };\n    setTimeout(() => {\n      this.contextMenuTrigger?.openMenu();\n    });\n  }\n\n  onPendingContextMenu(event: MouseEvent, index: number): void {\n    event.preventDefault();\n    event.stopPropagation();\n    this.contextAttachment = null;\n    this.contextPendingIndex = index;\n    this.contextMenuPosition = { x: event.clientX, y: event.clientY };\n    setTimeout(() => {\n      this.contextMenuTrigger?.openMenu();\n    });\n  }\n}\n","<div class=\"modal-backdrop\">\n  <div class=\"modal-wrapper\">\n\n    <!-- Header Fixo -->\n    <div class=\"modal-header\">\n      <div class=\"header-main\">\n        <div class=\"header-icon-badge\" [class.edit-mode]=\"isEdit\" [style.background]=\"selectedColor\">\n          <mat-icon class=\"material-icon\" [style.color]=\"selectedColor === '#334155' ? '#ffffff' : '#0f172a'\">\n            {{ isPinned ? 'push_pin' : (isEdit ? 'edit_note' : 'sticky_note_2') }}\n          </mat-icon>\n        </div>\n        <div class=\"header-title-box\">\n          <h2>{{ isReadOnly ? 'Detalhes do Cartão' : (isEdit ? 'Editar Cartão do Mural' : 'Novo Cartão no Mural') }}</h2>\n          <p>{{ isReadOnly ? 'Visualização dos dados, avisos e anexos deste cartão.' : (isEdit ? 'Atualize as informações, anexos ou estilo do aviso.' : 'Adicione uma nota, documento ou comunicado ao mural.') }}</p>\n        </div>\n      </div>\n      <button type=\"button\" class=\"close-btn\" (click)=\"fechar()\" title=\"Fechar\">\n        <mat-icon class=\"material-icon\">close</mat-icon>\n      </button>\n    </div>\n\n    <!-- Scrollable Body -->\n    <div class=\"modal-body\">\n      <!-- Banner de Erro/Aviso In-App -->\n      <div class=\"in-app-alert-banner\" *ngIf=\"errorMessage()\">\n        <mat-icon class=\"alert-icon\">error_outline</mat-icon>\n        <span class=\"alert-text\">{{ errorMessage() }}</span>\n        <button type=\"button\" class=\"alert-close\" (click)=\"errorMessage.set('')\" title=\"Fechar aviso\">\n          <mat-icon>close</mat-icon>\n        </button>\n      </div>\n\n      <!-- Modo Visualização Limpo & Elegante -->\n      <div class=\"read-only-view-container\" *ngIf=\"isReadOnly\">\n        <div class=\"view-content-card\" [style.border-left-color]=\"selectedColor\">\n          <div class=\"view-header-row\">\n            <h1 class=\"view-title\">{{ title || 'Sem título' }}</h1>\n 