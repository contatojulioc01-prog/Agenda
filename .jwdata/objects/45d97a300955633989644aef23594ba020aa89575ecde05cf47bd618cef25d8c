GroupId,\r\n            date: occ.date,\r\n            endDate: occ.endDate,\r\n          },\r\n          created => {\r\n            if (created) createdEvents.push(created);\r\n            if (--pending === 0) {\r\n              onComplete?.(createdEvents.length > 0 ? createdEvents : null);\r\n            }\r\n          }\r\n        );\r\n      });\r\n    });\r\n  }\r\n\r\n  /** Atualiza evento existente no backend */\r\n  update(id: string, changes: Partial<Omit<CalendarEvent, 'id'>>, onComplete?: (updated: CalendarEvent | null) => void): void {\r\n    if (this.events().find(event => event.id === id)?.isSystem) { onComplete?.(null); return; }\r\n    const userId = this.currentUserId();\r\n    if (!userId) { this.error.set('Usuário não identificado para salvar no PostgreSQL.'); onComplete?.(null); return; }\r\n    this.error.set('');\r\n\r\n    // Converte camelCase para o formato esperado pelo backend\r\n    const body: Record<string, unknown> = {};\r\n    if (changes.title !== undefined) body['title'] = changes.title;\r\n    if (changes.description !== undefined) body['description'] = changes.description;\r\n    if (changes.date !== undefined) body['date'] = changes.date;\r\n    if (changes.endDate !== undefined) body['endDate'] = changes.endDate;\r\n    if (changes.startTime !== undefined) body['startTime'] = changes.startTime;\r\n    if (changes.endTime !== undefined) body['endTime'] = changes.endTime;\r\n    if (changes.dayTimes !== undefined) body['dayTimes'] = changes.dayTimes;\r\n    if (changes.color !== undefined) body['color'] = changes.color;\r\n    if (changes.category !== undefined) body['category'] = changes.category;\r\n    if (changes.allDay !== undefined) body['allDay'] = changes.allDay;\r\n\r\n    this.http.put<CalendarEvent>(\r\n      `${getBackendUrl()}/api/events/${id}`,\r\n      body,\r\n      { headers: { 'x-user-id': userId } }\r\n    ).pipe(catchError(err => {\r\n      this.error.set(err.error?.error || 'Não foi possível atualizar o evento no PostgreSQL.');\r\n      return of(null);\r\n    })).subscribe(updated => {\r\n      if (updated) this.events.update(list => list.map(event => event.id === id ? updated : event));\r\n      onComplete?.(updated);\r\n    });\r\n  }\r\n\r\n  setAttachments(id: string, attachments: Attachment[]): void {\r\n    this.events.update(list => list.map(event => event.id === id ? { ...event, attachments } : event));\r\n  }\r\n\r\n  /** Remove evento no backend */\r\n  remove(id: string, onComplete?: (success: boolean) => void): void {\r\n    if (this.events().find(event => event.id === id)?.isSystem) { onComplete?.(false); return; }\r\n    const userId = this.currentUserId();\r\n    if (!userId) { this.error.set('Usuário não identificado para excluir no PostgreSQL.'); onComplete?.(false); return; }\r\n    this.error.set('');\r\n    this.http.delete(`${getBackendUrl()}/api/events/${id}`, { headers: { 'x-user-id': userId } })\r\n      .pipe(catchError(err => {\r\n        this.error.set(err.error?.error || 'Não foi possível excluir o evento no PostgreSQL.');\r\n        return of(null);\r\n      })).subscribe(result => {\r\n        if (result) this.events.update(list => list.filter(event => event.id !== id));\r\n        onComplete?.(!!result);\r\n      });\r\n  }\r\n\r\n  /** Move evento para outra data (drag & drop) */\r\n  moveToDate(id: string, newDate: string, newStartTime?: string, newEndTime?: string): void {\r\n    const changes: Partial<CalendarEvent> = { date: newDate };\r\n    if (newStartTime) changes.startTime = newStartTime;\r\n    if (newEndTime) changes.endTime = newEndTime;\r\n    this.update(id, changes);\r\n  }\r\n}\r\n","import { Injectable } from '@angular/core';\r\nimport { HttpClient } from '@angular/common/http';\r\nimport { Observable, of, tap, catchError } from 'rxjs';\r\nimport { Holiday } from '../models/holiday.model';\r\n\r\nfunction getBackendUrl(): string {\r\n  return '';\r\n}\r\n\r\n@Injectable({ providedIn: 'root' })\r\nexport class HolidaysService {\r\n  private cache = new Map<number, Holiday[]>();\r\n\r\n  constructor(private http: HttpClient) {}\r\n\r\n  getHolidays(year: number): Observable<Holiday[]> {\r\n    if (this.cache.has(year)) {\r\n      return of(this.cache.get(year)!);\r\n    }\r\n    return this.http.get<Holiday[]>(`${getBackendUrl()}/api/holidays/${year}`).pipe(\r\n      tap(data => this.cache.set(year, data)),\r\n      catchError(() => of([]))\r\n    );\r\n  }\r\n\r\n  isHoliday(date: string, holidays: Holiday[]): Holiday | undefined {\r\n    return holidays.find(h => h.date === date);\r\n  }\r\n}\r\n","export interface UserAll {\r\n  success: boolean;\r\n  message: any;\r\n  data: {\r\n    userResponses: UserResponse[];\r\n  };\r\n  errors: any;\r\n  meta: any;\r\n}\r\n\r\nexport interface UserResponse {\r\n  id: string;\r\n  createdAt: string;\r\n  updatedAt: string;\r\n  name: string;\r\n  email: string;\r\n  departamentId: string;\r\n  avatar: string;\r\n  isActive: boolean;\r\n  departament: Departament;\r\n  roles: Role[];\r\n  pemisssions: Permission[];\r\n}\r\n\r\nexport interface Departament {\r\n  id: string;\r\n  name: string;\r\n}\r\n\r\nexport interface Role {\r\n  id: string;\r\n  name: string;\r\n}\r\n\r\nexport interface Permission {\r\n  id: string;\r\n  name: string;\r\n}\r\n\r\nexport interface UserMe {\r\n  success?: boolean;\r\n  message?: any;\r\n  avatar?: string;\r\n  name?: string;\r\n  email?: string;\r\n  data?: {\r\n    id: string;\r\n    name?: string;\r\n    email: string;\r\n    avatar?: string;\r\n    departament?: Departament;\r\n    departamentName?: string;\r\n    roles?: string[];\r\n    permissions?: string[];\r\n  };\r\n  errors?: any;\r\n  meta?: any;\r\n}\r\n\r\nexport interface UserProfile {\r\n  id: string;\r\n  name: string;\r\n  email: string;\r\n  avatar?: string;\r\n  departamentName?: string;\r\n  roles: string[];\r\n  permissions: string[];\r\n}\r\n\r\n/** Avatar corporativo padrão caso o usuário não possua foto cadastrada */\r\nexport const DEFAULT_AVATAR = `data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\"><circle cx=\"32\" cy=\"32\" r=\"32\" fill=\"%236366f1\"/><path d=\"M32 34c5.523 0 10-4.477 10-10s-4.477-10-10-10-10 4.477-10 10 4.477 10 10 10zm0 4c-6.67 0-20 3.34-20 10v4h40v-4c0-6.66-13.33-10-20-10z\" fill=\"%23ffffff\"/></svg>`;\r\n\r\n","import { Injectable, signal, inject } from '@angular/core';\r\nimport { HttpClient } from '@angular/common/http';\r\nimport { Router } from '@angular/router';\r\nimport { Observable, of, forkJoin, throwError } from 'rxjs';\r\nimport { map, catchError } from 'rxjs/operators';\r\nimport { UserMe, UserResponse, UserProfile, DEFAULT_AVATAR } from '../models/user.model';\r\n\r\nfunction getApiBase(): string {\r\n  // Retorna caminho relativo para ser interceptado pelo proxy.conf.json do Angular\r\n  // escondendo totalmente o IP e Porta reais do backend no F12 -> Network\r\n  return '/api';\r\n}\r\n\r\n@Injectable({ providedIn: 'root' })\r\nexport class AuthService {\r\n  private readonly http = inject(HttpClient);\r\n  private readonly router = inject(Router);\r\n  private readonly TOKEN_KEY = 'agenda_token';\r\n  private readonly initialToken = this.getInitialToken();\r\n\r\n  // Signals de estado\r\n  token = signal<string | null>(this.initialToken);\r\n  currentUser = signal<UserProfile | null>(null);\r\n  allUsers = signal<UserResponse[]>([]);\r\n  isLoading = signal<boolean>(false);\r\n  isAuthenticated = signal<boolean>(!!this.initialToken);\r\n\r\n  constructor() {\r\n    const currentToken = this.token();\r\n    if (currentToken) {\r\n      this.validateSsoTicket(currentToken).subscribe();\r\n    }\r\n  }\r\n\r\n  /** Captura o ticket ou token da URL (?ticket=... ou ?token=...) ou do localStorage */\r\n  private getInitialToken(): string | null {\r\n    if (typeof window !== 'undefined') {\r\n      try {\r\n        const urlParams = new URLSearchParams(window.location.search);\r\n        const urlTicket = urlParams.get('ticket') || urlParams.get('token');\r\n        if (urlTicket && urlTicket.trim().length > 0) {\r\n          const cleanToken = urlTicket.trim();\r\n          urlParams.delete('ticket');\r\n          urlParams.delete('token');\r\n          const remainingQuery = urlParams.toString();\r\n          const cleanUrl = `${window.location.pathname}${remainingQuery ? `?${remainingQuery}` : ''}${window.location.hash}`;\r\n          window.history.replaceState(window.history.state, document.title, cleanUrl);\r\n          if (this.isTokenExpired(cleanToken)) {\r\n            localStorage.removeItem(this.TOKEN_KEY);\r\n            return null;\r\n          }\r\n          localStorage.setItem(this.TOKEN_KEY, cleanToken);\r\n          return cleanToken;\r\n        }\r\n        const storedToken = localStorage.getItem(this.TOKEN_KEY);\r\n        if (storedToken && this.isTokenExpired(storedToken)) {\r\n          localStorage.removeItem(this.TOKEN_KEY);\r\n          return null;\r\n        }\r\n        return storedToken;\r\n      } catch {\r\n        return null;\r\n      }\r\n    }\r\n    return null;\r\n  }\r\n\r\n  /** Valida o ticket de handoff SSO enviando ao backend da Agenda */\r\n  validateSsoTicket(ticket: string): Observable<any> {\r\n    const proxyUrl = `${getApiBase()}/auth/sso-login`;\r\n    return this.http.post<any>(proxyUrl, { ticket }).pipe(\r\n      map(res => {\r\n        if (res && (res.success || res.token || res.data || res.user)) {\r\n          const sessionToken = res.token || ticket;\r\n          localStorage.setItem(this.TOKEN_KEY, sessionToken);\r\n          this.token.set(sessionToken);\r\n          this.isAuthenticated.set(true);\r\n\r\n          const meData = res.data || res.user;\r\n          if (meData && (meData.id || meData.email)) {\r\n            const profile: UserProfile = {\r\n              id: meData.id || meData.userId || '',\r\n              email: meData.email || '',\r\n              roles: meData.roles || [],\r\n              permissions: meData.permissions || [],\r\n              name: meData.name || meData.email?.split('@')[0] || 'Usuário',\r\n              avatar: meData.avatar || DEFAULT_AVATAR,\r\n              departamentName: meData.departamentName || meData.departament?.name || 'Geral',\r\n            };\r\n            if (profile.id) {\r\n              this.currentUser.set(profile);\r\n            }\r\n          }\r\n          this.loadUserData();\r\n          return res;\r\n        }\r\n        throw new Error(res?.error || 'Validação de ticket falhou');\r\n      }),\r\n      catchError(err => {\r\n        console.warn('[AuthService] Falha na validação de ticket SSO:', err.message);\r\n        this.loadUserData();\r\n        return of(null);\r\n      })\r\n    );\r\n  }\r\n\r\n  /** Define um novo token manualmente ou vindo de navegação */\r\n  setToken(token: string): boolean {\r\n    const cleanToken = token.trim();\r\n    if (cleanToken && !this.isTokenExpired(cleanToken)) {\r\n      if (this.token() === cleanToken && this.isLoading()) return true;\r\n      localStorage.setItem(this.TOKEN_KEY, cleanToken);\r\n      this.token.set(cleanToken);\r\n      this.isAuthenticated.set(true);\r\n\r\n      // Tenta validar como ticket SSO\r\n      this.validateSsoTicket(cleanToken).subscribe();\r\n      return true;\r\n    }\r\n    this.clearSession();\r\n    return false;\r\n  }\r\n\r\n  getToken(): string | null {\r\n    return this.token();\r\n  }\r\n\r\n  /** Carrega os dados do usuário atual e lista completa de colaboradores */\r\n  loadUserData(): void {\r\n    const currentToken = this.getToken();\r\n    if (!currentToken) {\r\n      this.currentUser.set(null);\r\n      this.isAuthenticated.set(false);\r\n      return;\r\n    }\r\n\r\n    this.isLoading.set(true);\r\n\r\n    forkJoin({\r\n      me: this.fetchMe(),\r\n      users: this.fetchUsers(),\r\n    }).subscribe({\r\n      next: ({ me, users }) => {\r\n        const userList = users || [];\r\n        this.allUsers.set(userList);\r\n\r\n        const meAny = me as any;\r\n        const meData = me?.data || meAny?.user || meAny;\r\n        if (me && (me.data || meAny.id || meAny.email)) {\r\n          const userEmail = meData?.email || meAny.email || '';\r\n          const userId = meData?.id || meAny.id || '';\r\n          const matchingUser = userList.find(u =>\r\n            (u.email && userEmail && u.email.toLowerCase() === userEmail.toLowerCase()) ||\r\n            (u.id && userId && u.id === userId)\r\n          );\r\n          const resolvedUserId = userId || matchingUser?.id;\r\n          if (!resolvedUserId) {\r\n            this.invalidateSession();\r\n            this.isLoading.set(false);\r\n            return;\r\n          }\r\n\r\n          const avatarUrl = meData?.avatar || meAny.avatar || meData?.icon || meAny.icon || matchingUser?.avatar || DEFAULT_AVATAR;\r\n\r\n          const profile: UserProfile = {\r\n            id: resolvedUserId,\r\n            email: userEmail || matchingUser?.email || '',\r\n            roles: meData?.roles || meAny.roles || [],\r\n            permissions: meData?.permissions || meAny.permissions || [],\r\n            name: meData?.name || meAny.name || matchingUser?.name || userEmail.split('@')[0] || 'Usuário',\r\n            avatar: avatarUrl,\r\n            departamentName: meData?.departament?.name || meData?.departamentName || matchingUser?.departament?.name || 'Geral',\r\n          };\r\n          this.currentUser.set(profile);\r\n          this.isAuthenticated.set(true);\r\n        } else this.invalidateSession();\r\n        this.isLoading.set(false);\r\n      },\r\n      error: err => {\r\n        if (err?.status === 401 || err?.status === 403) this.invalidateSession();\r\n        else {\r\n          this.currentUser.set(null);\r\n          this.allUsers.set([]);\r\n          this.isAuthenticated.set(false);\r\n        }\r\n        this.isLoading.set(false);\r\n      }\r\n    });\r\n  }\r\n\r\n  fetchMe(): Observable<UserMe> {\r\n    const proxyUrl = `${getApiBase()}/auth/me`;\r\n\r\n    return this.http.get<UserMe>(proxyUrl).pipe(\r\n      catchError(err => {\r\n        console.warn('[AuthService] /auth/me indisponível via proxy:', err.message);\r\n        return throwError(() => err);\r\n      })\r\n    );\r\n  }\r\n\r\n  fetchUsers(): Observable<UserResponse[]> {\r\n    const proxyUrl = `${getApiBase()}/users/all`;\r\n\r\n    return this.http.get<any>(proxyUrl).pipe(\r\n      catchError(() => this.http.get<any>(`${getApiBase()}/users`)),\r\n      map(res => this.extractUserList(res)),\r\n      catchError(err => {\r\n        console.warn('[AuthService] /users/all indisponível via proxy:', err.message);\r\n        return of([]);\r\n      })\r\n    );\r\n  }\r\n\r\n  private extractUserList(res: any): UserResponse[] {\r\n    let list: UserResponse[] = [];\r\n    if (!res) list = [];\r\n    else if (Array.isArray(res)) list = res;\r\n    else if (Array.isArray(res.data?.userResponses)) list = res.data.userResponses;\r\n    else if (Array.isArray(res.data?.users)) list = res.data.users;\r\n    else if (Array.isArray(res.data)) list = res.data;\r\n    else if (Array.isArray(res.userResponses)) list = res.userResponses;\r\n    else if (Array.isArray(res.users)) list = res.users;\r\n\r\n    // Filtra estritamente usuários com isActive === true\r\n    return list.filter(u => u && (u.isActive === true || (u as any).isActive === 'true' || (u as any).isActive === 1));\r\n  }\r\n\r\n  logout(): void {\r\n    this.clearSession();\r\n  }\r\n\r\n  private invalidateSession(): void {\n    const destination = this.router.url;\n    this.clearSession();\n    if (destination.startsWith('/unauthorized')) return;\n    void this.router.navigate(['/unauthorized'], { queryParams: { retorno: destination } });\n  }\r\n\r\n  private clearSession(): void {\r\n    try {\r\n      localStorage.removeItem(this.TOKEN_KEY);\r\n    } catch {}\r\n    this.token.set(null);\r\n    this.currentUser.set(null);\r\n    this.allUsers.set([]);\r\n    this.isAuthenticated.set(false);\r\n  }\r\n\r\n  private isTokenExpired(token: string): boolean {\r\n    try {\r\n      const payloadPart = token.split('.')[1];\r\n      if (!payloadPart) return false;\r\n      const normalized = payloadPart.replace(/-/g, '+').replace(/_/g, '/');\r\n      const padded = normalized.padEnd(Math.ceil(normalized.length / 4) * 4, '=');\r\n      const payload = JSON.parse(atob(padded));\r\n      return typeof payload.exp === 'number' && payload.exp * 1000 <= Date.now();\r\n    } catch {\r\n      return false;\r\n    }\r\n  }\r\n}\r\n","import { Injectable, signal, inject, computed } from '@angular/core';\r\nimport { HttpClient } from '@angular/common/http';\r\nimport { catchError, of, tap } from 'rxjs';\r\nimport { Calendar, CalendarMember, CalendarPermission } from '../models/calendar.model';\r\nimport { AuthService } from './auth.service';\r\nimport { UserResponse } from '../models/user.model';\r\n\r\nexport function getBackendUrl(): string {\r\n  // Retorna string vazia para usar caminhos relativos (ex: /api/calendars)\r\n  // O Angular proxy.conf.json irá redirecionar para o backend Node\r\n  return '';\r\n}\r\n\r\n@Injectable({ providedIn: 'root' })\r\nexport class CalendarsService {\r\n  private http = inject(HttpClient);\r\n  private authService = inject(AuthService);\r\n\r\n  /** Lista de todas as agendas acessíveis pelo usuário */\r\n  calendars = signal<Calendar[]>([]);\r\n\r\n  /** IDs das agendas visíveis no calendário (toggle de exibição) */\r\n  visibleCalendarIds = signal<Set<string>>(new Set());\r\n\r\n  /** Loading state */\r\n  isLoading = signal(false);\r\n  error = signal('');\r\n  private loadVersion = 0;\r\n\r\n  /** Agendas visíveis calculadas */\r\n  visibleCalendars = computed(() =>\r\n    this.calendars().filter(c => this.visibleCalendarIds().has(c.id))\r\n  );\r\n\r\n  private get userId(): string {\r\n    return this.authService.currentUser()?.id ?? 'anonymous';\r\n  }\r\n\r\n  private get headers() {\r\n    return { 'x-user-id': this.userId };\r\n  }\r\n\r\n  /** Carrega todas as agendas do usuário do backend */\r\n  loadAll(afterLoad?: (calendars: Calendar[]) => void): void {\r\n    if (!this.userId || this.userId === 'anonymous') return;\r\n    const version = ++this.loadVersion;\r\n    this.isLoading.set(true);\r\n    this.error.set('');\r\n\r\n    this.http.get<Calendar[]>(`${getBackendUrl()}/api/calendars`, { headers: this.headers })\r\n      .pipe(\r\n        catchError(err => {\r\n          console.warn('[CalendarsService] PostgreSQL/backend indisponível:', err.message);\r\n          this.error.set('Não foi possível carregar as agendas do PostgreSQL.');\r\n          return of(null);\r\n        }),\r\n        tap(cals => {\r\n          if (version !== this.loadVersion) return;\r\n          if (cals === null) {\r\n            this.isLoading.set(false);\r\n            afterLoad?.([]);\r\n            return;\r\n          }\r\n          const finalList = (Array.isArray(cals) ? cals : []).map(calendar => ({\r\n            ...calendar,\r\n            members: this.enrichMembersWithUserData(calendar.members || [], this.authService.allUsers()),\r\n          }));\r\n          this.calendars.set(finalList);\r\n\r\n          // Tornar todas visíveis por padrão\r\n          const currentId = [...this.visibleCalendarIds()][0];\r\n          const selectedId = finalList.some(calendar => calendar.id === currentId) ? currentId : finalList[0]?.id;\r\n          this.visibleCalendarIds.set(new Set(selectedId ? [selectedId] : []));\r\n          this.isLoading.set(false);\r\n          afterLoad?.(finalList);\r\n        })\r\n      ).subscribe();\r\n  }\r\n\r\n  /** Cria nova agenda */\r\n  create(\r\n    name: string,\r\n    color: string,\r\n    isPrivate: boolean,\r\n    initialMembers: { user_id: string; permission: CalendarPermission }[] = [],\r\n    onComplete?: (success: boolean) => void\r\n  ): void {\r\n    const payload = { name, color, isPrivate, members: initialMembers };\r\n    this.error.set('');\r\n    this.http.post<Calendar>(`${getBackendUrl()}/api/calendars`, payload, { headers: this.headers })\r\n      .pipe(catchError(err => {\r\n        this.error.set(err.error?.error || 'Não foi possível salvar a agenda no PostgreSQL.');\r\n        return of(null);\r\n      }))\r\n      .subscribe(cal => {\r\n        if (cal) {\r\n          this.calendars.update(list => {\r\n            const exists = list.some(calendar => calendar.id === cal.id);\r\n            return exists ? list.map(calendar => calendar.id === cal.id ? cal : calendar) : [...list, cal];\r\n          });\r\n          this.visibleCalendarIds.set(new Set([cal.id]));\r\n        }\r\n        onComplete?.(!!cal);\r\n      });\r\n  }\r\n\r\n  /** Atualiza agenda existente */\r\n  update(id: string, changes: Partial<Pick<Calendar, 'name' | 'color' | 'isPrivate'>>, onComplete?: (success: boolean) => void): void {\r\n    if (this.calendars().find(calendar => calendar.id === id)?.isTaskCalendar) {\r\n      this.error.set('A agenda Tarefas é gerenciada automaticamente pelo time.');\r\n      onComplete?.(false);\r\n      return;\r\n    }\r\n    this.error.set('');\r\n    this.http.put<Calendar>(`${getBackendUrl()}/api/calendars/${id}`, changes, { headers: this.headers })\r\n      .pipe(catchError(err => { this.error.set(err.error?.error || 'Não foi possível atualizar a agenda no PostgreSQL.'); return of(null); }))\r\n      .subscribe(updated => {\r\n        if (updated) {\r\n          this.calendars.update(list => list.map(c => c.id === id ? { ...c, ...updated } : c));\r\n        }\r\n        onComplete?.(!!updated);\r\n      });\r\n  }\r\n\r\n  /** Remove agenda */\r\n  remove(id: string, onComplete?: (success: boolean) => void): void {\r\n    const calendar = this.calendars().find(item => item.id === id);\r\n    if (calendar?.isDefault || calendar?.isTaskCalendar) {\r\n      this.error.set(calendar?.isTaskCalendar\r\n        ? 'A agenda Tarefas só pode ser excluída junto com o time.'\r\n        : 'A agenda padrão não pode ser excluída.');\r\n      onComplete?.(false);\r\n      return;\r\n    }\r\n    this.error.set('');\r\n    this.http.delete(`${getBackendUrl()}/api/calendars/${id}`, { headers: this.headers })\r\n      .pipe(catchError(err => { this.error.set(err.error?.error || 'Não foi possível excluir a agenda no PostgreSQL.'); return of(null); }))\r\n      .subscribe(result => {\r\n        if (!result) { onComplete?.(false); return; }\r\n        this.calendars.update(list => list.filter(c => c.id !== id));\r\n        const remaining = this.calendars();\r\n        const selected = [...this.visibleCalendarIds()][0];\r\n        const nextId = selected === id || !remaining.some(calendar => calendar.id === selected) ? remaining[0]?.id : selected;\r\n        this.visibleCalendarIds.set(new Set(nextId ? [nextId] : []));\r\n        onComplete?.(true);\r\n      });\r\n  }\r\n\r\n  /** Adiciona membro à agenda */\r\n  addMember(calendarId: string, userId: string, permission: CalendarPermission, onComplete?: (success: boolean) => void): void {\r\n    this.http.post<CalendarMember>(\r\n      `${getBackendUrl()}/api/calendars/${calendarId}/members`,\r\n      { userId, permission },\r\n      { headers: this.headers }\r\n    ).pipe(catchError(err => { this.error.set(err.error?.error || 'Não foi possível compartilhar a agenda.'); return of(null); }))\r\n      .subscribe(member => {\r\n        if (member && (member as CalendarMember & { status?: string }).status !== 'pending') {\r\n          this.calendars.update(list =>\r\n            list.map(c => c.id === calendarId\r\n              ? { ...c, members: [...(c.members || []), member] }\r\n              : c\r\n            )\r\n          );\r\n        }\r\n        onComplete?.(!!member);\r\n      });\r\n  }\r\n\r\n  /** Atualiza permissão de membro */\r\n  updateMemberPermission(calendarId: string, memberId: string, permission: CalendarPermission, onComplete?: (success: boolean) => void): void {\r\n    this.http.put(\r\n      `${getBackendUrl()}/api/calendars/${calendarId}/members/${memberId}`,\r\n      { permission },\r\n      { headers: this.headers }\r\n    ).pipe(catchError(err => { this.error.set(err.error?.error || 'Não foi possível atualizar a permissão.'); return of(null); }))\r\n      .subscribe(result => {\r\n        if (!result) { onComplete?.(false); return; }\r\n        this.calendars.update(list =>\r\n          list.map(c => c.id === calendarId\r\n            ? {\r\n                ...c,\r\n                members: c.members.map(m =>\r\n                  m.id === memberId ? { ...m, permission } : m\r\n                )\r\n              }\r\n            : c\r\n          )\r\n        );\r\n        onComplete?.(true);\r\n      });\r\n  }\r\n\r\n  /** Remove membro da agenda */\r\n  removeMember(calendarId: string, memberId: string, onComplete?: (success: boolean) => void): void {\r\n    this.http.delete(\r\n      `${getBackendUrl()}/api/calendars/${calendarId}/members/${memberId}`,\r\n      { headers: this.headers }\r\n    ).pipe(catchError(err => { this.error.set(err.error?.error || 'Não foi possível remover o membro.'); return of(null); }))\r\n      .subscribe(result => {\r\n        if (!result) { onComplete?.(false); return; }\r\n        this.calendars.update(list =>\r\n          list.map(c => c.id === calendarId\r\n            ? { ...c, members: c.members.filter(m => m.id !== memberId) }\r\n            : c\r\n          )\r\n        );\r\n        onComplete?.(true);\r\n      });\r\n  }\r\n\r\n  /** Toggle visibilidade de uma agenda */\r\n  toggleVisibility(calendarId: string): void {\r\n    this.visibleCalendarIds.set(new Set([calendarId]));\r\n  }\r\n\r\n  /** Seleciona exclusivamente apenas esta agenda */\r\n  selectOnly(calendarId: string): void {\r\n    this.visibleCalendarIds.set(new Set([calendarId]));\r\n  }\r\n\r\n  /** Seleciona todas as agendas */\r\n  selectAll(): void {\r\n    const firstId = this.calendars()[0]?.id;\r\n    this.visibleCalendarIds.set(new Set(firstId ? [firstId] : []));\r\n  }\r\n\r\n  /** Desmarca todas as agendas */\r\n  deselectAll(): void {\r\n    this.selectAll();\r\n  }\r\n\r\n  /** Verifica se todas estão selecionadas */\r\n  isAllSelected(): boolean {\r\n    const all = this.calendars();\r\n    if (all.length === 0) return false;\r\n    const current = this.visibleCalendarIds();\r\n    return all.every(c => current.has(c.id));\r\n  }\r\n\r\n  /** Verifica se apenas uma específica está selecionada */\r\n  isOnlySelected(calendarId: string): boolean {\r\n    const current = this.visibleCalendarIds();\r\n    return current.size === 1 && current.has(calendarId);\r\n  }\r\n\r\n  /** Verifica se o usuário pode editar (owner/editor) */\r\n  canEdit(calendarId: string): boolean {\r\n    const cal = this.calendars().find(c => c.id === calendarId);\r\n    if (!cal || cal.isTaskCalendar) return false;\r\n    return ['owner', 'editor'].includes(cal.my_permission ?? 'viewer');\r\n  }\r\n\r\n  /** Verifica se o usuário é dono */\r\n  isOwner(calendarId: string): boolean {\r\n    const cal = this.calendars().find(c => c.id === calendarId);\r\n    return !cal?.isTaskCalendar && cal?.my_permission === 'owner';\r\n  }\r\n\r\n  /** Enriquece membros com dados dos usuários da API corporativa */\r\n  enrichMembersWithUserData(members: CalendarMember[], allUsers: UserResponse[]): CalendarMember[] {\r\n    return members.map(m => {\r\n      const user = allUsers.find(u => u.id === m.user_id);\r\n      return {\r\n        ...m,\r\n        userName: user?.name ?? m.userName ?? m.user_id,\r\n        userEmail: user?.email ?? m.userEmail,\r\n        userAvatar: user?.avatar ?? m.userAvatar,\r\n      };\r\n    });\r\n  }\r\n\r\n  /** Sincroniza agenda específica do backend (chamada pelo SyncService) */\r\n  syncCalendar(calendarId: string): void {\r\n    this.http.get<Calendar[]>(`${getBackendUrl()}/api/calendars`, { headers: this.headers })\r\n      .pipe(catchError(() => of(null)))\r\n      .subscribe(cals => {\r\n        if (cals) this.calendars.set(cals.map(calendar => ({\r\n          ...calendar,\r\n          members: this.enrichMembersWithUserData(calendar.members || [], this.authService.allUsers()),\r\n        })));\r\n      });\r\n  }\r\n\r\n  getBackendUrl(): string {\r\n    return getBackendUrl();\r\n  }\r\n}\r\n","import { Injectable, inject, signal } from '@angular/core';\r\nimport { HttpClient } from '@angular/common/http';\r\nimport { catchError, of } from 'rxjs';\r\nimport { AuthService } from './auth.service';\r\n\r\nexport interface CalendarInvitation {\r\n  id: string;\r\n  calendar_id: string;\r\n  permission: 'editor' | 'viewer';\r\n  calendar_name: string;\r\n  calendar_color: string;\r\n  owner_id: string;\r\n}\r\n\r\n@Injectable({ providedIn: 'root' })\r\nexport class InvitationsService {\r\n  private http = inject(HttpClient);\r\n  private auth = inject(AuthService);\r\n  invitations = signal<CalendarInvitation[]>([]);\r\n\r\n  private get headers() { return { 'x-user-id': this.auth.currentUser()?.id ?? '' }; }\r\n\r\n  load(): void {\r\n    if (!this.auth.currentUser()?.id) return;\r\n    this.http.get<CalendarInvitation[]>('/api/calendars/invitations', { headers: this.headers })\r\n      .pipe(catchError(() => of([])))\r\n      .subscribe(items => this.invitations.set(items));\r\n  }\r\n\r\n  respond(invitation: CalendarInvitation, accept: boolean, done: () => void): void {\r\n    this.http.put(`/api/calendars/invitations/${invitation.id}`, { accept }, { headers: this.headers })\r\n      .pipe(catchError(() => of(null)))\r\n      .subscribe(result => {\r\n        if (result) this.invitations.update(items => items.filter(i => i.id !== invitation.id));\r\n        done();\r\n      });\r\n  }\r\n}\r\n","import { Injectable, inject, signal } from '@angular/core';\r\nimport { HttpClient } from '@angular/common/http';\r\nimport { catchError, finalize, of, tap } from 'rxjs';\r\nimport { AuthService } from './auth.service';\r\nimport { KanbanBoard, KanbanBoardSummary, KanbanColumn, KanbanTask, KanbanTaskInput, KanbanTeam, KanbanTeamInvitation, KanbanTeamMember } from '../models/kanban.model';\r\nimport { Attachment } from '../models/attachment.model';\r\n\r\n@Injectable({ providedIn: 'root' })\r\nexport class KanbanService {\r\n  private http = inject(HttpClient);\r\n  private auth = inject(AuthService);\r\n\r\n  readonly boards = signal<KanbanBoardSummary[]>([]);\r\n  readonly activeBoard = signal<KanbanBoard | null>(null);\r\n  readonly teams = signal<KanbanTeam[]>([]);\r\n  readonly teamInvitations = signal<KanbanTeamInvitation[]>([]);\r\n  readonly teamMembers = signal<KanbanTeamMember[]>([]);\r\n  readonly trash = signal<KanbanTask[]>([]);\r\n  readonly trashLoading = signal(false);\r\n  readonly loading = signal(false);\r\n  readonly error = signal('');\r\n  private boardLoadVersion = new Map<string, number>();\r\n  private boardsLoadVersion = 0;\r\n  private teamMembersLoadVersion = 0;\r\n\r\n  private get headers() { return { 'x-user-id': this.auth.currentUser()?.id || 'anonymous' }; }\r\n\r\n  loadBoards(selectId?: string): void {\r\n    if (this.headers['x-user-id'] === 'anonymous') return;\r\n    const version = ++this.boardsLoadVersion;\r\n    this.loading.set(true);\r\n    this.http.get<KanbanBoardSummary[]>('/api/kanban/boards', { headers: this.headers }).pipe(\r\n      catchError(err => { this.error.set(err.error?.error || 'Não foi possível carregar os quadros.'); return of(null); }),\r\n      finalize(() => this.loading.set(false))\r\n    ).subscribe(boards => {\r\n      if (version !== this.boardsLoadVersion) return;\r\n      if (boards === null) return;\r\n      this.boards.set(boards);\r\n      const requested = selectId || this.activeBoard()?.id;\r\n      const target = boards.some(board => board.id === requested) ? requested : boards[0]?.id;\r\n      if (target) this.loadBoard(target);\r\n      else this.activeBoard.set(null);\r\n    });\r\n  }\r\n\r\n  loadWorkspace(se