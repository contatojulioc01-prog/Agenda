r\n            @if (message.content) {\r\n              @let parsed = parseContent(message.content);\r\n\r\n              @if (parsed.text) {\r\n                <div class=\"message-content\" [innerHTML]=\"formatMessage(parsed.text)\"></div>\r\n              }\r\n\r\n              @if (parsed.optionsPrompt && message.role === 'assistant') {\r\n                <div class=\"ai-options-card\" [class.answered]=\"!!message.selectedOptions?.length\">\r\n                  @if (parsed.optionsPrompt.question) {\r\n                    <div class=\"ai-options-title\">\r\n                      <mat-icon class=\"title-icon\">help_outline</mat-icon>\r\n                      <span>{{ parsed.optionsPrompt.question }}</span>\r\n                    </div>\r\n                  }\r\n\r\n                  @if (message.selectedOptions?.length) {\r\n                    <div class=\"ai-options-answered-badge\">\r\n                      <mat-icon class=\"answered-icon\">check_circle</mat-icon>\r\n                      <span>Opção selecionada: <strong>{{ message.selectedOptions?.join(', ') }}</strong></span>\r\n                    </div>\r\n                  } @else {\r\n                    <div class=\"ai-options-grid\" [class.multi]=\"parsed.optionsPrompt.multiSelect\">\r\n                      @for (option of parsed.optionsPrompt.options; track option) {\r\n                        <button\r\n                          type=\"button\"\r\n                          class=\"ai-option-chip\"\r\n                          [class.selected]=\"isOptionPending(message.id, option)\"\r\n                          [disabled]=\"isLoading()\"\r\n                          (click)=\"onOptionClick(message, parsed.optionsPrompt, option)\">\r\n                          <span class=\"chip-label\">{{ option }}</span>\r\n                        </button>\r\n                      }\r\n                    </div>\r\n\r\n                    @if (parsed.optionsPrompt.multiSelect) {\r\n                      <div class=\"ai-options-footer\">\r\n                        <button\r\n                          type=\"button\"\r\n                          class=\"options-select-all-btn\"\r\n                          [disabled]=\"isLoading()\"\r\n                          (click)=\"toggleSelectAll(message.id, parsed.optionsPrompt.options)\">\r\n                          {{ isAllPendingSelected(message.id, parsed.optionsPrompt.options) ? 'Desmarcar todos' : 'Marcar todos' }}\r\n                        </button>\r\n\r\n                        <button\r\n                          type=\"button\"\r\n                          class=\"options-confirm-btn\"\r\n                          [disabled]=\"isLoading() || getPendingCount(message.id) === 0\"\r\n                          (click)=\"submitPendingSelection(message, parsed.optionsPrompt)\">\r\n                          <mat-icon>send</mat-icon>\r\n                          <span>Confirmar seleção ({{ getPendingCount(message.id) }})</span>\r\n                        </button>\r\n                      </div>\r\n                    }\r\n                  }\r\n                </div>\r\n              }\r\n            }\r\n            @if (!message.content && isLoading()) { <div class=\"typing\" aria-label=\"IA digitando\"><i></i><i></i><i></i></div> }\r\n          </article>\r\n        }\r\n      </div>\r\n      <footer class=\"ai-composer\">\r\n        <textarea [(ngModel)]=\"draft\" (keydown)=\"onKeydown($event)\" [disabled]=\"isLoading()\" rows=\"1\" maxlength=\"12000\" placeholder=\"Pergunte alguma coisa...\" aria-label=\"Mensagem para o assistente\"></textarea>\r\n        <button type=\"button\" class=\"send-button\" (click)=\"send()\" [disabled]=\"isLoading() || !draft.trim()\" aria-label=\"Enviar mensagem\"><mat-icon>{{ isLoading() ? 'hourglass_top' : 'arrow_upward' }}</mat-icon></button>\r\n        <small>Enter envia · Shift+Enter quebra a linha</small>\r\n      </footer>\r\n    }\r\n  </section>\r\n</div>\r\n","import { AfterViewInit, ChangeDetectorRef, Component, ElementRef, EventEmitter, HostBinding, HostListener, OnDestroy, Output, inject } from '@angular/core';\n\n@Component({\n  selector: 'app-livro-abrindo',\n  standalone: true,\n  templateUrl: './livro-abrindo.component.html',\n  styleUrl: './livro-abrindo.component.scss',\n})\nexport class LivroAbrindoComponent implements AfterViewInit, OnDestroy {\n  @Output() readonly opened = new EventEmitter<void>();\n  @HostBinding('class.opening') opening = false;\n  @HostBinding('class.positioned') positioned = false;\n  @HostBinding('class.dragging') dragging = false;\n  @HostBinding('style.left.px') left: number | null = null;\n  @HostBinding('style.top.px') top: number | null = null;\n\n  src = 'assets/livro-doce-brinquedo.svg#db-closed';\n  private readonly element = inject(ElementRef<HTMLElement>);\n  private readonly cdr = inject(ChangeDetectorRef);\n  private readonly positionStorageKey = 'agenda-ai-assistant-position';\n  private openingTimer?: number;\n  private activePointerId?: number;\n  private pointerStartX = 0;\n  private pointerStartY = 0;\n  private positionStartX = 0;\n  private positionStartY = 0;\n  private dragMoved = false;\n  private suppressClick = false;\n\n  constructor() {\n    this.restorePosition();\n  }\n\n  ngAfterViewInit(): void {\n    this.restorePosition();\n  }\n\n  replay(): void {\n    this.src = `assets/livro-doce-brinquedo.svg?t=${Date.now()}`;\n  }\n\n  openAssistant(): void {\n    if (this.opening) return;\n    const host = this.element.nativeElement;\n    const rect = host.getBoundingClientRect();\n\n    // Salvar a posição atual antes de iniciar a animação\n    if (this.left === null || this.top === null) {\n      this.left = rect.left;\n      this.top = rect.top;\n      this.positioned = true;\n    }\n    this.persistPosition();\n\n    // Calcular o deslocamento exato do centro do livro até o centro do viewport\n    const currentCenterX = rect.left + rect.width / 2;\n    const currentCenterY = rect.top + rect.height / 2;\n    const targetCenterX = window.innerWidth / 2;\n    const targetCenterY = window.innerHeight / 2;\n    const deltaX = Math.round(targetCenterX - currentCenterX);\n    const deltaY = Math.round(targetCenterY - currentCenterY);\n\n    host.style.setProperty('--move-x', `${deltaX}px`);\n    host.style.setProperty('--move-y', `${deltaY}px`);\n\n    this.replay();\n    this.opening = true;\n    this.cdr.detectChanges();\n\n    const openingDuration = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 80 : 750;\n    this.openingTimer = window.setTimeout(() => {\n      this.opened.emit();\n    }, openingDuration);\n  }\n\n  onPointerDown(event: PointerEvent): void {\n    if (this.opening || event.button !== 0) return;\n    const rect = this.element.nativeElement.getBoundingClientRect();\n    this.activePointerId = event.pointerId;\n    this.pointerStartX = event.clientX;\n    this.pointerStartY = event.clientY;\n    this.positionStartX = rect.left;\n    this.positionStartY = rect.top;\n    this.dragMoved = false;\n    this.dragging = true;\n    (event.currentTarget as HTMLElement).setPointerCapture(event.pointerId);\n  }\n\n  onPointerMove(event: PointerEvent): void {\n    if (event.pointerId !== this.activePointerId || this.opening) return;\n    const deltaX = event.clientX - this.pointerStartX;\n    const deltaY = event.clientY - this.pointerStartY;\n    if (!this.dragMoved && Math.hypot(deltaX, deltaY) < 5) return;\n    this.dragMoved = true;\n    event.preventDefault();\n    this.setPosition(this.positionStartX + deltaX, this.positionStartY + deltaY);\n  }\n\n  onPointerUp(event: PointerEvent): void {\n    if (event.pointerId !== this.activePointerId) return;\n    const target = event.currentTarget as HTMLElement;\n    if (target.hasPointerCapture(event.pointerId)) target.releasePointerCapture(event.pointerId);\n    this.activePointerId = undefined;\n    this.dragging = false;\n    if (!this.dragMoved) return;\n    this.suppressClick = true;\n    this.dragMoved = false;\n    this.persistPosition();\n    window.setTimeout(() => { this.suppressClick = false; }, 0);\n  }\n\n  onPointerCancel(event: PointerEvent): void {\n    if (event.pointerId !== this.activePointerId) return;\n    this.activePointerId = undefined;\n    this.dragging = false;\n    if (this.dragMoved) this.persistPosition();\n    this.dragMoved = false;\n  }\n\n  onClick(event: MouseEvent): void {\n    if (this.suppressClick) {\n      event.preventDefault();\n      return;\n    }\n    this.openAssistant();\n  }\n\n  @HostListener('window:resize')\n  keepInsideViewport(): void {\n    if (!this.positioned || this.opening || this.left === null || this.top === null) return;\n    this.setPosition(this.left, this.top);\n    this.persistPosition();\n  }\n\n  private setPosition(left: number, top: number): void {\n    const rect = this.element.nativeElement.getBoundingClientRect();\n    const margin = 8;\n    const maxLeft = Math.max(margin, window.innerWidth - rect.width - margin);\n    const maxTop = Math.max(margin, window.innerHeight - rect.height - margin);\n    this.left = Math.min(Math.max(left, margin), maxLeft);\n    this.top = Math.min(Math.max(top, margin), maxTop);\n    this.positioned = true;\n  }\n\n  private moveToViewportCenter(): void {\n    const host = this.element.nativeElement;\n    this.left = Math.max(0, (window.innerWidth - host.offsetWidth) / 2);\n    this.top = Math.max(0, (window.innerHeight - host.offsetHeight) / 2);\n  }\n\n  private persistPosition(): void {\n    if (this.left === null || this.top === null) return;\n    try {\n      localStorage.setItem(this.positionStorageKey, JSON.stringify({ left: this.left, top: this.top }));\n    } catch {}\n  }\n\n  private restorePosition(): void {\n    try {\n      const saved = JSON.parse(localStorage.getItem(this.positionStorageKey) || 'null');\n      if (Number.isFinite(saved?.left) && Number.isFinite(saved?.top)) this.setPosition(saved.left, saved.top);\n    } catch {}\n  }\n\n  ngOnDestroy(): void {\n    if (this.openingTimer !== undefined) window.clearTimeout(this.openingTimer);\n  }\n}\n","<button\n  type=\"button\"\n  class=\"livro-assistente\"\n  [class.opening]=\"opening\"\n  [disabled]=\"opening\"\n  [attr.aria-busy]=\"opening\"\n  (pointerdown)=\"onPointerDown($event)\"\n  (pointermove)=\"onPointerMove($event)\"\n  (pointerup)=\"onPointerUp($event)\"\n  (pointercancel)=\"onPointerCancel($event)\"\n  (click)=\"onClick($event)\"\n  aria-label=\"Abrir Assistente IA\"\n  title=\"Abrir Assistente IA\"\n>\n  <span class=\"livro-glow\" aria-hidden=\"true\"></span>\n  @if (opening) {\n    <img class=\"livro-svg\" [src]=\"src\" width=\"320\" alt=\"Livro Doce Brinquedo abrindo\" />\n  } @else {\n    <img class=\"livro-static\" src=\"assets/header-transparent.png\" alt=\"Abrir Assistente IA da Doce Brinquedo\" />\n  }\n  <span class=\"livro-label\">Assistente IA</span>\n</button>\n","import { Component, OnInit, OnDestroy, ViewChild, inject, computed, signal, effect, untracked } from '@angular/core';\nimport { toSignal } from '@angular/core/rxjs-interop';\nimport { CommonModule } from '@angular/common';\r\nimport { ActivatedRoute, Router } from '@angular/router';\r\nimport { MatDialog, MatDialogModule } from '@angular/material/dialog';\r\nimport { MatIconModule } from '@angular/material/icon';\r\nimport { MatTooltipModule } from '@angular/material/tooltip';\r\n\r\nimport { EventsService } from '../../../core/services/events.service';\r\nimport { HolidaysService } from '../../../core/services/holidays.service';\r\nimport { AuthService } from '../../../core/services/auth.service';\r\nimport { CalendarsService } from '../../../core/services/calendars.service';\r\nimport { SyncService } from '../../../core/services/sync.service';\r\nimport { InvitationsService, CalendarInvitation } from '../../../core/services/invitations.service';\r\nimport { Holiday } from '../../../core/models/holiday.model';\r\nimport { CalendarEvent } from '../../../c