\n    </button>\n\n    <button mat-menu-item (click)=\"applyContextFormat('strike')\" class=\"md-context-item\">\n      <div class=\"item-icon-box strike-icon\">\n        <mat-icon>strikethrough_s</mat-icon>\n      </div>\n      <span class=\"md-menu-label\">Riscado</span>\n      <span class=\"md-menu-badge\">~~texto~~</span>\n    </button>\n\n    <mat-divider></mat-divider>\n\n    <!-- Opções de Bloco e Estrutura -->\n    <div class=\"md-context-section-label\">Estrutura & Listas</div>\n\n    <button mat-menu-item (click)=\"applyContextFormat('heading')\" class=\"md-context-item\">\n      <div class=\"item-icon-box heading-icon\">\n        <mat-icon>title</mat-icon>\n      </div>\n      <span class=\"md-menu-label\">Título</span>\n      <span class=\"md-menu-badge\">### Título</span>\n    </button>\n\n    <button mat-menu-item (click)=\"applyContextFormat('quote')\" class=\"md-context-item\">\n      <div class=\"item-icon-box quote-icon\">\n        <mat-icon>format_quote</mat-icon>\n      </div>\n      <span class=\"md-menu-label\">Citação</span>\n      <span class=\"md-menu-badge\">&gt; texto</span>\n    </button>\n\n    <button mat-menu-item (click)=\"applyContextFormat('list')\" class=\"md-context-item\">\n      <div class=\"item-icon-box list-icon\">\n        <mat-icon>format_list_bulleted</mat-icon>\n      </div>\n      <span class=\"md-menu-label\">Lista com Marcadores</span>\n      <span class=\"md-menu-badge\">- item</span>\n    </button>\n\n    <button mat-menu-item (click)=\"applyContextFormat('checklist')\" class=\"md-context-item\">\n      <div class=\"item-icon-box check-icon\">\n        <mat-icon>checklist</mat-icon>\n      </div>\n      <span class=\"md-menu-label\">Lista de Tarefas</span>\n      <span class=\"md-menu-badge\">- [ ] item</span>\n    </button>\n\n    <mat-divider></mat-divider>\n\n    <!-- Opção de Hyperlink -->\n    <button mat-menu-item (click)=\"openContextLinkModal()\" class=\"md-context-item link-item\">\n      <div class=\"item-icon-box link-icon\">\n        <mat-icon>link</mat-icon>\n      </div>\n      <span class=\"md-menu-label\">{{ hasSelection() ? 'Criar Hyperlink' : 'Inserir Hyperlink' }}</span>\n      <span class=\"md-menu-badge link-badge\">[link](url)</span>\n    </button>\n  </mat-menu>\n\n  <!-- Rodapé com dicas de formatação e contador -->\n  <div class=\"markdown-editor-footer\">\n    <span class=\"footer-hint\">Formatação Markdown em tempo real · Clique com o botão direito para opções</span>\n    <span class=\"footer-counter\">{{ text.length }}/{{ maxLength }}</span>\n  </div>\n</div>\n\n<!-- ══════════════ MODAL DE CONFIGURAÇÃO DE HYPERLINK ══════════════ -->\n<div class=\"link-modal-backdrop\" *ngIf=\"showLinkModal()\" (click)=\"closeLinkModal()\">\n  <div class=\"link-modal-card\" (click)=\"$event.stopPropagation()\">\n    <!-- Header -->\n    <div class=\"link-modal-header\">\n      <div class=\"link-modal-title\">\n        <div class=\"link-modal-badge\">\n          <mat-icon>link</mat-icon>\n        </div>\n        <div>\n          <h4>{{ linkModalTarget()?.fullMarkdown || linkModalTarget()?.url ? 'Editar Hyperlink' : 'Inserir Hyperlink' }}</h4>\n          <span>Configure o nome visível e a URL de destino</span>\n        </div>\n      </div>\n      <button type=\"button\" class=\"btn-close-link-modal\" (click)=\"closeLinkModal()\" title=\"Fechar\">\n        <mat-icon>close</mat-icon>\n      </button>\n    </div>\n\n    <!-- Body -->\n    <div class=\"link-modal-body\">\n      <!-- Campo 1: Nome do Hyperlink (Texto de Exibição) -->\n      <div class=\"link-field\">\n        <label for=\"link-text-input\">\n          <mat-icon>title</mat-icon>\n          <span>Nome / Texto de Exibição</span>\n        </label>\n        <input\n          id=\"link-text-input\"\n          type=\"text\"\n          [(ngModel)]=\"linkModalText\"\n          placeholder=\"Ex: Acessar Documentação, Site da Empresa...\"\n          autofocus\n        />\n        <span class=\"field-hint\">O texto que aparecerá sublinhado na descrição</span>\n      </div>\n\n      <!-- Campo 2: Endereço do Link (URL) -->\n      <div class=\"link-field\">\n        <label for=\"link-url-input\">\n          <mat-icon>link</mat-icon>\n          <span>Endereço do Link (URL) <strong class=\"req\">*</strong></span>\n        </label>\n        <input\n          id=\"link-url-input\"\n          type=\"text\"\n          [(ngModel)]=\"linkModalUrl\"\n          placeholder=\"https://exemplo.com.br\"\n          (keydown.enter)=\"applyLinkModal()\"\n        />\n        <span class=\"field-hint\">Destino para onde o link direcionará ao ser clicado</span>\n      </div>\n\n      <!-- Card de Pré-visualização do Hyperlink -->\n      <div class=\"link-preview-box\" *ngIf=\"linkModalUrl.trim()\">\n        <span class=\"preview-tag\">Pré-visualização do Hyperlink:</span>\n        <div class=\"preview-result\">\n          <mat-icon class=\"preview-icon\">open_in_new</mat-icon>\n          <span class=\"preview-label\">{{ linkModalText.trim() || linkModalUrl.trim() }}</span>\n          <span class=\"preview-target-url\">({{ linkModalUrl.trim() }})</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Footer -->\n    <div class=\"link-modal-footer\">\n      <button\n        *ngIf=\"linkModalTarget()?.fullMarkdown || linkModalTarget()?.url\"\n        type=\"button\"\n        class=\"btn-remove-link\"\n        (click)=\"removeLinkFromModal()\"\n        title=\"Remover hyperlink mantendo apenas o texto\"\n      >\n        <mat-icon>link_off</mat-icon>\n        <span>Remover Link</span>\n      </button>\n\n      <div class=\"footer-right-actions\">\n        <button type=\"button\" class=\"btn-cancel-link\" (click)=\"closeLinkModal()\">\n          Cancelar\n        </button>\n        <button\n          type=\"button\"\n          class=\"btn-apply-link\"\n          (click)=\"applyLinkModal()\"\n          [disabled]=\"!linkModalUrl.trim()\"\n        >\n          <mat-icon>check</mat-icon>\n          <span>Aplicar Hyperlink</span>\n        </button>\n      </div>\n    </div>\n  </div>\n</div>\n","/**\n * Utilitário para identificação de tipos de arquivos, linguagens de programação\n * e formatação / syntax highlighting em pré-visualizações.\n */\n\nexport interface FileTypeInfo {\n  id: string;\n  name: string;\n  category: 'code' | 'image' | 'pdf' | 'audio' | 'video' | 'archive' | 'sheet' | 'document' | 'other';\n  icon: string;\n  color: string;\n  extension: string;\n}\n\nconst LANGUAGE_MAP: Record<string, { id: string; name: string; icon: string; color: string }> = {\n  // Web & Scripting\n  ts: { id: 'typescript', name: 'TypeScript', icon: 'code', color: '#3178c6' },\n  tsx: { id: 'typescript', name: 'TypeScript (React)', icon: 'code', color: '#3178c6' },\n  js: { id: 'javascript', name: 'JavaScript', icon: 'javascript', color: '#f7df1e' },\n  mjs: { id: 'javascript', name: 'JavaScript (ESM)', icon: 'javascript', color: '#f7df1e' },\n  cjs: { id: 'javascript', name: 'JavaScript (CommonJS)', icon: 'javascript', color: '#f7df1e' },\n  jsx: { id: 'javascript', name: 'JavaScript (React)', icon: 'javascript', color: '#61dafb' },\n  html: { id: 'html', name: 'HTML', icon: 'html', color: '#e34f26' },\n  htm: { id: 'html', name: 'HTML', icon: 'html', color: '#e34f26' },\n  css: { id: 'css', name: 'CSS', icon: 'css', color: '#1572b6' },\n  scss: { id: 'scss', name: 'SCSS', icon: 'style', color: '#c69' },\n  sass: { id: 'scss', name: 'SASS', icon: 'style', color: '#c69' },\n  less: { id: 'css', name: 'LESS', icon: 'style', color: '#1d365d' },\n  json: { id: 'json', name: 'JSON', icon: 'data_object', color: '#f59e0b' },\n  jsonc: { id: 'json', name: 'JSON with Comments', icon: 'data_object', color: '#f59e0b' },\n  xml: { id: 'xml', name: 'XML', icon: 'code', color: '#0060ac' },\n  svg: { id: 'xml', name: 'SVG (XML)', icon: 'image', color: '#ff9900' },\n  yaml: { id: 'yaml', name: 'YAML', icon: 'settings', color: '#cb171e' },\n  yml: { id: 'yaml', name: 'YAML', icon: 'settings', color: '#cb171e' },\n  md: { id: 'markdown', name: 'Markdown', icon: 'description', color: '#083fa1' },\n  markdown: { id: 'markdown', name: 'Markdown', icon: 'description', color: '#083fa1' },\n\n  // Backend, Systems & General Purpose\n  py: { id: 'python', name: 'Python', icon: 'terminal', color: '#3776ab' },\n  pyw: { id: 'python', name: 'Python GUI', icon: 'terminal', color: '#3776ab' },\n  cs: { id: 'csharp', name: 'C# (.NET)', icon: 'code', color: '#68217a' },\n  java: { id: 'java', name: 'Java', icon: 'coffee', color: '#b07219' },\n  cpp: { id: 'cpp', name: 'C++', icon: 'memory', color: '#00599c' },\n  cxx: { id: 'cpp', name: 'C++', icon: 'memory', color: '#00599c' },\n  cc: { id: 'cpp', name: 'C++', icon: 'memory', color: '#00599c' },\n  c: { id: 'c', name: 'C', icon: 'memory', color: '#555555' },\n  h: { id: 'c', name: 'C/C++ Header', icon: 'memory', color: '#a8b9cc' },\n  hpp: { id: 'cpp', name: 'C++ Header', icon: 'memory', color: '#a8b9cc' },\n  go: { id: 'go', name: 'Go (Golang)', icon: 'code', color: '#00add8' },\n  rs: { id: 'rust', name: 'Rust', icon: 'precision_manufacturing', color: '#dea584' },\n  php: { id: 'php', name: 'PHP', icon: 'php', color: '#777bb4' },\n  rb: { id: 'ruby', name: 'Ruby', icon: 'diamond', color: '#cc342d' },\n  sql: { id: 'sql', name: 'SQL Query / Schema', icon: 'storage', color: '#00758f' },\n  sh: { id: 'shell', name: 'Shell Script', icon: 'terminal', color: '#89e051' },\n  bash: { id: 'shell', name: 'Bash Script', icon: 'terminal', color: '#89e051' },\n  zsh: { id: 'shell', name: 'Zsh Script', icon: 'terminal', color: '#89e051' },\n  ps1: { id: 'powershell', name: 'PowerShell', icon: 'terminal', color: '#012456' },\n  bat: { id: 'batch', name: 'Windows Batch', icon: 'terminal', color: '#c1f12e' },\n  cmd: { id: 'batch', name: 'Windows CMD', icon: 'terminal', color: '#c1f12e' },\n  kt: { id: 'kotlin', name: 'Kotlin', icon: 'code', color: '#a97bff' },\n  kts: { id: 'kotlin', name: 'Kotlin Script', icon: 'code', color: '#a97bff' },\n  swift: { id: 'swift', name: 'Swift', icon: 'code', color: '#f05138' },\n  dart: { id: 'dart', name: 'Dart', icon: 'code', color: '#0175c2' },\n  lua: { id: 'lua', name: 'Lua', icon: 'code', color: '#000080' },\n  r: { id: 'r', name: 'R', icon: 'analytics', color: '#198ce7' },\n  env: { id: 'config', name: 'Environment Config', icon: 'settings', color: '#ecd53f' },\n  ini: { id: 'config', name: 'INI Config', icon: 'settings', color: '#64748b' },\n  conf: { id: 'config', name: 'Config File', icon: 'settings', color: '#64748b' },\n  toml: { id: 'config', name: 'TOML Config', icon: 'settings', color: '#9c4221' },\n  txt: { id: 'text', name: 'Texto Puro', icon: 'article', color: '#64748b' },\n  log: { id: 'text', name: 'Log', icon: 'history', color: '#64748b' },\n  csv: { id: 'text', name: 'CSV', icon: 'table_chart', color: '#107c41' },\n  tsv: { id: 'text', name: 'TSV', icon: 'table_chart', color: '#107c41' },\n};\n\nexport function detectFileType(fileName: string, mimeType?: string): FileTypeInfo {\n  const cleanName = (fileName || '').trim().toLowerCase();\n  const extMatch = cleanName.match(/\\.([a-z0-9]+)$/);\n  const ext = extMatch ? extMatch[1] : '';\n\n  // 1. Programação / Código Fonte / Textos Estruturados\n  if (ext && LANGUAGE_MAP[ext]) {\n    const lang = LANGUAGE_MAP[ext];\n    return {\n      id: lang.id,\n      name: lang.name,\n      category: 'code',\n      icon: lang.icon,\n      color: lang.color,\n      extension: `.${ext}`,\n    };\n  }\n\n  // 2. Imagens\n  if (\n    /^(image\\/(png|jpe?g|gif|webp|bmp|avif|svg\\+xml))$/i.test(mimeType || '') ||\n    ['png', 'jpg', 'jpeg', 'gif', 'webp', 'bmp', 'avif'].includes(ext)\n  ) {\n    return {\n      id: 'image',\n      name: ext ? ext.toUpperCase() : 'Imagem',\n      category: 'image',\n      icon: 'image',\n      color: '#10b981',\n      extension: `.${ext || 'img'}`,\n    };\n  }\n\n  // 3. PDF\n  if (mimeType === 'application/pdf' || ext === 'pdf') {\n    return {\n      id: 'pdf',\n      name: 'PDF',\n      category: 'pdf',\n      icon: 'picture_as_pdf',\n      color: '#ef4444',\n      extension: '.pdf',\n    };\n  }\n\n  // 4. Arquivos Compactados\n  if (['zip', 'rar', '7z', 'tar', 'gz', 'bz2'].includes(ext)) {\n    return {\n      id: 'archive',\n      name: ext.toUpperCase(),\n      category: 'archive',\n      icon: 'folder_zip',\n      color: '#f59e0b',\n      extension: `.${ext}`,\n    };\n  }\n\n  // 5. Planilhas\n  if (['xlsx', 'xls', 'ods'].includes(ext)) {\n    return {\n      id: 'sheet',\n      name: 'Planilha ' + ext.toUpperCase(),\n      category: 'sheet',\n      icon: 'table_chart',\n      color: '#107c41',\n      extension: `.${ext}`,\n    };\n  }\n\n  // 6. Documentos de Texto / Word\n  if (['docx', 'doc', 'odt', 'rtf'].includes(ext)) {\n    return {\n      id: 'document',\n      name: 'Documento ' + ext.toUpperCase(),\n      category: 'document',\n      icon: 'description',\n      color: '#185abd',\n      extension: `.${ext}`,\n    };\n  }\n\n  // 7. Áudio\n  if (/^audio\\//i.test(mimeType || '') || ['mp3', 'wav', 'ogg', 'm4a', 'flac', 'aac'].includes(ext)) {\n    return {\n      id: 'audio',\n      name: 'Áudio ' + (ext ? ext.toUpperCase() : ''),\n      category: 'audio',\n      icon: 'audiotrack',\n      color: '#8b5cf6',\n      extension: `.${ext}`,\n    };\n  }\n\n  // 8. Vídeo\n  if (/^video\\//i.test(mimeType || '') || ['mp4', 'webm', 'mkv', 'mov', 'avi'].includes(ext)) {\n    return {\n      id: 'video',\n      name: 'Vídeo ' + (ext ? ext.toUpperCase() : ''),\n      category: 'video',\n      icon: 'movie',\n      color: '#ec4899',\n      extension: `.${ext}`,\n    };\n  }\n\n  // Padrão genérico\n  return {\n    id: 'other',\n    name: ext ? ext.toUpperCase() : 'Arquivo',\n    category: 'other',\n    icon: 'insert_drive_file',\n    color: '#64748b',\n    extension: ext ? `.${ext}` : '',\n  };\n}\n\nfunction escapeHtml(value: string): string {\n  return value\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#039;');\n}\n\n/**\n * Syntax Highlighter rápido, seguro e sem dependências externas pesadas.\n * Gera marcações estruturadas para exibição em visualizador de código com números de linha.\n */\nexport function formatCodeWithHighlight(code: string, languageId: string): string {\n  if (!code) return '';\n\n  const lines = code.split('\\n');\n  const highlightedLines: string[] = [];\n\n  for (let i = 0; i < lines.length; i++) {\n    const rawLine = lines[i];\n    const highlighted = highlightLine(rawLine, languageId);\n    highlightedLines.push(\n      `<div class=\"code-line\"><span class=\"line-num\">${i + 1}</span><span class=\"line-code\">${highlighted || '&nbsp;'}</span></div>`\n    );\n  }\n\n  return highlightedLines.join('');\n}\n\nfunction highlightLine(line: string, lang: string): string {\n  if (!line.trim()) return '';\n\n  // Escapa caracteres especiais HTML antes de aplicar os spans de estilo\n  let escaped = escapeHtml(line);\n\n  if (lang === 'json') {\n    // 1. Chaves JSON (\"key\":)\n    escaped = escaped.replace(/(&quot;.*?&quot;)(?=\\s*:)/g, '<span class=\"tok-json-key\">$1</span>');\n    // 2. Strings de valores JSON (\"value\")\n    escaped = escaped.replace(/(:\\s*)(&quot;.*?&quot;)/g, '$1<span class=\"tok-string\">$2</span>');\n    escaped = escaped.replace(/(^\\s*)(&quot;.*?&quot;)(?!\\s*:)/g, '$1<span class=\"tok-string\">$2</span>');\n    // 3. Booleanos e nulos\n    escaped = escaped.replace(/\\b(true|false|null)\\b/g, '<span class=\"tok-keyword\">$1</span>');\n    // 4. Números\n    escaped = escaped.replace(/\\b(-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)\\b/g, '<span class=\"tok-number\">$1</span>');\n    return escaped;\n  }\n\n  // 1. Strings: \"...\", '...', `...` (com entidades HTML &quot; e &#039;)\n  escaped = escaped.replace(/(&quot;.*?&quot;|&#039;.*?&#039;|`.*?`)/g, '<span class=\"tok-string\">$1</span>');\n\n  // 2. Comentários\n  if (['javascript', 'typescript', 'csharp', 'java', 'cpp', 'c', 'go', 'rust', 'php', 'swift', 'dart', 'kotlin', 'scss', 'css'].includes(lang)) {\n    escaped = escaped.replace(/(\\/\\/.*$)/, '<span class=\"tok-comment\">$1</span>');\n  } else if (['python', 'shell', 'powershell', 'ruby', 'yaml', 'r', 'config'].includes(lang)) {\n    escaped = escaped.replace(/(#.*$)/, '<span class=\"tok-comment\">$1</span>');\n  } else if (['sql'].includes(lang)) {\n    escaped = escaped.replace(/(--.*$)/, '<span class=\"tok-comment\">$1</span>');\n  } else if (['html', 'xml'].includes(lang)) {\n    escaped = escaped.replace(/(&lt;!--.*?--&gt;)/g, '<span class=\"tok-comment\">$1</span>');\n  }\n\n  // 3. Palavras-Chave (Keywords) por Linguagem\n  let keywordsRegex: RegExp | null = null;\n\n  if (['javascript', 'typescript'].includes(lang)) {\n    keywordsRegex = /\\b(const|let|var|function|return|if|else|for|while|do|switch|case|break|continue|try|catch|finally|throw|class|extends|implements|interface|type|import|export|from|default|async|await|new|this|super|typeof|instanceof|void|yield|null|undefined|true|false)\\b/g;\n  } else if (['python'].includes(lang)) {\n    keywordsRegex = /\\b(def|class|return|if|elif|else|for|while|try|except|finally|raise|import|from|as|with|lambda|yield|global|nonlocal|pass|break|continue|in|is|not|and|or|True|False|None|self)\\b/g;\n  } else if (['csharp', 'java'].includes(lang)) {\n    keywordsRegex = /\\b(public|private|protected|internal|static|readonly|void|class|interface|struct|enum|record|namespace|using|package|import|return|if|else|for|foreach|while|switch|case|break|continue|try|catch|finally|throw|new|this|base|super|async|await|get|set|var|null|true|false)\\b/g;\n  } else if (['sql'].includes(lang)) {\n    keywordsRegex = /\\b(SELECT|FROM|WHERE|INSERT|INTO|UPDATE|DELETE|JOIN|LEFT|RIGHT|INNER|OUTER|GROUP|BY|ORDER|HAVING|LIMIT|OFFSET|CREATE|TABLE|DROP|ALTER|ADD|INDEX|PRIMARY|KEY|FOREIGN|REFERENCES|NOT|NULL|AND|OR|AS|UNION|ALL|DISTINCT|VALUES|SET|COUNT|SUM|AVG|MIN|MAX|COALESCE|EXISTS|BETWEEN|IN|LIKE|IS|CASE|WHEN|THEN|ELSE|END)\\b/gi;\n  } else if (['go', 'rust'].includes(lang)) {\n    keywordsRegex = /\\b(fn|func|package|import|type|struct|interface|impl|let|mut|pub|return|if|else|for|while|loop|match|switch|select|case|defer|go|break|continue|nil|true|false)\\b/g;\n  } else if (['html', 'xml'].includes(lang)) {\n    escaped = escaped.replace(/(&lt;\\/?)([a-zA-Z0-9:-]+)/g, '$1<span class=\"tok-tag\">$2</span>');\n    escaped = escaped.replace(/([a-zA-Z0-9:-]+)=/g, '<span class=\"tok-attr\">$1</span>=');\n  }\n\n  if (keywordsRegex) {\n    escaped = escaped.replace(keywordsRegex, '<span class=\"tok-keyword\">$&</span>');\n  }\n\n  // 4. Números\n  escaped = escaped.replace(/\\b(\\d+(?:\\.\\d+)?)\\b/g, '<span class=\"tok-number\">$1</span>');\n\n  // 5. Chamadas de Função\n  escaped = escaped.replace(/\\b([a-zA-Z0-9_$]+)(?=\\s*\\()/g, '<span class=\"tok-fn\">$1</span>');\n\n  return escaped;\n}\n","import { Component, EventEmitter, Input, OnChanges, OnInit, Output, SimpleChanges, inject, signal } from '@angular/core';\nimport { CommonModule } from '@angular/common';\nimport { MatIconModule } from '@angular/material/icon';\nimport { MatTooltipModule } from '@angular/material/tooltip';\nimport { MatProgressSpinnerModule } from '@angular/material/progress-spinner';\nimport { DomSanitizer, SafeResourceUrl } from '@angular/platform-browser';\nimport { detectFileType, formatCodeWithHighlight, FileTypeInfo } from '../../../core/utils/code-highlight.util';\nimport { MarkdownTextComponent } from '../markdown-text/markdown-text.component';\n\n@Component({\n  selector: 'app-attachment-preview-modal',\n  standalone: true,\n  imports: [CommonModule, MatIconModule, MatTooltipModule, MatProgressSpinnerModule, MarkdownTextComponent],\n  templateUrl: './attachment-preview-modal.component.html',\n  styleUrl: './attachment-preview-modal.component.scss',\n})\nexport class AttachmentPreviewModalComponent implements OnInit, OnChanges {\n  private sanitizer = inject(DomSanitizer);\n\n  @Input() fileName = '';\n  @Input() fileUrl: string | null = null;\n  @Input() mimeType = '';\n  @Input() rawContent: string | null = null;\n  @Input() byteSize?: number;\n\n  @Output() close = new EventEmitter<void>();\n  @Output() download = new EventEmitter<void>();\n\n  readonly fileInfo = signal<FileTypeInfo>({\n    id: 'other',\n    name: 'Arquivo',\n    category: 'other',\n    icon: 'insert_drive_file',\n    color: '#64748b',\n    extension: '',\n  });\n\n  readonly trustedUrl = signal<SafeResourceUrl | null>(null);\n  readonly highlightedCode = signal<string>('');\n  readonly isCopied = signal(false);\n  readonly contentLoading = signal(false);\n  readonly currentText = signal<string>('');\n  readonly markdownViewMode = signal<'rendered' | 'raw'>('rendered');\n\n  ngOnInit(): void {\n    this.refreshState();\n  }\n\n  ngOnChanges(changes: SimpleChanges): void {\n    this.refreshState();\n  }\n\n  private refreshState(): void {\n    const info = detectFileType(this.fileName, this.mimeType);\n    this.fileInfo.set(info);\n\n    if (this.fileUrl) {\n      this.trustedUrl.set(this.sanitizer.bypassSecurityTrustResourceUrl(this.fileUrl));\n    } else {\n      this.trustedUrl.set(null);\n    }\n\n    if (info.category === 'code') {\n      if (this.rawContent) {\n        this.currentText.set(this.rawContent);\n        this.contentLoading.set(false);\n        this.highlightedCode.set(formatCodeWithHighlight(this.rawContent, info.id));\n      } else if (this.fileUrl) {\n        this.contentLoading.set(true);\n        fetch(this.fileUrl)\n          .then((res) => res.text())\n          .then((text) => {\n            this.currentText.set(text);\n            this.highlightedCode.set(formatCodeWithHighlight(text, info.id));\n            this.contentLoading.set(false);\n          })\n          .catch((err) => {\n            console.error('Erro ao ler conteúdo para syntax highlight:', err);\n            this.contentLoading.set(false);\n          });\n      } else {\n        this.currentText.set('');\n        this.highlightedCode.set('');\n        this.contentLoading.set(false);\n      }\n    } else {\n      this.currentText.set('');\n      this.highlightedCode.set('');\n      this.contentLoading.set(false);\n    }\n  }\n\n  copyCode(): void {\n    const textToCopy = this.currentText() || this.rawContent;\n    if (!textToCopy) return;\n    navigator.clipboard.writeText(textToCopy).then(() => {\n      this.isCopied.set(true);\n      setTimeout(() => this.isCopied.set(false), 2000);\n    }).catch(err => {\n      console.error('Falha ao copiar código:', err);\n    });\n  }\n\n  formatarTamanho(bytes?: number): string {\n    if (!bytes) return '';\n    if (bytes < 1024) return `${bytes} B`;\n    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;\n    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;\n  }\n}\n","<div class=\"attachment-preview-backdrop\" (click)=\"close.emit()\">\n  <div class=\"attachment-preview-card\" (click)=\"$event.stopPropagation()\">\n\n    <!-- Header com Informações e Ações -->\n    <div class=\"preview-header\">\n      <div class=\"preview-header-left\">\n        <div class=\"preview-type-badge\" [style.background]=\"fileInfo().color\">\n          <mat-icon>{{ fileInfo().icon }}</mat-icon>\n        </div>\n        <div class=\"preview-title-box\">\n          <h3 class=\"preview-file-name\" [title]=\"fileName\">{{ fileName }}</h3>\n          <div class=\"preview-meta-row\">\n            <span class=\"preview-lang-pill\" [style.border-color]=\"fileInfo().color\" [style.color]=\"fileInfo().color\">\n              {{ fileInfo().name }}\n            </span>\n            <span class=\"preview-size\" *ngIf=\"byteSize\">{{ formatarTamanho(byteSize) }}</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"preview-header-actions\">\n        <!-- Alternador entre Formatado (Markdown) e Código Fonte -->\n        <div class=\"view-mode-toggle\" *ngIf=\"fileInfo().id === 'markdown'\">\n          <button\n            type=\"button\"\n            class=\"toggle-btn\"\n            [class.active]=\"markdownViewMode() === 'rendered'\"\n            (click)=\"markdownViewMode.set('rendered')\"\n            matTooltip=\"Visualização Formatada em Markdown\"\n          >\n            <mat-icon>auto_stories</mat-icon>\n            <span>Formatado</span>\n          </button>\n          <button\n            type=\"button\"\n            class=\"toggle-btn\"\n            [class.active]=\"markdownViewMode() === 'raw'\"\n            (click)=\"markdownViewMode.set('raw')\"\n            matTooltip=\"Código Fonte com Linhas\"\n          >\n            <mat-icon>code</mat-icon>\n            <span>Código</span>\n          </button>\n        </div>\n\n        <!-- Botão de Copiar Código (para arquivos de código/texto) -->\n        <button\n          *ngIf=\"fileInfo().category === 'code' && (rawContent || currentText())\"\n          type=\"button\"\n          class=\"preview-action-btn copy-btn\"\n          (click)=\"copyCode()\"\n          [matTooltip]=\"isCopied() ? 'Copiado!' : 'Copiar texto / código'\"\n        >\n          <mat-icon>{{ isCopied() ? 'check' : 'content_copy' }}</mat-icon>\n          <span>{{ isCopied() ? 'Copiado!' : 'Copiar' }}</span>\n        </button>\n\n        <!-- Botão de Download -->\n        <button\n          *ngIf=\"fileUrl\"\n          type=\"button\"\n          class=\"preview-action-btn download-btn\"\n          (click)=\"download.emit()\"\n          matTooltip=\"Baixar arquivo\"\n        >\n          <mat-icon>download</mat-icon>\n          <span>Baixar</span>\n        </button>\n\n        <!-- Botão de Fechar -->\n        <button type=\"button\" class=\"preview-close-btn\" (click)=\"close.emit()\" title=\"Fechar\">\n          <mat-icon>close</mat-icon>\n        </button>\n      </div>\n    </div>\n\n    <!-- Corpo do Visualizador -->\n    <div\n      class=\"preview-body\"\n      [class.code-mode]=\"fileInfo().category === 'code' && (fileInfo().id !== 'markdown' || markdownViewMode() === 'raw')\"\n      [class.markdown-mode]=\"fileInfo().id === 'markdown' && markdownViewMode() === 'rendered'\"\n    >\n\n      <!-- 1. Documento Markdown Renderizado com Estilização Completa -->\n      <div class=\"markdown-viewer-container\" *ngIf=\"fileInfo().id === 'markdown' && markdownViewMode() === 'rendered'\">\n        <div class=\"markdown-viewer-header\">\n          <span class=\"md-badge\"><mat-icon>article</mat-icon> Documento Markdown</span>\n          <span class=\"md-stats\" *ngIf=\"rawContent || currentText()\">\n            {{ (rawContent || currentText()).split('\\n').length }} linhas\n          </span>\n        </div>\n        <div class=\"markdown-viewer-viewport\">\n          <div class=\"code-loading-box\" *ngIf=\"contentLoading()\">\n            <mat-progress-spinner mode=\"indeterminate\" diameter=\"28\"></mat-progress-spinner>\n            <span>Carregando documento Markdown...</span>\n          </div>\n          <div class=\"markdown-content-box\" *ngIf=\"!contentLoading()\">\n            <app-markdown-text [text]=\"currentText() || rawContent\"></app-markdown-text>\n          </div>\n        </div>\n      </div>\n\n      <!-- 2. Código Fonte / Texto Formatado com Syntax Highlighting -->\n      <div\n        class=\"code-viewer-container\"\n        *ngIf=\"fileInfo().category === 'code' && (fileInfo().id !== 'markdown' || markdownViewMode() === 'raw')\"\n      >\n        <div class=\"code-viewer-header\">\n          <span class=\"code-lang-label\">{{ fileInfo().name }}</span>\n          <span class=\"code-stats\" *ngIf=\"rawContent || currentText()\">\n            {{ (rawContent || currentText()).split('\\n').length }} linhas\n          </span>\n        </div>\n        <div class=\"code-editor-viewport\">\n          <div class=\"code-loading-box\" *ngIf=\"contentLoading()\">\n            <mat-progress-spinner mode=\"indeterminate\" diameter=\"28\"></mat-progress-spinner>\n            <span>Carregando arquivo de código...</span>\n          </div>\n          <pre class=\"code-pre\" *ngIf=\"!contentLoading()\" [innerHTML]=\"highlightedCode()\"></pre>\n        </div>\n      </div>\n\n      <!-- 2. Imagens -->\n      <div class=\"image-viewer-container\" *ngIf=\"fileInfo().category === 'image'\">\n        <img [src]=\"fileUrl\" [alt]=\"fileName\" class=\"preview-image\" />\n      </div>\n\n      <!-- 3. Documentos PDF -->\n      <div class=\"pdf-viewer-container\" *ngIf=\"fileInfo().category === 'pdf'\">\n        <iframe [src]=\"trustedUrl()\" class=\"preview-pdf-frame\" [title]=\"fileName\"></iframe>\n      </div>\n\n      <!-- 4. Áudio -->\n      <div class=\"media-viewer-container\" *ngIf=\"fileInfo().category === 'audio'\">\n        <mat-icon class=\"media-big-icon color-purple\">audiotrack</mat-icon>\n        <h4>{{ fileName }}</h4>\n        <audio controls [src]=\"fileUrl\" class=\"preview-audio-player\"></audio>\n      </div>\n\n      <!-- 5. Vídeo -->\n      <div class=\"media-viewer-container video\" *ngIf=\"fileInfo().category === 'video'\">\n        <video controls [src]=\"fileUrl\" class=\"preview-video-player\"></video>\n      </div>\n\n      <!-- 6. Outros Tipos de Arquivo (Download Direto) -->\n      <div class=\"generic-file-container\" *ngIf=\"['other', 'archive', 'sheet', 'document'].includes(fileInfo().category)\">\n        <div class=\"generic-file-card\">\n          <mat-icon class=\"generic-big-icon\" [style.color]=\"fileInfo().color\">{{ fileInfo().icon }}</mat-icon>\n          <h3>{{ fileName }}</h3>\n          <p>Arquivo {{ fileInfo().name }} · {{ formatarTamanho(byteSize) }}</p>\n          <button type=\"button\" class=\"btn-download-generic\" (click)=\"download.emit()\">\n            <mat-icon>download</mat-icon>\n            <span>Baixar Arquivo</span>\n          </button>\n        </div>\n      </div>\n\n    </div>\n\n  </div>\n</div>\n","import { Component, Inject, OnDestroy, OnInit, inject, computed, signal } from '@angular/core';\nimport { CommonModule } from '@angular/common';\nimport { FormsModule } from '@angular/forms';\nimport { MatDialogRef, MAT_DIALOG_DATA, MatDialogModule } from '@angular/material/dialog';\nimport { MatIconModule } from '@angular/material/icon';\nimport { MatProgressSpinnerModule } from '@angular/material/progress-spinner';\nimport { MatTooltipModule } from '@angular/material/tooltip';\n\nimport { EventsService } from '../../../core/services/events.service';\nimport { HolidaysService } from '../../../core/services/holidays.service';\nimport { CalendarsService } from '../../../core/services/calendars.service';\nimport { CalendarEvent, EventColor, EVENT_COLOR_MAP, EVENT_COLOR_LABELS } from '../../../core/models/event.model';\nimport { Holiday } from '../../../core/models/holiday.model';\nimport { Attachment } from '../../../core/models/attachment.model';\nimport { AttachmentsService } from '../../../core/services/attachments.service';\nimport { forkJoin } from 'rxjs';\nimport { DomSanitizer, SafeResourceUrl } from '@angular/platform-browser';\nimport { AiTextButtonComponent } from '../../../shared/components/ai-text-button/ai-text-button.component';\nimport { MarkdownTextComponent } from '../../../shared/components/markdown-text/markdown-text.component';\nimport { MarkdownEditorComponent } from '../../../shared/components/markdown-editor/markdown-editor.component';\nimport { AttachmentPreviewModalComponent } from '../../../shared/components/attachment-preview-modal/attachment-preview-modal.component';\nimport { detectFileType } from '../../../core/utils/code-highlight.util';\n\nexport interface EventModalData {\n  event?: CalendarEvent;\n  defaultDate?: string;\n  targetCalendarIds?: string[];\n  readOnly?: boolean;\n}\n\n@Component({\n  selector: 'app-event-modal',\n  standalone: true,\n  imports: [\n    CommonModule,\n    FormsModule,\n    MatDialogModule,\n    MatIconModule,\n    MatProgressSpinnerModule,\n    MatTooltipModule,\n    AiTextButtonComponent,\n    MarkdownTextComponent,\n    MarkdownEditorComponent,\n    AttachmentPreviewModalComponent,\n  ],\n  templateUrl: './event-modal.component.html',\n  styleUrl: './event-modal.component.scss'\n})\nexport class EventModalComponent implements OnInit, OnDestroy {\n  private calendarsService = inject(CalendarsService);\n  private attachmentsService = inject(AttachmentsService);\n  private sanitizer = inject(DomSanitizer);\n  isEdit = false;\n  get isReadOnly(): boolean { return !!this.data.readOnly; }\n\n  get canEditCurrentCalendar(): boolean {\n    const calId = this.formData.calendarId || this.data?.event?.calendarId;\n    return calId ? this.calendarsService.canEdit(calId) : false;\n  }\n\n  enableEditMode(): void {\n    if (this.canEditCurrentCalendar) {\n      this.data.readOnly = false;\n      this.isEdit = true;\n    }\n  }\n\n  getCalendarName(): string {\n    const calId = this.formData.calendarId || this.data?.event?.calendarId;\n    if (!calId) return '';\n    const cal = this.calendarsService.calendars().find(c => c.id === calId);\n    return cal ? cal.name : '';\n  }\n\n  getCalendarColor(): string {\n    const calId = this.formData.calendarId || this.data?.event?.calendarId;\n    if (!calId) return this.colorMap[this.formData.color] || '#6366f1';\n    const cal = this.calendarsService.calendars().find(c => c.id === calId);\n    return cal?.color || this.colorMap[this.formData.color] || '#6366f1';\n  }\n\n  formatEventSchedule(): string {\n    if (!this.formData.date) return '';\n    const [year, month, day] = this.formData.date.split('-');\n    const formattedDate = `${day}/${month}/${year}`;\n    if (this.formData.allDay) {\n      return `${formattedDate} · Dia inteiro`;\n    }\n    const time = `${this.formData.startTime || '00:00'} às ${this.formData.endTime || '00:00'}`;\n    if (this.formData.endDate && this.formData.endDate !== this.formData.date) {\n      const [endYear, endMonth, endDay] = this.formData.endDate.split('-');\n      return `${formattedDate} ${this.formData.startTime || ''} até ${endDay}/${endMonth}/${endYear} ${this.formData.endTime || ''}`;\n    }\n    return `${formattedDate} · ${time}`;\n  }\n\n  onDescriptionChangeInView(newDescription: string): void {\n    this.formData.description = newDescription;\n    if (this.data?.event) {\n      this.eventsService.update(this.data.event.id, { description: newDescription });\n    }\n  }\n\n  // ── Skill: Button HTTP Loading ──\n  loadingSalvar = false;\n  showDeleteConfirmation = false;\n  // A seção legada de participantes permanece desativada no template.\n  readonly allUsers = signal<any[]>([]);\n  readonly defaultAvatar = '';\n\n  // Form\n  formData: Omit<CalendarEvent, 'id'> = {\n    calendarId: '',\n    title: '',\n    description: '',\n    date: '',\n    endDate: '',\n    startTime: '09:00',\n    endTime: '10:00',\n    color: 'indigo',\n    category: 'Geral',\n    allDay: false,\n    attachments: [],\n  };\n\n  pendingFiles: File[] = [];\n  attachmentError = '';\n  readonly previewUrl = signal<string | null>(null);\n  readonly previewName = signal('');\n  readonly previewMimeType = signal('');\n  readonly previewRawContent = signal<string | null>(null);\n  readonly previewByteSize = signal<number | undefined>(undefined);\n  readonly previewCurrentAttachment = signal<Attachment | null>(null);\n  readonly trustedPreviewUrl = signal<SafeResourceUrl | null>(null);\n\n  holidayWarning: string | null = null;\n  holidays: Holiday[] = [];\n  private holidayYear: number | null = null;\n\n  readonly colorMap = EVENT_COLOR_MAP;\n  readonly colorLabels = EVENT_COLOR_LABELS;\n  readonly colorOptions = Object.keys(EVENT_COLOR_MAP) as EventColor[];\n\n  readonly categories = [\n    'Geral', 'Reunião', 'Prazo', 'Tarefas', 'Treinamento', 'Evento', 'Feriado', 'Outro'\n  ];\n\n  showDuplicateOptions = false;\n  duplicateCalendarIds = signal<Set<string>>(new Set());\n  readonly duplicateCalendars = computed(() => {\n    const event = this.data?.event;\n    if (!event) return [];\n    const group = event.copyGroupId || event.id;\n    return this.calendarsService.calendars().filter(calendar =>\n      calendar.id !== event.calendarId && this.calendarsService.canEdit(calendar.id) &&\n      !this.eventsService.events().some(item => item.calendarId === calendar.id && (item.copyGroupId || item.id) === group)\n    );\n  });\n\n  // ── Recorrência Mensal ──\n  monthlyRecurring = false;\n  recurringPreset: number | 'custom' = 12;\n  customMonths: number = 12;\n\n  get effectiveRecurringMonths(): number {\n    if (this.recurringPreset === 'custom') {\n      const val = Math.floor(Number(this.customMonths));\n      return Number.isFinite(val) && val > 0 ? Math.min(val, 120) : 1;\n    }\n    return Number(this.recurringPreset) || 12;\n  }\n\n  get recurringDay(): string {\n    return this.formData.date ? this.formData.date.slice(8, 10) : '01';\n  }\n\n  get hasTargetCalendars(): boolean {\n    return this.isEdit || (this.data.targetCalendarIds?.length ?? 0) > 0;\n  }\n\n  constructor(\n    public dialogRef: MatDialogRef<EventModalComponent>,\n    @Inject(MAT_DIALOG_DATA) public data: EventModalData,\n    public eventsService: EventsService,\n    private holidaysService: HolidaysService,\n  ) {}\n\n  ngOnInit(): void {\n    if (this.data?.event) {\n      this.isEdit = true;\n      this.formData = {\n        ...this.data.event,\n        endDate: this.data.event.endDate || this.data.event.date,\n      };\n    } else {\n      if (this.data?.defaultDate) {\n        this.formData.date = this.data.defaultDate;\n        this.formData.endDate = this.data.defaultDate;\n      }\n      if (this.data?.targetCalendarIds?.[0]) this.formData.calendarId = this.data.targetCalendarIds[0];\n    }\n    this.loadHolidays();\n  }\n\n  ngOnDestroy(): void { this.closePreview(); }\n\n  get attachments(): Attachment[] { return this.formData.attachments || []; }\n\n  selectFiles(event: Event): void {\n    const input = event.target as HTMLInputElement;\n    const available = Math.max(0, 10 - this.attachments.length - this.pendingFiles.length);\n    const selected = [...(input.files || [])].slice(0, available);\n    const tooLarge = selected.find(file => file.size > 10 * 1024 * 1024);\n    this.attachmentError = tooLarge ? `${tooLarge.name} excede o limite de 10 MB.` : '';\n    this.pendingFiles.push(...selected.filter(file => file.size <= 10 * 1024 * 1024));\n    input.value = '';\n  }\n\n  removePending(index: number): void { this.pendingFiles.splice(index, 1); }\n\n  getFileInfo(name: string, mime?: string) {\n    return detectFileType(name, mime);\n  }\n\n  openAttachment(attachment: Attachment): void {\n    const userId = this.eventsService.currentUserId();\n    const fileInfo = detectFileType(attachment.fileName, attachment.mimeType);\n    this.closePreview();\n    this.previewCurrentAttachment.set(attachment);\n    this.previewName.set(attachment.fileName);\n    this.previewMimeType.set(attachment.mimeType);\n    this.previewByteSize.set(attachment.byteSize);\n\n    if (fileInfo.category === 'code' || fileInfo.category === 'other' || attachment.mimeType.startsWith('text/')) {\n      this.attachmentsService.text(attachment.id, userId).subscribe({\n        next: (text) => {\n          this.previewRawContent.set(text);\n          this.attachmentsService.content(attachment.id, userId).subscribe({\n            next: blob => this.previewUrl.set(URL.createObjectURL(blob)),\n            error: () => this.attachmentError = 'Não foi possível carregar o arquivo.',\n          });\n        },\n        error: () => {\n          this.attachmentsService.content(attachment.id, userId).subscribe({\n            next: blob => this.previewUrl.set(URL.createObjectURL(blob)),\n            error: () => this.attachmentError = 'Não foi possível carregar o arquivo.',\n          });\n        }\n      });\n    } else {\n      this.previewRawContent.set(null);\n      this.attachmentsService.content(attachment.id, userId).subscribe({\n        next: blob => this.previewUrl.set(URL.createObjectURL(blob)),\n        error: () => this.attachmentError = 'Não foi possível carregar o arquivo.',\n      });\n    }\n  }\n\n  openPending(file: File): void {\n    const fileInfo = detectFileType(file.name, file.type);\n    this.closePreview();\n    this.previewCurrentAttachment.set(null);\n    this.previewName.set(file.name);\n    this.previewMimeType.set(file.type || '');\n    this.previewByteSize.set(file.size);\n\n    if (fileInfo.category === 'code' || file.type.startsWith('text/')) {\n      file.text().then(text => {\n        this.previewRawContent.set(text);\n        this.previewUrl.set(URL.createObjectURL(file));\n      }).catch(() => {\n        this.previewUrl.set(URL.createObjectURL(file));\n      });\n    } else {\n      this.previewRawContent.set(null);\n      this.previewUrl.set(URL.createObjectURL(file));\n    }\n  }\n\n  closePreview(): void {\n    const url = this.previewUrl();\n    if (url) URL.revokeObjectURL(url);\n    this.previewUrl.set(null);\n    this.previewName.set('');\n    this.previewMimeType.set('');\n    this.previewRawContent.set(null);\n    this.previewByteSize.set(undefined);\n    this.previewCurrentAttachment.set(null);\n    this.trustedPreviewUrl.set(null);\n  }\n\n  downloadAttachment(att?: Attachment | null): void {\n    const target = att || this.previewCurrentAttachment();\n    if (!target) return;\n    this.attachmentsService.download(target, this.eventsService.currentUserId());\n  }\n\n  deleteAttachment(attachment: Attachment): void {\n    if (this.isReadOnly) return;\n    this.attachmentsService.remove(attachment.id, this.eventsService.currentUserId()).subscribe({\n      next: () => {\n        this.formData.attachments = this.attachments.filter(item => item.id !== attachment.id);\n        if (this.data.event) this.eventsService.setAttachments(this.data.event.id, this.formData.attachments);\n      },\n      error: error => this.attachmentError = error.error?.error || 'Não foi possível excluir o anexo.',\n    });\n  }\n\n  private uploadPending(events: CalendarEvent[], onComplete: (success: boolean) => void): void {\n    if (!this.pendingFiles.length) return onComplete(true);\n    const userId = this.eventsService.currentUserId();\n    const requests = events.flatMap(event => this.pendingFiles.map(file => this.attachmentsService.upload('event', event.id, file, userId)));\n    forkJoin(requests).subscribe({\n      next: uploaded => {\n        events.forEach((event, index) => {\n          const start = index * this.pendingFiles.length;\n          this.eventsService.setAttachments(event.id, [...(event.attachments || []), ...uploaded.slice(start, start + this.pendingFiles.length)]);\n        });\n        this.pendingFiles = [];\n        onComplete(true);\n      },\n      error: error => {\n        this.attachmentError = error.error?.error || 'O evento foi salvo, mas não foi possível enviar todos os anexos.';\n        onComplete(false);\n      },\n    });\n  }\n\n  toggleDuplicateCalendar(calendarId: string): void {\n    this.duplicateCalendarIds.update(ids => {\n      const next = new Set(ids);\n      next.has(calendarId) ? next.delete(calendarId) : next.add(calendarId);\n      return next;\n    });\n  }\n\n  toggleAttendee(_userId: string): void {}\n  isAttendeeSelected(_userId: string): boolean { return false; }\n\n  duplicateToSelectedCalendars(): void {\n    if (!this.data?.event || this.duplicateCalendarIds().size === 0) return;\n    const { id, ...event } = this.data.event;\n    this.eventsService.createInCalendars({ ...event, copyGroupId: event.copyGroupId || id }, [...this.duplicateCalendarIds()]);\n    this.duplicateCalendarIds.set(new Set());\n    this.showDuplicateOptions = false;\n  }\n\n  onDateChange(): void {\n    if (!this.formData.endDate || this.formData.endDate < this.formData.date) {\n      this.formData.endDate = this.formData.date;\n    }\n    const year = Number(this.formData.date.slice(0, 4));\n    if (year && year !== this.holidayYear) this.loadHolidays();\n    else this.checkHoliday();\n  }\n\n  loadHolidays(): void {\n    const year = this.formData.date ? parseInt(this.formData.date.slice(0, 4), 10) : new Date().getFullYear();\n    this.holidayYear = year;\n    this.holidaysService.getHolidays(year).subscribe(h => {\n      this.holidays = h;\n      this.checkHoliday();\n    });\n  }\n\n  checkHoliday(): void {\n    if (!this.formData.date) {\n      this.holidayWarning = null;\n      return;\n    }\n    const found = this.holidays.find(h => h.date === this.formData.date);\n    this.holidayWarning = found ? `🎌 Atenção: ${found.name} (${found.type})` : null;\n  }\n\n  get hasValidSchedule(): boolean {\n    if (this.formData.allDay || !this.formData.date) return true;\n    const effectiveEndDate = this.formData.endDate || this.formData.date;\n    return effectiveEndDate > this.formData.date || this.formData.endTime > this.formData.startTime;\n  }\n\n  /**\n   * Computa as ocorrências mensais para o número de meses selecionado.\n   * Ajusta o dia se o mês de destino tiver menos dias (ex: dia 31 em fev/abr).\n   */\n  computeMonthlyOccurrences(startDateStr: string, endDateStr: string, count: number): Array<{ date: string; endDate: string }> {\n    if (!startDateStr || count <= 0) return [];\n    const [startYear, startMonth, startDay] = startDateStr.split('-').map(Number);\n    const [endYear, endMonth, endDay] = (endDateStr || startDateStr).split('-').map(Number);\n\n    const startDt = new Date(Date.UTC(startYear, startMonth - 1, startDay));\n    const endDt = new Date(Date.UTC(endYear, endMonth - 1, endDay));\n    const durationDays = Math.max(0, Math.round((endDt.getTime() - startDt.getTime()) / (1000 * 60 * 60 * 24)));\n\n    const occurrences: Array<{ date: string; endDate: string }> = [];\n\n    for (let i = 0; i < count; i++) {\n      const totalMonths = (startMonth - 1) + i;\n      const targetYear = startYear + Math.floor(totalMonths / 12);\n      const targetMonth = totalMonths % 12; // 0-indexed\n\n      // Último dia do mês alvo\n      const daysInTargetMonth = new Date(Date.UTC(targetYear, targetMonth + 1, 0)).getUTCDate();\n      const actualDay = Math.min(startDay, daysInTargetMonth);\n\n      const occStartDate = new Date(Date.UTC(targetYear, targetMonth, actualDay));\n      const occEndDate = new Date(Date.UTC(targetYear, targetMonth, actualDay + durationDays));\n\n      occurrences.push({\n        date: this.formatIsoDate(occStartDate),\n        endDate: this.formatIsoDate(occEndDate),\n      });\n    }\n\n    return occurrences;\n  }\n\n  private formatIsoDate(d: Date): string {\n    const y = d.getUTCFullYear();\n    const m = String(d.getUTCMonth() + 1).padStart(2, '0');\n    const day = String(d.getUTCDate()).padStart(2, '0');\n    return `${y}-${m}-${day}`;\n  }\n\n  // ── Skill: Button HTTP Loading — finalize() garante reset do loading ──\n  salvar(): void {\n    if (this.isReadOnly) return;\n    if (!this.formData.title.trim() || !this.formData.date || !this.hasTargetCalendars) return;\n\n    this.loadingSalvar = true;\n\n    // Normaliza endDate se for vazio ou anterior a date\n    const finalEndDate = (!this.formData.endDate || this.formData.endDate < this.formData.date)\n      ? this.formData.date\n      : this.formData.endDate;\n\n    const payload = {\n      ...this.formData,\n      endDate: finalEndDate,\n      title: this.formData.title.trim(),\n    };\n\n    const count = this.effectiveRecurringMonths;\n\n    const completed = (saved: CalendarEvent | CalendarEvent[] | null) => {\n      if (!saved) { this.loadingSalvar = false; return; }\n      this.uploadPending(Array.isArray(saved) ? saved : [saved], success => {\n        this.loadingSalvar = false;\n        if (success) this.dialogRef.close(true);\n      });\n    };\n\n    if (this.isEdit && this.data.event) {\n      if (this.monthlyRecurring && count > 1) {\n        // Atualiza o evento atual e cria as ocorrências para os meses subsequentes\n        this.eventsService.update(this.data.event.id, payload, updated => {\n          if (!updated) { this.loadingSalvar = false; return; }\n          const remainingOccurrences = this.computeMonthlyOccurrences(this.formData.date, finalEndDate, count).slice(1);\n          if (remainingOccurrences.length > 0) {\n            this.eventsService.createRecurringSeries(\n              { ...payload, copyGroupId: this.data.event!.copyGroupId || this.data.event!.id },\n              [this.data.event!.calendarId],\n              remainingOccurrences,\n              () => completed(updated)\n            );\n          } else {\n            completed(updated);\n          }\n        });\n      } else {\n        this.eventsService.update(this.data.event.id, payload, completed);\n      }\n    } else {\n      if (this.monthlyRecurring && count > 1) {\n        const occurrences = this.computeMonthlyOccurrences(this.formData.date, finalEndDate, count);\n        this.eventsService.createRecurringSeries(payload, this.data.targetCalendarIds || [], occurrences, completed);\n      } else {\n        this.eventsService.createInCalendars(payload, this.data.targetCalendarIds || [], completed);\n      }\n    }\n  }\n\n  excluir(): void {\n    if (!this.isReadOnly && this.isEdit && this.data.event) this.showDeleteConfirmation = true;\n  }\n\n  confirmDelete(): void {\n    if (!this.data.event) return;\n    this.loadingSalvar = true;\n    this.eventsService.remove(this.data.event.id, success => {\n      this.loadingSalvar = false;\n      if (success) this.dialogRef.close(true);\n    });\n  }\n}\n","<!-- ╔══════════════════════════════════════════════════════════╗\n     ║  SKILL: Angular Modal Layout                            ║\n     ║  Header fixo + Body rolável + Footer fixo              ║\n     ╚══════════════════════════════════════════════════════════╝ -->\n\n<div class=\"modal-wrapper\">\n\n  <!-- ── Header fixo ── -->\n  <div class=\"modal-header\">\n    <div class=\"header-main\">\n      <div class=\"header-icon-badge\" [class.edit-mode]=\"isEdit\">\n        <mat-icon>{{ isEdit ? 'edit_calendar' : 'event' }}</mat-icon>\n      </div>\n      <div class=\"header-title-box\">\n        <h2>{{ isReadOnly ? 'Detalhes do Evento' : isEdit ? 'Editar Evento' : 'Novo Evento' }}</h2>\n        <p>{{ isReadOnly ? 'Você possui acesso somente para visualização.' : isEdit ? 'Atualize os dados do evento selecionado.' : 'Preencha os dados para criar um novo evento.' }}</p>\n      </div>\n    </div>\n    <button type=\"button\" class=\"close-btn\" (click)=\"dialogRef.close()\" title=\"Fechar\" id=\"btn-close-modal\">\n      <mat-icon>close</mat-icon>\n    </button>\n  </div>\n\n  <div class=\"event-error\" *ngIf=\"eventsService.error()\"><mat-icon>error_outline</mat-icon><span>{{ eventsService.error() }}</span></div>\n  <div class=\"event-error\" *ngIf=\"!hasValidSchedule\"><mat-icon>schedule</mat-icon><span>O horário final deve ser posterior ao horário inicial.</span></div>\n\n  <!-- ── Body rolável ── -->\n  <div class=\"modal-body\">\n    <!-- Modo Visualização Limpo & Elegante -->\n    <div class=\"read-only-view-container\" *ngIf=\"isReadOnly\">\n      <div class=\"view-content-card\" [style.border-left-color]=\"getCalendarColor()\">\n        <div class=\"view-header-row\">\n          <h1 class=\"view-title\">{{ formData.title || 'Sem título' }}</h1>\n          <div class=\"view-meta-badges\">\n            <span class=\"view-badge badge-calendar\" *ngIf=\"getCalendarName()\" [style.color]=\"getCalendarColor()\">\n              <span class=\"view-badge-dot\" [style.background]=\"getCalendarColor()\"></span>\n              <span>{{ getCalendarName() }}</span>\n            </span>\n            <span class=\"view-badge badge-schedule\">\n              <mat-icon>schedule</mat-icon>\n              <span>{{ formatEventSchedule() }}</span>\n            </span>\n            <span class=\"view-badge badge-category\" *ngIf=\"formData.category\">\n              <mat-icon>label</mat-icon>\n              <span>{{ formData.category }}</span>\n            </span>\n          </div>\n        </div>\n\n        <div class=\"view-description-wrap\">\n          <app-markdown-text *ngIf=\"formData.description\" [text]=\"formData.description\" (textChange)=\"onDescriptionChangeInView($event)\"></app-markdown-text>\n          <p *ngIf=\"!formData.description\" class=\"view-empty-desc\">Nenhuma descrição informada.</p>\n        </div>\n      </div>\n\n      <!-- Anexos no modo visualização (somente se houver) -->\n      <div class=\"view-attachments-card\" *ngIf=\"attachments.length > 0\">\n        <div class=\"view-card-subtitle\">\n          <mat-icon>attach_file</mat-icon>\n          <span>Anexos ({{ attachments.length }})</span>\n        </div>\n        <div class=\"attachment-list\">\n          <div\n            class=\"attachment-item\"\n            *ngFor=\"let attachment of attachments\"\n            (click)=\"openAttachment(attachment)\"\n            role=\"button\"\n            tabindex=\"0\"\n            (keydown.enter)=\"openAttachment(attachment)\"\n          >\n            <mat-icon [style.color]=\"getFileInfo(attachment.fileName, attachment.mimeType).color\">\n              {{ getFileInfo(attachment.fileName, attachment.mimeType).icon }}\n            </mat-icon>\n            <div>\n              <strong>{{ attachment.fileName }}</strong>\n              <span>{{ attachment.byteSize / 1048576 | number:'1.0-2' }} MB · {{ getFileInfo(attachment.fileName, attachment.mimeType).name }}</span>\n            </div>\n            <mat-icon class=\"view-action-icon\">visibility</mat-icon>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Modo Edição / Criação com Formulário Completo -->\n    <form class=\"form-container\" *ngIf=\"!isReadOnly\" #eventForm=\"ngForm\">\n\n      <p class=\"no-calendar-warning\" *ngIf=\"!isEdit && !hasTargetCalendars\">Selecione ao menos uma agenda na lateral antes de criar o evento.</p>\n\n      <!-- SKILL: Form Groups — Grupo 1: Dados do Evento -->\n      <div class=\"form-card\">\n        <div class=\"card-header\">\n          <mat-icon class=\"section-icon color-blue\">event_note</mat-icon>\n          <h3>Dados do Evento</h3>\n        </div>\n\n        <div class=\"form-grid\">\n          <!-- Título -->\n          <div class=\"form-field col-span-2\">\n            <label for=\"ev-title\">Título <span class=\"required\">*</span></label>\n            <input\n              id=\"ev-title\"\n              type=\"text\"\n              [(ngModel)]=\"formData.title\"\n              name=\"title\"\n              placeholder=\"Ex: Reunião de alinhamento\"\n              required\n              maxlength=\"100\"\n            />\n          </div>\n\n          <!-- Categoria -->\n          <div class=\"form-field\">\n            <label for=\"ev-category\">Categoria</label>\n            <select id=\"ev-category\" [(ngModel)]=\"formData.category\" name=\"category\" class=\"custom-select\">\n              <option *ngFor=\"let cat of categories\" [value]=\"cat\">{{ cat }}</option>\n            </select>\n          </div>\n\n          <!-- Cor -->\n          <div class=\"form-field\">\n            <label>Cor do Evento</label>\n            <div class=\"color-picker\">\n              <button\n                *ngFor=\"let color of colorOptions\"\n                type=\"button\"\n                class=\"color-swatch\"\n                [class.selected]=\"formData.color === color\"\n                [style.background]=\"colorMap[color]\"\n                [matTooltip]=\"colorLabels[color]\"\n                (click)=\"formData.color = color\"\n                [id]=\"'color-' + color\"\n              >\n                <mat-icon *ngIf=\"formData.color === color\">check</mat-icon>\n              </button>\n            </div>\n          </div>\n\n          <!-- Descrição -->\n          <div class=\"form-field col-span-2 description-field\">\n            <div class=\"description-header\">\n              <label for=\"ev-desc\">Descrição</label>\n              <app-ai-text-button [text]=\"formData.description\" (textChange)=\"formData.description = $event\" />\n            </div>\n            <app-markdown-editor\n              [text]=\"formData.description\"\n              (textChange)=\"formData.description = $event\"\n              [maxLength]=\"5000\"\n              placeholder=\"Descrição opcional do evento...\"\n              ariaLabel=\"Descrição do evento\"\n              editorId=\"ev-desc\"\n            />\n          </div>\n        </div>\n      </div>\n\n      <div class='form-card attachment-card'>\n        <div class='card-header'>\n          <mat-icon class='section-icon color-purple'>attach_file</mat-icon>\n          <h3>Anexos</h3><span class='attachment-count'>{{ attachments.length + pendingFiles.length }}/10</span>\n        </div>\n        <p class='attachment-help'>Aceita todos os tipos de arquivos até 10 MB. Arquivos de programação contam com destaque de sintaxe.</p>\n        <label class='attachment-picker' *ngIf='attachments.length + pendingFiles.length < 10'>\n          <mat-icon>upload_file</mat-icon><span>Adicionar arquivos ou imagens</span>\n          <input type='file' multiple (change)='selectFiles($event)' />\n        </label>\n        <div class='attachment-list' *ngIf='attachments.length || pendingFiles.length'>\n          <div class='attachment-item' *ngFor='let attachment of attachments' (click)='openAttachment(attachment)' role='button' tabindex='0' (keydown.enter)='openAttachment(attachment)'>\n            <mat-icon [style.color]=\"getFileInfo(attachment.fileName, attachment.mimeType).color\">\n              {{ getFileInfo(attachment.fileName, attachment.mimeType).icon }}\n            </mat-icon>\n            <div>\n              <strong>{{ attachment.fileName }}</strong>\n              <span>{{ attachment.byteSize / 1048576 | number:'1.0-2' }} MB · {{ getFileInfo(attachment.fileName, attachment.mimeType).name }}</span>\n            </div>\n            <button type='button' (click)='$event.stopPropagation(); deleteAttachment(attachment)' title='Excluir anexo'><mat-icon>delete_outline</mat-icon></button>\n          </div>\n          <div class='attachment-item pending' *ngFor='let file of pendingFiles; let index = index' (click)='openPending(file)'>\n            <mat-icon [style.color]=\"getFileInfo(file.name, file.type).color\">\n              {{ getFileInfo(file.name, file.type).icon }}\n            </mat-icon>\n            <div>\n              <strong>{{ file.name }}</strong>\n              <span>Aguardando salvar · {{ file.size / 1048576 | number:'1.0-2' }} MB · {{ getFileInfo(file.name, file.type).name }}</span>\n            </div>\n            <button type='button' (click)='$event.stopPropagation(); removePending(index)' title='Remover'><mat-icon>close</mat-icon></button>\n          </div>\n        </div>\n        <p class='attachment-error' *ngIf='attachmentError'>{{ attachmentError }}</p>\n      </div>\n\n      <!-- SKILL: Form Groups — Grupo 2: Data e Horário -->\n      <div class=\"form-card\">\n        <div class=\"card-header\">\n          <mat-icon class=\"section-icon color-emerald\">schedule</mat-icon>\n          <h3>Data e Horário</h3>\n        </div>\n\n        <div class=\"form-grid\">\n          <!-- Data de Início -->\n          <div class=\"form-field\">\n            <label for=\"ev-date\">Data de Início <span class=\"required\">*</span></label>\n            <input\n              id=\"ev-date\"\n              type=\"date\"\n              [(ngModel)]=\"formData.date\"\n              name=\"date\"\n              required\n              (change)=\"onDateChange()\"\n            />\n            <!-- Aviso de feriado -->\n            <span *ngIf=\"holidayWarning\" class=\"holiday-warning\">\n              {{ holidayWarning }}\n            </span>\n          </div>\n\n          <!-- Data de Término -->\n          <div class=\"form-field\">\n            <label for=\"ev-end-date\">Data de Término</label>\n            <input\n              id=\"ev-end-date\"\n              type=\"date\"\n              [(ngModel)]=\"formData.endDate\"\n              name=\"endDate\"\n              [min]=\"formData.date\"\n              placeholder=\"Mesmo dia\"\n            />\n          </div>\n\n          <!-- Dia inteiro toggle -->\n          <div class=\"form-field col-span-2 all-day-row\">\n            <label class=\"checkbox-label\">\n              <input type=\"checkbox\" [(ngModel)]=\"formData.allDay\" name=\"allDay\" id=\"ev-allday\" />\n              <span>Evento de dia inteiro</span>\n            </label>\n          </div>\n\n          <!-- Horário início -->\n          <div class=\"form-field\" [class.disabled-field]=\"formData.allDay\">\n            <label for=\"ev-start\">Início <span class=\"required\">*</span></label>\n            <input\n              id=\"ev-start\"\n              type=\"time\"\n              [(ngModel)]=\"formData.startTime\"\n              name=\"startTime\"\n              [disabled]=\"formData.allDay\"\n            />\n          </div>\n\n          <!-- Horário fim -->\n          <div class=\"form-field\" [class.disabled-field]=\"formData.allDay\">\n            <label for=\"ev-end\">Término <span class=\"required\">*</span></label>\n            <input\n              id=\"ev-end\"\n              type=\"time\"\n              [(ngModel)]=\"formData.endTime\"\n              name=\"endTime\"\n              [disabled]=\"formData.allDay\"\n            />\n          </div>\n\n          <!-- Recorrência Mensal -->\n          <div class=\"form-field col-span-2 recurrence-card\">\n            <div class=\"recurrence-toggle-box\">\n              <label class=\"checkbox-label\" for=\"ev-recurring\">\n                <input\n                  type=\"checkbox\"\n                  [(ngModel)]=\"monthlyRecurring\"\n                  name=\"monthlyRecurring\"\n                  id=\"ev-recurring\"\n                />\n                <span class=\"recurrence-title\">\n                  <mat-icon class=\"inline-icon\">event_repeat</mat-icon>\n                  <strong>Recorrência mensal (repetir todo mês)</strong>\n                </span>\n              </label>\n            </div>\n\n            <div class=\"recurrence-config-panel\" *ngIf=\"monthlyRecurring\">\n              <div class=\"recurrence-duration-row\">\n                <label for=\"ev-recurring-preset\">Duração da repetição:</label>\n                <select id=\"ev-recurring-preset\" [(ngModel)]=\"recurringPreset\" name=\"recurringPreset\" class=\"custom-select recurrence-select\">\n                  <option [ngValue]=\"3\">3 meses</option>\n                  <option [ngValue]=\"6\">6 meses</option>\n                  <option [ngValue]=\"12\">12 meses (1 ano)</option>\n                  <option [ngValue]=\"24\">24 meses (2 anos)</option>\n                  <option [ngValue]=\"36\">36 meses (3 anos)</option>\n                  <option value=\"custom\">Personalizado...</option>\n                </select>\n\n                <div class=\"custom-duration-input-box\" *ngIf=\"recurringPreset === 'custom'\">\n                  <input\n                    type=\"number\"\n                    [(ngModel)]=\"customMonths\"\n                    name=\"customMonths\"\n                    id=\"ev-custom-months\"\n                    min=\"1\"\n                    max=\"120\"\n                    placeholder=\"Ex: 5\"\n                    class=\"custom-number-input\"\n                  />\n                  <span class=\"input-suffix\">meses</span>\n                </div>\n              </div>\n\n              <div class=\"recurrence-preview-pill\" *ngIf=\"formData.date\">\n                <mat-icon>info</mat-icon>\n                <span>O evento será criado para <strong>todo dia {{ formData.date.slice(8, 10) }}</strong> durante <strong>{{ effectiveRecurringMonths }} {{ effectiveRecurringMonths === 1 ? 'mês' : 'meses' }}</strong>.</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n    </form>\n  </div>\n\n  <!-- ── Footer fixo ── -->\n  <div class=\"duplicate-event-section\" *ngIf=\"isEdit && duplicateCalendars().length > 0\">\n    <div class=\"duplicate-calendar-options\" *ngIf=\"showDuplicateOptions\">\n      <label *ngFor=\"let calendar of duplicateCalendars()\">\n        <input type=\"checkbox\" [checked]=\"duplicateCalendarIds().has(calendar.id)\" (change)=\"toggleDuplicateCalendar(calendar.id)\" />\n        <span class=\"duplicate-dot\" [style.background]=\"calendar.color\"></span>\n        {{ calendar.name }}\n      </label>\n      <button type=\"button\" class=\"btn-duplicate-confirm\" [disabled]=\"duplicateCalendarIds().size === 0\" (click)=\"duplicateToSelectedCalendars()\">Duplicar evento</button>\n    </div>\n  </div>\n\n  <div class=\"modal-footer\">\n    <!-- Botão excluir (apenas no edit) -->\n    <button\n      *ngIf=\"isEdit && !isReadOnly\"\n      type=\"button\"\n      class=\"btn-delete\"\n      (click)=\"excluir()\"\n      id=\"btn-excluir-evento\"\n      matTooltip=\"Excluir evento\"\n    >\n      <mat-icon>delete</mat-icon>\n    </button>\n\n    <button\n      *ngIf=\"isEdit && !isReadOnly && duplicateCalendars().length > 0\"\n      type=\"button\"\n      class=\"btn-duplicate-toggle\"\n      (click)=\"showDuplicateOptions = !showDuplicateOptions\"\n    >\n      <mat-icon>content_copy</mat-icon>\n      Duplicar\n    </button>\n\n    <div class=\"footer-spacer\"></div>\n\n    <!-- SKILL: Angular Button HTTP Loading -->\n    <button\n      *ngIf=\"!isReadOnly\"\n      type=\"button\"\n      class=\"btn-save\"\n      (click)=\"salvar()\"\n      [disabled]=\"loadingSalvar || !formData.title.trim() || !formData.date || !hasTargetCalendars || !hasValidSchedule\"\n      id=\"btn-salvar-evento\"\n    >\n      <mat-progress-spinner\n        *ngIf=\"loadingSalvar\"\n        mode=\"indeterminate\"\n        diameter=\"18\"\n        class=\"button-spinner\"\n      ></mat-progress-spinner>\n      <mat-icon *ngIf=\"!loadingSalvar\" style=\"font-size:18px;width:18px;height:18px;\">save</mat-icon>\n      <span>{{ loadingSalvar ? 'Salvando...' : 'Salvar' }}</span>\n    </button>\n    <ng-container *ngIf=\"isReadOnly\">\n      <button\n        *ngIf=\"canEditCurrentCalendar\"\n        type=\"button\"\n        class=\"btn-cancel\"\n        (click)=\"enableEditMode()\"\n        matTooltip=\"Alternar para edição do evento\"\n      >\n        <mat-icon>edit</mat-icon>\n        <span>Editar Evento</span>\n      </button>\n      <button type=\"button\" class=\"btn-save\" (click)=\"dialogRef.close()\">\n        <mat-icon>close</mat-icon>\n        <span>Fechar</span>\n      </button>\n    </ng-container>\n  </div>\n\n  <div class=\"event-delete-backdrop\" *ngIf=\"showDeleteConfirmation\" (mousedown)=\"showDeleteConfirmation = false\">\n    <section class=\"event-delete-confirmation\" role=\"alertdialog\" aria-modal=\"true\" aria-labelledby=\"event-delete-title\" (mousedown)=\"$event.stopPropagation()\">\n      <mat-icon>event_busy</mat-icon>\n      <h3 id=\"event-delete-title\">Excluir evento</h3>\n      <p>Deseja excluir permanentemente <strong>{{ data.event?.title }}</strong>?</p>\n      <div><button type=\"button\" (click)=\"showDeleteConfirmation = false\">Cancelar</button><button type=\"button\" class=\"danger\" [disabled]=\"loadingSalvar\" (click)=\"confirmDelete()\">Excluir evento</button></div>\n    </section>\n  </div>\n\n  <app-attachment-preview-modal\n    *ngIf=\"previewUrl()\"\n    [fileName]=\"previewName()\"\n    [fileUrl]=\"previewUrl()\"\n    [mimeType]=\"previewMimeType()\"\n    [rawContent]=\"previewRawContent()\"\n    [byteSize]=\"previewByteSize()\"\n    (close)=\"closePreview()\"\n    (download)=\"downloadAttachment()\"\n  ></app-attachment-preview-modal>\n</div>\n","import { Component, Input, Output, EventEmitter, OnChanges, OnInit, SimpleChanges } from '@angular/core';\r\nimport { CommonModule } from '@angular/common';\r\nimport { MatIconModule } from '@angular/material/icon';\r\nimport { MatTooltipModule } from '@angular/material/tooltip';\r\nimport { Holiday } from '../../../core/models/holiday.model';\r\nimport { CalendarEvent } from '../../../core/models/event.model';\r\n\r\ninterface MiniDay {\r\n  date: Date;\r\n  dateStr: string;\r\n  dayNum: number;\r\n  isCurrentMonth: boolean;\r\n  isToday: boolean;\r\n  isWeekend: boolean;\r\n  isHoliday: boolean;\r\n  hasEvent: boolean;\r\n  isSelected: boolean;\r\n}\r\n\r\n@Component({\r\n  selector: 'app-mini-calendar',\r\n  standalone: true,\r\n  imports: [CommonModule, MatIconModule, MatTooltipModule],\r\n  templateUrl: './mini-calendar.component.html',\r\n  styleUrl: './mini-calendar.component.scss'\r\n})\r\nexport class MiniCalendarComponent implements OnInit, OnChanges {\r\n  @Input() selectedDate: Date = new Date();\r\n  @Input() holidays: Holiday[] = [];\r\n  @Input() events: CalendarEvent[] = [];\r\n  @Output() dateSelected = new EventEmitter<Date>();\r\n  @Output() monthChanged = new EventEmitter<Date>();\r\n\r\n  viewDate: Date = new Date();\r\n  weeks: MiniDay[][] = [];\r\n  monthLabel = '';\r\n  readonly DOW = ['D', 'S', 'T', 'Q', 'Q', 'S', 'S'];\r\n\r\n  ngOnInit(): void {\r\n    this.viewDate = new Date(this.selectedDate || new Date());\r\n    this.build();\r\n  }\r\n\r\n  ngOnChanges(changes: SimpleChanges): void {\r\n    if (changes['selectedDate'] && this.selectedDate) {\r\n      this.viewDate = new Date(this.selectedDate);\r\n    }\r\n    this.build();\r\n  }\r\n\r\n  prevMonth(): void {\r\n    this.viewDate = new Date(this.viewDate.getFullYear(), this.viewDate.getMonth() - 1, 1);\r\n    this.monthChanged.emit(new Date(this.viewDate));\r\n    this.build();\r\n  }\r\n\r\n  nextMonth(): void {\r\n    this.viewDate = new Date(this.viewDate.getFullYear(), this.viewDate.getMonth() + 1, 1);\r\n    this.monthChanged.emit(new Date(this.viewDate));\r\n    this.build();\r\n  }\r\n\r\n  selectDay(day: MiniDay): void {\r\n    this.dateSelected.emit(day.date);\r\n  }\r\n\r\n  private build(): void {\r\n    const today = new Date();\r\n    const currentDate = this.viewDate || new Date();\r\n    const year = currentDate.getFullYear();\r\n    const month = currentDate.getMonth();\r\n    const months = [\r\n      'Janeiro', 'Fevereiro', 'Março', 'Abril', 'Maio', 'Junho',\r\n      'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'\r\n    ];\r\n    this.monthLabel = `${months[month]} ${year}`;\r\n\r\n    const first = new Date(year, month, 1);\r\n    const startDow = first.getDay();\r\n    const start = new Date(year, month, 1 - startDow);\r\n\r\n    const holidayDates = new Set((this.holidays || []).map(h => h.date));\r\n    const eventDates = new Set((this.events || []).map(e => e.date));\r\n    const selectedStr = this.toStr(this.selectedDate || new Date());\r\n    const todayStr = this.toStr(today);\r\n\r\n    this.weeks = [];\r\n    let cur = new Date(start);\r\n    for (let w = 0; w < 6; w++) {\r\n      const week: MiniDay[] = [];\r\n      for (let d = 0; d < 7; d++) {\r\n        const dateStr = this.toStr(cur);\r\n        week.push({\r\n          date: new Date(cur),\r\n          dateStr,\r\n          dayNum: cur.getDate(),\r\n          isCurrentMonth: cur.getMonth() === month,\r\n          isToday: todayStr === dateStr,\r\n          isWeekend: cur.getDay() === 0 || cur.getDay() === 6,\r\n          isHoliday: holidayDates.has(dateStr),\r\n          hasEvent: eventDates.has(dateStr),\r\n          isSelected: selectedStr === dateStr,\r\n        });\r\n        cur = new Date(cur.getFullYear(), cur.getMonth(), cur.getDate() + 1);\r\n      }\r\n      this.weeks.push(week);\r\n      if (cur.getMonth() !== month && w >= 4) break;\r\n    }\r\n  }\r\n\r\n  private toStr(d: Date): string {\r\n    if (!d) return '';\r\n    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\r\n  }\r\n}\r\n","<div class=\"mini-cal\">\r\n  <!-- Cabeçalho do mini-calendário -->\r\n  <div class=\"mini-cal-header\">\r\n    <span class=\"mini-cal-title\">{{ monthLabel }}</span>\r\n    <div class=\"mini-cal-nav\">\r\n      <button (click)=\"prevMonth()\" matTooltip=\"Mês anterior\">&#8249;</button>\r\n      <button (click)=\"nextMonth()\" matTooltip=\"Próximo mês\">&#8250;</button>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- Grade dias da semana -->\r\n  <div class=\"mini-cal-grid\">\r\n    <span class=\"mini-cal-dow\" *ngFor=\"let d of DOW\">{{ d }}</span>\r\n\r\n    <ng-container *ngFor=\"let week of weeks\">\r\n      <div\r\n        *ngFor=\"let day of week\"\r\n        class=\"mini-cal-day\"\r\n        [class.other-month]=\"!day.isCurrentMonth\"\r\n        [class.today]=\"day.isToday\"\r\n        [class.selected]=\"day.isSelected && !day.isToday\"\r\n        [class.weekend]=\"day.isWeekend && !day.isToday\"\r\n        [class.holiday]=\"day.isHoliday && !day.isToday\"\r\n        [class.has-event]=\"day.hasEvent\"\r\n        (click)=\"selectDay(day)\"\r\n      >\r\n        {{ day.dayNum }}\r\n      </div>\r\n    </ng-container>\r\n  </div>\r\n</div>\r\n","import { Injectable, computed, signal } from '@angular/core';\n\nexport type StoredTheme =\n  | 'light'\n  | 'dark'\n  | 'dark-angel'\n  | 'dark-demon'\n  | 'light-angel'\n  | 'light-demon'\n  | 'dark-cadu'\n  | 'light-cadu';\n\nexport type StoredCalendarView = 'month' | 'week' | 'day';\n\nexport interface UserPreferences {\n  theme: StoredTheme;\n  calendarView: StoredCalendarView;\n  collapsedSidebarSections: string[];\n  agendaPillsExpanded: boolean;\n}\n\nconst THEMES: StoredTheme[] = [\n  'light', 'dark', 'dark-angel', 'dark-demon', 'light-angel', 'light-demon', 'dark-cadu', 'light-cadu',\n];\nconst CALENDAR_VIEWS: StoredCalendarView[] = ['month', 'week', 'day'];\n\n@Injectable({ providedIn: 'root' })\nexport class UserPreferencesService {\n  private readonly storageKey = 'agenda-user-preferences-v1';\n  private readonly legacyThemeKey = 'agenda-theme';\n  private readonly state = signal<UserPreferences>(this.load());\n\n  readonly preferences = this.state.asReadonly();\n  readonly theme = computed(() => this.state().theme);\n  readonly calendarView = computed(() => this.state().calendarView);\n  readonly collapsedSidebarSections = computed(() => this.state().collapsedSidebarSections);\n  readonly agendaPillsExpanded = computed(() => this.state().agendaPillsExpanded);\n\n  setTheme(theme: StoredTheme): void {\n    this.update({ theme });\n  }\n\n  setCalendarView(calendarView: StoredCalendarView): void {\n    this.update({ calendarView });\n  }\n\n  setCollapsedSidebarSections(collapsedSidebarSections: Iterable<string>): void {\n    this.update({ collapsedSidebarSections: [...new Set(collapsedSidebarSections)] });\n  }\n\n  setAgendaPillsExpanded(agendaPillsExpanded: boolean): void {\n    this.update({ agendaPillsExpanded });\n  }\n\n  private update(changes: Partial<UserPreferences>): void {\n    const next = { ...this.state(), ...changes };\n    this.state.set(next);\n    this.save(next);\n  }\n\n  private load(): UserPreferences {\n    const defaults = this.defaults();\n    try {\n      const raw = localStorage.getItem(this.storageKey);\n      if (!raw) {\n        const legacyTheme = localStorage.getItem(this.legacyThemeKey);\n        return THEMES.includes(legacyTheme as StoredTheme)\n          ? { ...defaults, theme: legacyTheme as StoredTheme }\n          : defaults;\n      }\n\n      const saved = JSON.parse(raw) as Partial<UserPreferences>;\n      return {\n        theme: THEMES.includes(saved.theme as StoredTheme) ? saved.theme as StoredTheme : defaults.theme,\n        calendarView: CALENDAR_VIEWS.includes(saved.calendarView as StoredCalendarView)\n          ? saved.calendarView as StoredCalendarView\n          : defaults.calendarView,\n        collapsedSidebarSections: Array.isArray(saved.collapsedSidebarSections)\n          ? [...new Set(saved.collapsedSidebarSections.filter(section => typeof section === 'string'))]\n          : defaults.collapsedSidebarSections,\n        agendaPillsExpanded: typeof saved.agendaPillsExpanded === 'boolean'\n          ? saved.agendaPillsExpanded\n          : defaults.agendaPillsExpanded,\n      };\n    } catch {\n      return defaults;\n    }\n  }\n\n  private save(preferences: UserPreferences): void {\n    try {\n      localStorage.setItem(this.storageKey, JSON.stringify(preferences));\n      localStorage.removeItem(this.legacyThemeKey);\n    } catch {\n      // A aplicação continua funcionando quando o armazenamento está indisponível.\n    }\n  }\n\n  private defaults(): UserPreferences {\n    const prefersDark =\n      typeof window !== 'undefined' &&\n      !!window.matchMedia &&\n      window.matchMedia('(prefers-color-scheme: dark)').matches;\n\n    return {\n      theme: prefersDark ? 'dark' : 'light',\n      calendarView: 'month',\n      collapsedSidebarSections: [],\n      agendaPillsExpanded: true,\n    };\n  }\n}\n","import { Injectable, effect, inject } from '@angular/core';\nimport { StoredTheme, UserPreferencesService } from './user-preferences.service';\n\n/**\n * Temas disponíveis:\n *  - light       → modo claro padrão\n *  - dark        → modo escuro padrão\n *  - dark-angel  → reino angelical (fundo roxo/branco, partículas de luz)\n *  - dark-demon  → reino demoníaco (fundo preto/vermelho, chamas)\n *  - light-angel → reino angelical claro\n *  - light-demon → reino demoníaco claro\n *  - dark-cadu   → modo Cadu Maverick escuro (Ondas noturnas da Ilha Pen Gu, turquesa bioluminescente & sunset âmbar)\n *  - light-cadu  → modo Cadu Maverick claro (Praia tropical de Pen Gu, mar cristalino turquesa & sol dourado)\n */\nexport type Theme = StoredTheme;\n\n/** Qual \"reino\" especial está ativo (null = nenhum) */\nexport type Realm = 'angel' | 'demon' | 'cadu' | null;\n\n@Injectable({ providedIn: 'root' })\nexport class ThemeService {\n  private readonly userPreferences = inject(UserPreferencesService);\n\n  readonly theme = this.userPreferences.theme;\n\n  /** true quando qualquer variante escura está ativa */\n  isDark = (() => {\n    const t = this.theme;\n    return () => t() === 'dark' || t() === 'dark-angel' || t() === 'dark-demon' || t() === 'dark-cadu';\n  })();\n\n  /** Qual reino especial está ativo */\n  realm = (() => {\n    const t = this.theme;\n    return (): Realm => {\n      if (t() === 'dark-angel' || t() === 'light-angel') return 'angel';\n      if (t() === 'dark-demon' || t() === 'light-demon') return 'demon';\n      if (t() === 'dark-cadu' || t() === 'light-cadu') return 'cadu';\n      return null;\n    };\n  })();\n\n  private keyBuffer = '';\n  private keyTimeout?: any;\n\n  constructor() {\n    effect(() => {\n      this.applyTheme(this.theme());\n    });\n    this.initEasterEggListener();\n  }\n\n  /**\n   * Toggle normal do botão de tema:\n   *  - Sem reino: alterna light ↔ dark\n   *  - Com reino: alterna entre light e o tema do reino ativo\n   */\n  toggle(): void {\n    const current = this.theme();\n    if (current === 'dark-angel') this.setTheme('light-angel');\n    else if (current === 'light-angel') this.setTheme('dark-angel');\n    else if (current === 'dark-demon') this.setTheme('light-demon');\n    else if (current === 'light-demon') this.setTheme('dark-demon');\n    else if (current === 'dark-cadu') this.setTheme('light-cadu');\n    else if (current === 'light-cadu') this.setTheme('dark-cadu');\n    else if (current === 'dark') this.setTheme('light');\n    else this.setTheme('dark');\n  }\n\n  /**\n   * Clique na imagem do sidebar:\n   * Cicla entre nenhum reino → angel → demon → cadu → nenhum\n   * Mantém o tom escuro/claro atual\n   */\n  cycleRealm(): void {\n    const current = this.theme();\n    if (current === 'dark-angel') {\n      this.setTheme('dark-demon');\n    } else if (current === 'dark-demon') {\n      this.setTheme('dark-cadu');\n    } else if (current === 'dark-cadu') {\n      this.setTheme('dark');\n    } else if (current === 'dark') {\n      this.setTheme('dark-angel');\n    } else if (current === 'light-angel') {\n      this.setTheme('light-demon');\n    } else if (current === 'light-demon') {\n      this.setTheme('light-cadu');\n    } else if (current === 'light-cadu') {\n      this.setTheme('light');\n    } else {\n      this.setTheme('light-angel');\n    }\n  }\n\n  setTheme(t: Theme): void {\n    this.userPreferences.setTheme(t);\n  }\n\n  private applyTheme(t: Theme): void {\n    if (typeof document !== 'undefined' && document.documentElement) {\n      document.documentElement.setAttribute('data-theme', t);\n    }\n  }\n\n  /**\n   * Easter egg escondido: digitar 'cadu' ou 'maverick' em qualquer tela\n   * ativa o tema especial de surf da Ilha Pen Gu!\n   */\n  private initEasterEggListener(): void {\n    if (typeof window === 'undefined') return;\n\n    window.addEventListener('keydown', (e: KeyboardEvent) => {\n      // Ignora se estiver digitando em inputs ou textarea\n      const target = e.target as HTMLElement;\n      if (target && ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName) || target?.isContentEditable) {\n        return;\n      }\n\n      if (e.key.length === 1 && /[a-zA-Z]/i.test(e.key)) {\n        this.keyBuffer += e.key.toLowerCase();\n        if (this.keyBuffer.length > 15) this.keyBuffer = this.keyBuffer.slice(-15);\n\n        clearTimeout(this.keyTimeout);\n        this.keyTimeout = setTimeout(() => { this.keyBuffer = ''; }, 2500);\n\n        if (this.keyBuffer.includes('cadu') || this.keyBuffer.includes('maverick') || this.keyBuffer.includes('surfsup')) {\n          this.keyBuffer = '';\n          const isDarkCurrent = this.isDark();\n          this.setTheme(isDarkCurrent ? 'dark-cadu' : 'light-cadu');\n        }\n      }\n    });\n  }\n}\n","import { Component, inject } from '@angular/core';\nimport { CommonModule } from '@angular/common';\nimport { ThemeService } from '../../../core/services/theme.service';\n\n@Component({\n  selector: 'app-theme-toggle',\n  standalone: true,\n  imports: [CommonModule],\n  templateUrl: './theme-toggle.component.html',\n  styleUrl: './theme-toggle.component.scss'\n})\nexport class ThemeToggleComponent {\n  readonly theme = inject(ThemeService);\n\n  toggle(): void {\n    this.theme.toggle();\n  }\n\n  get title(): string {\n    const t = this.theme.theme();\n    if (t === 'dark-angel' || t === 'light-angel') return 'Modo Angelical — clique para alternar modo claro/escuro';\n    if (t === 'dark-demon' || t === 'light-demon') return 'Modo Demoníaco — clique para alternar modo claro/escuro';\n    if (t === 'dark-cadu' || t === 'light-cadu') return 'Modo Cadu Maverick 🏄‍♂️ — clique para alternar entre Sol e Noite na Ilha Pen Gu';\n    if (t === 'dark') return 'Ativar modo claro';\n    return 'Ativar modo escuro';\n  }\n}\n","<button\n  class=\"theme-toggle-btn\"\n  [class.dark]=\"theme.isDark()\"\n  [class.angel]=\"theme.realm() === 'angel'\"\n  [class.demon]=\"theme.realm() === 'demon'\"\n  [class.cadu]=\"theme.realm() === 'cadu'\"\n  (click)=\"toggle()\"\n  [title]=\"title\"\n  id=\"btn-theme-toggle\"\n>\n  <!-- ── Efeito de aura (angel / demon / cadu) ── -->\n  <span class=\"realm-aura\"></span>\n  <span class=\"realm-ring\"></span>\n\n  <!-- ── Asa esquerda (angel) ── -->\n  <span class=\"realm-badge badge-left\" *ngIf=\"theme.realm() === 'angel'\">\n    <svg class=\"wing-svg\" viewBox=\"0 0 32 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M28 38 C20 30, 4 28, 2 10 C8 16, 14 14, 18 20 C14 12, 20 6, 28 2 C22 14, 26 24, 28 38Z\"\n            fill=\"url(#wingGrad)\" opacity=\"0.9\"/>\n      <path d=\"M26 36 C18 28, 6 26, 4 12 C9 17, 15 15, 19 21\"\n            stroke=\"rgba(255,255,255,0.4)\" stroke-width=\"0.5\" fill=\"none\"/>\n      <defs>\n        <linearGradient id=\"wingGrad\" x1=\"2\" y1=\"38\" x2=\"28\" y2=\"2\" gradientUnits=\"userSpaceOnUse\">\n          <stop offset=\"0%\" stop-color=\"#c0a0ff\"/>\n          <stop offset=\"50%\" stop-color=\"#e8d9ff\"/>\n          <stop offset=\"100%\" stop-color=\"#ffffff\"/>\n        </linearGradient>\n      </defs>\n    </svg>\n  </span>\n\n  <!-- ── Chifre esquerdo (demon) ── -->\n  <span class=\"realm-badge badge-left\" *ngIf=\"theme.realm() === 'demon'\">\n    <svg class=\"horn-svg\" viewBox=\"0 0 20 36\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M10 34 C8 26, 2 18, 4 6 C7 10, 9 14, 10 20 C11 14, 14 10, 16 4 C18 16, 14 26, 10 34Z\"\n            fill=\"url(#hornGrad)\" opacity=\"0.9\"/>\n      <path d=\"M10 34 C9 28, 5 20, 6 10\" stroke=\"rgba(255,120,0,0.5)\" stroke-width=\"0.8\" fill=\"none\"/>\n      <defs>\n        <linearGradient id=\"hornGrad\" x1=\"10\" y1=\"34\" x2=\"10\" y2=\"4\" gradientUnits=\"userSpaceOnUse\">\n          <stop offset=\"0%\" stop-color=\"#7f0000\"/>\n          <stop offset=\"50%\" stop-color=\"#dc2626\"/>\n          <stop offset=\"100%\" stop-color=\"#ff6b2b\"/>\n        </linearGradient>\n      </defs>\n    </svg>\n  </span>\n\n  <!-- ── Prancha de Surf / Onda (cadu) ── -->\n  <span class=\"realm-badge badge-left\" *ngIf=\"theme.realm() === 'cadu'\">\n    <svg class=\"surf-svg\" viewBox=\"0 0 24 38\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M12 2 C18 10, 22 24, 18 36 C14 38, 10 38, 6 36 C2 24, 6 10, 12 2Z\"\n            fill=\"url(#surfGrad)\" opacity=\"0.95\"/>\n      <path d=\"M12 4 L12 34\" stroke=\"#ffffff\" stroke-width=\"1.2\" stroke-linecap=\"round\" opacity=\"0.8\"/>\n      <defs>\n        <linearGradient id=\"surfGrad\" x1=\"12\" y1=\"2\" x2=\"12\" y2=\"36\" gradientUnits=\"userSpaceOnUse\">\n          <stop offset=\"0%\" stop-color=\"#06b6d4\"/>\n          <stop offset=\"50%\" stop-color=\"#f59e0b\"/>\n          <stop offset=\"100%\" stop-color=\"#ea580c\"/>\n        </linearGradient>\n      </defs>\n    </svg>\n  </span>\n\n  <!-- ── Partículas ── -->\n  <span class=\"particle p1\"></span>\n  <span class=\"particle p2\"></span>\n  <span class=\"particle p3\"></span>\n  <span class=\"particle p4\"></span>\n  <span class=\"particle p5\"></span>\n\n  <!-- ── Ícones ── -->\n  <span class=\"toggle-icon icon-sun\">☀️</span>\n  <span class=\"toggle-icon icon-moon\">🌙</span>\n  <span class=\"toggle-icon icon-angel\">😇</span>\n  <span class=\"toggle-icon icon-demon\">😈</span>\n  <span class=\"toggle-icon icon-cadu\">🏄‍♂️</span>\n\n  <!-- ── Thumb ── -->\n  <span class=\"toggle-thumb\"></span>\n</button>\n","export type CalendarPermission = 'owner' | 'editor' | 'viewer';\r\n\r\nexport interface CalendarMember {\r\n  id: string;\r\n  calendar_id: string;\r\n  user_id: string;\r\n  permission: CalendarPermission;\r\n  // Enriquecido no frontend com dados da API de usuários\r\n  userName?: string;\r\n  userEmail?: string;\r\n  userAvatar?: string;\r\n}\r\n\r\nexport interface Calendar {\r\n  id: string;\r\n  name: string;\r\n  color: string;\r\n  isPrivate: boolean;\r\n  isDefault?: boolean;\r\n  isTaskCalendar?: boolean;\r\n  taskTeamName?: string | null;\r\n  owner_id: string;\r\n  created_at: string;\r\n  members: CalendarMember[];\r\n  // Resolvido no frontend\r\n  my_permission?: CalendarPermission;\r\n}\r\n\r\nexport const CALENDAR_COLORS = [\r\n  { value: '#4f46e5', label: 'Índigo' },\r\n  { value: '#0284c7', label: 'Azul' },\r\n  { value: '#0d9488', label: 'Verde-azulado' },\r\n  { value: '#059669', label: 'Esmeralda' },\r\n  { value: '#d97706', label: 'Âmbar' },\r\n  { value: '#ea580c', label: 'Laranja' },\r\n  { value: '#e11d48', label: 'Rosa' },\r\n  { value: '#9333ea', label: 'Roxo' },\r\n  { value: '#db2777', label: 'Pink' },\r\n  { value: '#475569', label: 'Cinza' },\r\n];\r\n","import {\r\n  Component, Input, Output, EventEmitter, inject, signal, computed, OnInit\r\n} from '@angular/core';\r\nimport { CommonModule } from '@angular/common';\r\nimport { FormsModule } from '@angular/forms';\r\nimport { MatIconModule } from '@angular/material/icon';\r\nimport { MatTooltipModule } from '@angular/material/tooltip';\r\nimport { Calendar, CalendarMember, CalendarPermission, CALENDAR_COLORS } from '../../../core/models/calendar.model';\r\nimport { CalendarsService } from '../../../core/services/calendars.service';\r\nimport { AuthService } from '../../../core/services/auth.service';\r\nimport { UserResponse, DEFAULT_AVATAR } from '../../../core/models/user.model';\r\n\r\n@Component({\r\n  selector: 'app-calendar-manager',\r\n  standalone: true,\r\n  imports: [CommonModule, FormsModule, MatIconModule, MatTooltipModule],\r\n  templateUrl: './calendar-manager.component.html',\r\n  styleUrl: './calendar-manager.component.scss',\r\n})\r\nexport class CalendarManagerComponent implements OnInit {\r\n  public calendarsService = inject(CalendarsService);\r\n  public authService = inject(AuthService);\r\n\r\n  readonly defaultAvatar = DEFAULT_AVATAR;\r\n\r\n  /** null = criando nova, Calendar = editando existente */\r\n  @Input() calendar: Calendar | null = null;\r\n  @Output() closed = new EventEmitter<void>();\r\n  @Output() saved = new EventEmitter<void>();\r\n\r\n  readonly COLORS = CALENDAR_COLORS;\r\n  readonly allUsers = this.authService.allUsers;\r\n  readonly currentUser = this.authService.currentUser;\r\n\r\n  // Form state\r\n  name = signal('');\r\n  selectedColor = '#4f46e5';\r\n  isPrivate = true;\r\n\r\n  // Dropdowns\r\n  showMemberDropdown = false;\r\n  userSearch = signal('');\r\n  isSaving = false;\r\n  showDeleteConfirmation = false;\r\n\r\n  // Membros adicionados\r\n  members = signal<CalendarMember[]>([]);\r\n\r\n  get isEditing(): boolean { return !!this.calendar; }\r\n  get isOwner(): boolean { return !!this.calendar && this.calendarsService.isOwner(this.calendar.id); }\r\n  get canDelete(): boolean { return this.isOwner && !this.calendar?.isDefault; }\r\n\r\n  /** Lista de colaboradores disponíveis (excluindo já adicionados e o próprio usuário logado) */\r\n  readonly availableUsers = computed<UserResponse[]>(() => {\r\n    const users = this.allUsers();\r\n    const currentId = this.currentUser()?.id;\r\n    const addedIds = new Set(this.members().map(m => m.user_id));\r\n\r\n    return users.filter(u => u.id !== currentId && !addedIds.has(u.id));\r\n  });\r\n\r\n  /** Usuários filtrados para o campo de busca de membros (atualiza em tempo real) */\r\n  readonly filteredUsers = computed<UserResponse[]>(() => {\r\n    const q = this.userSearch().toLowerCase().trim();\r\n    const available = this.availableUsers();\r\n\r\n    if (!q) return available.slice(0, 15);\r\n    return available.filter(u =>\r\n      (u.name || '').toLowerCase().includes(q) ||\r\n      (u.email || '').toLowerCase().includes(q) ||\r\n      (u.departament?.name || '').toLowerCase().includes(q)\r\n    ).slice(0, 15);\r\n  });\r\n\r\n  ngOnInit(): void {\r\n    if (this.calendar) {\r\n      this.name.set(this.calendar.name);\r\n      this.selectedColor = this.calendar.color;\r\n      this.isPrivate = this.calendar.isPrivate;\r\n\r\n      const allU = this.allUsers();\r\n      this.members.set(\r\n        this.calendar.members\r\n          .filter(m => m.permission !== 'owner')\r\n          .map(m => {\r\n            const user = allU.find(u => u.id === m.user_id);\r\n            return {\r\n              ...m,\r\n              userName: user?.name ?? m.userName,\r\n              userEmail: user?.email ?? m.userEmail,\r\n              userAvatar: user?.avatar ?? m.userAvatar,\r\n            };\r\n          })\r\n      );\r\n    }\r\n  }\r\n\r\n  /* ── Campo de busca de membros ── */\r\n  onMemberSearchFocus(): void {\r\n    this.showMemberDropdown = true;\r\n  }\r\n\r\n  onMemberSearchChange(): void {\r\n    this.showMemberDropdown = true;\r\n  }\r\n\r\n  onMemberSearchBlur(): void {\r\n    setTimeout(() => {\r\n      this.showMemberDropdown = false;\r\n    }, 250);\r\n  }\r\n\r\n  addMember(user: UserResponse): void {\r\n    this.members.update(list => [...list, {\r\n      id: '',\r\n      calendar_id: this.calendar?.id ?? '',\r\n      user_id: user.id,\r\n      permission: 'editor',\r\n      userName: user.name,\r\n      userEmail: user.email,\r\n      userAvatar: user.avatar,\r\n    }]);\r\n    this.userSearch.set('');\r\n  }\r\n\r\n  updatePermission(userId: string, permission: CalendarPermission): void {\r\n    this.members.update(list =>\r\n      list.map(m => m.user_id === userId ? { ...m, permission } : m)\r\n    );\r\n  }\r\n\r\n  removeMember(userId: string): void {\r\n    this.members.update(list => list.filter(m => m.user_id !== userId));\r\n  }\r\n\r\n  onSave(): void {\r\n    const val = this.name().trim();\r\n    if (!val) return;\r\n    this.isSaving = true;\r\n\r\n    if (this.isEditing && this.calendar) {\r\n      const existing = this.calendar.members.filter(m => m.permission !== 'owner');\r\n      const current = this.isOwner ? (this.isPrivate ? [] : this.members()) : existing;\r\n\r\n      const toAdd = current.filter(m => !existing.some(e => e.user_id === m.user_id));\r\n      const toRemove = existing.filter(e => !current.some(m => m.user_id === e.user_id));\r\n      const toUpdate = current.filter(m => {\r\n        const e = existing.find(ex => ex.user_id === m.user_id);\r\n        return e && e.permission !== m.permission;\r\n      });\r\n      const operations: Array<(done: (success: boolean) => void) => void> = [\r\n        done => this.calendarsService.update(this.calendar!.id, { name: val, color: this.selectedColor, isPrivate: this.isPrivate }, done),\r\n        ...toAdd.map(m => (done: (success: boolean) => void) => this.calendarsService.addMember(this.calendar!.id, m.user_id, m.permission, done)),\r\n        ...toRemove.map(m => (done: (success: boolean) => void) => this.calendarsService.removeMember(this.calendar!.id, m.id, done)),\r\n        ...toUpdate.map(m => (done: (success: boolean) => void) => {\r\n          const existingMember = existing.find(item => item.user_id === m.user_id)!;\r\n          this.calendarsService.updateMemberPermission(this.calendar!.id, existingMember.id, m.permission, done);\r\n        }),\r\n      ];\r\n      let pending = operations.length;\r\n      let succeeded = true;\r\n      operations.forEach(operation => operation(success => {\r\n        succeeded = succeeded && success;\r\n        if (--pending === 0) this.finishSave(succeeded);\r\n      }));\r\n    } else {\r\n      const initialMembers = (this.isPrivate ? [] : this.members()).map(m => ({\r\n        user_id: m.user_id,\r\n        permission: m.permission,\r\n      }));\r\n      this.calendarsService.create(val, this.selectedColor, this.isPrivate, initialMembers, success => this.finishSave(success));\r\n    }\r\n  }\r\n\r\n  onDelete(): void {\r\n    if (!this.calendar) return;\r\n    this.showDeleteConfirmation = true;\r\n  }\r\n\r\n  cancelDelete(): void {\r\n    this.showDeleteConfirmation = false;\r\n  }\r\n\r\n  confirmDelete(): void {\r\n    if (!this.calendar) return;\r\n    this.showDeleteConfirmation = false;\r\n    this.isSaving = true;\r\n    this.calendarsService.remove(this.calendar.id, success => {\r\n      this.isSaving = false;\r\n      if (success) {\r\n        this.saved.emit();\r\n        this.closed.emit();\r\n      }\r\n    });\r\n  }\r\n\r\n  onClose(): void {\r\n    this.closed.emit();\r\n  }\r\n\r\n  permissionLabel(p: CalendarPermission): string {\r\n    return p === 'editor' ? 'Leitura e Gravação' : 'Somente Leitura';\r\n  }\r\n\r\n  memberAvatar(member: CalendarMember): string {\r\n    return member.userAvatar\r\n      || this.allUsers().find(user => user.id === member.user_id)?.avatar\r\n      || this.defaultAvatar;\r\n  }\r\n\r\n  private finishSave(success: boolean): void {\r\n    this.isSaving = false;\r\n    if (!success) return;\r\n    this.saved.emit();\r\n    this.closed.emit();\r\n  }\r\n}\r\n","<div class=\"modal-overlay\">\r\n  <div class=\"modal-card\">\r\n\r\n    <!-- Header -->\r\n    <div class=\"modal-header\">\r\n      <div class=\"modal-icon-badge\">\r\n        <mat-icon>calendar_month</mat-icon>\r\n      </div>\r\n      <div class=\"modal-title-group\">\r\n        <h2 class=\"modal-title\">{{ isEditing ? 'Editar Agenda' : 'Nova Agenda' }}</h2>\r\n        <p class=\"modal-subtitle\">Configure nome, cor e colaboradores vinculados</p>\r\n      </div>\r\n      <button class=\"btn-close-modal\" (click)=\"onClose()\" aria-label=\"Fechar\">\r\n        <mat-icon>close</mat-icon>\r\n      </button>\r\n    </div>\r\n\r\n    <div class=\"manager-error\" *ngIf=\"calendarsService.error()\"><mat-icon>error_outline</mat-icon>{{ calendarsService.error() }}</div>\r\n\r\n    <!-- Body -->\r\n    <div class=\"modal-body\">\r\n\r\n      <!-- Nome da agenda -->\r\n      <div class=\"field-group\">\r\n        <label class=\"field-label\">Nome da agenda</label>\r\n        <div class=\"input-with-icon\">\r\n          <mat-icon class=\"input-icon\">edit</mat-icon>\r\n          <input\r\n            type=\"text\"\r\n            class=\"field-input with-left-icon\"\r\n            [ngModel]=\"name()\"\r\n            (ngModelChange)=\"name.set($event)\"\r\n            placeholder=\"Ex: Projetos, Reuniões, Agenda comercial...\"\r\n            maxlength=\"60\"\r\n            autofocus\r\n            autocomplete=\"off\"\r\n          />\r\n        </div>\r\n\r\n      </div>\r\n\r\n      <!-- Cor -->\r\n      <div class=\"field-group\">\r\n        <label class=\"field-label\">Cor da agenda</label>\r\n        <div class=\"color-picker\">\r\n          <button\r\n            *ngFor=\"let c of COLORS\"\r\n            class=\"color-dot\"\r\n            [class.selected]=\"selectedColor === c.value\"\r\n            [style.background]=\"c.value\"\r\n            [matTooltip]=\"c.label\"\r\n            (click)=\"selectedColor = c.value\"\r\n            type=\"button\"\r\n          >\r\n            <mat-icon *ngIf=\"selectedColor === c.value\" class=\"check-icon\">check</mat-icon>\r\n          </button>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Privacidade -->\r\n      <div class=\"field-grou