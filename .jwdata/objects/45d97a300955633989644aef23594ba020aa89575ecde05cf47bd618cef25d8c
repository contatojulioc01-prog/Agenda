rror(err => {\n          this.error.set(err.error?.error || 'Erro ao atualizar nota.');\n          return of(null);\n        })\n      )\n      .subscribe(updated => {\n        if (updated) {\n          this.activeBoard.update(curr => curr ? {\n            ...curr,\n            items: curr.items.map(i => i.id === itemId ? { ...i, ...updated } : i)\n          } : null);\n        }\n        onComplete?.(updated);\n      });\n  }\n\n  deleteItem(itemId: string, onComplete?: (success: boolean) => void): void {\n    this.http.delete(`/api/mural/items/${itemId}`, { headers: this.headers })\n      .pipe(\n        catchError(err => {\n          this.error.set(err.error?.error || 'Erro ao excluir nota.');\n          return of(null);\n        })\n      )\n      .subscribe(res => {\n        if (res) {\n          const active = this.activeBoard();\n          if (active) {\n            this.activeBoard.update(curr => curr ? {\n              ...curr,\n              items: curr.items.filter(i => i.id !== itemId)\n            } : null);\n            this.boards.update(list => list.map(b => b.id === active.id ? { ...b, itemCount: Math.max(0, b.itemCount - 1) } : b));\n          }\n        }\n        onComplete?.(!!res);\n      });\n  }\n}\n","import { Injectable, signal, inject, NgZone, OnDestroy } from '@angular/core';\nimport { HttpClient } from '@angular/common/http';\nimport { CalendarsService } from './calendars.service';\nimport { EventsService } from './events.service';\nimport { InvitationsService } from './invitations.service';\nimport { KanbanService } from './kanban.service';\nimport { MuralService } from './mural.service';\nimport { AuthService } from './auth.service';\n\nexport type SyncStatus = 'connected' | 'connecting' | 'disconnected';\n\nfunction getWsUrl(): string {\n  if (typeof window !== 'undefined' && window.location.hostname) {\n    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';\n    const basePath = new URL(document.baseURI).pathname.replace(/\\/$/, '');\n    return `${protocol}//${window.location.host}${basePath}/ws`;\n  }\n  return 'ws://192.168.13.244:9900';\n}\n\nfunction getHttpUrl(): string {\n  if (typeof document === 'undefined') return '';\n  return new URL(document.baseURI).pathname.replace(/\\/$/, '');\n}\n\nfunction shouldUseWebSocket(): boolean {\n  return getHttpUrl() === '';\n}\n\n@Injectable({ providedIn: 'root' })\nexport class SyncService implements OnDestroy {\n  private calendarsService = inject(CalendarsService);\n  private eventsService = inject(EventsService);\n  private invitationsService = inject(InvitationsService);\n  private kanbanService = inject(KanbanService);\n  private muralService = inject(MuralService);\n  private authService = inject(AuthService);\n  private http = inject(HttpClient);\n  private ngZone = inject(NgZone);\n\n  status = signal<SyncStatus>('disconnected');\n  lastSyncAt = signal<Date | null>(null);\n  clientsOnline = signal<number>(0);\n\n  private ws: WebSocket | null = null;\n  private eventSource: EventSource | null = null;\n  private recentMessageIds = new Set<string>();\n  private listeners = new Set<(event: any) => void>();\n  private reconnectTimer: ReturnType<typeof setTimeout> | null = null;\n  private healthInterval: ReturnType<typeof setInterval> | null = null;\n  private healthOnline = false;\n  private shouldReconnect = false;\n\n  constructor() {}\n\n  subscribe(listener: (event: any) => void): () => void {\n    this.listeners.add(listener);\n    return () => this.listeners.delete(listener);\n  }\n\n  /** Inicia a conexão WebSocket com o backend */\n  connect(): void {\n    this.shouldReconnect = true;\n    this.startHealthMonitor();\n    this.connectEventSource();\n    if (!shouldUseWebSocket()) {\n      if (!this.isRealtimeConnected()) this.status.set('connecting');\n      return;\n    }\n    if (this.ws && (this.ws.readyState === WebSocket.CONNECTING || this.ws.readyState === WebSocket.OPEN)) {\n      return;\n    }\n\n    if (!this.healthOnline) this.status.set('connecting');\n\n    try {\n      if (this.ws) {\n        try { this.ws.close(); } catch {}\n        this.ws = null;\n      }\n\n      const token = this.authService.getToken();\n      const rawUrl = getWsUrl();\n      const url = token ? `${rawUrl}${rawUrl.includes('?') ? '&' : '?'}token=${encodeURIComponent(token)}` : rawUrl;\n      this.ws = new WebSocket(url);\n\n      this.ws.onopen = () => {\n        this.ngZone.run(() => {\n          this.healthOnline = true;\n          this.status.set('connected');\n          this.lastSyncAt.set(new Date());\n          if (this.reconnectTimer) {\n            clearTimeout(this.reconnectTimer);\n            this.reconnectTimer = null;\n          }\n          console.log('[SyncService] WebSocket conectado com sucesso');\n\n          // Ao conectar, atualiza agendas e eventos\n          this.calendarsService.loadAll();\n          const ids = [...this.calendarsService.visibleCalendarIds()];\n          if (ids.length) this.eventsService.loadFromCalendars(ids);\n        });\n      };\n\n      this.ws.onmessage = (event) => {\n        try {\n          const msg = JSON.parse(event.data);\n          this.ngZone.run(() => this.handleMessage(msg));\n        } catch {}\n      };\n\n      this.ws.onclose = () => {\n        this.ngZone.run(() => {\n          this.status.set(this.isRealtimeConnected() ? 'connected' : (this.healthOnline ? 'connecting' : 'disconnected'));\n          this.scheduleReconnect();\n        });\n      };\n\n      this.ws.onerror = () => {\n        this.ngZone.run(() => {\n          this.status.set(this.isRealtimeConnected() ? 'connected' : (this.healthOnline ? 'connecting' : 'disconnected'));\n        });\n      };\n    } catch {\n      this.status.set(this.healthOnline ? 'connecting' : 'disconnected');\n      this.scheduleReconnect();\n    }\n  }\n\n  /** Verifica se a API HTTP está respondendo e força conexão */\n  checkHealthAndConnect(): void {\n    this.http.get<{ status: string; clients?: number }>(`${getHttpUrl()}/health`).subscribe({\n      next: (res) => {\n        if (res?.status === 'ok') {\n          this.healthOnline = true;\n          this.status.set(this.isRealtimeConnected() ? 'connected' : 'connecting');\n          this.clientsOnline.set(res.clients ?? 0);\n\n          if (shouldUseWebSocket() && (!this.ws || this.ws.readyState === WebSocket.CLOSED)) {\n            this.connect();\n          }\n        }\n      },\n      error: () => {\n        this.healthOnline = false;\n        this.status.set(this.isRealtimeConnected() ? 'connected' : 'disconnected');\n      }\n    });\n  }\n\n  disconnect(): void {\n    this.shouldReconnect = false;\n    this.healthOnline = false;\n    if (this.reconnectTimer) { clearTimeout(this.reconnectTimer); this.reconnectTimer = null; }\n    if (this.healthInterval) { clearInterval(this.healthInterval); this.healthInterval = null; }\n    if (this.ws) {\n      this.ws.onclose = null;\n      try { this.ws.close(); } catch {}\n      this.ws = null;\n    }\n    if (this.eventSource) {\n      this.eventSource.close();\n      this.eventSource = null;\n    }\n    this.status.set('disconnected');\n  }\n\n  ngOnDestroy(): void {\n    this.disconnect();\n  }\n\n  private connectEventSource(): void {\n    if (typeof EventSource === 'undefined' || this.eventSource) return;\n    const token = this.authService.getToken();\n    const rawUrl = `${getHttpUrl()}/api/realtime`;\n    const sseUrl = token ? `${rawUrl}?token=${encodeURIComponent(token)}` : rawUrl;\n    this.eventSource = new EventSource(sseUrl);\n    this.eventSource.onopen = () => this.ngZone.run(() => {\n      this.status.set('connected');\n      this.lastSyncAt.set(new Date());\n    });\n    this.eventSource.onmessage = event => {\n      try {\n        const msg = JSON.parse(event.data);\n        this.ngZone.run(() => this.handleMessage(msg));\n      } catch {}\n    };\n    this.eventSource.onerror = () => {\n      this.ngZone.run(() => {\n        if (!this.isRealtimeConnected()) this.status.set(this.healthOnline ? 'connecting' : 'disconnected');\n      });\n    };\n  }\n\n  private startHealthMonitor(): void {\n    if (this.healthInterval) return;\n    this.checkHealthAndConnect();\n    this.healthInterval = setInterval(() => this.checkHealthAndConnect(), 4000);\n  }\n\n  private isRealtimeConnected(): boolean {\n    return this.ws?.readyState === 1 || this.eventSource?.readyState === 1;\n  }\n\n  private handleMessage(msg: { type: string; messageId?: string; calendarId?: string; eventId?: string; userId?: string; boardId?: string; taskId?: string; teamId?: string; muralId?: string }): void {\n    if (msg.messageId) {\n      if (this.recentMessageIds.has(msg.messageId)) return;\n      this.recentMessageIds.add(msg.messageId);\n      setTimeout(() => this.recentMessageIds.delete(msg.messageId!), 10000);\n    }\n    this.lastSyncAt.set(new Date());\n\n    // Notify custom listeners\n    this.listeners.forEach(cb => {\n      try { cb(msg); } catch {}\n    });\n\n    switch (msg.type) {\n      case 'event_created':\n      case 'event_updated':\n      case 'event_deleted':\n        if (msg.calendarId && this.calendarsService.visibleCalendarIds().has(msg.calendarId)) {\n          this.eventsService.loadFromCalendar(msg.calendarId);\n        }\n        break;\n\n      case 'calendar_created':\n      case 'calendar_updated':\n      case 'calendar_deleted':\n      case 'member_added':\n      case 'member_updated':\n      case 'member_removed':\n        if (msg.type === 'calendar_deleted' && msg.calendarId) {\n          this.eventsService.unloadCalendar(msg.calendarId);\n        }\n        this.calendarsService.loadAll(calendars => {\n          this.eventsService.retainCalendars(calendars.map(calendar => calendar.id));\n          const visibleIds = [...this.calendarsService.visibleCalendarIds()];\n          if (visibleIds.length) this.eventsService.loadFromCalendars(visibleIds);\n        });\n        break;\n      case 'calendar_invited':\n        this.invitationsService.load();\n        break;\n      case 'invitation_accepted':\n      case 'invitation_declined':\n        this.calendarsService.loadAll();\n        this.invitationsService.load();\n        break;\n      case 'kanban_updated':\n        if (msg.boardId && this.kanbanService.activeBoard()?.id === msg.boardId) {\n          this.kanbanService.loadBoard(msg.boardId);\n        } else {\n          this.kanbanService.loadBoards();\n        }\n        break;\n      case 'kanban_team_invited':\n        this.kanbanService.loadTeamInvitations();\n        break;\n      case 'kanban_team_updated':\n      case 'kanban_team_joined':\n      case 'kanban_team_declined':\n        this.kanbanService.loadTeams();\n        this.kanbanService.loadTeamInvitations();\n        this.kanbanService.loadBoards();\n        this.muralService.loadBoards();\n        break;\n      case 'mural_updated':\n        if (msg.muralId && this.muralService.activeBoard()?.id === msg.muralId) {\n          this.muralService.loadBoard(msg.muralId);\n        } else {\n          this.muralService.loadBoards();\n        }\n        break;\n      case 'mural_deleted':\n        this.muralService.loadBoards();\n        break;\n    }\n  }\n\n  private scheduleReconnect(): void {\n    if (!this.shouldReconnect) return;\n    if (this.reconnectTimer) clearTimeout(this.reconnectTimer);\n    this.reconnectTimer = setTimeout(() => {\n      this.connect();\n    }, 3000);\n  }\n}\n","import { Attachment } from './attachment.model';\r\n\r\nexport interface CalendarEvent {\r\n  id: string;\r\n  calendarId: string;   // ID da agenda à qual o evento pertence\r\n  title: string;\r\n  description: string;\r\n  date: string;        // 'YYYY-MM-DD'\r\n  endDate?: string;    // 'YYYY-MM-DD' (para eventos que duram múltiplos dias)\r\n  startTime: string;   // 'HH:MM' (horário padrão ou do primeiro dia)\r\n  endTime: string;     // 'HH:MM' (horário padrão ou do último dia)\r\n  dayTimes?: Record<string, { startTime: string; endTime: string }>; // Horários individuais por dia ('YYYY-MM-DD' -> { startTime, endTime })\r\n  color: EventColor;\r\n  category: string;\r\n  allDay: boolean;\r\n  copyGroupId?: string;\r\n  /** Evento calculado pelo sistema, sem edição manual. */\r\n  isSystem?: boolean;\r\n  /** Prazo sincronizado de uma tarefa; editável somente pelo card no Kanban. */\r\n  isTaskDeadline?: boolean;\r\n  /** Referências usadas para abrir o card de origem a partir da agenda. */\r\n  taskId?: string;\r\n  taskBoardId?: string;\r\n  taskParentId?: string;\r\n  attachments: Attachment[];\r\n}\r\n\r\nexport type EventColor =\r\n  | 'indigo'\r\n  | 'blue'\r\n  | 'teal'\r\n  | 'emerald'\r\n  | 'amber'\r\n  | 'orange'\r\n  | 'rose'\r\n  | 'purple'\r\n  | 'pink'\r\n  | 'slate';\r\n\r\nexport const EVENT_COLOR_MAP: Record<EventColor, string> = {\r\n  indigo:  '#4f46e5',\r\n  blue:    '#0284c7',\r\n  teal:    '#0d9488',\r\n  emerald: '#059669',\r\n  amber:   '#d97706',\r\n  orange:  '#ea580c',\r\n  rose:    '#e11d48',\r\n  purple:  '#9333ea',\r\n  pink:    '#db2777',\r\n  slate:   '#475569',\r\n};\r\n\r\nexport const EVENT_COLOR_LABELS: Record<EventColor, string> = {\r\n  indigo:  'Índigo',\r\n  blue:    'Azul',\r\n  teal:    'Verde-azulado',\r\n  emerald: 'Esmeralda',\r\n  amber:   'Âmbar',\r\n  orange:  'Laranja',\r\n  rose:    'Rosa',\r\n  purple:  'Roxo',\r\n  pink:    'Pink',\r\n  slate:   'Cinza',\r\n};\r\n","import {\r\n  Component, Input, Output, EventEmitter, OnChanges, OnInit, SimpleChanges\r\n} from '@angular/core';\r\nimport { CommonModule } from '@angular/common';\r\nimport { MatIconModule } from '@angular/material/icon';\r\nimport { MatTooltipModule } from '@angular/material/tooltip';\r\nimport { CalendarEvent, EVENT_COLOR_MAP } from '../../../../core/models/event.model';\r\nimport { Holiday } from '../../../../core/models/holiday.model';\r\nimport { EventDropPayload } from '../week-view/week-view.component';\r\n\r\nexport interface MonthDay {\r\n  date: Date;\r\n  dateStr: string;\r\n  dayNum: number;\r\n  isCurrentMonth: boolean;\r\n  isToday: boolean;\r\n  isWeekend: boolean;\r\n  holiday: Holiday | null;\r\n}\r\n\r\nexport interface EventSegment {\r\n  event: CalendarEvent;\r\n  startCol: number; // 0 a 6\r\n  span: number;     // 1 a 7\r\n  isStart: boolean; // se é o início real do evento\r\n  isEnd: boolean;   // se é o fim real do evento\r\n  rowSlot: number;  // slot vertical (0, 1, 2...)\r\n}\r\n\r\nexport interface MonthWeek {\r\n  days: MonthDay[];\r\n  segments: EventSegment[];\r\n  maxSlot: number;\r\n}\r\n\r\n@Component({\r\n  selector: 'app-month-view',\r\n  standalone: true,\r\n  imports: [CommonModule, MatIconModule, MatTooltipModule],\r\n  templateUrl: './month-view.component.html',\r\n  styleUrl: './month-view.component.scss',\r\n})\r\nexport class MonthViewComponent implements OnInit, OnChanges {\r\n  @Input() year: number = new Date().getFullYear();\r\n  @Input() month: number = new Date().getMonth();\r\n  @Input() events: CalendarEvent[] = [];\r\n  @Input() holidays: Holiday[] = [];\r\n  @Output() dayClick = new EventEmitter<string>();\r\n  @Output() dayContextMenu = new EventEmitter<{ date: string; mouseEvent: MouseEvent }>();\r\n  @Output() eventClick = new EventEmitter<CalendarEvent>();\r\n  @Output() eventContextMenu = new EventEmitter<{ event: CalendarEvent; mouseEvent: MouseEvent }>();\r\n  @Output() eventDrop = new EventEmitter<EventDropPayload>();\r\n\r\n  readonly DOW = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];\r\n  readonly colorMap = EVENT_COLOR_MAP;\r\n\r\n  monthWeeks: MonthWeek[] = [];\r\n  dragEventId: string | null = null;\r\n\r\n  ngOnInit(): void {\r\n    this.build();\r\n  }\r\n\r\n  ngOnChanges(changes: SimpleChanges): void {\r\n    this.build();\r\n  }\r\n\r\n  private build(): void {\r\n    const today = this.toStr(new Date());\r\n    const holidayMap = new Map((this.holidays || []).map(h => [h.date, h]));\r\n\r\n    const first = new Date(this.year, this.month, 1);\r\n    const startDow = first.getDay();\r\n    const start = new Date(this.year, this.month, 1 - startDow);\r\n\r\n    this.monthWeeks = [];\r\n    let cur = new Date(start);\r\n\r\n    for (let w = 0; w < 6; w++) {\r\n      const days: MonthDay[] = [];\r\n      const dayDateStrings: string[] = [];\r\n\r\n      for (let d = 0; d < 7; d++) {\r\n        const ds = this.toStr(cur);\r\n        dayDateStrings.push(ds);\r\n        days.push({\r\n          date: new Date(cur),\r\n          dateStr: ds,\r\n          dayNum: cur.getDate(),\r\n          isCurrentMonth: cur.getMonth() === this.month,\r\n          isToday: ds === today,\r\n          isWeekend: cur.getDay() === 0 || cur.getDay() === 6,\r\n          holiday: holidayMap.get(ds) ?? null,\r\n        });\r\n        cur = new Date(cur.getFullYear(), cur.getMonth(), cur.getDate() + 1);\r\n      }\r\n\r\n      const weekStartStr = dayDateStrings[0];\r\n      const weekEndStr = dayDateStrings[6];\r\n\r\n      // Filtra eventos que aparecem nesta semana\r\n      const weekEvents = (this.events || [])\r\n        .filter(e => {\r\n          const evEnd = e.endDate || e.date;\r\n          return evEnd >= weekStartStr && e.date <= weekEndStr;\r\n        })\r\n        .sort((a, b) => {\r\n          const aEnd = a.endDate || a.date;\r\n          const bEnd = b.endDate || b.date;\r\n          const aDur = new Date(aEnd).getTime() - new Date(a.date).getTime();\r\n          const bDur = new Date(bEnd).getTime() - new Date(b.date).getTime();\r\n          // Mais longos primeiro\r\n          if (bDur !== aDur) return bDur - aDur;\r\n          if (a.date !== b.date) return a.date.localeCompare(b.date);\r\n          return (a.startTime || '09:00').localeCompare(b.startTime || '09:00');\r\n        });\r\n\r\n      // Grade de ocupação de slots para as 7 colunas\r\n      const colSlots: boolean[][] = Array.from({ length: 7 }, () => []);\r\n      const segments: EventSegment[] = [];\r\n      let maxSlot = 0;\r\n\r\n      for (const ev of weekEvents) {\r\n        const evEnd = ev.endDate || ev.date;\r\n\r\n        let startCol = 0;\r\n        if (ev.date >= weekStartStr) {\r\n          const foundIdx = dayDateStrings.indexOf(ev.date);\r\n          if (foundIdx >= 0) startCol = foundIdx;\r\n        }\r\n\r\n        let endCol = 6;\r\n        if (evEnd <= weekEndStr) {\r\n          const foundIdx = dayDateStrings.indexOf(evEnd);\r\n          if (foundIdx >= 0) endCol = foundIdx;\r\n        }\r\n\r\n        const span = Math.max(1, endCol - startCol + 1);\r\n\r\n        // Encontra o primeiro slot livre para todas as colunas de startCol até endCol\r\n        let slot = 0;\r\n        while (true) {\r\n          let conflict = false;\r\n          for (let c = startCol; c <= endCol; c++) {\r\n            if (colSlots[c][slot]) {\r\n              conflict = true;\r\n              break;\r\n            }\r\n          }\r\n          if (!conflict) break;\r\n          slot++;\r\n        }\r\n\r\n        // Marca como ocupado\r\n        for (let c = startCol; c <= endCol; c++) {\r\n          colSlots[c][slot] = true;\r\n        }\r\n        if (slot > maxSlot) maxSlot = slot;\r\n\r\n        segments.push({\r\n          event: ev,\r\n          startCol,\r\n          span,\r\n          isStart: ev.date >= weekStartStr,\r\n          isEnd: evEnd <= weekEndStr,\r\n          rowSlot: slot,\r\n        });\r\n      }\r\n\r\n      this.monthWeeks.push({\r\n        days,\r\n        segments,\r\n        maxSlot,\r\n      });\r\n\r\n      if (cur.getMonth() !== this.month && w >= 4) break;\r\n    }\r\n  }\r\n\r\n  onDragStart(ev: DragEvent, event: CalendarEvent): void {\r\n    if (event.isSystem) {\r\n      ev.preventDefault();\r\n      return;\r\n    }\r\n    this.dragEventId = event.id;\r\n    if (ev.dataTransfer) {\r\n      ev.dataTransfer.setData('text/plain', event.id);\r\n      ev.dataTransfer.effectAllowed = 'move';\r\n    }\r\n    (ev.target as HTMLElement).classList.add('dragging');\r\n    document.body.classList.add('dragging-active');\r\n  }\r\n\r\n  onDragEnd(ev: DragEvent): void {\r\n    (ev.target as HTMLElement).classList.remove('dragging');\r\n    this.dragEventId = null;\r\n    document.body.classList.remove('dragging-active');\r\n    this.dragEnterCounters = new WeakMap();\r\n  }\r\n\r\n  private dragEnterCounters = new WeakMap<HTMLElement, number>();\r\n\r\n  onDragEnter(ev: DragEvent, cell: HTMLElement): void {\r\n    ev.preventDefault();\r\n    const count = (this.dragEnterCounters.get(cell) ?? 0) + 1;\r\n    this.dragEnterCounters.set(cell, count);\r\n    if (count === 1) cell.classList.add('drag-over');\r\n  }\r\n\r\n  onDragOver(ev: DragEvent, cell: HTMLElement): void {\r\n    ev.preventDefault();\r\n    if (ev.dataTransfer) ev.dataTransfer.dropEffect = 'move';\r\n  }\r\n\r\n  onDragLeave(ev: DragEvent, cell: HTMLElement): void {\r\n    const count = Math.max(0, (this.dragEnterCounters.get(cell) ?? 0) - 1);\r\n    this.dragEnterCounters.set(cell, count);\r\n    if (count === 0) cell.classList.remove('drag-over');\r\n  }\r\n\r\n  onDrop(ev: DragEvent, day: MonthDay, cell: HTMLElement): void {\r\n    ev.preventDefault();\r\n    ev.stopPropagation();\r\n    document.body.classList.remove('dragging-active');\r\n    if (cell) {\r\n      cell.classList.remove('drag-over');\r\n      this.dragEnterCounters.set(cell, 0);\r\n    }\r\n    const eventId = (ev.dataTransfer ? ev.dataTransfer.getData('text/plain') : null) || this.dragEventId;\r\n    if (eventId) {\r\n      const orig = (this.events || []).find(e => e.id === eventId);\r\n      this.eventDrop.emit({\r\n        eventId,\r\n        oldDate: orig?.date || day.dateStr,\r\n        oldEndDate: orig?.endDate || orig?.date,\r\n        newDate: day.dateStr,\r\n      });\r\n    }\r\n  }\r\n\r\n  toStr(d: Date): string {\r\n    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\r\n  }\r\n}\r\n","<div class=\"view-month\">\r\n  <!-- Cabeçalho dias da semana -->\r\n  <div class=\"month-dow-header\">\r\n    <div\r\n      *ngFor=\"let d of DOW; let i = index\"\r\n      class=\"month-dow-cell\"\r\n      [class.weekend-col]=\"i === 0 || i === 6\"\r\n    >{{ d }}</div>\r\n  </div>\r\n\r\n  <!-- Grade do mês dividida em linhas de semanas -->\r\n  <div class=\"month-grid\">\r\n    <div *ngFor=\"let week of monthWeeks\" class=\"month-week-row\">\r\n      <!-- Camada de Células de Fundo (7 colunas) -->\r\n      <div class=\"week-cells-layer\">\r\n        <div\r\n          *ngFor=\"let day of week.days\"\r\n          #cellRef\r\n          class=\"day-cell\"\r\n          [class.other-month]=\"!day.isCurrentMonth\"\r\n          [class.today-cell]=\"day.isToday\"\r\n          [class.weekend-cell]=\"day.isWeekend && !day.isToday && !day.holiday\"\r\n          [class.holiday-cell]=\"!!day.holiday\"\r\n          (click)=\"dayClick.emit(day.dateStr)\"\r\n          (contextmenu)=\"$event.preventDefault(); dayContextMenu.emit({ date: day.dateStr, mouseEvent: $event })\"\r\n          (dragenter)=\"onDragEnter($event, cellRef)\"\r\n          (dragover)=\"onDragOver($event, cellRef)\"\r\n          (dragleave)=\"onDragLeave($event, cellRef)\"\r\n          (drop)=\"onDrop($event, day, cellRef)\"\r\n        >\r\n          <div class=\"day-cell-header\">\r\n            <span class=\"day-number\">{{ day.dayNum }}</span>\r\n            <span *ngIf=\"day.holiday\" class=\"holiday-tag\" [matTooltip]=\"day.holiday.name\">\r\n              🎌 {{ day.holiday.name | slice:0:16 }}{{ day.holiday.name.length > 16 ? '…' : '' }}\r\n            </span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Camada de Barras de Eventos (Grid contínuo de 7 colunas sobreposto) -->\r\n      <div class=\"week-events-layer\">\r\n        <div\r\n          *ngFor=\"let seg of week.segments\"\r\n          class=\"month-event-bar\"\r\n          [class.bar-start]=\"seg.isStart\"\r\n          [class.bar-end]=\"seg.isEnd\"\r\n          [class.bar-single]=\"seg.isStart && seg.isEnd && seg.span === 1\"\r\n          [class.system-event]=\"seg.event.isSystem\"\r\n          [class.task-deadline]=\"seg.event.isTaskDeadline\"\r\n          [style.grid-column]=\"(seg.startCol + 1) + ' / span ' + seg.span\"\r\n          [style.top.px]=\"32 + seg.rowSlot * 24\"\r\n          [style.background]=\"colorMap[seg.event.color]\"\r\n          [attr.draggable]=\"seg.event.isSystem || (seg.event.endDate && seg.event.endDate !== seg.event.date) ? null : true\"\r\n          (dragstart)=\"onDragStart($event, seg.event)\"\r\n          (dragend)=\"onDragEnd($event)\"\r\n          (click)=\"$event.stopPropagation(); eventClick.emit(seg.event)\"\r\n          (contextmenu)=\"$event.preventDefault(); $event.stopPropagation(); eventContextMenu.emit({ event: seg.event, mouseEvent: $event })\"\r\n          [matTooltip]=\"seg.event.title + (seg.event.allDay ? '' : ' · ' + seg.event.startTime + ' - ' + seg.event.endTime) + (seg.event.endDate && seg.event.endDate !== seg.event.date ? ' (' + seg.event.date + ' até ' + seg.event.endDate + ')' : '') + (seg.event.isTaskDeadline ? ' · Clique para abrir o card em Tarefas' : '')\"\r\n        >\r\n          <span *ngIf=\"!seg.event.allDay && seg.isStart\" class=\"bar-time\">{{ seg.event.startTime }}</span>\r\n          <span class=\"bar-title\">{{ seg.event.title }}</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n","import { CalendarEvent } from '../models/event.model';\r\n\r\nexport interface PositionedEvent extends CalendarEvent {\r\n  top: number;\r\n  height: number;\r\n  left: number;        // Porcentagem (0 - 100)\r\n  width: number;       // Porcentagem (0 - 100)\r\n  column: number;      // Índice da coluna dentro do grupo\r\n  totalColumns: number;// Total de colunas simultâneas no grupo\r\n}\r\n\r\ninterface EventGroup {\r\n  events: CalendarEvent[];\r\n  columns: CalendarEvent[][];\r\n}\r\n\r\n/** Converte horário 'HH:MM' para minutos desde a meia-noite */\r\nexport function timeToMinutes(timeStr: string): number {\r\n  if (!timeStr) return 0;\r\n  const [h, m] = timeStr.split(':').map(Number);\r\n  return (h || 0) * 60 + (m || 0);\r\n}\r\n\r\n/** Converte minutos desde a meia-noite para 'HH:MM' */\r\nexport function minutesToTime(mins: number): string {\r\n  const clamped = Math.max(0, Math.min(24 * 60 - 1, Math.round(mins)));\r\n  const h = Math.floor(clamped / 60);\r\n  const m = clamped % 60;\r\n  const pad = (n: number) => String(n).padStart(2, '0');\r\n  return `${pad(h)}:${pad(m)}`;\r\n}\r\n\r\n/** Verifica se dois eventos se sobrepõem no horário */\r\nexport function eventsOverlap(a: CalendarEvent, b: CalendarEvent): boolean {\r\n  const aStart = timeToMinutes(a.startTime);\r\n  const aEnd = Math.max(aStart + 15, timeToMinutes(a.endTime));\r\n  const bStart = timeToMinutes(b.startTime);\r\n  const bEnd = Math.max(bStart + 15, timeToMinutes(b.endTime));\r\n\r\n  return aStart < bEnd && aEnd > bStart;\r\n}\r\n\r\n/** Agrupa eventos sobrepostos */\r\nfunction buildGroups(events: CalendarEvent[]): EventGroup[] {\r\n  const sorted = [...events].sort((a, b) => timeToMinutes(a.startTime) - timeToMinutes(b.startTime));\r\n  const groups: EventGroup[] = [];\r\n\r\n  for (const event of sorted) {\r\n    let placed = false;\r\n    for (const group of groups) {\r\n      if (group.events.some(e => eventsOverlap(e, event))) {\r\n        group.events.push(event);\r\n        placed = true;\r\n        break;\r\n      }\r\n    }\r\n    if (!placed) {\r\n      groups.push({ events: [event], columns: [] });\r\n    }\r\n  }\r\n\r\n  return groups;\r\n}\r\n\r\n/** Distribui eventos em colunas paralelas sem colisão dentro do grupo */\r\nfunction assignColumns(group: EventGroup): void {\r\n  const sorted = [...group.events].sort((a, b) => timeToMinutes(a.startTime) - timeToMinutes(b.startTime));\r\n  group.columns = [];\r\n\r\n  for (const event of sorted) {\r\n    let placed = false;\r\n    for (const col of group.columns) {\r\n      const lastInCol = col[col.length - 1];\r\n      if (!eventsOverlap(lastInCol, event)) {\r\n        col.push(event);\r\n        placed = true;\r\n        break;\r\n      }\r\n    }\r\n    if (!placed) {\r\n      group.columns.push([event]);\r\n    }\r\n  }\r\n}\r\n\r\n/** Retorna o número máximo de colunas simultâneas durante o período do evento */\r\nfunction getMaxConcurrentCols(event: CalendarEvent, group: EventGroup): number {\r\n  const concurrent = group.events.filter(e => eventsOverlap(e, event));\r\n  const usedCols = new Set<number>();\r\n  for (let ci = 0; ci < group.columns.length; ci++) {\r\n    for (const e of group.columns[ci]) {\r\n      if (concurrent.includes(e)) {\r\n        usedCols.add(ci);\r\n      }\r\n    }\r\n  }\r\n  return Math.max(usedCols.size, 1);\r\n}\r\n\r\n/**\r\n * Calcula o posicionamento de sobreposição estilo Google Calendar para os eventos de um dia\r\n */\r\nexport function resolveDayOverlaps(\r\n  events: CalendarEvent[],\r\n  hourHeight = 60\r\n): PositionedEvent[] {\r\n  if (!events || events.length === 0) return [];\r\n\r\n  const timedEvents = events.filter(e => !e.allDay);\r\n  if (timedEvents.length === 0) return [];\r\n\r\n  const groups = buildGroups(timedEvents);\r\n  groups.forEach(assignColumns);\r\n\r\n  const positioned: PositionedEvent[] = [];\r\n\r\n  for (const group of groups) {\r\n    const numColumns = group.columns.length;\r\n\r\n    for (let colIndex = 0; colIndex < numColumns; colIndex++) {\r\n      for (const event of group.columns[colIndex]) {\r\n        const maxConcurrent = getMaxConcurrentCols(event, group);\r\n        const totalCols = Math.max(numColumns, maxConcurrent);\r\n\r\n        const startMins = timeToMinutes(event.startTime);\r\n        const endMins = Math.max(startMins + 15, timeToMinutes(event.endTime));\r\n        const durationMins = endMins - startMins;\r\n\r\n        const top = (startMins / 60) * hourHeight;\r\n        const height = Math.max((durationMins / 60) * hourHeight, 26);\r\n\r\n        const widthPercent = 100 / totalCols;\r\n        const leftPercent = (colIndex / totalCols) * 100;\r\n\r\n        positioned.push({\r\n          ...event,\r\n          top,\r\n          height,\r\n          left: leftPercent,\r\n          width: widthPercent,\r\n          column: colIndex,\r\n          totalColumns: totalCols,\r\n        });\r\n      }\r\n    }\r\n  }\r\n\r\n  return positioned;\r\n}\r\n","import {\r\n  Component, Input, Output, EventEmitter, OnChanges, OnInit, OnDestroy, SimpleChanges, inject, NgZone, ChangeDetectorRef\r\n} from '@angular/core';\r\nimport { CommonModule } from '@angular/common';\r\nimport { MatIconModule } from '@angular/material/icon';\r\nimport { MatTooltipModule } from '@angular/material/tooltip';\r\nimport { CalendarEvent, EVENT_COLOR_MAP } from '../../../../core/models/event.model';\r\nimport { Holiday } from '../../../../core/models/holiday.model';\r\nimport { resolveDayOverlaps, PositionedEvent, timeToMinutes, minutesToTime } from '../../../../core/utils/overlap.util';\r\nimport { EventsService } from '../../../../core/services/events.service';\r\n\r\nexport interface EventDropPayload {\r\n  eventId: string;\r\n  oldDate: string;\r\n  oldEndDate?: string;\r\n  newDate: string;\r\n  newStartTime?: string;\r\n  newEndTime?: string;\r\n}\r\n\r\ninterface WeekDay {\r\n  date: Date;\r\n  dateStr: string;\r\n  dayNum: number;\r\n  dayLabel: string;\r\n  isToday: boolean;\r\n  isWeekend: boolean;\r\n  holiday: Holiday | null;\r\n  positionedEvents: PositionedEvent[];\r\n}\r\n\r\ninterface WeekEventSpan {\r\n  event: CalendarEvent;\r\n  startCol: number;\r\n  span: number;\r\n  top: number;\r\n  height: number;\r\n  left: number;\r\n  width: number;\r\n}\r\n\r\n@Component({\r\n  selector: 'app-week-view',\r\n  standalone: true,\r\n  imports: [CommonModule, MatIconModule, MatTooltipModule],\r\n  templateUrl: './week-view.component.html',\r\n  styleUrl: './week-view.component.scss',\r\n})\r\nexport class WeekViewComponent implements OnInit, OnChanges, OnDestroy {\r\n  private eventsService = inject(EventsService);\r\n  private ngZone = inject(NgZone);\r\n  private cdr = inject(ChangeDetectorRef);\r\n\r\n  @Input() selectedDate: Date = new Date();\r\n  @Input() events: CalendarEvent[] = [];\r\n  @Input() holidays: Holiday[] = [];\r\n  @Output() dayClick = new EventEmitter<string>();\r\n  @Output() dayContextMenu = new EventEmitter<{ date: string; mouseEvent: MouseEvent }>();\r\n  @Output() eventClick = new EventEmitter<CalendarEvent>();\r\n  @Output() eventContextMenu = new EventEmitter<{ event: CalendarEvent; mouseEvent: MouseEvent }>();\r\n  @Output() eventDrop = new EventEmitter<EventDropPayload>();\r\n\r\n  readonly colorMap = EVENT_COLOR_MAP;\r\n  readonly DAYS_LABEL = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb'];\r\n  readonly HOURS = Array.from({ length: 24 }, (_, i) => i);\r\n\r\n  weekDays: WeekDay[] = [];\r\n  multiDaySpans: WeekEventSpan[] = [];\r\n  currentTimeTop = 0;\r\n  private timeInterval: ReturnType<typeof setInterval> | null = null;\r\n\r\n  // Estado de arrasto\r\n  private draggingEvent: CalendarEvent | null = null;\r\n  private dragOffsetY = 0;\r\n  private dragOverCell: HTMLElement | null = null;\r\n  // Contador de dragenter por célula (para highlight confiável sem flickering)\r\n  private dragEnterCounters = new WeakMap<HTMLElement, number>();\r\n\r\n  // Estado de redimensionamento em tempo real\r\n  isResizing = false;\r\n  resizingEventId: string | null = null;\r\n\r\n  ngOnInit(): void {\r\n    this.build();\r\n    this.updateCurrentTime();\r\n    this.timeInterval = setInterval(() => this.updateCurrentTime(), 60000);\r\n    this.injectScrollbarWidth();\r\n  }\r\n\r\n  ngOnChanges(changes: SimpleChanges): void {\r\n    this.build();\r\n    this.updateCurrentTime();\r\n  }\r\n\r\n  ngOnDestroy(): void {\r\n    if (this.timeInterval) clearInterval(this.timeInterval);\r\n  }\r\n\r\n  /** Mede a largura da scrollbar do SO e injeta como variável CSS para alinhar header com body */\r\n  private injectScrollbarWidth(): void {\r\n    const outer = document.createElement('div');\r\n    outer.style.cssText = 'visibility:hidden;overflow:scroll;position:absolute;top:-9999px;';\r\n    document.body.appendChild(outer);\r\n    const inner = document.createElement('div');\r\n    outer.appendChild(inner);\r\n    const scrollbarWidth = outer.offsetWidth - inner.offsetWidth;\r\n    document.body.removeChild(outer);\r\n    document.documentElement.style.setProperty('--scrollbar-width', scrollbarWidth + 'px');\r\n  }\r\n\r\n  /* ── Redimensionamento Manual em Tempo Real (Resize Handle) ── */\r\n  onResizeStart(mouseEvent: MouseEvent, event: PositionedEvent, columnElement: HTMLElement, edge: 'top' | 'bottom' = 'bottom', dayDateStr?: string): void {\r\n    mouseEvent.stopPropagation();\r\n    mouseEvent.preventDefault();\r\n    if (event.isSystem) return;\r\n\r\n    this.isResizing = true;\r\n    this.resizingEventId = event.id;\r\n    document.body.classList.add('resizing-active');\r\n\r\n    const targetDateStr = dayDateStr || event.date;\r\n    const startMins = timeToMinutes(event.startTime);\r\n    const endMins = timeToMinutes(event.endTime);\r\n    const rect = columnElement.getBoundingClientRect();\r\n\r\n    const onMouseMove = (moveEvent: MouseEvent) => {\r\n      const relY = moveEvent.clientY - rect.top;\r\n      const rawMin = Math.max(0, Math.min(24 * 60, relY)); // 1px = 1minuto\r\n      const snappedMin = Math.round(rawMin / 15) * 15;\r\n\r\n      let changed = false;\r\n\r\n      if (edge === 'bottom') {\r\n        const clampedEndMin = Math.max(startMins + 15, Math.min(24 * 60, snappedMin));\r\n        const newEndTime = minutesToTime(clampedEndMin);\r\n\r\n        if (newEndTime !== event.endTime) {\r\n          event.endTime = newEndTime;\r\n          const orig = (this.events || []).find(e => e.id === event.id);\r\n          if (orig) {\r\n            orig.dayTimes = orig.dayTimes || {};\r\n            orig.dayTimes[targetDateStr] = {\r\n              startTime: orig.dayTimes[targetDateStr]?.startTime || event.startTime || orig.startTime || '09:00',\r\n              endTime: newEndTime,\r\n            };\r\n          }\r\n          changed = true;\r\n        }\r\n      } else {\r\n        const clampedStartMin = Math.min(endMins - 15, Math.max(0, snappedMin));\r\n        const newStartTime = minutesToTime(clampedStartMin);\r\n\r\n        if (newStartTime !== event.startTime) {\r\n          event.startTime = newStartTime;\r\n          const orig = (this.events || []).find(e => e.id === event.id);\r\n          if (orig) {\r\n            orig.dayTimes = orig.dayTimes || {};\r\n            orig.dayTimes[targetDateStr] = {\r\n              startTime: newStartTime,\r\n              endTime: orig.dayTimes[targetDateStr]?.endTime || event.endTime || orig.endTime || '10:00',\r\n            };\r\n          }\r\n          changed = true;\r\n        }\r\n      }\r\n\r\n      if (changed) {\r\n        this.ngZone.run(() => {\r\n          this.build(); // Re-calcula sobreposições, largura e altura instantaneamente\r\n          this.cdr.detectChanges(); // Atualiza a visualização do DOM no mesmo frame\r\n        });\r\n      }\r\n    };\r\n\r\n    const onMouseUp = () => {\r\n      window.removeEventListener('mousemove', onMouseMove);\r\n      window.removeEventListener('mouseup', onMouseUp);\r\n      document.body.classList.remove('resizing-active');\r\n\r\n      // Persiste o horário do dia específico no service\r\n      const orig = (this.events || []).find(e => e.id === event.id);\r\n      if (orig) {\r\n        const updatedDayTimes = { ...(orig.dayTimes || {}) };\r\n        updatedDayTimes[targetDateStr] = {\r\n          startTime: event.startTime,\r\n          endTime: event.endTime,\r\n        };\r\n\r\n        this.eventsService.update(event.id, {\r\n          dayTimes: updatedDayTimes,\r\n        });\r\n      }\r\n\r\n      this.ngZone.run(() => {\r\n        setTimeout(() => {\r\n          this.isResizing = false;\r\n          this.resizingEventId = null;\r\n          this.build();\r\n          this.cdr.detectChanges();\r\n        }, 50);\r\n      });\r\n    };\r\n\r\n    window.addEventListener('mousemove', onMouseMove);\r\n    window.addEventListener('mouseup', onMouseUp);\r\n  }\r\n\r\n  /* ── Redimensionamento Horizontal entre Dias (Esquerda / Direita) ── */\r\n  onResizeHorizontalStart(mouseEvent: MouseEvent, event: CalendarEvent, edge: 'left' | 'right'): void {\r\n    mouseEvent.stopPropagation();\r\n    mouseEvent.preventDefault();\r\n    if (event.isSystem) return;\r\n\r\n    this.isResizing = true;\r\n    this.resizingEventId = event.id;\r\n    document.body.classList.add('resizing-x-active');\r\n\r\n    const onMouseMove = (moveEvent: MouseEvent) => {\r\n      const clientX = moveEvent.clientX;\r\n\r\n      // Localiza a coluna do dia sobre a qual o mouse está passando\r\n      let targetDayStr: string | null = null;\r\n      for (const day of this.weekDays) {\r\n        const colEl = document.querySelector(`[data-date=\"${day.dateStr}\"]`) as HTMLElement;\r\n        if (colEl) {\r\n          const rect = colEl.getBoundingClientRect();\r\n          if (clientX >= rect.left && clientX <= rect.right) {\r\n            targetDayStr = day.dateStr;\r\n            break;\r\n          }\r\n        }\r\n      }\r\n\r\n      if (!targetDayStr) return;\r\n\r\n      let changed = false;\r\n\r\n      if (edge === 'right') {\r\n        // Redimensiona término para a direita/esquerda\r\n        const currentStartDate = event.date;\r\n        const newEndDate = targetDayStr >= currentStartDate ? targetDayStr : currentStartDate;\r\n\r\n        if (newEndDate !== (event.endDate || event.date)) {\r\n          event.endDate = newEndDate;\r\n          const orig = (this.events || []).find(e => e.id === event.id);\r\n          if (orig) orig.endDate = newEndDate;\r\n          changed = true;\r\n        }\r\n      } else {\r\n        // Redimensiona início para a esquerda/direita\r\n        const currentEndDate = event.endDate || event.date;\r\n        const newStartDate = targetDayStr <= currentEndDate ? targetDayStr : currentEndDate;\r\n\r\n        if (newStartDate !== event.date) {\r\n          event.date = newStartDate;\r\n          const orig = (this.events || []).find(e => e.id === event.id);\r\n          if (orig) orig.date = newStartDate;\r\n          changed = true;\r\n        }\r\n      }\r\n\r\n      if (changed) {\r\n        this.ngZone.run(() => {\r\n          this.build();\r\n          this.cdr.detectChanges();\r\n        });\r\n      }\r\n    };\r\n\r\n    const onMouseUp = () => {\r\n      window.removeEventListener('mousemove', onMouseMove);\r\n      window.removeEventListener('mouseup', onMouseUp);\r\n      document.body.classList.remove('resizing-x-active');\r\n\r\n      const orig = (this.events || []).find(e => e.id === event.id);\r\n      if (orig) {\r\n        this.eventsService.update(event.id, {\r\n          date: orig.date,\r\n          endDate: orig.endDate || orig.date,\r\n        });\r\n      }\r\n\r\n      this.ngZone.run(() => {\r\n        setTimeout(() => {\r\n          this.isResizing = false;\r\n          this.resizingEventId = null;\r\n          this.build();\r\n          this.cdr.detectChanges();\r\n        }, 50);\r\n      });\r\n    };\r\n\r\n    window.addEventListener('mousemove', onMouseMove);\r\n    window.addEventListener('mouseup', onMouseUp);\r\n  }\r\n\r\n  /* ── Drag & Drop de Eventos ── */\r\n  onDragStart(ev: DragEvent, event: CalendarEvent): void {\r\n    if (this.isResizing || event.isSystem) {\r\n      ev.preventDefault();\r\n      return;\r\n    }\r\n    this.draggingEvent = event;\r\n\r\n    const target = ev.target as HTMLElement;\r\n    const card = target ? (target.closest('.week-event') as HTMLElement) || target : null;\r\n    if (card) {\r\n      const cardRect = card.getBoundingClientRect();\r\n      this.dragOffsetY = ev.clientY - cardRect.top;\r\n      card.classList.add('dragging');\r\n    } else {\r\n      this.dragOffsetY = ev.offsetY || 0;\r\n    }\r\n\r\n    if (ev.dataTransfer) {\r\n      ev.dataTransfer.setData('text/plain', event.id);\r\n      ev.dataTransfer.effectAllowed = 'move';\r\n    }\r\n    document.body.classList.add('dragging-active');\r\n  }\r\n\r\n  onDragEnd(ev: DragEvent): void {\r\n    const target = ev.target as HTMLElement;\r\n    const card = target ? (target.closest('.week-event') as HTMLElement) || target : null;\r\n    if (card) card.classList.remove('dragging');\r\n    this.draggingEvent = null;\r\n    this.dragOffsetY = 0;\r\n    document.body.classList.remove('dragging-active');\r\n    // Limpa highlight e contadores residuais\r\n    if (this.dragOverCell) {\r\n      this.dragOverCell.classList.remove('drag-over');\r\n      this.dragEnterCounters.set(this.dragOverCell, 0);\r\n      this.dragOverCell = null;\r\n    }\r\n  }\r\n\r\n  onDragEnter(ev: DragEvent, cell: HTMLElement): void {\r\n    ev.preventDefault();\r\n    if (!cell) return;\r\n    const count = (this.dragEnterCounters.get(cell) ?? 0) + 1;\r\n    this.dragEnterCounters.set(cell, count);\r\n    if (count === 1) {\r\n      // Saindo de outra coluna — limpa highlight anterior\r\n      if (this.dragOverCell && this.dragOverCell !== cell) {\r\n        this.dragOverCell.classList.remove('drag-over');\r\n        this.dragEnterCounters.set(this.dragOverCell, 0);\r\n      }\r\n      cell.classList.add('drag-over');\r\n      this.dragOverCell = cell;\r\n    }\r\n  }\r\n\r\n  onDragOver(ev: DragEvent, cell: HTMLElement): void {\r\n    ev.preventDefault();\r\n    if (ev.dataTransfer) ev.dataTransfer.dropEffect = 'move';\r\n  }\r\n\r\n  onDragLeave(ev: DragEvent, cell: HTMLElement): void {\r\n    if (!cell) return;\r\n    const count = Math.max(0, (this.dragEnterCounters.get(cell) ?? 0) - 1);\r\n    this.dragEnterCounters.set(cell, count);\r\n    if (count === 0) {\r\n      cell.classList.remove('drag-over');\r\n      if (this.dragOverCell === cell) this.dragOverCell = null;\r\n    }\r\n  }\r\n\r\n  onDrop(ev: DragEvent, day: WeekDay, cell: HTMLElement): void {\r\n    ev.preventDefault();\r\n    ev.stopPropagation();\r\n    document.body.classList.remove('dragging-active');\r\n    if (cell) {\r\n      cell.classList.remove('drag-over');\r\n      this.dragEnterCounters.set(cell, 0);\r\n    }\r\n    if (this.dragOverCell === cell) this.dragOverCell = null;\r\n\r\n    const eventId = (ev.dataTransfer ? ev.dataTransfer.getData('text/plain') : null) || this.draggingEvent?.id;\r\n    if (!eventId) return;\r\n\r\n    const event = this.draggingEvent || (this.events || []).find(e => e.id === eventId);\r\n\r\n    if (event) {\r\n      const rect = cell.getBoundingClientRect();\r\n      const clickY = ev.clientY - rect.top;\r\n      const offset = (this.dragOffsetY > 0 && this.dragOffsetY < rect.height) ? this.dragOffsetY : 0;\r\n      const targetTopY = Math.max(0, clickY - offset);\r\n      const snappedMinutes = Math.min(23 * 60 + 45, Math.max(0, Math.round(targetTopY / 15) * 15));\r\n\r\n      const [sh, sm] = (event.startTime || '09:00').split(':').map(Number);\r\n      const [eh, em] = (event.endTime || '10:00').split(':').map(Number);\r\n      const origDuration = Math.max(15, ((eh || 0) * 60 + (em || 0)) - ((sh || 0) * 60 + (sm || 0)));\r\n\r\n      const newStartHour = Math.floor(snappedMinutes / 60);\r\n      const newStartMin = snappedMinutes % 60;\r\n\r\n      const endMinutes = Math.min(24 * 60 - 1, snappedMinutes + origDuration);\r\n      const newEndHour = Math.floor(endMinutes / 60);\r\n      const newEndMin = endMinutes % 60;\r\n\r\n      const pad = (n: number) => String(n).padStart(2, '0');\r\n      const newStartTime = `${pad(newStartHour)}:${pad(newStartMin)}`;\r\n      const newEndTime = `${pad(newEndHour)}:${pad(newEndMin)}`;\r\n\r\n      this.eventDrop.emit({\r\n        eventId: event.id,\r\n        oldDate: event.date,\r\n        oldEndDate: event.endDate || event.date,\r\n        newDate: day.dateStr,\r\n        newStartTime,\r\n        newEndTime,\r\n      });\r\n    } else {\r\n      const fallback = (this.events || []).find(e => e.id === eventId);\r\n      this.eventDrop.emit({\r\n        eventId,\r\n        oldDate: fallback?.date || day.dateStr,\r\n        oldEndDate: fallback?.endDate || fallback?.date,\r\n        newDate: day.dateStr,\r\n      });\r\n    }\r\n  }\r\n\r\n  onCardClick(ev: MouseEvent, event: CalendarEvent): void {\r\n    if (this.isResizing) return;\r\n    this.eventClick.emit(event);\r\n  }\r\n\r\n  private build(): void {\r\n    const today = this.toStr(new Date());\r\n    const holidayMap = new Map((this.holidays || []).map(h => [h.date, h]));\r\n\r\n    const d = new Date(this.selectedDate || new Date());\r\n    d.setDate(d.getDate() - d.getDay());\r\n\r\n    const weekDates = Array.from({ length: 7 }, (_, i) => this.toStr(new Date(d.getFullYear(), d.getMonth(), d.getDate() + i)));\r\n    const weekStart = weekDates[0];\r\n    const weekEnd = weekDates[6];\r\n    this.multiDaySpans = (this.events || [])\r\n      .filter(event => {\r\n        const end = event.endDate || event.date;\r\n        return end !== event.date && event.date <= weekEnd && end >= weekStart;\r\n      })\r\n      .map(event => {\r\n        const end = event.endDate || event.date;\r\n        const startCol = event.date < weekStart ? 0 : weekDates.indexOf(event.date);\r\n        const endCol = end > weekEnd ? 6 : weekDates.indexOf(end);\r\n        const start = timeToMinutes(event.startTime || '09:00');\r\n        const finish = Math.max(start + 15, timeToMinutes(event.endTime || '10:00'));\r\n        const span = endCol - startCol + 1;\r\n        return {\r\n          event, startCol, span, top: start, height: Math.max(22, finish - start),\r\n          left: (startCol / 7) * 100, width: (span / 7) * 100,\r\n        };\r\n      });\r\n\r\n    this.weekDays = [];\r\n    for (let i = 0; i < 7; i++) {\r\n      const cur = new Date(d.getFullYear(), d.getMonth(), d.getDate() + i);\r\n      const ds = this.toStr(cur);\r\n      const dayEvents = (this.events || [])\r\n        .filter(e => e.date <= ds && (e.endDate || e.date) >= ds && (e.endDate || e.date) === e.date)\r\n        .map(e => {\r\n          const daySchedule = e.dayTimes?.[ds];\r\n          const st = daySchedule?.startTime || e.startTime || '09:00';\r\n          const et = daySchedule?.endTime || e.endTime || '10:00';\r\n          return {\r\n            ...e,\r\n            startTime: st,\r\n            endTime: et,\r\n          };\r\n        });\r\n      const positioned = resolveDayOverlaps(dayEvents, 60);\r\n\r\n      this.weekDays.push({\r\n        date: cur,\r\n        dateStr: ds,\r\n        dayNum: cur.getDate(),\r\n        dayLabel: this.DAYS_LABEL[cur.getDay()],\r\n        isToday: ds === today,\r\n        isWeekend: cur.getDay() === 0 || cur.getDay() === 6,\r\n        holiday: holidayMap.get(ds) ?? null,\r\n        positionedEvents: positioned,\r\n      });\r\n    }\r\n\r\n    this.updateCurrentTime();\r\n  }\r\n\r\n  private updateCurrentTime(): void {\r\n    const now = new Date();\r\n    this.currentTimeTop = now.getHours() * 60 + now.getMinutes();\r\n  }\r\n\r\n  toStr(d: Date): string {\r\n    if (!d) return '';\r\n    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\r\n  }\r\n\r\n  formatHour(h: number): string {\r\n    return h === 0 ? '' : `${String(h).padStart(2, '0')}:00`;\r\n  }\r\n}\r\n","<div class=\"view-week\">\r\n  <!-- Cabeçalho da semana -->\r\n  <div class=\"week-header\">\r\n    <div class=\"week-time-gutter-header\"></div>\r\n    <div\r\n      *ngFor=\"let day of weekDays\"\r\n      class=\"week-day-header\"\r\n      [class.today]=\"day.isToday\"\r\n      [class.weekend]=\"day.isWeekend\"\r\n      [class.holiday]=\"!!day.holiday\"\r\n      (click)=\"dayClick.emit(day.dateStr)\"\r\n      (contextmenu)=\"$event.preventDefault(); dayContextMenu.