const TIME_ZONE = process.env.AGENDA_TIME_ZONE || 'America/Sao_Paulo';
const EVENT_COLORS = ['indigo', 'blue', 'teal', 'emerald', 'amber', 'orange', 'rose', 'purple', 'pink', 'slate'];
