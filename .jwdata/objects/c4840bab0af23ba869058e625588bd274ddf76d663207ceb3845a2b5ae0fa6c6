function jsonSchemaForZod(schema) {
  return z.toJSONSchema(schema, { target: 'draft-7' });
}

function getAiToolCatalog(names) {
  const selected = names ? new Set(names) : null;
  return toolDefinitions.filter(tool => !selected || selected.has(tool.name)).map(tool => ({
    name: tool.name,
    description: tool.description,
    parameters: jsonSchemaForZod(tool.schema),
    readOnly: tool.annotations?.readOnlyHint === true,
    destructive: tool.annotations?.destructiveHint === true,
  }));
}

function shouldPlanWithAgendaTools(text) {
  return /\b(agenda|agendas|agendado|agendada|agendados|agendadas|evento|eventos|compromisso|compromissos|reuni[aã]o|reuni[oõ]es|calend[aá]rio|calendarios|kanban|quadro|quadros|coluna|colunas|card|cards|tarefa|tarefas|pend[eê]ncia|pend[eê]ncias|backlog|equipe|equipes|time|times|prazo|prazos|mural|murais|postit|postits|post-it|post-its|aviso|avisos|comunicado|comunicados|recado|recados|nota|notas|hoje|amanh[aã]|ontem|semana|m[eê]s|fazer|atividade|atividades|membro|membros|convite|convites|anexo|anexos|arquivo|arquivos|notifica|notifica[cç][aã]o|notifica[cç][oõ]es|lembrete|lembretes|alerta|alertas|dispositivo|dispositivos|lgpd|meus dados|privacidade|lixeira|restaurar|excluir|criar|listar|organizar|planejar|horario|horarios|hor[aá]rio|hor[aá]rios|periodo|período|turno|turnos|dia|dias|data|datas|segunda|ter[cç]a|quarta|quinta|sexta|s[aá]bado|domingo|jan|fev|mar|abr|mai|jun|jul|ago|set|out|nov|dez|janeiro|fevereiro|mar[cç]o|abril|maio|junho|julho|agosto|setembro|outubro|novembro|dezembro)\b/i.test(String(text || ''));
}

async function createAgendaMcpServer(userId, broadcast) {
  const { McpServer } = await import('@modelcontextprotocol/server');
  const server = new McpServer({ name: 'doce-agenda-mcp', version: '2.0.0' }, {
    instructions: `Servidor MCP corporativo da Agenda Doce Brinquedo. Contexto autenticado do usuário (${userId}). Fuso horário corporativo: ${TIME_ZONE}. Todas as operações de leitura e escrita (Agendas, Eventos, Tarefas Kanban e Mural de Notas/Avisos) refletem a base de dados em tempo real. Para questões do mural, consulte 'listar_murais' e 'obter_mural' para visualizar grupos e notas/post-its, e utilize 'criar_item_mural' / 'atualizar_item_mural' para redigir e estruturar avisos, ideias e documentações com suporte completo a Markdown rico, cores pastéis e anexos. Consulte recursos (agenda://manual, agenda://schema, agenda://contexto) e ferramentas de contexto para obter IDs e permissões antes de executar mutações. Descrições suportam Markdown. Operações destrutivas exigem confirmar=true.`,
  });

  for (const tool of toolDefinitions) {
    server.registerTool(tool.name, {
      title: tool.title,
      description: tool.description,
      inputSchema: tool.schema,
      annotations: tool.annotations,
    }, async args => {
      try { return result(await executeAgendaTool(tool.name, args, { userId, broadcast })); }
      catch (error) { return result({ error: error.expose ? error.message : 'Falha ao executar a ferramenta.' }, true); }
    });
  }

  server.registerResource('manual-da-agenda', 'agenda://manual', {
    title: 'Manual operacional da Agenda',
    description: 'Regras de uso, datas, Markdown, permissões e segurança.',
    mimeType: 'text/markdown',
  }, async uri => ({ contents: [{ uri: uri.href, mimeType: 'text/markdown', text: `${SYSTEM_MANUAL}\n- Fuso horário atual: **${TIME_ZONE}**.` }] }));

  server.registerResource('schema-do-sistema', 'agenda://schema', {
    title: 'Schema e catálogo do sistema',
    description: 'Catálogo completo e legível por máquina das operações, parâmetros e efeitos destrutivos.',
    mimeType: 'application/json',
  }, async uri => ({ contents: [{ uri: uri.href, mimeType: 'application/json', text: JSON.stringify({
    service: 'Agenda Corporativa',
    version: '2.0.0',
    timeZone: TIME_ZONE,
    tools: getAiToolCatalog(),
  }, null, 2) }] }));

  server.registerResource('contexto-do-usuario', 'agenda://contexto', {
    title: 'Contexto atual do usuário',
    description: 'Estrutura completa visível, permissões, convites, preferências e totais da sessão autenticada.',
    mimeType: 'application/json',
  }, async uri => ({ contents: [{ uri: uri.href, mimeType: 'application/json', text: JSON.stringify(await executeAgendaTool('obter_contexto_completo', {}, { userId, broadcast }), null, 2) }] }));

  server.registerPrompt('planejar_dia', {
    title: 'Planejar o dia',
    description: 'Orienta o cliente a consultar compromissos e tarefas antes de montar um plano direto.',
    argsSchema: z.object({ data: z.string().optional(), objetivo: z.string().max(500).optional() }),
  }, ({ data, objetivo }) => ({ messages: [{ role: 'user', content: { type: 'text', text: `Planeje ${data ? `o dia ${data}` : 'meu dia'}${objetivo ? ` com o objetivo: ${objetivo}` : ''}. Consulte primeiro os eventos e tarefas pelas ferramentas MCP. Entregue um plano direto e prático em Markdown.` } }] }));

  server.registerPrompt('criar_aviso_mural', {
    title: 'Criar aviso ou nota para o Mural',
    description: 'Orienta a estruturar comunicados, notas ou lembretes corporativos com clareza e formatação Markdown para o mural.',
    argsSchema: z.object({ assunto: z.string().max(200), equipe: z.string().optional(), publicoAlvo: z.string().optional() }),
  }, ({ assunto, equipe, publicoAlvo }) => ({ messages: [{ role: 'user', content: { type: 'text', text: `Redija um comunicado/aviso claro, profissional e bem estruturado em Markdown para ser publicado no Mural${equipe ? ` da equipe ${equipe}` : ''}${publicoAlvo ? ` voltado para ${publicoAlvo}` : ''}. O assunto principal é: "${assunto}". Inclua título chamativo, tópicos organizados, instruções práticas e destaques importantes. Consulte 'listar_murais' e 'obter_mural' se precisar identificar o mural e grupo adequados.` } }] }));

  return server;
}

