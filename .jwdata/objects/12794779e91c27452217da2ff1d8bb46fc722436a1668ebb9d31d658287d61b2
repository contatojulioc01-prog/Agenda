      </button>
      <button class="primary-btn expand-pill-btn size-36 primary-pill" (click)="abrirNovoItem()" matTooltip="Novo Cart\xE3o no Mural">
        <mat-icon>add</mat-icon><span class="pill-label">Novo Cart\xE3o</span>
      </button>
      <button *ngIf="activeBoard()?.myRole === 'admin'" class="secondary-btn expand-pill-btn size-36" (click)="abrirEditarMural()" matTooltip="Configurar / Excluir Mural">
