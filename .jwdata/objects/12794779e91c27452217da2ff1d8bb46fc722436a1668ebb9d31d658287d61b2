            <span class="pill-dot" [style.background]="cal.color"></span>\r
            <span class="pill-name">{{ calendarDisplayName(cal) }}</span>\r
          </button>\r
        </div>\r
      </div>\r
    </div>\r
\r
    <!-- \u2500\u2500 GRUPO 2: Calend\xE1rio \u2500\u2500 -->\r
