      MatTooltipModule,
      AiTextButtonComponent,
      MarkdownTextComponent,
      MarkdownEditorComponent,
      AttachmentPreviewModalComponent
    ], template: `<!-- \u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557
     \u2551  SKILL: Angular Modal Layout                            \u2551
     \u2551  Header fixo + Body rol\xE1vel + Footer fixo              \u2551
     \u255A\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255D -->

<div class="modal-wrapper">

  <!-- \u2500\u2500 Header fixo \u2500\u2500 -->
  <div class="modal-header">
    <div class="header-main">
      <div class="header-icon-badge" [class.edit-mode]="isEdit">
        <mat-icon>{{ isEdit ? 'edit_calendar' : 'event' }}</mat-icon>
      </div>
      <div class="header-title-box">
        <h2>{{ isReadOnly ? 'Detalhes do Evento' : isEdit ? 'Editar Evento' : 'Novo Evento' }}</h2>
        <p>{{ isReadOnly ? 'Voc\xEA possui acesso somente para visualiza\xE7\xE3o.' : isEdit ? 'Atualize os dados do evento selecionado.' : 'Preencha os dados para criar um novo evento.' }}</p>
      </div>
    </div>
    <button type="button" class="close-btn" (click)="dialogRef.close()" title="Fechar" id="btn-close-modal">
      <mat-icon>close</mat-icon>
    </button>
  </div>

  <div class="event-error" *ngIf="eventsService.error()"><mat-icon>error_outline</mat-icon><span>{{ eventsService.error() }}</span></div>
  <div class="event-error" *ngIf="!hasValidSchedule"><mat-icon>schedule</mat-icon><span>O hor\xE1rio final deve ser posterior ao hor\xE1rio inicial.</span></div>

  <!-- \u2500\u2500 Body rol\xE1vel \u2500\u2500 -->
  <div class="modal-body">
    <!-- Modo Visualiza\xE7\xE3o Limpo & Elegante -->
    <div class="read-only-view-container" *ngIf="isReadOnly">
      <div class="view-content-card" [style.border-left-color]="getCalendarColor()">
        <div class="view-header-row">
          <h1 class="view-title">{{ formData.title || 'Sem t\xEDtulo' }}</h1>
          <div class="view-meta-badges">
            <span class="view-badge badge-calendar" *ngIf="getCalendarName()" [style.color]="getCalendarColor()">
              <span class="view-badge-dot" [style.background]="getCalendarColor()"></span>
              <span>{{ getCalendarName() }}</span>
            </span>
            <span class="view-badge badge-schedule">
              <mat-icon>schedule</mat-icon>
              <span>{{ formatEventSchedule() }}</span>
            </span>
            <span class="view-badge badge-category" *ngIf="formData.category">
              <mat-icon>label</mat-icon>
              <span>{{ formData.category }}</span>
            </span>
          </div>
        </div>

        <div class="view-description-wrap">
          <app-markdown-text *ngIf="formData.description" [text]="formData.description" (textChange)="onDescriptionChangeInView($event)"></app-markdown-text>
          <p *ngIf="!formData.description" class="view-empty-desc">Nenhuma descri\xE7\xE3o informada.</p>
        </div>
      </div>

      <!-- Anexos no modo visualiza\xE7\xE3o (somente se houver) -->
      <div class="view-attachments-card" *ngIf="attachments.length > 0">
        <div class="view-card-subtitle">
          <mat-icon>attach_file</mat-icon>
          <span>Anexos ({{ attachments.length }})</span>
        </div>
        <div class="attachment-list">
          <div
            class="attachment-item"
            *ngFor="let attachment of attachments"
            (click)="openAttachment(attachment)"
            role="button"
            tabindex="0"
            (keydown.enter)="openAttachment(attachment)"
          >
            <mat-icon [style.color]="getFileInfo(attachment.fileName, attachment.mimeType).color">
              {{ getFileInfo(attachment.fileName, attachment.mimeType).icon }}
            </mat-icon>
            <div>
              <strong>{{ attachment.fileName }}</strong>
              <span>{{ attachment.byteSize / 1048576 | number:'1.0-2' }} MB \xB7 {{ getFileInfo(attachment.fileName, attachment.mimeType).name }}</span>
            </div>
            <mat-icon class="view-action-icon">visibility</mat-icon>
          </div>
        </div>
      </div>
    </div>

    <!-- Modo Edi\xE7\xE3o / Cria\xE7\xE3o com Formul\xE1rio Completo -->
    <form class="form-container" *ngIf="!isReadOnly" #eventForm="ngForm">

      <p class="no-calendar-warning" *ngIf="!isEdit && !hasTargetCalendars">Selecione ao menos uma agenda na lateral antes de criar o evento.</p>

      <!-- SKILL: Form Groups \u2014 Grupo 1: Dados do Evento -->
      <div class="form-card">
        <div class="card-header">
          <mat-icon class="section-icon color-blue">event_note</mat-icon>
          <h3>Dados do Evento</h3>
        </div>

        <div class="form-grid">
          <!-- T\xEDtulo -->
          <div class="form-field col-span-2">
            <label for="ev-title">T\xEDtulo <span class="required">*</span></label>
            <input
              id="ev-title"
              type="text"
              [(ngModel)]="formData.title"
              name="title"
              placeholder="Ex: Reuni\xE3o de alinhamento"
              required
              maxlength="100"
            />
          </div>

          <!-- Categoria -->
          <div class="form-field">
            <label for="ev-category">Categoria</label>
            <select id="ev-category" [(ngModel)]="formData.category" name="category" class="custom-select">
              <option *ngFor="let cat of categories" [value]="cat">{{ cat }}</option>
            </select>
          </div>

          <!-- Cor -->
          <div class="form-field">
            <label>Cor do Evento</label>
            <div class="color-picker">
              <button
                *ngFor="let color of colorOptions"
                type="button"
                class="color-swatch"
                [class.selected]="formData.color === color"
                [style.background]="colorMap[color]"
                [matTooltip]="colorLabels[color]"
                (click)="formData.color = color"
                [id]="'color-' + color"
              >
                <mat-icon *ngIf="formData.color === color">check</mat-icon>
              </button>
            </div>
          </div>

          <!-- Descri\xE7\xE3o -->
          <div class="form-field col-span-2 description-field">
            <div class="description-header">
              <label for="ev-desc">Descri\xE7\xE3o</label>
              <app-ai-text-button [text]="formData.description" (textChange)="formData.description = $event" />
            </div>
            <app-markdown-editor
              [text]="formData.description"
              (textChange)="formData.description = $event"
              [maxLength]="5000"
              placeholder="Descri\xE7\xE3o opcional do evento..."
              ariaLabel="Descri\xE7\xE3o do evento"
              editorId="ev-desc"
            />
          </div>
        </div>
      </div>

      <div class='form-card attachment-card'>
        <div class='card-header'>
          <mat-icon class='section-icon color-purple'>attach_file</mat-icon>
          <h3>Anexos</h3><span class='attachment-count'>{{ attachments.length + pendingFiles.length }}/10</span>
        </div>
        <p class='attachment-help'>Aceita todos os tipos de arquivos at\xE9 10 MB. Arquivos de programa\xE7\xE3o contam com destaque de sintaxe.</p>
        <label class='attachment-picker' *ngIf='attachments.length + pendingFiles.length < 10'>
          <mat-icon>upload_file</mat-icon><span>Adicionar arquivos ou imagens</span>
          <input type='file' multiple (change)='selectFiles($event)' />
        </label>
        <div class='attachment-list' *ngIf='attachments.length || pendingFiles.length'>
          <div class='attachment-item' *ngFor='let attachment of attachments' (click)='openAttachment(attachment)' role='button' tabindex='0' (keydown.enter)='openAttachment(attachment)'>
            <mat-icon [style.color]="getFileInfo(attachment.fileName, attachment.mimeType).color">
              {{ getFileInfo(attachment.fileName, attachment.mimeType).icon }}
            </mat-icon>
            <div>
              <strong>{{ attachment.fileName }}</strong>
              <span>{{ attachment.byteSize / 1048576 | number:'1.0-2' }} MB \xB7 {{ getFileInfo(attachment.fileName, attachment.mimeType).name }}</span>
            </div>
            <button type='button' (click)='$event.stopPropagation(); deleteAttachment(attachment)' title='Excluir anexo'><mat-icon>delete_outline</mat-icon></button>
          </div>
          <div class='attachment-item pending' *ngFor='let file of pendingFiles; let index = index' (click)='openPending(file)'>
            <mat-icon [style.color]="getFileInfo(file.name, file.type).color">
              {{ getFileInfo(file.name, file.type).icon }}
            </mat-icon>
            <div>
              <strong>{{ file.name }}</strong>
              <span>Aguardando salvar \xB7 {{ file.size / 1048576 | number:'1.0-2' }} MB \xB7 {{ getFileInfo(file.name, file.type).name }}</span>
            </div>
            <button type='button' (click)='$event.stopPropagation(); removePending(index)' title='Remover'><mat-icon>close</mat-icon></button>
          </div>
        </div>
        <p class='attachment-error' *ngIf='attachmentError'>{{ attachmentError }}</p>
      </div>

      <!-- SKILL: Form Groups \u2014 Grupo 2: Data e Hor\xE1rio -->
      <div class="form-card">
        <div class="card-header">
          <mat-icon class="section-icon color-emerald">schedule</mat-icon>
          <h3>Data e Hor\xE1rio</h3>
        </div>

        <div class="form-grid">
          <!-- Data de In\xEDcio -->
          <div class="form-field">
            <label for="ev-date">Data de In\xEDcio <span class="required">*</span></label>
            <input
              id="ev-date"
              type="date"
              [(ngModel)]="formData.date"
              name="date"
              required
              (change)="onDateChange()"
            />
            <!-- Aviso de feriado -->
            <span *ngIf="holidayWarning" class="holiday-warning">
              {{ holidayWarning }}
            </span>
          </div>

          <!-- Data de T\xE9rmino -->
          <div class="form-field">
            <label for="ev-end-date">Data de T\xE9rmino</label>
            <input
              id="ev-end-date"
              type="date"
              [(ngModel)]="formData.endDate"
              name="endDate"
              [min]="formData.date"
              placeholder="Mesmo dia"
            />
          </div>

          <!-- Dia inteiro toggle -->
          <div class="form-field col-span-2 all-day-row">
            <label class="checkbox-label">
              <input type="checkbox" [(ngModel)]="formData.allDay" name="allDay" id="ev-allday" />
              <span>Evento de dia inteiro</span>
            </label>
          </div>

          <!-- Hor\xE1rio in\xEDcio -->
          <div class="form-field" [class.disabled-field]="formData.allDay">
            <label for="ev-start">In\xEDcio <span class="required">*</span></label>
            <input
              id="ev-start"
              type="time"
              [(ngModel)]="formData.startTime"
              name="startTime"
              [disabled]="formData.allDay"
            />
          </div>

