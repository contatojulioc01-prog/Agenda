(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && setClassMetadata(EventModalComponent, [{
    type: Component,
    args: [{ selector: "app-event-modal", standalone: true, imports: [
      CommonModule,
      FormsModule,
