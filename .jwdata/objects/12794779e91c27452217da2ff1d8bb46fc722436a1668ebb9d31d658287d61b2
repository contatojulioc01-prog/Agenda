            </div>
            <div class="card-footer">
              <span class="card-author" *ngIf="item.createdByName">
                <mat-icon>person</mat-icon>{{ item.createdByName }}
              </span>
              <span class="card-date">{{ formatarData(item.createdAt) }}</span>
            </div>
          </div>

          <!-- Empty group placeholder (drop target) -->
          <div class="empty-group-placeholder" *ngIf="!(itemsByGroup().get(group.id) || []).length" (click)="abrirNovoItem(group.id)">
            <mat-icon>note_add</mat-icon>
            <span>Clique ou arraste um cart\xE3o aqui</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Notas Soltas -->
    <div class="mural-ungrouped-section"
      *ngIf="ungroupedItems().length || !activeBoard()?.groups?.length"
      [class.drag-over]="dragOverGroupId === 'ungrouped'"
      (dragover)="onGroupDragOver($event, 'ungrouped')"
      (dragleave)="onGroupDragLeave()"
      (drop)="onDropInGroup($event, null)"
    >
      <div class="section-title-divider">
        <mat-icon>push_pin</mat-icon>
        <span>Notas & Avisos Soltos no Mural</span>
        <span class="column-count" *ngIf="ungroupedItems().length">{{ ungroupedItems().length }}</span>
      </div>

      <div class="ungrouped-wall-grid">
        <div
          *ngFor="let item of ungroupedItems()"
          class="sticky-card loose-card"
          [style.background]="item.color"
          [style.transform]="'rotate(' + item.rotation + 'deg)'"
          [class.pinned]="item.isPinned"
          [class.dragging]="draggingItemId === item.id"
          draggable="true"
          (dragstart)="onDragStart($event, item)"
          (dragend)="onDragEnd()"
          (click)="abrirVisualizarItem(item)"
          (contextmenu)="openMuralItemContextMenu($event, item)"
        >
          <div class="card-pin" [class.active]="item.isPinned" (click)="alternarFixacao($event, item)">
            <mat-icon>push_pin</mat-icon>
          </div>
          <div class="card-header-row"><h4 class="card-title">{{ item.title }}</h4></div>
          <div class="card-body" *ngIf="item.content">
            <app-markdown-text [text]="item.content" (textChange)="onItemContentChange(item, $event)"></app-markdown-text>
          </div>
          <div class="card-attachments-chips" *ngIf="item.attachments?.length">
            <span
              *ngFor="let att of item.attachments"
              class="att-chip"
              [ngClass]="'chip-' + getFileInfo(att.fileName, att.mimeType).category"
              (click)="abrirPreview($event, att)"
            >
              <mat-icon [style.color]="getFileInfo(att.fileName, att.mimeType).color">{{ getFileInfo(att.fileName, att.mimeType).icon }}</mat-icon>
              <span>{{ att.fileName }}</span>
            </span>
          </div>
          <div class="card-footer">
            <span class="card-author" *ngIf="item.createdByName"><mat-icon>person</mat-icon>{{ item.createdByName }}</span>
            <span class="card-date">{{ formatarData(item.createdAt) }}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Estado Vazio -->
    <div class="mural-empty-state" *ngIf="!loading() && !filteredItems().length && !activeBoard()?.groups?.length">
      <div class="empty-icon-box"><mat-icon>sticky_note_2</mat-icon></div>
      <h2>Mural pronto!</h2>
      <p>Fixe comunicados, notas, fotos e documentos importantes no seu mural.</p>
      <button class="primary-btn" (click)="abrirNovoItem()">
        <mat-icon>add</mat-icon><span>Criar Primeira Nota</span>
      </button>
    </div>
  </div>
</div>

<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 MODAL DE ITEM \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->
<app-mural-item-modal
  *ngIf="itemModalOpen()"
  [boardId]="activeBoard()?.id || ''"
  [item]="editingItem()"
  [groups]="activeBoard()?.groups || []"
  [defaultGroupId]="targetGroupId()"
  [isReadOnly]="itemModalReadOnly()"
  (close)="fecharItemModal()"
  (saved)="onItemSalvo($event)"
  (deleted)="onItemExcluido($event)"
></app-mural-item-modal>

<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 MENU DE CONTEXTO DO ITEM DO MURAL \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->
<div
  class="mural-context-menu"
  *ngIf="muralItemContextMenu() as menu"
  [style.left.px]="menu.x"
  [style.top.px]="menu.y"
  (click)="$event.stopPropagation()"
>
  <button type="button" (click)="abrirVisualizarItem(menu.item)">
    <mat-icon>visibility</mat-icon><span>Visualizar</span>
  </button>
  <button type="button" (click)="abrirEditarItem(menu.item)">
    <mat-icon>edit</mat-icon><span>Editar</span>
  </button>
  <button type="button" (click)="alternarFixacao($event, menu.item)">
    <mat-icon>push_pin</mat-icon><span>{{ menu.item.isPinned ? 'Desafixar' : 'Fixar' }}</span>
  </button>
  <button type="button" class="danger" (click)="excluirItemFromContext(menu.item)">
    <mat-icon>delete_outline</mat-icon><span>Excluir</span>
  </button>
</div>

<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 MODAL DE GRUPO / QUADRO \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->
<div class="modal-overlay" *ngIf="groupModalOpen()" (mousedown)="fecharGrupoModal()">
  <div class="modal-card modal-sm" (mousedown)="$event.stopPropagation()">
    <div class="modal-header">
      <div class="header-main">
        <div class="header-badge" [style.background]="groupColor || '#64748b'">
          <mat-icon>{{ editingGroup() ? 'edit' : 'create_new_folder' }}</mat-icon>
        </div>
        <div>
          <h2>{{ editingGroup() ? 'Editar Quadro' : 'Novo Quadro no Mural' }}</h2>
          <p>{{ editingGroup() ? 'Atualize o t\xEDtulo e cor deste quadro.' : 'Crie uma se\xE7\xE3o tem\xE1tica para organizar cart\xF5es.' }}</p>
        </div>
      </div>
      <button class="close-btn" (click)="fecharGrupoModal()"><mat-icon>close</mat-icon></button>
    </div>
    <div class="modal-body">
      <div class="form-card">
        <div class="card-section-header"><mat-icon class="color-blue">folder</mat-icon><h3>Dados do Quadro</h3></div>
        <div class="form-grid">
          <div class="form-field">
            <label>Nome do Quadro <span class="required">*</span></label>
            <input type="text" [(ngModel)]="groupTitle" name="groupTitle" placeholder="Ex: Quadro de Avisos, Ideias, Documenta\xE7\xF5es..." autofocus />
          </div>
          <div class="form-field">
            <label>Cor de Destaque</label>
            <div class="color-presets-row">
              <button type="button" *ngFor="let c of colorPresets" class="color-swatch-btn" [style.background]="c.value" [class.selected]="groupColor === c.value" [matTooltip]="c.label" (click)="groupColor = c.value">
                <mat-icon *ngIf="groupColor === c.value">check</mat-icon>
              </button>
              <input type="color" [(ngModel)]="groupColor" name="groupColor" class="color-input-custom" matTooltip="Cor personalizada" />
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <ng-container *ngIf="!confirmDeleteGroup()">
        <button *ngIf="editingGroup()" class="delete-btn" (click)="solicitarExclusaoGrupo()" [disabled]="loadingExcluirGrupo">
          <mat-icon>delete</mat-icon><span>Excluir Quadro</span>
        </button>
        <button class="cancel-btn" (click)="fecharGrupoModal()">Cancelar</button>
        <button class="primary-btn" (click)="salvarGrupo()" [disabled]="loadingSalvarGrupo || !groupTitle.trim()">
          <mat-progress-spinner *ngIf="loadingSalvarGrupo" mode="indeterminate" diameter="16" class="button-spinner"></mat-progress-spinner>
          <mat-icon *ngIf="!loadingSalvarGrupo">save</mat-icon>
          <span>{{ loadingSalvarGrupo ? 'Salvando...' : 'Salvar Quadro' }}</span>
        </button>
      </ng-container>

      <div class="delete-confirm-box" *ngIf="confirmDeleteGroup()">
        <div class="confirm-text">
          <mat-icon class="warn-icon">warning</mat-icon>
          <span>Excluir este quadro? As notas existentes ser\xE3o mantidas como notas soltas no mural.</span>
        </div>
        <div class="confirm-actions">
          <button class="cancel-btn" (click)="cancelarExclusaoGrupo()">Voltar</button>
          <button class="danger-btn" (click)="confirmarExclusaoGrupo()" [disabled]="loadingExcluirGrupo">
            <mat-progress-spinner *ngIf="loadingExcluirGrupo" mode="indeterminate" diameter="16" class="button-spinner"></mat-progress-spinner>
            <span>Confirmar Exclus\xE3o</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 MODAL NOVO MURAL \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->
<div class="modal-overlay" *ngIf="createBoardModalOpen()" (mousedown)="fecharNovoMuralModal()">
  <div class="modal-card modal-sm" (mousedown)="$event.stopPropagation()">
    <div class="modal-header">
      <div class="header-main">
        <div class="header-badge" [style.background]="newBoardColor || '#f59e0b'">
          <mat-icon>dashboard_customize</mat-icon>
        </div>
        <div>
          <h2>Novo Mural</h2>
          <p>Crie um novo espa\xE7o de notas, avisos e ideias.</p>
        </div>
      </div>
      <button class="close-btn" (click)="fecharNovoMuralModal()"><mat-icon>close</mat-icon></button>
    </div>
    <div class="modal-body">
      <div class="form-card">
        <div class="card-section-header"><mat-icon class="color-amber">space_dashboard</mat-icon><h3>Dados do Mural</h3></div>
        <div class="form-grid">
          <div class="form-field">
            <label>Nome do Mural <span class="required">*</span></label>
            <input type="text" [(ngModel)]="newBoardName" placeholder="Ex: Projetos Pessoais, Planejamento..." autofocus />
          </div>
          <div class="form-field">
            <label>Descri\xE7\xE3o</label>
            <textarea [(ngModel)]="newBoardDescription" rows="2" class="custom-textarea" placeholder="Descri\xE7\xE3o opcional..."></textarea>
          </div>
          <div class="form-field">
            <label>Cor do Mural</label>
            <div class="color-presets-row">
              <button type="button" *ngFor="let c of colorPresets" class="color-swatch-btn" [style.background]="c.value" [class.selected]="newBoardColor === c.value" [matTooltip]="c.label" (click)="newBoardColor = c.value">
                <mat-icon *ngIf="newBoardColor === c.value">check</mat-icon>
              </button>
              <input type="color" [(ngModel)]="newBoardColor" class="color-input-custom" matTooltip="Cor personalizada" />
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="cancel-btn" (click)="fecharNovoMuralModal()">Cancelar</button>
      <button class="primary-btn" (click)="salvarNovoMural()" [disabled]="loadingCriarMural || !newBoardName.trim()">
        <mat-progress-spinner *ngIf="loadingCriarMural" mode="indeterminate" diameter="16" class="button-spinner"></mat-progress-spinner>
        <mat-icon *ngIf="!loadingCriarMural">save</mat-icon>
        <span>{{ loadingCriarMural ? 'Criando...' : 'Criar Mural' }}</span>
      </button>
    </div>
  </div>
</div>

<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 MODAL CONFIGURAR MURAL \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->
<div class="modal-overlay" *ngIf="boardModalOpen()" (mousedown)="fecharBoardModal()">
  <div class="modal-card modal-sm" (mousedown)="$event.stopPropagation()">
    <div class="modal-header">
      <div class="header-main">
        <div class="header-badge edit-mode" [style.background]="boardColor || '#f59e0b'"><mat-icon>space_dashboard</mat-icon></div>
        <div><h2>Configurar Mural</h2><p>Altere o nome, descri\xE7\xE3o, cor ou exclua o mural.</p></div>
      </div>
      <button class="close-btn" (click)="fecharBoardModal()"><mat-icon>close</mat-icon></button>
    </div>
    <div class="modal-body">
      <div class="form-card">
        <div class="card-section-header"><mat-icon class="color-amber">tune</mat-icon><h3>Dados do Mural</h3></div>
        <div class="form-grid">
          <div class="form-field">
            <label>Nome <span class="required">*</span></label>
            <input type="text" [(ngModel)]="boardName" placeholder="Ex: Mural de Avisos" />
          </div>
          <div class="form-field">
            <label>Descri\xE7\xE3o</label>
            <textarea [(ngModel)]="boardDescription" rows="3" class="custom-textarea" placeholder="Descri\xE7\xE3o opcional..."></textarea>
          </div>
          <div class="form-field">
            <label>Cor de Destaque</label>
            <div class="color-presets-row">
              <button type="button" *ngFor="let c of colorPresets" class="color-swatch-btn" [style.background]="c.value" [class.selected]="boardColor === c.value" [matTooltip]="c.label" (click)="boardColor = c.value">
                <mat-icon *ngIf="boardColor === c.value">check</mat-icon>
              </button>
              <input type="color" [(ngModel)]="boardColor" class="color-input-custom" matTooltip="Cor personalizada" />
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <ng-container *ngIf="!confirmDeleteBoard()">
        <button *ngIf="activeBoard()?.myRole === 'admin'" class="delete-btn" (click)="solicitarExclusaoMural()" [disabled]="loadingExcluirMural">
          <mat-icon>delete_outline</mat-icon><span>Excluir Mural</span>
        </button>
        <button class="cancel-btn" (click)="fecharBoardModal()">Cancelar</button>
        <button class="primary-btn" (click)="salvarMural()" [disabled]="loadingSalvarMural || !boardName.trim()">
          <mat-progress-spinner *ngIf="loadingSalvarMural" mode="indeterminate" diameter="16" class="button-spinner"></mat-progress-spinner>
          <mat-icon *ngIf="!loadingSalvarMural">save</mat-icon>
          <span>{{ loadingSalvarMural ? 'Salvando...' : 'Salvar Altera\xE7\xF5es' }}</span>
        </button>
      </ng-container>

      <div class="delete-confirm-box" *ngIf="confirmDeleteBoard()">
        <div class="confirm-text">
          <mat-icon class="warn-icon">warning</mat-icon>
          <span>Excluir este mural e todas as suas notas? Esta a\xE7\xE3o n\xE3o poder\xE1 ser desfeita.</span>
        </div>
        <div class="confirm-actions">
          <button class="cancel-btn" (click)="cancelarExclusaoMural()">Voltar</button>
          <button class="danger-btn" (click)="confirmarExclusaoMural()" [disabled]="loadingExcluirMural">
            <mat-progress-spinner *ngIf="loadingExcluirMural" mode="indeterminate" diameter="16" class="button-spinner"></mat-progress-spinner>
            <span>Confirmar Exclus\xE3o</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 MODAL DE TIME & SSO (ID\xCANTICO AO TAREFAS) \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->
<div class="team-modal-backdrop" *ngIf="teamModalOpen()" (mousedown)="fecharTimeModal()">
  <section class="team-modal" (mousedown)="$event.stopPropagation()">
    <header>
      <div>
        <h2>{{ creatingTeam() ? 'Criar novo time' : 'Gerenciar time' }}</h2>
        <p>Times t\xEAm murais e quadros compartilhados entre todos os membros vinculados ao SSO.</p>
      </div>
      <button class="icon-btn" (click)="fecharTimeModal()"><mat-icon>close</mat-icon></button>
    </header>

    <div class="team-selector" *ngIf="!creatingTeam() && teams().length > 1">
      <button *ngFor="let team of teams()" [class.active]="currentTeam()?.id === team.id" (click)="trocarTimeNoModal(team.id)">
        <span [style.background]="team.color"></span>{{ team.name }}
      </button>
    </div>

    <!-- Modo Criar Novo Time -->
    <form class="team-create-form" *ngIf="creatingTeam()" (ngSubmit)="saveTeam()">
      <label>
        <span>Nome do time *</span>
        <input [(ngModel)]="newTeamName" name="teamName" maxlength="80" placeholder="Ex.: Produto, Marketing, Opera\xE7\xF5es" autofocus required>
      </label>
      <div class="team-description-field">
        <div class="description-header">
          <span>Descri\xE7\xE3o</span>
          <app-ai-text-button [text]="newTeamDescription" (textChange)="newTeamDescription = $event" />
        </div>
        <app-markdown-editor [text]="newTeamDescription" (textChange)="newTeamDescription = $event" [maxLength]="1000" placeholder="Objetivo deste time" ariaLabel="Descri\xE7\xE3o do time" />
      </div>
      <label>
        <span>Cor</span>
        <input [(ngModel)]="newTeamColor" name="teamColor" type="color">
      </label>
      <div class="team-form-actions">
        <button type="button" class="cancel-btn" (click)="creatingTeam.set(false)" *ngIf="teams().length">Voltar</button>
        <button class="primary-btn" type="submit" [disabled]="!newTeamName.trim()">Criar time</button>
      </div>
    </form>

    <!-- Modo Gerenciar Time Existente -->
    <div class="team-management" *ngIf="!creatingTeam() && currentTeam() as team">
      <div class="team-summary">
        <span class="team-logo" [style.background]="team.color"><mat-icon>groups</mat-icon></span>
        <div>
          <h3>{{ team.name }}</h3>
          <p>{{ kanbanService.teamMembers().length || team.memberCount }} membro{{ (kanbanService.teamMembers().length || team.memberCount) !== 1 ? 's' : '' }} \xB7 {{ team.myRole === 'admin' ? 'Voc\xEA administra este time' : 'Voc\xEA \xE9 membro' }}</p>
        </div>
        <button class="danger-icon" *ngIf="team.myRole === 'admin' && !confirmDeleteTeam()" (click)="solicitarExclusaoTime()" matTooltip="Excluir time">
          <mat-icon>delete_outline</mat-icon>
        </button>
      </div>

      <!-- Confirma\xE7\xE3o in-app de exclus\xE3o de time -->
      <div class="in-app-confirm-banner" *ngIf="confirmDeleteTeam()">
        <div class="confirm-content">
          <mat-icon class="warn-icon">warning</mat-icon>
          <span>Excluir time <strong>{{ team.name }}</strong> e todos os seus recursos?</span>
        </div>
        <div class="confirm-buttons">
          <button class="cancel-btn-sm" (click)="cancelarExclusaoTime()">Cancelar</button>
          <button class="danger-btn-sm" (click)="confirmarExclusaoTime()">Confirmar Exclus\xE3o</button>
        </div>
      </div>

      <!-- Convidar usu\xE1rio SSO -->
      <div class="invite-row" *ngIf="team.myRole === 'admin'">
        <select [(ngModel)]="invitedUserId">
          <option value="">Selecione uma pessoa (SSO) para convidar</option>
          <option *ngFor="let user of inviteableUsers()" [value]="user.id">{{ user.name }} \xB7 {{ user.email }}</option>
        </select>
        <button class="primary-btn" (click)="inviteMember()" [disabled]="!invitedUserId">
          <mat-icon>person_add</mat-icon>Convidar
        </button>
      </div>

      <!-- Lista de membros -->
      <div class="member-list">
        <h4>Membros</h4>
        <div class="member-row" *ngFor="let member of kanbanService.teamMembers()">
          <img [src]="memberAvatar(member.user_id)" [alt]="memberName(member.user_id)" (error)="$any($event.target).src = defaultAvatar">
          <div>
            <strong>{{ memberName(member.user_id) }}</strong>
            <span>{{ member.role === 'admin' ? 'Administrador' : 'Membro' }}</span>
          </div>
          <span *ngIf="isTeamOwner(member.user_id)" class="owner-badge" matTooltip="Criador do time">
            <mat-icon>shield</mat-icon>
          </span>
          <ng-container *ngIf="team.myRole === 'admin' && !isTeamOwner(member.user_id)">
            <button *ngIf="member.role !== 'admin'" class="icon-btn promote-btn"
              (click)="changeMemberRole(member.id, 'admin')" matTooltip="Promover a administrador">
              <mat-icon>manage_accounts</mat-icon>
            </button>
            <button *ngIf="member.role === 'admin'" class="icon-btn"
              (click)="changeMemberRole(member.id, 'member')" matTooltip="Rebaixar a membro">
              <mat-icon>person_outline</mat-icon>
            </button>
            <button *ngIf="team.myRole === 'admin'" class="danger-icon" (click)="removeMember(member.id)" matTooltip="Remover do time">
              <mat-icon>person_remove</mat-icon>
            </button>
          </ng-container>
        </div>
      </div>

      <button class="new-team-link" (click)="creatingTeam.set(true)">
        <mat-icon>add</mat-icon>Criar outro time
      </button>
    </div>
  </section>
</div>

<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 PREVIEW DE ANEXO \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->
<app-attachment-preview-modal
  *ngIf="previewAttachmentUrl()"
  [fileName]="previewAttachmentName()"
  [fileUrl]="previewAttachmentUrl()"
  [mimeType]="previewAttachmentMimeType()"
  [rawContent]="previewAttachmentRawContent()"
  [byteSize]="previewAttachmentByteSize()"
  (close)="fecharPreview()"
