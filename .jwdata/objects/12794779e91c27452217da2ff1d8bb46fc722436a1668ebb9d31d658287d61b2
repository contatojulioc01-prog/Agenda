              <span class="view-badge badge-pin" *ngIf="isPinned">
                <mat-icon>push_pin</mat-icon>
                <span>Fixado</span>
              </span>
              <span class="view-badge badge-group" *ngIf="getGroupName()">
                <mat-icon>folder_open</mat-icon>
                <span>{{ getGroupName() }}</span>
              </span>
            </div>
          </div>

          <div class="view-description-wrap">
            <app-markdown-text *ngIf="content" [text]="content" (textChange)="onContentChangeInView($event)"></app-markdown-text>
            <p *ngIf="!content" class="view-empty-desc">Nenhum conte\xFAdo informado.</p>
          </div>
        </div>

        <!-- Anexos no modo visualiza\xE7\xE3o (somente se houver) -->
        <div class="view-attachments-card" *ngIf="attachments.length > 0">
          <div class="view-card-subtitle">
            <mat-icon>attach_file</mat-icon>
            <span>Anexos & Arquivos ({{ attachments.length }})</span>
          </div>
          <div class="attachments-list">
            <div
              class="attachment-item"
              *ngFor="let att of attachments"
              (click)="abrirPreview(att)"
              (contextmenu)="onAttachmentContextMenu($event, att)"
              matTooltip="Clique para visualizar ou bot\xE3o direito para op\xE7\xF5es"
              [matTooltipShowDelay]="600"
            >
              <div class="attachment-info">
                <mat-icon class="att-type-icon" [style.color]="getFileInfo(att.fileName, att.mimeType).color">
                  {{ getFileInfo(att.fileName, att.mimeType).icon }}
                </mat-icon>
                <div class="att-text">
                  <span class="att-name" [title]="att.fileName">{{ att.fileName }}</span>
                  <span class="att-size">{{ formatarTamanho(att.byteSize) }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Modo Edi\xE7\xE3o / Cria\xE7\xE3o com Formul\xE1rio Completo -->
      <form class="form-container" *ngIf="!isReadOnly" (submit)="salvar(); $event.preventDefault()">

        <!-- GRUPO 1: Conte\xFAdo da Nota -->
        <div class="form-card">
          <div class="card-header">
            <mat-icon class="section-icon color-amber">sticky_note_2</mat-icon>
            <h3>Conte\xFAdo & Informa\xE7\xF5es</h3>
          </div>

          <div class="form-grid">
            <div class="form-field col-span-2">
              <label>T\xEDtulo / Assunto <span class="required">*</span></label>
              <input
                type="text"
                [(ngModel)]="title"
                name="title"
                placeholder="Ex: Reuni\xE3o Geral de Alinhamento"
                required
                autofocus
              />
            </div>

            <div class="form-field col-span-2">
              <div class="field-label-row">
                <label>Descri\xE7\xE3o / Texto da Nota</label>
                <app-ai-text-button [(text)]="content" placeholderContext="conte\xFAdo do aviso"></app-ai-text-button>
              </div>
              <app-markdown-editor [text]="content" (textChange)="content = $event" placeholder="Escreva a nota, use formata\xE7\xE3o Markdown ou listas de tarefas (- [ ] item)..."></app-markdown-editor>
            </div>
          </div>
        </div>

        <!-- GRUPO 2: Organiza\xE7\xE3o & Estilo Visual -->
        <div class="form-card">
          <div class="card-header">
            <mat-icon class="section-icon color-blue">palette</mat-icon>
            <h3>Organiza\xE7\xE3o & Visual do Cart\xE3o</h3>
          </div>

          <div class="form-grid">
            <!-- Grupo / Se\xE7\xE3o -->
            <div class="form-field">
              <label>Grupo / Se\xE7\xE3o no Mural</label>
              <select [(ngModel)]="selectedGroupId" name="selectedGroupId" class="custom-select">
                <option [ngValue]="null">\u{1F4CC} Sem Grupo (Nota Solta no Mural)</option>
                <option *ngFor="let g of groups" [ngValue]="g.id">{{ g.title }}</option>
              </select>
            </div>

            <!-- Fixar no Topo -->
            <div class="form-field">
              <label>Destaque / Fixa\xE7\xE3o</label>
              <div class="pin-toggle-box" (click)="isPinned = !isPinned">
                <mat-icon class="pin-icon" [class.active]="isPinned">push_pin</mat-icon>
                <span>{{ isPinned ? 'Fixado em Destaque' : 'Fixa\xE7\xE3o Normal' }}</span>
                <input type="checkbox" [(ngModel)]="isPinned" name="isPinned" class="hidden-checkbox" />
              </div>
            </div>

            <!-- Seletor de Cores -->
            <div class="form-field col-span-2">
              <label>Cor do Cart\xE3o</label>
              <div class="color-palette-grid">
                <button
                  type="button"
                  *ngFor="let opt of colorOptions"
                  class="color-circle"
                  [class.active]="selectedColor === opt.value"
                  [style.background]="opt.value"
                  [style.border-color]="opt.border"
                  [matTooltip]="opt.name"
                  (click)="selectedColor = opt.value"
                >
                  <mat-icon *ngIf="selectedColor === opt.value" class="check-icon" [style.color]="opt.value === '#334155' ? '#ffffff' : '#0f172a'">check</mat-icon>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- GRUPO 3: Anexos & Arquivos (Qualquer tipo de arquivo) -->
        <div class="form-card">
          <div class="card-header">
            <mat-icon class="section-icon color-emerald">attach_file</mat-icon>
            <h3>Documentos, C\xF3digos & Anexos</h3>
          </div>

          <div class="attachments-section">
            <div class="upload-dropzone">
              <input
                type="file"
                #fileInput
                (change)="onFilesSelected($event)"
                multiple
                style="display: none;"
              />
              <button
                type="button"
                class="btn-upload"
                (click)="fileInput.click()"
                [disabled]="loadingUpload"
              >
                <mat-progress-spinner
                  *ngIf="loadingUpload"
                  mode="indeterminate"
                  diameter="18"
                  class="button-spinner"
                ></mat-progress-spinner>
                <mat-icon *ngIf="!loadingUpload">cloud_upload</mat-icon>
                <span>{{ loadingUpload ? 'Enviando anexos...' : 'Anexar Arquivos (Qualquer formato)' }}</span>
              </button>
              <span class="upload-hint">Aceita c\xF3digos de programa\xE7\xE3o, PDFs, imagens, documentos e planilhas</span>
            </div>

            <!-- Arquivos Pendentes (Mini-Cards sem bot\xF5es vis\xEDveis, op\xE7\xF5es no bot\xE3o direito) -->
            <div class="pending-section-wrap" *ngIf="pendingFiles.length > 0">
              <div class="pending-title">Prontos para envio ao salvar (clique para pr\xE9-visualizar ou bot\xE3o direito para op\xE7\xF5es):</div>
              <div class="pending-attachments-list">
                <div
                  class="attachment-item pending"
                  *ngFor="let file of pendingFiles; let i = index"
                  (click)="abrirPendingPreview(file)"
                  (contextmenu)="onPendingContextMenu($event, i)"
                  matTooltip="Clique para visualizar ou bot\xE3o direito para op\xE7\xF5es"
                  [matTooltipShowDelay]="600"
                >
                  <div class="attachment-info">
                    <mat-icon class="att-type-icon" [style.color]="getFileInfo(file.name, file.type).color">
                      {{ getFileInfo(file.name, file.type).icon }}
                    </mat-icon>
                    <div class="att-text">
                      <span class="att-name" [title]="file.name">{{ file.name }}</span>
                      <span class="att-size">{{ formatarTamanho(file.size) }}</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Lista de Anexos J\xE1 Salvos (Mini-Cards sem bot\xF5es vis\xEDveis, op\xE7\xF5es no bot\xE3o direito) -->
            <div class="attachments-list" *ngIf="attachments.length > 0">
              <div
                class="attachment-item"
                *ngFor="let att of attachments"
                (click)="abrirPreview(att)"
                (contextmenu)="onAttachmentContextMenu($event, att)"
                matTooltip="Clique para visualizar ou bot\xE3o direito para op\xE7\xF5es"
                [matTooltipShowDelay]="600"
              >
                <div class="attachment-info">
                  <mat-icon class="att-type-icon" [style.color]="getFileInfo(att.fileName, att.mimeType).color">
                    {{ getFileInfo(att.fileName, att.mimeType).icon }}
                  </mat-icon>
                  <div class="att-text">
                    <span class="att-name" [title]="att.fileName">{{ att.fileName }}</span>
                    <span class="att-size">{{ formatarTamanho(att.byteSize) }}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </form>

      <!-- Trigger invis\xEDvel para Menu de Contexto (Angular Material) -->
      <div
        class="context-menu-trigger-anchor"
        [style.left.px]="contextMenuPosition.x"
        [style.top.px]="contextMenuPosition.y"
        [matMenuTriggerFor]="attachmentContextMenu"
      ></div>

      <!-- Menu de Contexto Angular Material -->
      <mat-menu #attachmentContextMenu="matMenu" class="mural-attachment-context-menu">
        <ng-template matMenuContent>
          <!-- Op\xE7\xF5es para Anexo Salvo -->
          <ng-container *ngIf="contextAttachment as att">
            <button mat-menu-item (click)="abrirPreview(att)">
              <mat-icon class="color-blue">visibility</mat-icon>
              <span>Visualizar anexo</span>
            </button>
            <button mat-menu-item (click)="baixarAnexo(att)">
              <mat-icon class="color-indigo">download</mat-icon>
              <span>Baixar arquivo</span>
            </button>
            <mat-divider *ngIf="!isReadOnly"></mat-divider>
            <button *ngIf="!isReadOnly" mat-menu-item (click)="removerAnexo(att)" class="menu-item-danger">
              <mat-icon class="color-red">delete_outline</mat-icon>
              <span>Excluir anexo</span>
            </button>
          </ng-container>

          <!-- Op\xE7\xF5es para Arquivo Pendente -->
          <ng-container *ngIf="contextPendingIndex !== null">
            <button mat-menu-item (click)="removerPendingFile(contextPendingIndex)" class="menu-item-danger">
              <mat-icon class="color-red">delete_outline</mat-icon>
              <span>Remover da lista</span>
            </button>
          </ng-container>
        </ng-template>
      </mat-menu>
    </div>

    <!-- Fixed Footer -->
    <div class="modal-footer">
      <ng-container *ngIf="isReadOnly">
        <button type="button" class="btn-cancel" (click)="enableEditMode()">
          <mat-icon>edit</mat-icon>
          <span>Editar Cart\xE3o</span>
        </button>
        <button type="button" class="btn-save" (click)="fechar()">
          <mat-icon>close</mat-icon>
          <span>Fechar</span>
        </button>
      </ng-container>

      <ng-container *ngIf="!isReadOnly">
        <ng-container *ngIf="isEdit">
          <button *ngIf="!confirmDelete()" type="button" class="btn-delete" (click)="excluir()" [disabled]="loadingExcluir">
            <mat-icon>delete</mat-icon>
            <span>Excluir</span>
          </button>

          <!-- Confirma\xE7\xE3o in-app integrada -->
          <div class="delete-confirm-box" *ngIf="confirmDelete()">
            <span class="confirm-text">Confirmar exclus\xE3o?</span>
            <button type="button" class="btn-delete confirm" (click)="excluir()" [disabled]="loadingExcluir">
              <mat-progress-spinner *ngIf="loadingExcluir" mode="indeterminate" diameter="16" class="button-spinner"></mat-progress-spinner>
              <mat-icon *ngIf="!loadingExcluir">check</mat-icon>
              <span>Sim, excluir</span>
            </button>
            <button type="button" class="btn-cancel compact" (click)="cancelarExclusao()">N\xE3o</button>
          </div>
        </ng-container>

        <button type="button" class="btn-cancel" (click)="fechar()">Cancelar</button>

        <button type="button" class="btn-save" (click)="salvar()" [disabled]="loadingSalvar || !title.trim()">
          <mat-progress-spinner
            *ngIf="loadingSalvar"
            mode="indeterminate"
            diameter="20"
            class="button-spinner"
          ></mat-progress-spinner>
          <mat-icon *ngIf="!loadingSalvar">save</mat-icon>
          <span>{{ loadingSalvar ? 'Salvando...' : (isEdit ? 'Salvar Altera\xE7\xF5es' : 'Adicionar ao Mural') }}</span>
        </button>
      </ng-container>
    </div>

  </div>
</div>

<!-- Modal de Pr\xE9-visualiza\xE7\xE3o de Anexo -->
<app-attachment-preview-modal
  *ngIf="previewAttachmentUrl()"
  [fileName]="previewAttachmentName()"
  [fileUrl]="previewAttachmentUrl()"
  [mimeType]="previewAttachmentMimeType()"
  [rawContent]="previewAttachmentRawContent()"
  [byteSize]="previewAttachmentByteSize()"
  (close)="fecharPreview()"
  (download)="baixarAnexo()"
></app-attachment-preview-modal>
