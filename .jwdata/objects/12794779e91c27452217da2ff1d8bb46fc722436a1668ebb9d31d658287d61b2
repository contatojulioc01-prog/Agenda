      <button class="archive-toggle expand-pill-btn size-34" [class.active]="filterPinnedOnly()" (click)="filterPinnedOnly.set(!filterPinnedOnly())" matTooltip="Fixados">
        <mat-icon>push_pin</mat-icon><span class="pill-label">Fixados</span>
      </button>
      <button class="archive-toggle expand-pill-btn size-34" [class.active]="filterWithAttachments()" (click)="filterWithAttachments.set(!filterWithAttachments())" matTooltip="Com Anexos">
        <mat-icon>attach_file</mat-icon><span class="pill-label">Com Anexos</span>
      </button>
    </div>

    <div class="toolbar-actions">
