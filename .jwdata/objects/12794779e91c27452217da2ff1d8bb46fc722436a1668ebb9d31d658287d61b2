      </button>
      <button *ngIf="activeBoard()?.scopeType === 'team' || teams().length > 0" class="secondary-btn expand-pill-btn size-36" (click)="abrirGerenciarTime()" matTooltip="Gerenciar Time & Membros SSO">
        <mat-icon>group</mat-icon><span class="pill-label">Membros</span>
      </button>
    </div>
  </div>

  <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 CANVAS \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->
  <div class="mural-canvas" [class.is-loading]="loading()" (click)="closeMuralItemContextMenu()" (dragover)="$event.preventDefault()">

