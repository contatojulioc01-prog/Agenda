        (eventClick)="openViewModal($event)" (eventContextMenu)="openEventContextMenu($event)"\r
        (eventDrop)="onEventDrop($event)"></app-week-view>\r
\r
      <app-day-view *ngIf="currentView === 'day'" [selectedDate]="selectedDate" [events]="displayedEvents()"\r
