                <button
                  type="button"
                  class="menu-board-btn"
                  (click)="selecionarMural(b.id)"
                >
                  <span class="menu-board-dot" [style.background]="b.color"></span>
                  <span class="menu-board-title">{{ b.name }}</span>
                  <span class="menu-board-count" *ngIf="b.itemCount">({{ b.itemCount }})</span>
                  <mat-icon *ngIf="b.id === activeBoard()?.id" class="menu-check-icon">check</mat-icon>
                </button>
                <div class="menu-row-actions" (click)="$event.stopPropagation()">
                  <button type="button" class="menu-action-btn" (click)="selecionarMural(b.id); abrirEditarMural()" matTooltip="Configurar Mural">
                    <mat-icon>settings</mat-icon>
                  </button>
                  <button type="button" class="menu-action-btn danger" *ngIf="boards().length > 1" (click)="excluirMuralPorId(b, $event)" matTooltip="Excluir Mural">
                    <mat-icon>delete_outline</mat-icon>
                  </button>
                </div>
              </div>
            </ng-container>

            <!-- Murais de Time -->
            <div class="mat-menu-group-label" *ngIf="hasTeamBoards()">
              <mat-icon>groups</mat-icon>
              <span>Times & Equipes</span>
            </div>
            <ng-container *ngFor="let b of boards()">
              <div
                class="menu-board-row"
                *ngIf="b.scopeType === 'team'"
                cdkDrag
                [cdkDragData]="b"
                [class.active-row]="b.id === activeBoard()?.id"
              >
                <mat-icon class="menu-drag-icon" cdkDragHandle matTooltip="Arraste para reordenar">drag_indicator</mat-icon>
                <button
                  type="button"
                  class="menu-board-btn"
                  (click)="selecionarMural(b.id)"
                >
                  <span class="menu-board-dot" [style.background]="b.color"></span>
                  <span class="menu-board-title">{{ b.name }}</span>
                  <span class="menu-board-count" *ngIf="b.itemCount">({{ b.itemCount }})</span>
                  <mat-icon *ngIf="b.id === activeBoard()?.id" class="menu-check-icon">check</mat-icon>
                </button>
                <div class="menu-row-actions" (click)="$event.stopPropagation()">
                  <button type="button" class="menu-action-btn" *ngIf="b.myRole === 'admin'" (click)="selecionarMural(b.id); abrirEditarMural()" matTooltip="Configurar Mural">
                    <mat-icon>settings</mat-icon>
                  </button>
                  <button type="button" class="menu-action-btn danger" *ngIf="b.myRole === 'admin'" (click)="excluirMuralPorId(b, $event)" matTooltip="Excluir Mural">
                    <mat-icon>delete_outline</mat-icon>
                  </button>
                </div>
              </div>
            </ng-container>
          </div>
        </mat-menu>
      </div>

      <!-- Busca -->
      <div class="search-box">
