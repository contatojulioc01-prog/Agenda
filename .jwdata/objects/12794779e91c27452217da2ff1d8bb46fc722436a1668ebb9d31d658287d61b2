    ], template: `<div class="mural-shell">

  <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 TOOLBAR \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->
  <div class="mural-toolbar group-panel">

    <div class="toolbar-left">
      <!-- Board Selector com Angular Material Menu -->
      <div class="board-selector-wrapper">
        <button
          type="button"
          class="mat-board-trigger"
          [matMenuTriggerFor]="muralMenu"
          aria-label="Selecionar Mural"
        >
          <div class="board-mark" [style.background]="activeBoard()?.color || '#f59e0b'">
            <mat-icon>{{ activeBoard()?.scopeType === 'team' ? 'groups' : 'space_dashboard' }}</mat-icon>
          </div>
          <div class="board-heading">
            <div class="board-title-row">
              <span class="board-active-name">{{ activeBoard()?.name || 'Selecionar Mural' }}</span>
              <span class="board-items-badge" *ngIf="activeBoard()?.items?.length">({{ activeBoard()?.items?.length }})</span>
              <mat-icon class="dropdown-chevron">expand_more</mat-icon>
