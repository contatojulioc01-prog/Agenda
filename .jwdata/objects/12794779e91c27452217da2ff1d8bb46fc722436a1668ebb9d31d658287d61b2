            <span class="board-subtitle" *ngIf="activeBoard()?.scopeType === 'team'">
              {{ activeBoard()?.teamName || 'Mural do Time' }}
            </span>
          </div>
        </button>

        <mat-menu #muralMenu="matMenu" class="mural-custom-mat-menu" xPosition="after">
          <!-- Cabe\xE7alho do Menu / A\xE7\xF5es R\xE1pidas -->
