    delete cleanUrl.queryParams["ticket"];
    delete cleanUrl.queryParams["token"];
    return cleanUrl;
  }
  if (authService.getToken()) {
    return true;
  }
  return router.createUrlTree(["/unauthorized"], { queryParams: { retorno: state.url } });
};

