  "sourcesContent": [":host {\r\n  display: flex;\r\n  flex: 1 1 0%;\r\n  width: 100%;\r\n  height: 100%;\r\n  min-height: 0;\r\n}\r\n\r\n.app-content { display: contents; }\r\n\r\n.startup-loader {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: 10000;\r\n  display: grid;\r\n  place-items: center;\r\n  overflow: hidden;\r\n  padding: 24px;\r\n  color: var(--text-primary, #172033);\r\n  background:\r\n    radial-gradient(circle at 50% 42%, color-mix(in srgb, var(--brand-500, #6758e8) 10%, transparent), transparent 31%),\r\n    var(--bg-app, #f7f8fc);\r\n  opacity: 1;\r\n  transition: opacity 210ms ease, visibility 210ms ease;\r\n}\r\n\r\n.startup-loader.is-leaving {\r\n  visibility: hidden;\r\n  opacity: 0;\r\n  pointer-events: none;\r\n}\r\n\r\n.loader-card {\r\n  position: relative;\r\n  z-index: 2;\r\n  display: flex;\r\n  width: min(420px, calc(100vw - 48px));\r\n  flex-direction: column;\r\n  align-items: center;\r\n  padding: 42px 42px 34px;\r\n  border: 1px solid color-mix(in srgb, var(--border, #dfe3ec) 72%, transparent);\r\n  border-radius: 28px;\r\n  background: color-mix(in srgb, var(--bg-surface, #fff) 88%, transparent);\r\n  box-shadow: 0 28px 80px color-mix(in srgb, var(--text-primary, #172033) 11%, transparent);\r\n  text-align: center;\r\n  backdrop-filter: blur(18px);\r\n  animation: loader-arrive 700ms cubic-bezier(.2, .8, .2, 1) both;\r\n}\r\n\r\n.brand-mark {\r\n  position: relative;\r\n  display: grid;\r\n  width: 96px;\r\n  height: 96px;\r\n  place-items: center;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.brand-mark::before {\r\n  position: absolute;\r\n  inset: 10px;\r\n  border-radius: 24px;\r\n  background: linear-gradient(145deg, color-mix(in srgb, var(--brand-500, #6758e8) 18%, transparent), transparent);\r\n  box-shadow: 0 14px 34px color-mix(in srgb, var(--brand-500, #6758e8) 20%, transparent);\r\n  content: '';\r\n  animation: mark-breathe 2.4s ease-in-out infinite;\r\n}\r\n\r\n.brand-mark svg {\r\n  z-index: 1;\r\n  width: 64px;\r\n  height: 64px;\r\n  overflow: visible;\r\n}\r\n\r\n.calendar-page {\r\n  fill: var(--bg-surface, #fff);\r\n  stroke: var(--brand-500, #6758e8);\r\n  stroke-width: 3;\r\n}\r\n\r\n.calendar-header,\r\n.calendar-ring,\r\n.calendar-check {\r\n  fill: none;\r\n  stroke: var(--brand-500, #6758e8);\r\n  stroke-linecap: round;\r\n  stroke-linejoin: round;\r\n  stroke-width: 3;\r\n}\r\n\r\n.calendar-check {\r\n  stroke: #18a56b;\r\n  stroke-dasharray: 28;\r\n  stroke-dashoffset: 28;\r\n  animation: draw-check 1.45s .35s ease-in-out infinite;\r\n}\r\n\r\n.orbit {\r\n  position: absolute;\r\n  inset: 0;\r\n  border: 1px solid color-mix(in srgb, var(--brand-500, #6758e8) 20%, transparent);\r\n  border-radius: 50%;\r\n  animation: orbit-spin 5s linear infinite;\r\n}\r\n\r\n.orbit::after {\r\n  position: absolute;\r\n  top: 8px;\r\n  left: 18px;\r\n  width: 7px;\r\n  height: 7px;\r\n  border-radius: 50%;\r\n  background: var(--brand-500, #6758e8);\r\n  box-shadow: 0 0 14px color-mix(in srgb, var(--brand-500, #6758e8) 65%, transparent);\r\n  content: '';\r\n}\r\n\r\n.orbit-two {\r\n  inset: 7px;\r\n  animation-direction: reverse;\r\n  animation-duration: 3.8s;\r\n  opacity: .65;\r\n}\r\n\r\n.orbit-two::after { top: auto; right: 5px; bottom: 17px; left: auto; width: 5px; height: 5px; }\r\n\r\n.loader-copy { min-height: 92px; }\r\n.loader-eyebrow {\r\n  display: block;\r\n  margin-bottom: 7px;\r\n  color: var(--text-brand, #6758e8);\r\n  font-size: .72rem;\r\n  font-weight: 700;\r\n  letter-spacing: .18em;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.loader-copy h1 {\r\n  margin: 0;\r\n  color: var(--text-primary, #172033);\r\n  font-size: clamp(1.35rem, 5vw, 1.7rem);\r\n  font-weight: 650;\r\n  letter-spacing: -.035em;\r\n}\r\n\r\n.loader-copy p,\r\n.loader-footnote {\r\n  color: var(--text-secondary, #6f7787);\r\n}\r\n\r\n.loader-copy p { margin: 9px 0 0; font-size: .9rem; }\r\n.typing-dots { display: inline-flex; gap: 3px; margin-left: 5px; vertical-align: middle; }\r\n.typing-dots i {\r\n  width: 3px;\r\n  height: 3px;\r\n  border-radius: 50%;\r\n  background: currentColor;\r\n  animation: dot-bounce 1.2s ease-in-out infinite;\r\n}\r\n.typing-dots i:nth-child(2) { animation-delay: 140ms; }\r\n.typing-dots i:nth-child(3) { animation-delay: 280ms; }\r\n\r\n.progress-track {\r\n  width: 100%;\r\n  height: 4px;\r\n  margin-top: 27px;\r\n  overflow: hidden;\r\n  border-radius: 99px;\r\n  background: color-mix(in srgb, var(--brand-500, #6758e8) 12%, transparent);\r\n}\r\n\r\n.progress-track span {\r\n  display: block;\r\n  width: 42%;\r\n  height: 100%;\r\n  border-radius: inherit;\r\n  background: linear-gradient(90deg, transparent, var(--brand-500, #6758e8), color-mix(in srgb, var(--brand-500, #6758e8) 50%, white));\r\n  animation: progress-glide 1.45s cubic-bezier(.65, 0, .35, 1) infinite;\r\n}\r\n\r\n.loader-footnote {\r\n  position: absolute;\r\n  bottom: max(24px, 5vh);\r\n  z-index: 2;\r\n  margin: 0;\r\n  font-size: .76rem;\r\n  letter-spacing: .035em;\r\n}\r\n\r\n.loader-glow {\r\n  position: absolute;\r\n  width: 340px;\r\n  height: 340px;\r\n  border-radius: 50%;\r\n  background: color-mix(in srgb, var(--brand-500, #6758e8) 9%, transparent);\r\n  filter: blur(60px);\r\n  animation: glow-drift 7s ease-in-out infinite alternate;\r\n}\r\n.loader-glow-one { top: -170px; right: -80px; }\r\n.loader-glow-two { bottom: -200px; left: -100px; animation-delay: -3.5s; }\r\n\r\n@keyframes loader-arrive { from { opacity: 0; transform: translateY(10px) scale(.98); } }\r\n@keyframes mark-breathe { 50% { transform: scale(1.06); opacity: .72; } }\r\n@keyframes orbit-spin { to { transform: rotate(360deg); } }\r\n@keyframes draw-check { 0%, 20% { stroke-dashoffset: 28; } 55%, 85% { stroke-dashoffset: 0; } 100% { stroke-dashoffset: -28; } }\r\n@keyframes dot-bounce { 0%, 65%, 100% { opacity: .35; transform: translateY(0); } 35% { opacity: 1; transform: translateY(-3px); } }\r\n@keyframes progress-glide { from { transform: translateX(-110%); } to { transform: translateX(340%); } }\r\n@keyframes glow-drift { to { transform: translate3d(45px, 30px, 0) scale(1.15); } }\r\n\r\n@media (max-width: 520px) {\r\n  .loader-card { padding: 34px 24px 29px; border-radius: 24px; }\r\n  .brand-mark { margin-bottom: 19px; }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .loader-card,\r\n  .brand-mark::before,\r\n  .orbit,\r\n  .calendar-check,\r\n  .typing-dots i,\r\n  .progress-track span,\r\n  .loader-glow { animation: none; }\r\n  .calendar-check { stroke-dashoffset: 0; }\r\n  .progress-track span { width: 65%; background: var(--brand-500, #6758e8); }\r\n}\r\n"],
