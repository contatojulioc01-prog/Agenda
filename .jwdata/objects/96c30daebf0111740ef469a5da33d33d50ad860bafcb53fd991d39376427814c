    SELECT id, archived FROM kanban_tasks WHERE column_id = ?
    UNION ALL
    SELECT t.id, t.archived FROM kanban_tasks t JOIN tree ON t.parent_task_id = tree.id
  ) SELECT DISTINCT id, archived FROM tree`, [column.id]);
