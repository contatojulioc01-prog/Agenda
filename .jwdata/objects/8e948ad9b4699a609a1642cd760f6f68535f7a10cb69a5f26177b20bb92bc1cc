       bottom: 0;\r\n        width: 100%;\r\n        height: 100%;\r\n        opacity: 0;\r\n        cursor: pointer;\r\n      }\r\n    }\r\n\r\n    .notion-status-pill,\r\n    .notion-priority-pill,\r\n    .notion-assignees-stack,\r\n    .notion-date-wrapper,\r\n    .notion-custom-select-wrap {\r\n      pointer-events: none; /* Allows click through to full-cell overlay */\r\n    }\r\n\r\n    &:hover {\r\n      background: var(--bg-hover, #f8fafc);\r\n    }\r\n  }\r\n\r\n  .interactive-check-cell {\r\n    cursor: pointer;\r\n    user-select: none;\r\n\r\n    &:hover {\r\n      background: var(--bg-hover, #f8fafc);\r\n    }\r\n  }\r\n\r\n  .col-assignee {\r\n    position: relative;\r\n    cursor: pointer;\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .notion-assignees-stack {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 4px;\r\n    flex-wrap: wrap;\r\n    pointer-events: none;\r\n\r\n    .notion-assignee-pill {\r\n      display: inline-flex;\r\n      align-items: center;\r\n      padding: 2px 8px;\r\n      border-radius: 4px;\r\n      background: #fce7f3;\r\n      color: #9d174d;\r\n      border: 1px solid #fbcfe8;\r\n      font-size: 11.5px;\r\n      font-weight: 600;\r\n      white-space: nowrap;\r\n    }\r\n  }\r\n\r\n  .interactive-pill {\r\n    position: relative;\r\n    cursor: pointer;\r\n    transition: transform 0.1s ease, filter 0.12s ease;\r\n\r\n    select {\r\n      position: absolute;\r\n      inset: 0;\r\n      width: 100%;\r\n      height: 100%;\r\n      opacity: 0;\r\n      cursor: pointer;\r\n      font-size: 12px;\r\n\r\n      option {\r\n        background: var(--bg-surface, #ffffff);\r\n        color: var(--text-primary, #111827);\r\n      }\r\n    }\r\n\r\n    &:hover {\r\n      filter: brightness(0.95);\r\n    }\r\n  }\r\n\r\n  .notion-assignee-placeholder {\r\n    font-size: 11px;\r\n    color: var(--text-muted);\r\n    cursor: pointer;\r\n    padding: 2px 6px;\r\n    border-radius: 4px;\r\n    border: 1px dashed var(--border);\r\n  }\r\n\r\n  .notion-date-wrapper {\r\n    position: relative;\r\n    display: inline-flex;\r\n    align-items: center;\r\n    cursor: pointer;\r\n  }\r\n\r\n  .col-status {\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  /* Notion Status Pill Badge com Ponto Colorido e Dropdown Inline */\r\n  .notion-status-pill {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    position: relative;\r\n    padding: 2.5px 10px;\r\n    border-radius: 12px;\r\n    font-size: 11.5px;\r\n    font-weight: 600;\r\n    transition: filter 0.15s ease;\r\n    cursor: pointer;\r\n\r\n    .status-bullet {\r\n      width: 6.5px;\r\n      height: 6.5px;\r\n      border-radius: 50%;\r\n      flex-shrink: 0;\r\n    }\r\n\r\n    .status-label-text {\r\n      font-size: 11.5px;\r\n      font-weight: 600;\r\n      white-space: nowrap;\r\n      overflow: hidden;\r\n      text-overflow: ellipsis;\r\n      max-width: 110px;\r\n    }\r\n\r\n    &.status-done {\r\n      background: #d1fae5;\r\n      color: #065f46;\r\n      border: 1px solid #a7f3d0;\r\n      .status-bullet {\r\n        background: #10b981;\r\n      }\r\n    }\r\n\r\n    &.status-waiting {\r\n      background: #fef3c7;\r\n      color: #92400e;\r\n      border: 1px solid #fde68a;\r\n      .status-bullet {\r\n        background: #f59e0b;\r\n      }\r\n    }\r\n\r\n    &.status-in-progress {\r\n      background: #e0e7ff;\r\n      color: #3730a3;\r\n      border: 1px solid #c7d2fe;\r\n      .status-bullet {\r\n        background: #6366f1;\r\n      }\r\n    }\r\n\r\n    &.status-todo {\r\n      background: #f1f5f9;\r\n      color: #475569;\r\n      border: 1px solid #e2e8f0;\r\n      .status-bullet {\r\n        background: #94a3b8;\r\n      }\r\n    }\r\n\r\n    &.status-custom {\r\n      background: var(--custom-status-bg);\r\n      color: var(--custom-status-color);\r\n      border: 1px solid color-mix(in srgb, var(--custom-status-color) 30%, transparent);\r\n      .status-bullet {\r\n        background: var(--custom-status-dot);\r\n      }\r\n    }\r\n\r\n    select {\r\n      position: absolute;\r\n      inset: 0;\r\n      width: 100%;\r\n      height: 100%;\r\n      opacity: 0;\r\n      cursor: pointer;\r\n      font-size: 12px;\r\n\r\n      option {\r\n        background: var(--bg-surface, #ffffff);\r\n        color: var(--text-primary, #111827);\r\n      }\r\n    }\r\n\r\n    &:hover {\r\n      filter: brightness(0.96);\r\n    }\r\n  }\r\n\r\n  .col-priority {\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .notion-priority-pill {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 4px;\r\n    padding: 2.5px 8px;\r\n    border-radius: 6px;\r\n    font-size: 11.5px;\r\n    font-weight: 700;\r\n    cursor: pointer;\r\n    position: relative;\r\n\r\n    .p-icon {\r\n      font-size: 14px;\r\n      width: 14px;\r\n      height: 14px;\r\n    }\r\n\r\n    &.urgent {\r\n      background: rgba(239, 68, 68, 0.14);\r\n      color: #ef4444;\r\n      border: 1px solid rgba(239, 68, 68, 0.3);\r\n    }\r\n\r\n    &.high {\r\n      background: rgba(249, 115, 22, 0.14);\r\n      color: #ea580c;\r\n      border: 1px solid rgba(249, 115, 22, 0.3);\r\n    }\r\n\r\n    &.medium {\r\n      background: rgba(245, 158, 11, 0.14);\r\n      color: #d97706;\r\n      border: 1px solid rgba(245, 158, 11, 0.3);\r\n    }\r\n\r\n    &.low {\r\n      background: rgba(16, 185, 129, 0.14);\r\n      color: #059669;\r\n      border: 1px solid rgba(16, 185, 129, 0.3);\r\n    }\r\n  }\r\n\r\n  .col-labels {\r\n    min-width: 120px;\r\n    max-width: 200px;\r\n    cursor: pointer;\r\n\r\n    &:hover {\r\n      background: var(--bg-hover, #f8fafc);\r\n    }\r\n  }\r\n\r\n  .notion-labels-wrapper {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 4px;\r\n    flex-wrap: wrap;\r\n    width: 100%;\r\n\r\n    .notion-label-tag {\r\n      font-size: 10.5px;\r\n      font-weight: 600;\r\n      padding: 1.5px 6px;\r\n      border-radius: 4px;\r\n      background: var(--brand-100);\r\n      color: var(--text-brand);\r\n      white-space: nowrap;\r\n      max-width: 90px;\r\n      overflow: hidden;\r\n      text-overflow: ellipsis;\r\n    }\r\n\r\n    .notion-label-more {\r\n      font-size: 10px;\r\n      font-weight: 700;\r\n      color: var(--text-muted);\r\n    }\r\n  }\r\n\r\n  .col-custom-dyn {\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .col-custom-cell {\r\n    box-sizing: border-box;\r\n    cursor: pointer;\r\n\r\n    &:hover {\r\n      background: var(--bg-hover, #f8fafc);\r\n    }\r\n\r\n    .notion-custom-text-wrap {\r\n      width: 100%;\r\n      overflow: hidden;\r\n      text-overflow: ellipsis;\r\n      white-space: nowrap;\r\n    }\r\n\r\n    .notion-custom-select-wrap {\r\n      display: inline-flex;\r\n      align-items: center;\r\n      padding: 2px 8px;\r\n      border-radius: 6px;\r\n      background: var(--bg-hover);\r\n      border: 1px solid var(--border);\r\n      font-size: 11.5px;\r\n      font-weight: 500;\r\n      color: var(--text-primary);\r\n\r\n      .custom-select-val {\r\n        max-width: 130px;\r\n        overflow: hidden;\r\n        text-overflow: ellipsis;\r\n        white-space: nowrap;\r\n      }\r\n    }\r\n\r\n    .notion-custom-check-wrap {\r\n      display: inline-flex;\r\n      align-items: center;\r\n\r\n      input[type=\"checkbox\"] {\r\n        accent-color: var(--brand-500);\r\n        cursor: pointer;\r\n        width: 16px;\r\n        height: 16px;\r\n      }\r\n    }\r\n  }\r\n\r\n  .editable-field {\r\n    cursor: text;\r\n    border-radius: 4px;\r\n    padding: 1px 4px;\r\n    margin: -1px -4px;\r\n    transition: background 0.12s ease;\r\n\r\n    &:hover {\r\n      background: rgba(148, 163, 184, 0.15);\r\n    }\r\n  }\r\n\r\n  .inline-cell-input {\r\n    width: 100%;\r\n    height: 26px;\r\n    padding: 2px 6px;\r\n    font-size: 12px;\r\n    font-family: inherit;\r\n    color: var(--text-primary);\r\n    background: var(--bg-surface);\r\n    border: 1px solid var(--brand-500, #6366f1);\r\n    border-radius: 5px;\r\n    outline: none;\r\n    box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2);\r\n\r\n    &.title-input {\r\n      font-weight: 500;\r\n    }\r\n  }\r\n\r\n  .col-add-column {\r\n    width: 36px;\r\n    min-width: 36px;\r\n    max-width: 36px;\r\n    padding: 8px 6px !important;\r\n    text-align: center;\r\n    cursor: pointer;\r\n\r\n    mat-icon {\r\n      margin: 0 !important;\r\n      font-size: 16px;\r\n      width: 16px;\r\n      height: 16px;\r\n      color: var(--text-muted);\r\n    }\r\n\r\n    &:hover {\r\n      background: var(--bg-hover);\r\n      mat-icon {\r\n        color: var(--brand-500);\r\n      }\r\n    }\r\n  }\r\n\r\n  .col-add-column-cell {\r\n    width: 36px;\r\n    min-width: 36px;\r\n    max-width: 36px;\r\n    padding: 4px 6px !important;\r\n    text-align: center;\r\n\r\n    .row-open-modal-btn {\r\n      opacity: 0;\r\n      width: 24px;\r\n      height: 24px;\r\n      padding: 0;\r\n      border: 0;\r\n      background: transparent;\r\n      border-radius: 4px;\r\n      cursor: pointer;\r\n      color: var(--text-muted);\r\n      display: inline-flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      transition: opacity 0.15s, background 0.15s, color 0.15s;\r\n\r\n      mat-icon {\r\n        font-size: 14px;\r\n        width: 14px;\r\n        height: 14px;\r\n      }\r\n\r\n      &:hover {\r\n        background: var(--bg-hover);\r\n        color: var(--brand-500);\r\n      }\r\n    }\r\n  }\r\n\r\n  tr.notion-row:hover .row-open-modal-btn {\r\n    opacity: 1;\r\n  }\r\n\r\n  .notion-empty-cell {\r\n    color: var(--text-muted);\r\n    font-size: 11px;\r\n  }\r\n\r\n  .notion-empty-row {\r\n    padding: 36px 12px;\r\n    text-align: center;\r\n    color: var(--text-muted);\r\n    font-size: 12px;\r\n\r\n    mat-icon {\r\n      font-size: 24px;\r\n      width: 24px;\r\n      height: 24px;\r\n      display: block;\r\n      margin: 0 auto 6px;\r\n      opacity: 0.5;\r\n    }\r\n  }\r\n\r\n  .notion-add-task-row {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    padding: 10px 14px;\r\n    border-top: 1px solid var(--border);\r\n    color: var(--text-muted);\r\n    font-size: 12px;\r\n    font-weight: 600;\r\n    cursor: pointer;\r\n    transition: color 0.15s, background 0.15s;\r\n\r\n    mat-icon {\r\n      font-size: 17px;\r\n      width: 17px;\r\n      height: 17px;\r\n    }\r\n\r\n    &:hover {\r\n      color: var(--brand-600, #4f46e5);\r\n      background: color-mix(in srgb, var(--bg-surface) 90%, var(--bg-hover));\r\n    }\r\n  }\r\n}\r\n\r\n/* ══════════════════════════════════════════════════════════════════\r\n   MODO DE VISUALIZAÇÃO EXPANDIDA / TELA CHEIA (SEM F11 NATIVO)\r\n   ══════════════════════════════════════════════════════════════════ */\r\n\r\n.workspace-tabs {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n\r\n  .tabs-list-wrap {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    overflow-x: auto;\r\n    flex: 1;\r\n  }\r\n\r\n  .expand-mode-btn {\r\n    height: 32px;\r\n    padding: 0 11px;\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n    border-radius: 8px;\r\n    border: 1px solid var(--border);\r\n    background: var(--bg-hover);\r\n    color: var(--text-secondary);\r\n    font-size: 11.5px;\r\n    font-weight: 650;\r\n    white-space: nowrap;\r\n    cursor: pointer;\r\n    transition: all 0.15s ease;\r\n    flex-shrink: 0;\r\n\r\n    mat-icon {\r\n      font-size: 17px;\r\n      width: 17px;\r\n      height: 17px;\r\n      color: var(--text-muted);\r\n    }\r\n\r\n    &:hover {\r\n      color: var(--text-primary);\r\n      border-color: var(--border-focus);\r\n      background: var(--bg-surface);\r\n    }\r\n\r\n    &.active {\r\n      background: var(--brand-100);\r\n      color: var(--brand-700, #4f46e5);\r\n      border-color: var(--brand-500);\r\n\r\n      mat-icon {\r\n        color: var(--brand-600, #4f46e5);\r\n      }\r\n    }\r\n  }\r\n}\r\n\r\n.fullscreen-btn {\r\n  &.active {\r\n    background: var(--brand-500);\r\n    color: #fff;\r\n    border-color: var(--brand-600);\r\n\r\n    mat-icon {\r\n      color: #fff;\r\n    }\r\n\r\n    &:hover {\r\n      background: var(--brand-600);\r\n      color: #fff;\r\n    }\r\n  }\r\n}\r\n\r\n:host-context(body.kanban-fullscreen-active) {\r\n  position: fixed !important;\r\n  inset: 0 !important;\r\n  z-index: 9999 !important;\r\n  width: 100vw !important;\r\n  height: 100vh !important;\r\n  background: var(--bg-surface-alt, var(--bg-surface)) !important;\r\n  box-sizing: border-box !important;\r\n  padding: 10px 14px !important;\r\n\r\n  .kanban-toolbar,\r\n  .workspace-tabs {\r\n    display: none !important;\r\n  }\r\n\r\n  .kanban-shell {\r\n    width: 100% !important;\r\n    height: 100% !important;\r\n    max-width: none !important;\r\n  }\r\n}\r\n\r\n/* Regra global quando o modo de tela cheia está ativo no body */\r\nbody.kanban-fullscreen-active {\r\n  overflow: hidden !important;\r\n\r\n  aside.sidebar {\r\n    display: none !important;\r\n  }\r\n\r\n  .kanban-toolbar,\r\n  .workspace-tabs {\r\n    display: none !important;\r\n  }\r\n\r\n  .main-area.tasks-main {\r\n    position: fixed !important;\r\n    inset: 0 !important;\r\n    z-index: 9990 !important;\r\n    width: 100vw !important;\r\n    height: 100vh !important;\r\n    padding: 0 !important;\r\n    margin: 0 !important;\r\n    max-width: none !important;\r\n    background: var(--bg-surface-alt, var(--bg-surface)) !important;\r\n  }\r\n}\r\n\r\n/* ══════════════════════════════════════════════════\r\n   ✅ CHECKLIST — Padrão Angular Material\r\n   ══════════════════════════════════════════════════ */\r\n\r\n/* Checklist no MODAL (substituindo check-item básico) */\r\n.check-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  min-height: 36px;\r\n  padding: 4px 6px;\r\n  border-radius: 8px;\r\n  transition: background 0