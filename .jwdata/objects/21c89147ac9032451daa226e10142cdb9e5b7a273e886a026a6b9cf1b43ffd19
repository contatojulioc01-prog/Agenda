adow: 0 6px 24px rgba(220, 38, 38, 0.65), 0 0 36px rgba(220, 38, 38, 0.35);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n/* ─── Eventos com brilho infernal ─── */\r\n[data-theme=\"dark-demon\"] .month-event-bar:hover,\r\n[data-theme=\"dark-demon\"] .week-event:hover,\r\n[data-theme=\"dark-demon\"] .day-event:hover {\r\n  box-shadow: 0 4px 16px rgba(0, 0, 0, .55), 0 0 12px rgba(220, 38, 38, .40);\r\n}\r\n\r\n/* ─── Célula hoje: chama ─── */\r\n[data-theme=\"dark-demon\"] .today-cell .day-number,\r\n[data-theme=\"dark-demon\"] .week-day-header.today .week-day-number,\r\n[data-theme=\"dark-demon\"] .mini-cal-day.today {\r\n  background: linear-gradient(135deg, #7f1d1d 0%, #ef4444 100%);\r\n  box-shadow: 0 0 12px rgba(220, 38, 38, 0.70), 0 0 24px rgba(220, 38, 38, 0.35);\r\n}\r\n\r\n/* ─── Scrollbar infernal ─── */\r\n[data-theme=\"dark-demon\"] ::-webkit-scrollbar-thumb {\r\n  background: rgba(200, 40, 0, 0.40);\r\n}\r\n\r\n[data-theme=\"dark-demon\"] ::-webkit-scrollbar-thumb:hover {\r\n  background: rgba(220, 50, 0, 0.65);\r\n}\r\n\r\n/* ─── Inputs infernais ─── */\r\n[data-theme=\"dark-demon\"] .form-field input:focus,\r\n[data-theme=\"dark-demon\"] .custom-select:focus,\r\n[data-theme=\"dark-demon\"] .custom-textarea:focus {\r\n  border-color: #f87171;\r\n  box-shadow: 0 0 0 3.5px rgba(239, 68, 68, 0.22), 0 0 12px rgba(239, 68, 68, 0.16);\r\n}\r\n\r\n/* ─── Drag over infernal ─── */\r\n[data-theme=\"dark-demon\"] .week-day-col.drag-over {\r\n  background: rgba(200, 40, 0, 0.14) !important;\r\n  outline: 2.5px dashed rgba(220, 50, 0, 0.65) !important;\r\n  box-shadow: inset 0 0 24px rgba(200, 40, 0, 0.16);\r\n}\r\n\r\n/* ─── Linha de hora atual: brasa ─── */\r\n[data-theme=\"dark-demon\"] .current-time-line {\r\n  background: #ef4444;\r\n  box-shadow: 0 0 8px rgba(239, 68, 68, 0.75);\r\n}\r\n\r\n[data-theme=\"dark-demon\"] .current-time-line::before {\r\n  background: #f87171;\r\n  box-shadow: 0 0 8px rgba(248, 113, 113, 0.85);\r\n}\r\n\r\n/* ─── Seleção de texto i