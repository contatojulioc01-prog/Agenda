# =============================================================================
# Gitignore - Agenda Corporativa & Kanban
# Proteção estrita contra vazamento de credenciais, bancos e arquivos internos
# =============================================================================

# Dependências & Gerenciadores de Pacote
node_modules/
backend/node_modules/
frontend/node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variáveis de Ambiente, Segredos e Chaves
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12
*.token
secrets/

# Deploy interno e ferramentas de servidor (JW Deploy / PM2)
.jw
.jwignore
.jwdata/
*.jwdata
jw-deploys.json
deploy-config.json
pm2-*.log

# Bancos de Dados, Dumps e Snapshots
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal
backend/agenda.db
backend/*.db
data/
*.sql
*.dump
*.bak
*.backup

# Releases e Pacotes compactados internos
release/
releases/
frontend/release/
*.zip
*.tar.gz
*.rar
*.7z

# Builds e Distribuição
frontend/dist/
frontend/.angular/
dist/
build/
.angular/

# Uploads temporários e anexos locais
uploads/
backend/uploads/
backend/public/assets/uploads/
temp/
tmp/
*.pdf

# Logs e Processos
*.log
logs/
backend/logs/

# IDEs e Ferramentas de Desenvolvimento
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln.docstates
*.user
*.userosscache
*.swp
*.swo

# Arquivos do Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
