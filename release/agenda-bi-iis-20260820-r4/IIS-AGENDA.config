<!-- Adicione estas regras dentro de system.webServer/rewrite/rules no web.config do portal. -->

<!-- Garante a barra final para o base href /agenda/. -->
<rule name="Agenda - Barra final" stopProcessing="true">
  <match url="^agenda$" />
  <action type="Redirect" url="/agenda/" redirectType="Permanent" />
</rule>

<!-- Encaminha frontend, API, health check e WebSocket para o Node. -->
<rule name="Agenda" stopProcessing="true">
  <match url="^agenda(?:/(.*))?$" />
  <action
    type="Rewrite"
    url="http://docebrinquedo.local:9900/{R:1}"
    appendQueryString="true"
  />
</rule>
