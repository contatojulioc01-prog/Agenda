# Copie este arquivo para .env e preencha com os dados do seu PostgreSQL.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=agenda
PGUSER=agenda_app
PGPASSWORD=troque_por_uma_senha_forte
PGSSL=false
PGPOOL_MAX=10

# O db:setup usa estas credenciais administrativas para criar o usuário/database.
# Se forem omitidas, ele tenta usar PGUSER/PGPASSWORD.
PGADMINDB=postgres
PGADMINUSER=postgres
PGADMINPASSWORD=senha_do_administrador_postgres

# Alternativa: use uma URL única e remova PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD.
# DATABASE_URL=postgresql://agenda_app:senha@servidor:5432/agenda

PORT=9900

# API corporativa usada para autenticação e listagem de colaboradores.
PORTAL_API=http://192.168.13.244:7000
