{
  "name": "agenda",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node ../production-start.js",
    "dev": "node ../scripts/dev-start.cjs",
    "dev:serve": "ng serve --host 0.0.0.0 --port 9990",
    "dev:local": "ng serve --host 127.0.0.1 --port 9990",
    "backend": "npm --prefix ../backend start",
    "backend:install": "npm --prefix ../backend install",
    "db:setup": "npm --prefix ../backend run db:setup",
    "db:migrate:sqlite": "npm --prefix ../backend run db:migrate:sqlite",
    "stop": "node kill.js",
    "kill": "node kill.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm --prefix ../backend test && npm run typecheck",
    "typecheck": "tsc -p tsconfig.app.json --noEmit"
  },
  "private": true,
  "packageManager": "npm@12.2.1",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
